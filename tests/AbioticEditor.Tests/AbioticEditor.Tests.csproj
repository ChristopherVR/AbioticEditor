<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Platforms>x64</Platforms>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- CA1707: underscore_separated test names are the xunit convention. -->
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Supplies libSkiaSharp.so so SkiaRoundtripTests can load Skia on the Linux CI runner
         (the base SkiaSharp package carries Windows/macOS natives only). Inert on Windows. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
    <PackageReference Include="xunit" />
    <PackageReference Include="Xunit.SkippableFact" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\..\src\AbioticEditor.Plugins.Abstractions\AbioticEditor.Plugins.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\AbioticEditor.Cli\AbioticEditor.Cli.csproj" />
    <ProjectReference Include="..\..\src\AbioticEditor.Updater\AbioticEditor.Updater.csproj" />
    <ProjectReference Include="..\..\src\AbioticEditor.Web\AbioticEditor.Web.csproj" />
    <ProjectReference Include="..\..\submodules\UeSaveGame\UeSaveGame\UeSaveGame.csproj" />
    <ProjectReference Include="..\..\submodules\UeSaveGame\UeSaveGame.Json\UeSaveGame.Json.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample fix-up plugins, referenced so PluginFixupTests exercises the real operations. -->
    <ProjectReference Include="..\..\plugins\RepairNeeds\RepairNeeds.csproj" />
    <ProjectReference Include="..\..\plugins\GrantFlag\GrantFlag.csproj" />
    <ProjectReference Include="..\..\plugins\VersionShim\VersionShim.csproj" />
    <!-- The optional game-models plugin: its math, formats and loading are tested here. -->
    <ProjectReference Include="..\..\plugins\GameModels3D\GameModels3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Caps how many test classes run at once. Many classes parse the ~16 MB region saves or
         mount the game's paks, and with one class per core running together a full run peaked
         at about 11 GB in a single test process. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
