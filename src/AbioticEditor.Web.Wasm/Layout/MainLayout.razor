@inherits LayoutComponentBase
@implements IDisposable
@using AbioticEditor.Web.Wasm.Services
@inject PlayerSaveSession Session
@inject NavigationManager Nav

<div class="shell">
    <header class="shell-header">
        <a class="brand" href="">ABIOTIC EDITOR<span class="brand-tag">browser</span></a>

        @if (Session.HasSave)
        {
            <div class="open-save">
                <span class="open-save-name">@Session.FileName</span>
                @if (Session.IsDirty)
                {
                    <span class="badge-dirty">unsaved changes</span>
                }
            </div>
            <div class="header-actions">
                <button class="btn btn-primary" @onclick="DownloadAsync" disabled="@(!Session.IsDirty)">
                    Download save
                </button>
                <button class="btn" @onclick="Close">Close</button>
            </div>
        }
    </header>

    <div class="shell-body">
        @if (Session.HasSave)
        {
            <nav class="shell-nav">
                <NavLink class="nav-item" href="" Match="NavLinkMatch.All">Overview</NavLink>
                <NavLink class="nav-item" href="stats">Vitals &amp; health</NavLink>
                <NavLink class="nav-item" href="skills">Skills</NavLink>
                <NavLink class="nav-item" href="traits">Traits &amp; background</NavLink>
                <NavLink class="nav-item" href="inventory">Inventory</NavLink>
                <NavLink class="nav-item" href="progression">Progression</NavLink>
            </nav>
        }

        <main class="shell-main">
            @Body
        </main>
    </div>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private Task DownloadAsync() => Session.DownloadAsync();

    private void Close()
    {
        Session.Close();
        Nav.NavigateTo("");
    }
}
