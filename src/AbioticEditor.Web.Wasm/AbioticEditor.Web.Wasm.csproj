<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!-- Data files this build serves over HTTP, copied from the repo's shared assets.

       They are COPIED INTO wwwroot rather than declared as <Content Include Link="wwwroot\..."/>.
       That looked equivalent and is not: a linked Content item lands in the output folder but is
       never registered as a Blazor static web asset, so every request for one answered
       "200 OK, Content-Length: 0". Nothing errored - the registry simply parsed as empty, and the
       editor came up with no item names, no recipes and no pictures at all. Blazor takes static
       web assets from the wwwroot folder itself, so the files have to actually be there.

       The copies are generated, so wwwroot/{registry,icons,Templates} are gitignored; the
       originals under assets/ are what is committed. -->
  <ItemGroup>
    <BrowserDataAsset Include="..\..\assets\registry\registry.json" TargetDir="registry" />
    <BrowserDataAsset Include="..\..\assets\icons\*.png" TargetDir="icons" />
    <!-- Everything the editor draws that is not an item icon: skill icons, trader portraits,
         chapter cards, sector maps, creature and pet portraits, the logo. -->
    <BrowserDataAsset Include="..\..\assets\art\*.png" TargetDir="art" />
    <BrowserDataAsset Include="..\..\assets\art\manifest.json" TargetDir="art" />
    <!-- The offline copies of the verified wiki images, which the desktop downloads on demand. -->
    <BrowserDataAsset Include="..\..\assets\wiki\*.png" TargetDir="wiki" />
    <BrowserDataAsset Include="..\AbioticEditor.Core\Resources\blank-world-template.sav" TargetDir="Templates" />
    <BrowserDataAsset Include="..\AbioticEditor.Core\Resources\blank-player-template.sav" TargetDir="Templates" />
  </ItemGroup>

  <Target Name="CopyBrowserDataAssets"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Inputs="@(BrowserDataAsset)"
          Outputs="@(BrowserDataAsset -> 'wwwroot\%(TargetDir)\%(Filename)%(Extension)')">
    <Copy SourceFiles="@(BrowserDataAsset)"
          DestinationFiles="@(BrowserDataAsset -> 'wwwroot\%(TargetDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\AbioticEditor.Ui.Abstractions\AbioticEditor.Ui.Abstractions.csproj" />
    <!-- The editor's screens and services, shared with the desktop host. -->
    <ProjectReference Include="..\AbioticEditor.Web.Shared\AbioticEditor.Web.Shared.csproj" />
  </ItemGroup>

</Project>
