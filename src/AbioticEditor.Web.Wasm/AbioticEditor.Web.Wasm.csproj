<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>

    <!-- Cuts the download roughly in half (see docs/PROGRESS.md round-58 for the measurements).
         Blazor already publishes trimmed, but at TrimMode=partial, which only touches assemblies
         whose authors marked them trimmable. Nothing we depend on is marked, so the pak-reading
         and plugin-scripting libraries shipped WHOLE even though a browser can never run them.
         Full mode trims everything, which is what finally removes them. -->
    <TrimMode>full</TrimMode>
  </PropertyGroup>

  <!-- Assemblies the trimmer must keep INTACT.

       Save files are parsed by looking up a property type by its name in the file and building
       it with Activator.CreateInstance, so nothing statically references most of those types
       and a trimmer sees them as dead code. Left to itself, full trim deletes the whole save
       engine: a measured run dropped UeSaveGame and UeSaveGame.Json outright and cut Core from
       1007 KB to 268 KB, which would have shipped an editor that cannot open a save at all.
       Rooting these keeps every type that a save file might name.

       Cost is about 2 MB of the 17 MB, and it buys back the one thing that must never break. -->
  <ItemGroup>
    <TrimmerRootAssembly Include="UeSaveGame" />
    <TrimmerRootAssembly Include="UeSaveGame.Json" />
    <TrimmerRootAssembly Include="AbioticEditor.Core" />
    <TrimmerRootAssembly Include="AbioticEditor.Web.Shared" />
    <!-- This project too. The little records handed back and forth with JavaScript are built by
         the JSON reader, never by our own code, so the trimmer removed their constructors and
         the very first click - OPEN FOLDER - failed with "DeserializeNoConstructor". -->
    <TrimmerRootAssembly Include="AbioticEditor.Web.Wasm" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <!-- Data files this build serves over HTTP, copied from the repo's shared assets.

       They are COPIED INTO wwwroot rather than declared as <Content Include Link="wwwroot\..."/>.
       That looked equivalent and is not: a linked Content item lands in the output folder but is
       never registered as a Blazor static web asset, so every request for one answered
       "200 OK, Content-Length: 0". Nothing errored - the registry simply parsed as empty, and the
       editor came up with no item names, no recipes and no pictures at all. Blazor takes static
       web assets from the wwwroot folder itself, so the files have to actually be there.

       The copies are generated, so wwwroot/{registry,icons,Templates} are gitignored; the
       originals under assets/ are what is committed. -->
  <ItemGroup>
    <!-- One per language the game ships. Only the one matching the player is ever downloaded. -->
    <BrowserDataAsset Include="..\..\assets\registry\registry*.json" TargetDir="registry" />
    <BrowserDataAsset Include="..\..\assets\icons\*.png" TargetDir="icons" />
    <!-- Everything the editor draws that is not an item icon: skill icons, trader portraits,
         chapter cards, sector maps, creature and pet portraits, the logo. -->
    <BrowserDataAsset Include="..\..\assets\art\*.png" TargetDir="art" />
    <BrowserDataAsset Include="..\..\assets\art\manifest.json" TargetDir="art" />
    <!-- The offline copies of the verified wiki images, which the desktop downloads on demand. -->
    <BrowserDataAsset Include="..\..\assets\wiki\*.png" TargetDir="wiki" />
    <BrowserDataAsset Include="..\AbioticEditor.Core\Resources\blank-world-template.sav" TargetDir="Templates" />
    <BrowserDataAsset Include="..\AbioticEditor.Core\Resources\blank-player-template.sav" TargetDir="Templates" />
  </ItemGroup>

  <Target Name="CopyBrowserDataAssets"
          BeforeTargets="ResolveStaticWebAssetsInputs"
          Inputs="@(BrowserDataAsset)"
          Outputs="@(BrowserDataAsset -> 'wwwroot\%(TargetDir)\%(Filename)%(Extension)')">
    <Copy SourceFiles="@(BrowserDataAsset)"
          DestinationFiles="@(BrowserDataAsset -> 'wwwroot\%(TargetDir)\%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\AbioticEditor.Ui.Abstractions\AbioticEditor.Ui.Abstractions.csproj" />
    <!-- The editor's screens and services, shared with the desktop host. -->
    <ProjectReference Include="..\AbioticEditor.Web.Shared\AbioticEditor.Web.Shared.csproj" />
  </ItemGroup>

</Project>
