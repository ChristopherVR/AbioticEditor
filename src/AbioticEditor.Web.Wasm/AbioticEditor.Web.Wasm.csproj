<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The blank saves a new world is built from. The desktop host copies these beside its
         executable and reads them off disk; here they ship as ordinary static files that
         BrowserSaveTemplateSource fetches from the page's own origin. -->
    <Content Include="..\AbioticEditor.Core\Resources\blank-world-template.sav"
             Link="wwwroot\Templates\blank-world-template.sav"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\AbioticEditor.Core\Resources\blank-player-template.sav"
             Link="wwwroot\Templates\blank-player-template.sav"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Game data dumped from the paks ahead of time (item, recipe and skill names, icon paths).
         This is what lets the browser show real names without the game installed: mounting the
         paks in a tab is not possible (see docs/PROGRESS.md round-45 - the IoStore container
         alone is 4.6 GB against a ~2 GB WebAssembly heap), but this dump is about a megabyte.
         Program.cs stages it where GameDataRegistry.LoadBundled() looks. -->
    <Content Include="..\..\assets\registry\registry.json"
             Link="wwwroot\registry\registry.json"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Item pictures, dumped from the game ahead of time by `abioticeditor dump-icons`. Shipped
         for THIS host only: the desktop app decodes them out of the installed game on demand and
         carrying a copy would only make its download bigger. Icons are untranslated artwork, so
         this one set serves every language - only the names beside them are localised, and those
         live in registry.json above. -->
    <Content Include="..\..\assets\icons\*.png"
             Link="wwwroot\icons\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\AbioticEditor.Ui.Abstractions\AbioticEditor.Ui.Abstractions.csproj" />
    <!-- The editor's screens and services, shared with the desktop host. -->
    <ProjectReference Include="..\AbioticEditor.Web.Shared\AbioticEditor.Web.Shared.csproj" />
  </ItemGroup>

</Project>
