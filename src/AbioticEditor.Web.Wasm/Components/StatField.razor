@* A 0-100 survival/health value: slider for quick changes, number box for exact ones. *@

<div class="field">
    <label for="@_id">@Label <span class="stat-readout">@Display</span></label>
    <input id="@_id" type="range" min="0" max="100" step="1" value="@Rounded"
           @onchange="OnChanged" />
</div>

@code {
    private readonly string _id = $"stat-{Guid.NewGuid():N}";

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    [Parameter] public double Value { get; set; }

    [Parameter] public EventCallback<double> ValueChanged { get; set; }

    private double Rounded => Math.Round(Value);

    // Saves carry full precision (a real hunger value looks like 54.20499963164332), so show
    // whole numbers but never round-trip the stored value unless the user actually moves the
    // slider - an untouched stat must write back exactly what was read.
    private string Display => Value.ToString("0.#");

    private Task OnChanged(ChangeEventArgs e)
    {
        if (!double.TryParse(e.Value?.ToString(), out var parsed)) return Task.CompletedTask;
        return ValueChanged.InvokeAsync(Math.Clamp(parsed, 0, 100));
    }
}
