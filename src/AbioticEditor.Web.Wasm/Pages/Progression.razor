@page "/progression"
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Web.Wasm.Services
@inject PlayerSaveSession Session

<PageTitle>Progression - Abiotic Editor</PageTitle>

@if (Session.Data is null)
{
    <NoSaveOpen />
}
else
{
    <h1>Progression</h1>
    <p class="hint">
        These are the lists your character has collected: recipes you can craft, journal entries and
        emails you have read, maps you have found, and fish you have caught. One internal id per
        line. Removing a line takes that unlock away; adding one grants it.
    </p>

    <div class="panel">
        <NameListEditor Label="Recipes unlocked" Rows="12"
                        Value="_recipes" ValueChanged="OnRecipesChanged" />
    </div>

    <div class="panel">
        <NameListEditor Label="Journal entries" Value="_journals" ValueChanged="OnJournalsChanged" />
    </div>

    <div class="panel">
        <NameListEditor Label="Emails read" Value="_emails" ValueChanged="OnEmailsChanged" />
    </div>

    <div class="panel">
        <NameListEditor Label="Maps unlocked" Rows="5"
                        Value="_maps" ValueChanged="OnMapsChanged" />
    </div>

    <div class="panel">
        <NameListEditor Label="Fish caught" Rows="6"
                        Value="_fish" ValueChanged="OnFishChanged" />
    </div>

    <h2>Creatures killed</h2>
    <div class="panel">
        @if (_kills.Count == 0)
        {
            <p class="hint">This character has not killed anything yet.</p>
        }
        else
        {
            <table>
                <thead>
                    <tr><th>Creature</th><th style="width:8rem">Killed</th></tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < _kills.Count; i++)
                    {
                        var index = i;
                        <tr>
                            <td><code>@_kills[index].CompendiumRow</code></td>
                            <td>
                                <input type="number" min="0" step="1" value="@_kills[index].Count"
                                       aria-label="@_kills[index].CompendiumRow kill count"
                                       @onchange="e => OnKillCountChanged(index, e)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@code {
    private IReadOnlyList<string> _recipes = [];
    private IReadOnlyList<string> _journals = [];
    private IReadOnlyList<string> _emails = [];
    private IReadOnlyList<string> _maps = [];
    private IReadOnlyList<string> _fish = [];
    private List<KillCount> _kills = [];

    protected override void OnInitialized()
    {
        if (Session.Data is not { } data) return;

        _recipes = data.Recipes;
        _journals = data.Journals;
        _emails = data.EmailsRead;
        _maps = data.MapsUnlocked;
        _fish = data.FishCaught;
        _kills = data.KillCounts.ToList();
    }

    private void OnRecipesChanged(IReadOnlyList<string> value)
    {
        _recipes = value;
        Mutate(data => PlayerSaveWriter.ApplyRecipes(data, value));
    }

    private void OnJournalsChanged(IReadOnlyList<string> value)
    {
        _journals = value;
        Mutate(data => PlayerSaveWriter.ApplyJournals(data, value));
    }

    private void OnEmailsChanged(IReadOnlyList<string> value)
    {
        _emails = value;
        Mutate(data => PlayerSaveWriter.ApplyEmailsRead(data, value));
    }

    private void OnMapsChanged(IReadOnlyList<string> value)
    {
        _maps = value;
        Mutate(data => PlayerSaveWriter.ApplyMapsUnlocked(data, value));
    }

    private void OnFishChanged(IReadOnlyList<string> value)
    {
        _fish = value;
        Mutate(data => PlayerSaveWriter.ApplyFishCaught(data, value));
    }

    private void OnKillCountChanged(int index, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var count)) return;
        _kills[index] = _kills[index] with { Count = Math.Max(0, count) };
        Mutate(data => PlayerSaveWriter.ApplyKillCounts(data, _kills));
    }

    private void Mutate(Action<PlayerSaveData> apply)
    {
        if (Session.Data is not { } data) return;
        apply(data);
        Session.MarkDirty();
    }
}
