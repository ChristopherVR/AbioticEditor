@page "/"
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Web.Wasm.Services
@inject PlayerSaveSession Session

<PageTitle>Abiotic Editor (browser)</PageTitle>

@if (Session.Data is null)
{
    <h1>Edit your Abiotic Factor save, right here</h1>
    <p>
        Pick a character save and change your stats, skills, traits, inventory and progress.
        Everything happens inside this browser tab: your save is never uploaded to a server,
        because there is no server. Nothing is written back to your computer until you press
        <strong>Download save</strong>.
    </p>

    <div class="panel">
        <h3>Open a save</h3>
        <p class="hint">
            Character saves are named <code>Player_&lt;steamid64&gt;.sav</code>. On Steam they live in
            <code>%LOCALAPPDATA%\AbioticFactor\Saved\SaveGames</code>, inside your world's
            <code>PlayerData</code> folder.
        </p>
        <InputFile OnChange="OnFileSelectedAsync" accept=".sav" />
    </div>

    @if (_error is not null)
    {
        <p class="error">@_error</p>
    }

    <p class="hint">
        Always keep a copy of your original save. This is a fan-made tool and is not part of the game.
    </p>
}
else
{
    var data = Session.Data;

    <h1>Overview</h1>

    <div class="panel">
        <div class="field-grid">
            <div class="field">
                <label>Save file</label>
                <strong>@Session.FileName</strong>
            </div>
            <div class="field">
                <label>Save version</label>
                <strong>@(data.AbfVersion?.ToString() ?? "unknown")</strong>
            </div>
            <div class="field">
                <label>Background</label>
                <strong>@BackgroundName(data.Phd)</strong>
            </div>
            <div class="field">
                <label>Money</label>
                <strong>@data.Stats.Money</strong>
            </div>
        </div>
    </div>

    <h2>What's in this save</h2>
    <div class="panel">
        <table>
            <tbody>
                <tr><td>Skills</td><td>@data.Skills.Count (@TotalSkillLevels total levels)</td></tr>
                <tr><td>Traits</td><td>@data.Traits.Count</td></tr>
                <tr><td>Items carried</td><td>@FilledSlots of @TotalSlots slots filled</td></tr>
                <tr><td>Recipes unlocked</td><td>@data.Recipes.Count</td></tr>
                <tr><td>Journal entries</td><td>@data.Journals.Count</td></tr>
                <tr><td>Emails read</td><td>@data.EmailsRead.Count</td></tr>
                <tr><td>Maps unlocked</td><td>@data.MapsUnlocked.Count</td></tr>
                <tr><td>Fish caught</td><td>@data.FishCaught.Count</td></tr>
                <tr><td>Creatures killed</td><td>@data.KillCounts.Sum(k => k.Count)</td></tr>
            </tbody>
        </table>
    </div>

    @if (!data.HasKnownSaveClass)
    {
        <p class="error">
            This file's save type (<code>@(data.SaveClassName ?? "unknown")</code>) is not one the editor
            recognises. It has still been read, but treat any edit with caution and keep your backup.
        </p>
    }

    <p class="hint">
        Item and recipe names are shown as their internal ids in this browser version, because reading
        the game's own data files needs the game installed on the same machine. The desktop app shows
        real names and icons.
    </p>
}

@code {
    private string? _error;

    private int TotalSkillLevels => Session.Data?.Skills.Sum(s => s.Level) ?? 0;

    private int TotalSlots => AllSlots().Count();

    private int FilledSlots => AllSlots().Count(s => !s.IsEmpty);

    private IEnumerable<InventoryItemSlot> AllSlots()
    {
        var inventory = Session.Data?.Inventory;
        if (inventory is null) return Array.Empty<InventoryItemSlot>();
        return inventory.Equipment.Concat(inventory.Hotbar).Concat(inventory.Main);
    }

    private static string BackgroundName(string? phd)
    {
        if (string.IsNullOrEmpty(phd)) return "none";
        return TraitCatalog.Backgrounds.TryGetValue(phd, out var name) ? name : phd;
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs e)
    {
        _error = null;
        var file = e.File;
        try
        {
            await using var stream = file.OpenReadStream(PlayerSaveSession.MaximumFileSize);
            await Session.LoadAsync(stream, file.Name);
        }
        catch (Exception ex)
        {
            _error = $"Couldn't read {file.Name} as a character save: {ex.Message}";
        }
    }
}
