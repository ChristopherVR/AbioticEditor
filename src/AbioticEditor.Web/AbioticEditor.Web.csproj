<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Windows gets its own native file/folder pickers (System.Windows.Forms) instead of
         shelling out to a PowerShell subprocess; Linux/macOS keep using the plain TFM and
         the existing zenity/kdialog/osascript subprocess pickers, since there is no
         equivalent native .NET dialog API on those platforms.

         The Windows TFM is only offered ON Windows. A Linux or macOS SDK cannot restore a
         Windows-targeted project at all without EnableWindowsTargeting, and restore covers
         every TFM a project declares - so simply listing it broke `dotnet test -f net10.0`
         and the Linux/macOS publish jobs, which all run on those platforms, with
         NETSDK1100. Nothing needs the Windows TFM off Windows: the Windows host is
         published by a windows-latest job. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0;net10.0</TargetFrameworks>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">true</UseWindowsForms>
    <!-- OutputType stays the Web SDK default (Exe). Setting WinExe to stop Windows handing the
         app a console ALSO stops the SDK emitting wwwroot/_framework, so blazor.web.js never
         ships and the editor opens to a blank window. The published executable is marked
         graphical afterwards instead (see SuppressPublishedConsoleWindow below). -->
    <RootNamespace>AbioticEditor.Web</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ship as one executable with the runtime and every dependency inside it, including the
         native Photino/WebView2 libraries. What stays beside it is only what the editor reads
         as data at run time: Mappings.usmap, the registry and wiki folders, the save Templates,
         wwwroot (the served static assets) and the licence files. Publishing 560 loose files
         made the download look like an SDK drop rather than an app. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- web.config only matters when hosting under IIS, which this never is. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Do NOT set AllowedReferenceRelatedFileExtensions=none to drop the referenced projects'
         .pdb/.xml files: it also strips wwwroot/_framework, so blazor.web.js never ships and
         the editor opens to a blank window. These two are the safe way to leave them out. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugSymbols>false</DebugSymbols>
    <!-- The same Abiotic Factor artwork the native app shipped: embedded in the exe for the
         taskbar/Explorer, and copied beside it (below) for the Photino window icon. -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\AbioticEditor.Ui.Abstractions\AbioticEditor.Ui.Abstractions.csproj" />
    <!-- Nexus Mods does its own file versioning and their guidelines discourage bundled
         auto-updaters, so the build published there must not contain one at all. Building with
         -p:NexusMods=true drops the updater assembly entirely rather than merely hiding it. -->
    <ProjectReference Include="..\AbioticEditor.Updater\AbioticEditor.Updater.csproj"
                      Condition="'$(NexusMods)' != 'true'" />
  </ItemGroup>
  <!-- Nexus Mods build: define NEXUSMODS so every `#if !NEXUSMODS` block compiles away, and
       drop the update page so nothing can reach the removed service. -->
  <PropertyGroup Condition="'$(NexusMods)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXUSMODS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(NexusMods)' == 'true'">
    <Content Remove="Components\Pages\Updates.razor" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only Windows loads the .ico; Linux and macOS use the .png, so shipping both there is
         dead weight. ExcludeFromSingleFile because the single-file bundler otherwise swallows
         the icon into the executable, leaving nothing on disk for the window to load - the app
         then opened with the blank default icon. The .png is untouched by the bundler. -->
    <Content Include="appicon.ico"
             Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appicon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\Mappings.usmap"
             Link="Mappings.usmap"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\registry\*.json"
             Link="registry\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\wiki\*"
             Exclude="..\..\assets\wiki\README.md"
             Link="wiki\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\NOTICE"
             Link="NOTICE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt"
             Link="THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\AbioticEditor.Core\Resources\blank-world-template.sav"
             Link="Templates\blank-world-template.sav"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\AbioticEditor.Core\Resources\blank-player-template.sav"
             Link="Templates\blank-player-template.sav"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Referenced projects emit their own .pdb regardless of this project's settings, and the
       blanket switch that would drop them (AllowedReferenceRelatedFileExtensions) also strips
       wwwroot/_framework. Dropping them from the publish list directly keeps the shipped folder
       to the executable plus the data it reads. -->
  <!-- The static-assets manifest cannot be embedded in the executable: the SDK only produces the
       publish copy after the files are staged, which is long after the assembly is compiled, so
       embedding it would need a second compile pass over the first pass's output. It also cannot
       simply be dropped - the app refuses to start without it. Moving it in beside the assets it
       describes keeps it out of the download's top level, which is the whole point, and costs
       nothing: StaticAssetManifest looks there. Keep this in step with that lookup. -->
  <Target Name="TuckAwayStaticAssetManifest" AfterTargets="CopyStaticWebAssetsEndpointsManifest">
    <Move SourceFiles="$(PublishDir)$(TargetName).staticwebassets.endpoints.json"
          DestinationFiles="$(PublishDir)wwwroot/$(TargetName).staticwebassets.endpoints.json"
          Condition="Exists('$(PublishDir)$(TargetName).staticwebassets.endpoints.json')" />
  </Target>
  <!-- Windows decides whether to hand a process a console from one field in its executable
       header, before any of our code runs. Hiding the window at startup (DesktopConsole) is
       therefore always a frame or two late: a black console flashes up and vanishes. Setting
       OutputType=WinExe is the supported way to set that field, but it also stops the SDK
       emitting wwwroot/_framework, so blazor.web.js never ships and the editor opens blank.
       Writing the same value into the published executable afterwards gets the behaviour without
       the side effect. The field is a fixed offset from the PE header and the write is in place,
       so the single-file bundle appended after it is untouched. -->
  <UsingTask TaskName="MarkExecutableAsGuiSubsystem" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExecutablePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(ExecutablePath)) return true;
        using var file = new System.IO.FileStream(ExecutablePath, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite);
        using var reader = new System.IO.BinaryReader(file, System.Text.Encoding.ASCII, true);
        file.Position = 0x3C;
        var peHeader = reader.ReadInt32();
        file.Position = peHeader;
        if (reader.ReadUInt32() != 0x00004550) { Log.LogError("Not a PE image: " + ExecutablePath); return false; }
        // PE signature (4) + COFF header (20) puts the optional header here; its Subsystem field
        // sits 68 bytes in, at the same place for both the 32- and 64-bit header layouts.
        var subsystem = peHeader + 4 + 20 + 68;
        file.Position = subsystem;
        var current = reader.ReadUInt16();
        const ushort Console = 3, WindowsGui = 2;
        if (current == WindowsGui) return true;
        if (current != Console) { Log.LogError("Unexpected subsystem " + current + " in " + ExecutablePath); return false; }
        file.Position = subsystem;
        using var writer = new System.IO.BinaryWriter(file, System.Text.Encoding.ASCII, true);
        writer.Write(WindowsGui);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="SuppressPublishedConsoleWindow" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <MarkExecutableAsGuiSubsystem ExecutablePath="$(PublishDir)$(AssemblyName).exe" />
  </Target>
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- Each platform's launcher ships only in that platform's package. The Linux and macOS
       scripts are the documented way to start the editor there (they set the library paths and
       clear macOS quarantine), but in the Windows download they were three files nobody can
       use. Keyed off the publish RID, so a plain build without one keeps them all. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux'))">
    <Content Include="launch-linux.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="install-linux-desktop.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx'))">
    <Content Include="launch-mac.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
