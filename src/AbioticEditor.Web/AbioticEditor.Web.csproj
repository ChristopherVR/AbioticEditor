<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <!-- Windows gets its own TFM so Windows-only code can be compiled in (the WINDOWS symbol).
         It is the plain net10.0-windows: no Windows Forms and no Windows SDK projection, which
         added about 45 MB to the package for two file dialogs. The pickers are the desktop
         window's own (Photino) dialogs now, see WindowDesktopPicker.

         The Windows TFM is only offered ON Windows. A Linux or macOS SDK cannot restore a
         Windows-targeted project at all without EnableWindowsTargeting, and restore covers
         every TFM a project declares - so simply listing it broke `dotnet test -f net10.0`
         and the Linux/macOS publish jobs, which all run on those platforms, with
         NETSDK1100. Nothing needs the Windows TFM off Windows: the Windows host is
         published by a windows-latest job. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows;net10.0</TargetFrameworks>
    <!-- OutputType stays the Web SDK default (Exe). Setting WinExe to stop Windows handing the
         app a console ALSO stops the SDK emitting wwwroot/_framework, so blazor.web.js never
         ships and the editor opens to a blank window. The published executable is marked
         graphical afterwards instead (see SuppressPublishedConsoleWindow below). -->
    <RootNamespace>AbioticEditor.Web</RootNamespace>
    <!-- A desktop app for one person, not a busy web server. The web SDK's default server GC keeps a
         heap per core and holds on to freed memory: with the Facility open it had 460 MB committed for
         163 MB of live data. Workstation GC returns what it does not need. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Ship as one executable with the runtime and every dependency inside it, including the
         native Photino/WebView2 libraries. What stays beside it is only what the editor reads
         as data at run time: Mappings.usmap, the registry and wiki folders, the save Templates,
         wwwroot (the served static assets) and the licence files. Publishing 560 loose files
         made the download look like an SDK drop rather than an app. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
    <!-- web.config only matters when hosting under IIS, which this never is. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- Do NOT set AllowedReferenceRelatedFileExtensions=none to drop the referenced projects'
         .pdb/.xml files: it also strips wwwroot/_framework, so blazor.web.js never ships and
         the editor opens to a blank window. These two are the safe way to leave them out. -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <DebugSymbols>false</DebugSymbols>
    <!-- The same Abiotic Factor artwork the native app shipped: embedded in the exe for the
         taskbar/Explorer, and copied beside it (below) for the Photino window icon. -->
    <ApplicationIcon>appicon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\AbioticEditor.Core\AbioticEditor.Core.csproj" />
    <ProjectReference Include="..\AbioticEditor.Ui.Abstractions\AbioticEditor.Ui.Abstractions.csproj" />
    <!-- The editor's screens and their services, shared with the browser-only host. -->
    <ProjectReference Include="..\AbioticEditor.Web.Shared\AbioticEditor.Web.Shared.csproj" />
    <!-- Nexus Mods does its own file versioning and their guidelines discourage bundled
         auto-updaters, so the build published there must not contain one at all. Building with
         -p:NexusMods=true drops the updater assembly entirely rather than merely hiding it. -->
    <ProjectReference Include="..\AbioticEditor.Updater\AbioticEditor.Updater.csproj"
                      Condition="'$(NexusMods)' != 'true'" />
  </ItemGroup>
  <!-- Nexus Mods build: define NEXUSMODS so every `#if !NEXUSMODS` block compiles away, and
       drop the update page so nothing can reach the removed service. -->
  <PropertyGroup Condition="'$(NexusMods)' == 'true'">
    <DefineConstants>$(DefineConstants);NEXUSMODS</DefineConstants>
    <!-- Keep managed assemblies bundled, but native DLLs beside the executable so
         the Nexus download does not extract executable files into TEMP at startup. -->
    <IncludeNativeLibrariesForSelfExtract Condition="$(RuntimeIdentifier.StartsWith('win'))">false</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
  <ItemGroup Condition="'$(NexusMods)' == 'true'">
    <Content Remove="Components\Pages\Updates.razor" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Photino.NET" />
  </ItemGroup>
  <ItemGroup>
    <!-- Only Windows loads the .ico; Linux and macOS use the .png, so shipping both there is
         dead weight. ExcludeFromSingleFile because the single-file bundler otherwise swallows
         the icon into the executable, leaving nothing on disk for the window to load - the app
         then opened with the blank default icon. The .png is untouched by the bundler. -->
    <Content Include="appicon.ico"
             Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win'))"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appicon.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\assets\Mappings.usmap"
             Link="Mappings.usmap"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\registry\*.json"
             Link="registry\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\assets\wiki\*"
             Exclude="..\..\assets\wiki\README.md"
             Link="wiki\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\LICENSE"
             Link="LICENSE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\NOTICE"
             Link="NOTICE"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt"
             Link="THIRD-PARTY-NOTICES.txt"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\AbioticEditor.Core\Resources\blank-world-template.sav"
             Link="Templates\blank-world-template.sav"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\AbioticEditor.Core\Resources\blank-player-template.sav"
             Link="Templates\blank-player-template.sav"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="UnpackNexusUe4ssBundle" AfterTargets="Publish"
          Condition="'$(NexusMods)' == 'true' and $(RuntimeIdentifier.StartsWith('win'))">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildProjectDirectory)/../../tools/unpack-ue4ss-bundle.ps1&quot; -BundleDir &quot;$(PublishDir)live-agent/ue4ss&quot;" />
  </Target>
  <!-- Referenced projects emit their own .pdb regardless of this project's settings, and the
       blanket switch that would drop them (AllowedReferenceRelatedFileExtensions) also strips
       wwwroot/_framework. Dropping them from the publish list directly keeps the shipped folder
       to the executable plus the data it reads. -->
  <!-- The static-assets manifest cannot be embedded in the executable: the SDK only produces the
       publish copy after the files are staged, which is long after the assembly is compiled, so
       embedding it would need a second compile pass over the first pass's output. It also cannot
       simply be dropped - the app refuses to start without it. Moving it in beside the assets it
       describes keeps it out of the download's top level, which is the whole point, and costs
       nothing: StaticAssetManifest looks there. Keep this in step with that lookup. -->
  <Target Name="TuckAwayStaticAssetManifest" AfterTargets="CopyStaticWebAssetsEndpointsManifest">
    <Move SourceFiles="$(PublishDir)$(TargetName).staticwebassets.endpoints.json"
          DestinationFiles="$(PublishDir)wwwroot/$(TargetName).staticwebassets.endpoints.json"
          Condition="Exists('$(PublishDir)$(TargetName).staticwebassets.endpoints.json')" />
  </Target>
  <!-- Windows decides whether to hand a process a console from one field in its executable
       header, before any of our code runs. Hiding the window at startup (DesktopConsole) is
       therefore always a frame or two late: a black console flashes up and vanishes. Setting
       OutputType=WinExe is the supported way to set that field, but it also stops the SDK
       emitting wwwroot/_framework, so blazor.web.js never ships and the editor opens blank.
       Writing the same value into the published executable afterwards gets the behaviour without
       the side effect. The field is a fixed offset from the PE header and the write is in place,
       so the single-file bundle appended after it is untouched. -->
  <UsingTask TaskName="MarkExecutableAsGuiSubsystem" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <ExecutablePath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (!System.IO.File.Exists(ExecutablePath)) return true;
        using var file = new System.IO.FileStream(ExecutablePath, System.IO.FileMode.Open, System.IO.FileAccess.ReadWrite);
        using var reader = new System.IO.BinaryReader(file, System.Text.Encoding.ASCII, true);
        file.Position = 0x3C;
        var peHeader = reader.ReadInt32();
        file.Position = peHeader;
        if (reader.ReadUInt32() != 0x00004550) { Log.LogError("Not a PE image: " + ExecutablePath); return false; }
        // PE signature (4) + COFF header (20) puts the optional header here; its Subsystem field
        // sits 68 bytes in, at the same place for both the 32- and 64-bit header layouts.
        var subsystem = peHeader + 4 + 20 + 68;
        file.Position = subsystem;
        var current = reader.ReadUInt16();
        const ushort Console = 3, WindowsGui = 2;
        if (current == WindowsGui) return true;
        if (current != Console) { Log.LogError("Unexpected subsystem " + current + " in " + ExecutablePath); return false; }
        file.Position = subsystem;
        using var writer = new System.IO.BinaryWriter(file, System.Text.Encoding.ASCII, true);
        writer.Write(WindowsGui);
      ]]></Code>
    </Task>
  </UsingTask>
  <Target Name="SuppressPublishedConsoleWindow" AfterTargets="Publish"
          Condition="$(RuntimeIdentifier.StartsWith('win'))">
    <MarkExecutableAsGuiSubsystem ExecutablePath="$(PublishDir)$(AssemblyName).exe" />
  </Target>
  <!-- The same for a plain build's executable: running the built (not published) app used to
       open a console window next to the editor window, and hiding it from code came a frame
       late. The apphost is regenerated by every build, so this runs after each one. -->
  <Target Name="SuppressBuiltConsoleWindow" AfterTargets="Build"
          Condition="'$(OS)' == 'Windows_NT' and '$(TargetFramework)' == 'net10.0-windows' and Exists('$(TargetDir)$(AssemblyName).exe')">
    <MarkExecutableAsGuiSubsystem ExecutablePath="$(TargetDir)$(AssemblyName).exe" />
  </Target>
  <Target Name="DropSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
  <!-- Pages scenery is downloaded into user data only. Fail publishing if a future
       content glob accidentally tries to put its source packs in a release package. -->
  <Target Name="RejectBundledHostedScenery" AfterTargets="ComputeResolvedFilesToPublishList" BeforeTargets="GenerateSingleFileBundle">
    <ItemGroup>
      <_HostedSceneryInRelease Include="@(ResolvedFileToPublish)"
        Condition="$([System.String]::Copy('%(ResolvedFileToPublish.FullPath)').Replace('\', '/').Contains('/assets/scenery/')) or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\', '/').StartsWith('scenery/'))" />
    </ItemGroup>
    <Error Condition="'@(_HostedSceneryInRelease)' != ''" Text="Hosted scenery belongs only in the GitHub Pages artifact, never in a desktop release." />
  </Target>
  <!-- Each platform's launcher ships only in that platform's package. The Linux and macOS
       scripts are the documented way to start the editor there (they set the library paths and
       clear macOS quarantine), but in the Windows download they were three files nobody can
       use. Keyed off the publish RID, so a plain build without one keeps them all. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('linux'))">
    <Content Include="launch-linux.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="install-linux-desktop.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <!-- A double-clickable, no-terminal launcher: KDE Plasma (Steam Deck Desktop Mode)
         offers to "Trust and Launch" a local .desktop file like this even when it lacks
         the executable bit an ordinary script or binary would need, so this is the one
         file in the archive that can survive an archive tool stripping permissions. -->
    <Content Include="launch-linux.desktop"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx'))">
    <Content Include="launch-mac.sh"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Live editing's in-game side (live-agent/, see its README): bundled so the desktop host can
       set up a detected local game for live editing itself. The Lua mod is plain text with no
       build step, so it always ships. The small native helper only ships when this particular
       build actually has one to bundle: `windows-latest` release CI builds it fresh (see the
       build-web-win job) before publishing, but a plain local `dotnet build` that never ran the
       one-time native build in live-agent/README.md simply ships without it - live editing on
       that machine then falls back to the fully manual setup this feature replaces, exactly as it
       worked before. The pinned UE4SS package (live-agent/ue4ss/, see tools/fetch-ue4ss.ps1) ships
       the same way: only when `UE4SS.zip` has actually been fetched for this build. When it is
       present, LiveAgentSetup installs it into the game folder after consent
       (Ue4ssBundledRuntime); when it is absent (a dev build, or any non-Windows release), setup
       falls back to LiveAgentSetup.NeedsUe4ss and the player installs UE4SS by hand. Windows-only:
       UE4SS and this game's live editing are both Windows-only today.
       ExcludeFromSingleFile on the helper, manifest and package: the single-file bundler
       otherwise swallows them into the executable (the first bundled release attempt shipped an
       empty live-agent/ue4ss folder), and LiveAgentSetup needs them as real files on disk.
       Linux ships it too: a Steam Play player runs the same Windows game binary under Proton, so
       the same UE4SS package, Lua scripts and helper are what get installed there. -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('win')) or $(RuntimeIdentifier.StartsWith('linux'))">
    <Content Include="..\..\live-agent\AbioticEditorLiveAgentLua\Scripts\**"
             Link="live-agent\Lua\Scripts\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\live-agent\AbioticEditorLiveAgentHelper\build\Release\AbioticEditorLiveAgentHelper.exe"
             Condition="Exists('..\..\live-agent\AbioticEditorLiveAgentHelper\build\Release\AbioticEditorLiveAgentHelper.exe')"
             Link="live-agent\AbioticEditorLiveAgentHelper.exe"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\live-agent\ue4ss\runtime.json"
             Link="live-agent\ue4ss\runtime.json"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\live-agent\ue4ss\UE4SS.zip"
             Condition="Exists('..\..\live-agent\ue4ss\UE4SS.zip')"
             Link="live-agent\ue4ss\UE4SS.zip"
             ExcludeFromSingleFile="true"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- Reading the game files and writing a 16 MB save make many large temporary buffers; this lets
         the GC compact them away instead of keeping the fragmented space committed. -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <!-- The 3D view's game models ship with the app: the Game Models plugin is built with it and
       placed in the plugins folder next to the executable (PluginPaths.BundledPluginsDirectory), so
       there is nothing to download or install. It still reads the models from the player's own
       game install; nothing from the game is in the download. The optional native animation
       decoder is included when the release workflow built one (GameModelsNativesDir). -->
  <ItemGroup>
    <ProjectReference Include="..\..\plugins\GameModels3D\GameModels3D.csproj" ReferenceOutputAssembly="false" Private="false" SkipGetTargetFrameworkProperties="true" GlobalPropertiesToRemove="TargetFramework;RuntimeIdentifier;SelfContained" />
  </ItemGroup>

  <Target Name="ResolveBundledGameModels">
    <MSBuild Projects="..\..\plugins\GameModels3D\GameModels3D.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_GameModelsAssembly" />
    </MSBuild>
    <!-- The bundled copy carries the app's version, so it wins over a copy of the plugin installed
         by hand before it shipped with the app (PluginManager keeps the higher version). -->
    <PropertyGroup>
      <_GameModelsManifestSource>@(_GameModelsAssembly->'%(RootDir)%(Directory)plugin.json')</_GameModelsManifestSource>
      <_GameModelsManifest>$(IntermediateOutputPath)bundled-plugins\GameModels3D\plugin.json</_GameModelsManifest>
      <_GameModelsManifestText>$([System.IO.File]::ReadAllText('$(_GameModelsManifestSource)'))</_GameModelsManifestText>
      <_GameModelsManifestText>$([System.Text.RegularExpressions.Regex]::Replace('$(_GameModelsManifestText)', '"version":\s*"[^"]*"', '"version": "$(Version)"'))</_GameModelsManifestText>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)bundled-plugins\GameModels3D" />
    <WriteLinesToFile File="$(_GameModelsManifest)" Lines="$(_GameModelsManifestText)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <_GameModelsFiles Include="@(_GameModelsAssembly)" />
      <_GameModelsFiles Include="$(_GameModelsManifest)" />
      <_GameModelsFiles Include="$(GameModelsNativesDir)\CUE4Parse-Natives.*" Condition="'$(GameModelsNativesDir)' != ''" />
    </ItemGroup>
  </Target>

  <Target Name="BundleGameModelsOnBuild" AfterTargets="Build" DependsOnTargets="ResolveBundledGameModels">
    <Copy SourceFiles="@(_GameModelsFiles)" DestinationFolder="$(OutDir)plugins\GameModels3D" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="BundleGameModelsOnPublish" AfterTargets="Publish" DependsOnTargets="ResolveBundledGameModels">
    <Copy SourceFiles="@(_GameModelsFiles)" DestinationFolder="$(PublishDir)plugins\GameModels3D" SkipUnchangedFiles="true" />
  </Target>
</Project>
