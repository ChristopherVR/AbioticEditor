@inject AbioticEditor.Web.Services.HostLanguageService Languages
<!DOCTYPE html>
<html lang="@Languages.CurrentCode">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* Content-stamped addresses from the build manifest. The per-screen stylesheet bundle is
       regenerated in place by every build, and asking for it by plain name meant a window open
       during a build lost every one of those styles until it was reloaded by hand. *@
    @* parity.css, the fonts and the images now live in AbioticEditor.Web.Shared so the browser
       host serves the identical look from the identical files. A Razor Class Library's static
       assets are published under _content/<library>/, which is why these addresses changed. The
       scoped-CSS bundle stays named after THIS app: the SDK folds every referenced library's
       per-component styles into the consuming app's one bundle. *@
    <link rel="stylesheet" href="@Assets["AbioticEditor.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/AbioticEditor.Web.Shared/parity.css"]" />
    <link rel="icon" type="image/png" href="@Assets["_content/AbioticEditor.Web.Shared/images/abiotic-factor.png"]" />
    <title>Abiotic Editor</title>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="@Assets["_content/AbioticEditor.Web.Shared/modal.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>
</html>
