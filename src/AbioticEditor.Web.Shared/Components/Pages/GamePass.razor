@using AbioticEditor.Core.GamePass
@inject HostLanguageService Languages
@inject SaveLibraryService Library
@inject AbioticEditor.Ui.IFolderPicker FolderPicker
@inject AbioticEditor.Ui.IExternalNavigationService ExternalNavigation

<article class="settings-card gamepass-card">
    <h2>@R("Settings_SaveConversion")</h2>
    <p class="muted">@R("Settings_SaveConversionHint")</p>
    @* Said out loud because the lists below appear a few seconds late, and a card that fills
       itself in with no warning reads as the editor having changed its mind. *@
    @if (_searching)
    {
        <p class="muted conversion-hint" role="status">@R("Settings_ConvertLookingForSaves")</p>
    }
    @if (_step != ConvertStep.PickSave)
    {
        <div class="conversion-nav-row">
            <p class="conversion-hint"><span class="platform-badge @PlatformClass(DestinationPlatform)">@R("Settings_ConvertTargetLabel")</span> <strong>@Languages.PlatformLabel(DestinationPlatform)</strong></p>
            <div class="conversion-nav-actions">
                @if (_step is ConvertStep.ChooseWorld or ConvertStep.ChoosePlayer)
                {
                    <button class="secondary" type="button" @onclick="Back" disabled="@_busy">@R("CreateWorld_Back")</button>
                }
                <button class="secondary" type="button" @onclick="ResetWizard" disabled="@_busy">@R("Settings_ConvertStartOver")</button>
            </div>
        </div>
    }

    @if (_step == ConvertStep.PickSave)
    {
        <section>
            <h3>@R("Settings_ConvertStepSourceTitle")</h3>
            <p class="muted">@R("Settings_ConvertStepSourceDesc")</p>
            <button class="primary conversion-action" type="button" @onclick="ConvertAsync" disabled="@_busy">
                @R("Settings_ConvertBrowse")
            </button>

            @if (AllDiscoveredWorlds.Any())
            {
                <p class="muted conversion-hint">@R("Settings_ConvertWorldsFound")</p>
                <div class="discovered-world-list conversion-world-choices">
                    @foreach (var entry in AllDiscoveredWorlds.OrderByDescending(entry => entry.World.LastPlayed))
                    {
                        <article class="discovered-world-card">
                            <div>
                                <h3>
                                    @entry.World.WorldName
                                    <span class="platform-badge @PlatformClass(entry.World.Platform)">@Languages.PlatformLabel(entry.World.Platform, entry.World.Source)</span>
                                </h3>
                                <p>@entry.World.LastPlayed.ToString("g")</p>
                                <small title="@entry.World.FolderPath">@entry.World.FolderPath</small>
                            </div>
                            <button class="primary" type="button" @onclick="() => ConvertDiscoveredAsync(entry.Direction, entry.World)" disabled="@_busy">
                                @R("Settings_ConvertThisWorld")
                            </button>
                        </article>
                    }
                </div>
            }
        </section>
    }
    else if (_step == ConvertStep.ChooseWorld)
    {
        <section>
            <h3>@R("Settings_ConvertStepWorldTitle")</h3>
            <p class="muted">@R("Settings_ConvertPickWorld")</p>
            <ul class="conversion-world-list">
                @foreach (var world in _worldChoices ?? Array.Empty<string>())
                {
                    <li>
                        <button class="secondary" type="button" @onclick="() => ChooseWorldAsync(world)" disabled="@_busy">
                            @WorldLabel(world)
                        </button>
                    </li>
                }
            </ul>
        </section>
    }
    else if (_step == ConvertStep.ChoosePlayer)
    {
        <section>
            <h3>@R("Settings_ConvertStepPlayerTitle")</h3>
            <p class="muted">@R(_characters is { Count: > 1 } ? "Settings_ConvertStepPlayerDescMulti" : "Settings_ConvertStepPlayerDescSingle")</p>
            @* A character left "as is" stays owned by the account it came from, where the platform
               it is heading to cannot find it and starts a new one instead. That is a ruined
               afternoon discovered in-game, so it is said up front, not after the fact - and this is
               a heads-up, not a wall, because carrying a character over as it is stays a fair thing
               to want. *@
            @if (StrandedIfLeftAsIs.Count > 0)
            {
                <p class="conversion-id-warning" role="alert">@R("Settings_ConvertOrphanCharacter")</p>
            }

            @foreach (var character in _characters ?? Array.Empty<string>())
            {
                <div class="conversion-player-row">
                    <label for="@RowInputId(character)">@character</label>
                    <select id="@RowInputId(character)" value="@RowChoice(character)"
                            @onchange="args => SetRowChoice(character, args.Value?.ToString())" disabled="@_busy">
                        <option value="@LeaveAsIsOption">@R("Settings_ConvertLeaveAsIs")</option>
                        @foreach (var account in _accounts)
                        {
                            <option value="@account.AccountId">@AccountOptionLabel(account)</option>
                        }
                        <option value="@CustomAccountOption">@R("Settings_ConvertCustomId")</option>
                    </select>
                    @if (RowChoice(character) == CustomAccountOption)
                    {
                        <input value="@RowCustomValue(character)" @oninput="args => SetCustomId(character, args.Value?.ToString())"
                               placeholder="@R("Settings_ConvertIdPlaceholder")" disabled="@_busy" />
                        @if (RowWarning(character) is not SaveConversionIdWarning.None)
                        {
                            <p class="conversion-id-warning" role="status">@RowWarningText(character)</p>
                        }
                    }
                </div>
            }
            <p class="muted conversion-hint">@R("Settings_ConvertIdHint")</p>

            <button class="primary conversion-action" type="button" @onclick="FinishAsync" disabled="@_busy">
                @R("Settings_ConvertFinish")
            </button>
        </section>
    }
    else
    {
        <section>
            <h3>@R("Settings_ConvertStepDoneTitle")</h3>
            @if (_outputFolder is not null)
            {
                <button class="secondary conversion-action" type="button" @onclick="OpenOutputFolderAsync" disabled="@_busy">@R("Settings_OpenOutputFolder")</button>
            }
        </section>
    }

    @if (_status is not null)
    {
        <p class="conversion-status @(_failed ? "error" : "success")" role="@(_failed ? "alert" : "status")">@_status</p>
    }
</article>

@code {
    private enum ConvertStep { PickSave, ChooseWorld, ChoosePlayer, Done }

    private ConvertStep _step = ConvertStep.PickSave;
    // Which way this run is converting. Unknown until a save is picked: the direction is read
    // off the save itself (its own platform badge, or auto-detected from a browsed folder)
    // rather than asked as a separate question up front.
    private SaveConversionDirection? _direction;
    private string? _outputFolder;
    private string? _status;
    private bool _busy;
    private bool _searching;
    private bool _failed;
    private IReadOnlyList<string>? _worldChoices;
    // Every character in the save being converted, each with its own row on the ChoosePlayer
    // step - a shared world can have several, and each one's account is independent of the rest.
    private IReadOnlyList<string>? _characters;
    private string? _pendingSource;
    private string? _pendingContainer;

    private const string LeaveAsIsOption = "__leave__";
    private const string CustomAccountOption = "__custom__";
    // character id -> the account it is being re-homed to. A character with no entry here is left
    // exactly as it is, which is a fine and common choice, not just a fallback.
    private readonly Dictionary<string, string> _rehomes = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<DiscoveredAccount> _accounts = Array.Empty<DiscoveredAccount>();
    private IReadOnlyList<DiscoveredWorld> _worldsToSteam = Array.Empty<DiscoveredWorld>();
    private IReadOnlyList<DiscoveredWorld> _worldsToGamePass = Array.Empty<DiscoveredWorld>();

    private string R(string key, params object?[] args) => Languages.Resource(key, args);

    private SavePlatform DestinationPlatform => _direction is { } direction ? SaveConversionService.DestinationPlatform(direction) : SavePlatform.Unknown;

    /// <summary>Characters currently set to carry over untouched that would land on the far
    /// platform unreachable - the fact that drives the heads-up banner. Computed live off the
    /// current row choices rather than once up front, since re-homing a character is exactly
    /// what takes it off this list.</summary>
    private IReadOnlyList<string> StrandedIfLeftAsIs =>
        (_characters ?? Array.Empty<string>())
            .Where(character => !_rehomes.ContainsKey(character))
            .Where(character => GamePassConverter.WouldStrandCharacters(DestinationPlatform, new[] { character }))
            .ToList();

    private static string RowInputId(string character) => $"conversion-player-{character}";

    /// <summary>The select's current value for a character: the account it is set to move to, the
    /// custom-id sentinel if that account isn't one of the discovered ones, or "leave as is".</summary>
    private string RowChoice(string character) =>
        _rehomes.TryGetValue(character, out var id)
            ? (_accounts.Any(account => string.Equals(account.AccountId, id, StringComparison.OrdinalIgnoreCase))
                ? id
                : CustomAccountOption)
            : LeaveAsIsOption;

    private string RowCustomValue(string character) => _rehomes.GetValueOrDefault(character, string.Empty);

    private void SetRowChoice(string character, string? value)
    {
        if (string.IsNullOrEmpty(value) || value == LeaveAsIsOption) { _rehomes.Remove(character); return; }
        // Switching to "type an account...": start the box empty rather than pre-filled with
        // whatever this row's select value happened to be.
        _rehomes[character] = value == CustomAccountOption ? string.Empty : value;
    }

    private void SetCustomId(string character, string? value) => _rehomes[character] = value?.Trim() ?? string.Empty;

    private SaveConversionIdWarning RowWarning(string character)
        => _direction is { } direction && _rehomes.TryGetValue(character, out var id) && !string.IsNullOrWhiteSpace(id)
            ? SaveConversionService.WarnAboutAccountId(direction, id)
            : SaveConversionIdWarning.None;

    private string RowWarningText(string character) => RowWarning(character) switch
    {
        SaveConversionIdWarning.UnusableInFileName => R("Settings_ConvertIdUnusable"),
        _ => R("Settings_ConvertIdNotSteam"),
    };

    /// <summary>An account's row in the re-home dropdown: its resolved name with the raw id
    /// alongside it, since the id is what actually gets written and is worth confirming before
    /// committing a character to it.</summary>
    private string AccountOptionLabel(DiscoveredAccount account) => account.DisplayName is { Length: > 0 } name
        ? $"{name} ({account.AccountId}) ({Languages.PlatformLabel(account.Platform)})"
        : $"{account.AccountId} ({Languages.PlatformLabel(account.Platform)})";

    /// <summary>Every world found on this machine, in either direction, so the first screen is
    /// "pick a save" rather than an abstract "pick a platform" before a save is even in view -
    /// each entry already carries the direction converting it implies.</summary>
    private IEnumerable<(DiscoveredWorld World, SaveConversionDirection Direction)> AllDiscoveredWorlds =>
        _worldsToSteam.Select(world => (world, SaveConversionDirection.ToSteam))
            .Concat(_worldsToGamePass.Select(world => (world, SaveConversionDirection.ToGamePass)));

    /// <summary>Container names carry a "-WC" suffix that means nothing to a player.</summary>
    private static string WorldLabel(string container)
        => container.EndsWith("-WC", StringComparison.OrdinalIgnoreCase) ? container[..^3] : container;

    // The badge colours the rest of the editor uses: Xbox green, Steam blue, orange otherwise.
    private static string PlatformClass(SavePlatform platform) => platform switch
    {
        SavePlatform.GamePass => "platform-gamepass",
        SavePlatform.Steam => "platform-steam",
        _ => "platform-unknown",
    };

    /// <summary>
    /// Looks for the worlds and accounts already on this machine, so the usual conversion is a
    /// single click instead of a hunt through folders.
    /// </summary>
    /// <remarks>
    /// This has a guard of its own rather than sharing the card's busy flag. Scanning takes a few
    /// seconds, and the whole card being dead for those seconds looks like the editor ignoring
    /// clicks; browsing for a folder has nothing to do with the scan and stays available. Nothing
    /// found is a perfectly ordinary answer (a browser cannot look at all), and the card works
    /// exactly as it always did without it, so a failed scan is logged and otherwise passed over.
    /// </remarks>
    protected override async Task OnInitializedAsync()
    {
        if (!Library.CanDiscover || _searching) return;
        _searching = true;
        try
        {
            var worlds = await Library.DiscoverAsync();
            _accounts = await Library.DiscoverAccountsAsync();

            // A conversion always starts on the platform it is leaving, so only Game Pass worlds
            // can go to Steam and only ordinary world folders can go the other way. Offering the
            // rest would only produce a refusal the moment one was pressed.
            _worldsToSteam = worlds.Where(world => world.IsGamePassContainer).ToList();
            _worldsToGamePass = worlds
                .Where(world => world.Source == DiscoveredWorldSource.Client && !world.IsGamePassContainer)
                .ToList();
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "List worlds and accounts for conversion");
        }
        finally
        {
            _searching = false;
        }
    }

    /// <summary>Fills the box from the list. Typing over it afterwards is the whole point.</summary>
    /// <summary>Drops back to picking a save. The account choices on this run were about a
    /// specific world's specific characters, so a different save means starting those over too.</summary>
    private void Back()
    {
        _step = ConvertStep.PickSave;
        _status = null;
        _failed = false;
        _direction = null;
        _worldChoices = null;
        ClearPending();
    }

    /// <summary>Back to the very first question. Every conversion call is one-shot and safe to
    /// re-run, so this is nothing more than clearing the state gathered so far.</summary>
    private void ResetWizard()
    {
        Back();
        _outputFolder = null;
    }

    /// <summary>
    /// Converts a save folder, starting by asking which folder to convert. The folder's own
    /// shape says which direction it is going - a Steam world folder can only go to Game Pass
    /// and vice versa - so nothing needs to be picked beforehand.
    /// </summary>
    /// <remarks>
    /// The card is marked busy before the folder chooser opens, not after it closes. Choosing a
    /// folder is the slow part, and while it was open the button was still live, so every further
    /// click put another chooser on screen and queued another conversion behind it.
    /// </remarks>
    private async Task ConvertAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var picked = await FolderPicker.PickFolderAsync(new() { Title = R("Settings_ConvertBrowse") });
            if (picked is null || string.IsNullOrWhiteSpace(picked.Path)) return;

            var direction = DetectDirection(picked.Path);
            if (direction is null)
            {
                _failed = true;
                _status = R("Settings_ConvertUnrecognised");
                return;
            }

            await BeginConversionAsync(direction.Value, picked.Path, container: null);
        }
        catch (Exception exception)
        {
            Fail(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A folder is a valid source for exactly one direction (a Steam world folder never
    /// also looks like a Game Pass container and vice versa), so trying both tells us which.</summary>
    private static SaveConversionDirection? DetectDirection(string folder)
    {
        if (SaveConversionService.ValidateSource(SaveConversionDirection.ToGamePass, folder) == SaveConversionSourceValidation.Valid)
            return SaveConversionDirection.ToGamePass;
        if (SaveConversionService.ValidateSource(SaveConversionDirection.ToSteam, folder) == SaveConversionSourceValidation.Valid)
            return SaveConversionDirection.ToSteam;
        return null;
    }

    /// <summary>
    /// Converts a world straight from the list of ones found on this machine. Both answers the
    /// folder chooser would have produced are already known here, including which world inside a
    /// Game Pass save it is and which direction it is heading, so nothing is asked again.
    /// </summary>
    private async Task ConvertDiscoveredAsync(SaveConversionDirection direction, DiscoveredWorld world)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await BeginConversionAsync(direction, world.FolderPath, world.GamePassContainer);
        }
        catch (Exception exception)
        {
            Fail(exception);
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The shared body of a conversion, however the folder was chosen. Callers own the busy flag:
    /// this can stop half-way to ask a question, and the flag has to stay taken until it is
    /// answered.
    /// </summary>
    private async Task BeginConversionAsync(SaveConversionDirection direction, string sourceFolder, string? container)
    {
        _direction = direction;
        _failed = false;
        _outputFolder = null;
        _worldChoices = null;
        _characters = null;
        _rehomes.Clear();
        _status = null;

        var validation = SaveConversionService.ValidateSource(direction, sourceFolder);
        if (validation != SaveConversionSourceValidation.Valid)
        {
            _failed = true;
            _status = R(validation == SaveConversionSourceValidation.MissingSteamWorldSave
                ? "Settings_ConvertNoWorldSave"
                : "Settings_ConvertNoContainers");
            return;
        }

        // A Game Pass folder can hold several worlds. Converting whichever one came first was a
        // coin toss the player never saw, so ask when there is a choice still to make - picking a
        // world from the list above has already made it.
        if (container is null)
        {
            var worlds = await Task.Run(() => SaveConversionService.WorldContainers(direction, sourceFolder));
            if (worlds.Count > 1)
            {
                _pendingSource = sourceFolder;
                _worldChoices = worlds;
                _step = ConvertStep.ChooseWorld;
                return;
            }
        }

        await ContinueConversionAsync(sourceFolder, container);
    }

    private async Task ChooseWorldAsync(string container)
    {
        // The list is disabled while a conversion runs, but a double-click lands both presses
        // before the card is redrawn, so the flag is checked as well as shown.
        if (_busy) return;
        var source = _pendingSource;
        if (source is null) return;
        _worldChoices = null;
        _busy = true;
        try
        {
            await ContinueConversionAsync(source, container);
        }
        catch (Exception exception)
        {
            Fail(exception);
            ClearPending();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>
    /// The step between picking a world and converting it: who does each of its characters
    /// belong to afterward. Every character gets its own row rather than the conversion being
    /// limited to claiming one, so a shared world's co-op group can each keep their own character
    /// instead of everyone but the one claimed starting over.
    /// </summary>
    private async Task ContinueConversionAsync(string sourceFolder, string? container)
    {
        var direction = _direction!.Value;
        var characters = await Task.Run(
            () => SaveConversionService.Characters(direction, sourceFolder, container));

        if (characters.Count == 0)
        {
            await RunConversionAsync(sourceFolder, container);
            return;
        }

        _pendingSource = sourceFolder;
        _pendingContainer = container;
        _characters = characters;
        _step = ConvertStep.ChoosePlayer;
    }

    /// <summary>Runs the conversion with whatever the rows on this screen currently say - an
    /// account per character that is being re-homed, and nothing for any character left as is.</summary>
    private async Task FinishAsync()
    {
        if (_busy) return;
        var source = _pendingSource;
        if (source is null) return;
        _busy = true;
        try
        {
            await RunConversionAsync(source, _pendingContainer);
        }
        catch (Exception exception)
        {
            Fail(exception);
        }
        finally
        {
            _busy = false;
            ClearPending();
        }
    }

    private void ClearPending()
    {
        _pendingSource = null;
        _pendingContainer = null;
        _characters = null;
        _rehomes.Clear();
    }

    private void Fail(Exception exception)
    {
        _failed = true;
        _status = Errors.Detail(exception, "Convert save", R("Settings_ConvertFailed"));
    }

    private async Task RunConversionAsync(string sourceFolder, string? container)
    {
        _step = ConvertStep.Done;
        _status = R("Settings_Converting");
        var rehomes = _rehomes.Count > 0 ? new Dictionary<string, string>(_rehomes, StringComparer.OrdinalIgnoreCase) : null;
        _outputFolder = await Task.Run(
            () => SaveConversionService.Convert(
                _direction!.Value, sourceFolder, playerAccountId: null, container, sourcePlayerId: null, rehomes: rehomes));
        _status = R("Settings_ConvertDone", _outputFolder);
        ClearPending();
    }

    private async Task OpenOutputFolderAsync()
    {
        if (_busy || _outputFolder is null) return;
        _busy = true;
        try { await ExternalNavigation.RevealPathAsync(_outputFolder); }
        catch (Exception exception)
        {
            _failed = true;
            Errors.Record(exception, "Open converted save folder");
            _status = R("Settings_ConvertFailed");
        }
        finally { _busy = false; }
    }
}
