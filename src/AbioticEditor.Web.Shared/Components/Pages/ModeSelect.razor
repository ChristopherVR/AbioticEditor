@page "/"
@inject NavigationManager Navigation

@* This route only exists because something has to own "/" (Photino's start URL, and any
   bookmark or link back to root). The actual "what do you want to do" choice moved into
   ModeSelectDialog, shown as an overlay by MainLayout - see MainLayout.OnInitialized - so
   every host lands on the normal browse screen here, same as the old "live editing not
   available" branch used to. *@
@code {
    protected override void OnInitialized() => Navigation.NavigateTo("browse", replace: true);
}
