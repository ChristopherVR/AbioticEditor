@page "/"
@page "/browse"
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Components.World
@implements IDisposable
@inject SaveLibraryService Library
@inject SaveWorkspaceSessionService Workspace
@inject AbioticEditor.Ui.IFolderPicker FolderPicker
@inject AbioticEditor.Ui.IFilePicker FilePicker
@inject ISaveFileSystem Files
@inject ToastService Toasts
@inject UnsavedChangesGuard Unsaved
@inject HostLanguageService Languages
@inject NavigationManager Navigation

<PageTitle>@Languages.Resource("Common_AppName")</PageTitle>

@if (Workspace.Current?.SelectedSave is null || IsBrowsing)
{
    @* The middle of the page IS the drop target - the whole window accepts a drop, and saying so
       with a dashed frame around the buttons is what makes that discoverable. It used to be one
       line of small print, and only on the desktop, so browser players had no idea they could
       drop anything at all. *@
    @* Opening a world takes real time - unpacking a zip runs to several seconds - and the middle
       of the page is where anyone dropping something is looking. It said nothing at all, so the
       editor looked hung. This is the same busy line the shell shows, given the space it needs. *@
    @if (Workspace.BusyOperation is { } busy)
    {
        <section class="hero native-empty-state empty-busy" role="status" aria-live="polite">
            <span class="blocking-busy-spinner" aria-hidden="true"></span>
            <strong>@busy</strong>
            <p class="empty-note">@Languages.Resource("Empty_BusyHint")</p>
        </section>
    }
    <section class="hero native-empty-state empty-dropzone @(Workspace.BusyOperation is null ? null : "is-busy")">
        <h1>@Languages.Resource("Empty_EditorTitle")</h1>
        @* Where the save folder lives on disk only helps someone who can browse to it. In a
           browser the folder is chosen through the browser's own picker, so that instruction
           would be pointing at a path the player has no reason to type. *@
        @if (Library.CanDiscover)
        {
            <p class="lede">@Languages.Resource("Empty_OpenYourSaveFolderInstructions")</p>
        }
        <div class="empty-actions">
            <button class="primary" type="button" @onclick="PickFolderAsync" disabled="@_isLoading">@Languages.Resource("Empty_OpenFolder")</button>
            @* Opening a zip is the other end of EXPORT, and the only way in at all on a browser
               with no folder picker. A desktop player unzips and opens the folder instead. *@
            @if (Bundles is not null)
            {
                <button class="secondary" type="button" @onclick="OpenBundleAsync" disabled="@_isLoading">@Languages.Resource("Bundle_Open")</button>
            }
            @* Making a world writes a whole folder tree wherever the player chooses, which is
               past what a browser tab is allowed to do. *@
            @if (Workspace.HasLocalPaths)
            {
                <a class="secondary button-link" href="create-world">@Languages.Resource("Empty_NewWorld")</a>
            }
        </div>
        <p class="empty-drop-hint">
            <span class="material-symbol" aria-hidden="true">upload</span>
            @(Workspace.HasLocalPaths
                ? Languages.Resource("Empty_YouCanAlsoDropASaveFolderAnywhereOnThisWindow")
                : Languages.Resource("Empty_DropHere"))
        </p>
        <p class="empty-note">@Languages.Resource("Empty_EveryWriteKeepsABakBackupNextToTheSave")</p>

        @* Worlds opened in an earlier visit. A browser forgets the folder when the tab closes,
           so without this a refresh meant finding it in the picker all over again. *@
        @if (_recent.Count > 0)
        {
            <section class="recent-worlds" aria-labelledby="recent-worlds-title">
                <h2 id="recent-worlds-title">@Languages.Resource("Empty_Recent")</h2>
                <p>@Languages.Resource("Empty_RecentHint")</p>
                <div class="discovered-world-list">
                    @foreach (var recent in _recent)
                    {
                        <article class="discovered-world-card">
                            <div>
                                <h3>@recent.Name</h3>
                                @if (recent.OpenedAt is { } opened) { <p>@opened.LocalDateTime.ToString("g")</p> }
                                @* This one lives in the browser rather than in a folder, so it
                                   comes back with its edits but still has to be exported to
                                   reach the game. Worth saying on the card itself. *@
                                @if (recent.StoredInBrowser) { <small>@Languages.Resource("Empty_RecentStored")</small> }
                            </div>
                            <div class="recent-world-actions">
                                <button class="primary" type="button" @onclick="() => ReopenRecentAsync(recent)" disabled="@_isLoading">@Languages.Resource("Empty_Open")</button>
                                <button class="secondary" type="button" @onclick="() => ForgetRecentAsync(recent)" disabled="@_isLoading">@Languages.Resource("Empty_Forget")</button>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (_worlds.Count > 0)
        {
            <section class="discovered-worlds" aria-labelledby="discovered-worlds-title">
                <h2 id="discovered-worlds-title">@Languages.Resource("Empty_WorldsFoundOnThisMachine")</h2>
                <p>@Languages.Resource("Empty_SaveFoldersDetectedAutomatically")</p>
                <div class="discovered-world-list">
                    @foreach (var world in _worlds)
                    {
                        <article class="discovered-world-card">
                            <div><h3>@world.WorldName <span class="platform-badge @PlatformClass(world)">@PlatformLabel(world)</span></h3><p>@world.LastPlayed.ToString("g") · @Languages.Resource("Main_SaveFileCount", world.SaveFileCount)</p><small title="@world.FolderPath">@world.FolderPath</small></div>
                            <button class="primary" type="button" @onclick="() => SelectWorldAsync(world)" disabled="@_isLoading">@Languages.Resource("Empty_Open")</button>
                        </article>
                    }
                </div>
            </section>
        }
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    </section>
}
else
{
    <SaveEditorSurface />
}

@code {
    private IReadOnlyList<DiscoveredWorld> _worlds = Array.Empty<DiscoveredWorld>();
    private IReadOnlyList<RecentWorld> _recent = Array.Empty<RecentWorld>();
    private bool _isLoading;
    private string? _error;

    /// <summary>
    /// The two browser-only capabilities this page offers, or null on a host without them.
    /// </summary>
    /// <remarks>
    /// Asked of the file system rather than injected, so the desktop needs no do-nothing
    /// implementations and the buttons simply are not built where they would do nothing.
    /// </remarks>
    private ISaveBundleReader? Bundles => Files as ISaveBundleReader;
    private IRecentWorldStore? Recents => Files as IRecentWorldStore;

    /// <summary>
    /// The header's home button lands on /browse so the world list shows even while a
    /// save is open; the open session and its staged edits stay untouched, and picking
    /// a save from the sidebar returns to the editor.
    /// </summary>
    private bool IsBrowsing => Navigation.ToBaseRelativePath(Navigation.Uri).TrimEnd('/')
        .Equals("browse", StringComparison.OrdinalIgnoreCase);
    protected override async Task OnInitializedAsync()
    {
        Workspace.Changed += WorkspaceChanged;
        // "/" and /browse both land on this component, so the router reuses the same
        // instance and (with no route parameters to change) may skip re-rendering it.
        // IsBrowsing lives on the URL alone; re-render on every navigation so the home
        // button flips the view reliably.
        Navigation.LocationChanged += LocationChanged;
        _isLoading = true;
        try
        {
            // Test hook mirroring the native app's ABIOTIC_EDITOR_FOLDER: auto-open a save
            // folder from the environment so automated verification never has to drive the
            // OS folder picker. No effect when the variable is unset.
            var autoFolder = Environment.GetEnvironmentVariable("ABIOTIC_EDITOR_FOLDER");
            if (Workspace.Current is null && Workspace.HasLocalPaths
                && !string.IsNullOrWhiteSpace(autoFolder) && Directory.Exists(autoFolder))
                await Workspace.OpenAsync(autoFolder);
            _worlds = await Library.DiscoverAsync();
            await LoadRecentAsync();
        }
        catch (Exception ex) { Errors.Record(ex, "Discover save folders"); }
        finally { _isLoading = false; }
    }

    private async Task LoadRecentAsync()
    {
        if (Recents is not { } recents) return;
        try { _recent = await recents.ListAsync(); }
        catch (Exception ex) { Errors.Record(ex, "List recently opened worlds"); }
    }

    /// <summary>
    /// Re-opens a world from an earlier visit. The browser asks the player's permission again
    /// here, which is why this hangs off a button: a permission prompt with no click behind it
    /// is refused outright.
    /// </summary>
    private async Task ReopenRecentAsync(RecentWorld recent)
    {
        if (Recents is not { } recents) return;
        _isLoading = true; _error = null;
        try
        {
            // The permission prompt has to ride on this click, so it happens before the
            // unsaved-changes question rather than after it.
            var folder = await recents.ReopenAsync(recent.Name, UnpackProgress());
            if (folder is null)
            {
                // Either the player said no, or the folder has been moved or deleted. Neither is
                // an error to report as a fault - the entry simply cannot be used any more.
                _error = Languages.Resource("Empty_RecentUnavailable");
                return;
            }
            await SelectWorldAsync(new(folder, folder, DiscoveredWorldSource.Client, null));
        }
        catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Home_SaveFolderOpenFailed"), Languages.Resource("Home_SaveFolderOpenGuidance")); }
        finally { _isLoading = false; await Workspace.ReportBusyAsync(null); }
    }

    /// <summary>Shows unpacking progress in the shell's busy line, which this page also draws.</summary>
    private IProgress<SaveBundleProgress> UnpackProgress() => new Progress<SaveBundleProgress>(step =>
        _ = Workspace.ReportBusyAsync(Languages.Resource("Bundle_Unpacking", step.Done, step.Total)));

    private async Task ForgetRecentAsync(RecentWorld recent)
    {
        if (Recents is not { } recents) return;
        try
        {
            await recents.ForgetAsync(recent.Name);
            await LoadRecentAsync();
        }
        catch (Exception ex) { Errors.Record(ex, "Forget a recently opened world"); }
    }

    /// <summary>
    /// Opens a zipped save folder the player points at - the other end of EXPORT, and the only
    /// way in at all on a browser with no folder picker.
    /// </summary>
    private async Task OpenBundleAsync()
    {
        if (Bundles is not { } bundles) return;
        _isLoading = true; _error = null;
        try
        {
            var picked = await FilePicker.PickFileAsync(new()
            {
                Title = Languages.Resource("Bundle_OpenTitle"),
                FileTypes = [new(Languages.Resource("Bundle_OpenTitle"), [".zip"])],
            });
            if (picked is null) { _error = Languages.Resource("Bundle_Cancelled"); return; }

            await using var stream = await picked.OpenReadAsync(CancellationToken.None);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            var folder = await bundles.OpenBundleAsync(picked.Name, buffer.ToArray(), UnpackProgress());
            await SelectWorldAsync(new(folder, folder, DiscoveredWorldSource.Client, null));
            Toasts.Show(Languages.Resource("Bundle_Opened", folder), ToastKind.Success);
        }
        catch (Exception ex)
        {
            Errors.Record(ex, "Open a zip of saves");
            _error = Errors.Present(ex, Languages.Resource("Bundle_OpenFailed"), Languages.Resource("Bundle_OpenGuidance"));
        }
        finally { _isLoading = false; await Workspace.ReportBusyAsync(null); }
    }

    /// <summary>
    /// Opens a world, asking first when the one already open has edits that would be lost.
    /// </summary>
    /// <remarks>
    /// Every way into a world from this page funnels through here - a discovered world, a picked
    /// folder, a zip, a remembered world - so the question is asked once, in one place.
    /// </remarks>
    private Task SelectWorldAsync(DiscoveredWorld world) => Unsaved.ConfirmAsync(() => OpenWorldAsync(world));

    private async Task OpenWorldAsync(DiscoveredWorld world)
    {
        _isLoading = true; _error = null;
        try { await Workspace.OpenAsync(world); }
        catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Home_SaveFolderOpenFailed"), Languages.Resource("Home_SaveFolderOpenGuidance")); }
        finally { _isLoading = false; await InvokeAsync(StateHasChanged); }
    }

    private async Task PickFolderAsync()
    {
        _error = null;
        try
        {
            var picked = await FolderPicker.PickFolderAsync(new() { Title = Languages.Text("folder.choose.title") });
            if (picked?.Path is null) return;
            await SelectWorldAsync(new(picked.Path, Path.GetFileName(picked.Path), DiscoveredWorldSource.Client, null));
        }
        catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Home_FolderPickerFailed"), Languages.Resource("Home_FolderPickerGuidance")); }
    }

    private string PlatformLabel(DiscoveredWorld world) => Languages.PlatformLabel(world.Platform, world.Source);

    // Native badge fill (MainViewModel.CurrentSaveTypeBadgeColor): Xbox green for Game
    // Pass, Steam blue for Steam, orange otherwise - shared with the sidebar badge.
    private static string PlatformClass(DiscoveredWorld world) => world.Platform switch
    {
        SavePlatform.GamePass => "platform-gamepass",
        SavePlatform.Steam => "platform-steam",
        _ => "platform-unknown",
    };
    private void WorkspaceChanged() => _ = InvokeAsync(StateHasChanged);
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Workspace.Changed -= WorkspaceChanged;
        Navigation.LocationChanged -= LocationChanged;
    }
}
