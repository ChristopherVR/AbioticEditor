@page "/live"
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.Player
@using AbioticEditor.Core.LiveEditing.World
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Services
@using Microsoft.Extensions.DependencyInjection
@implements IAsyncDisposable
@inject HostLanguageService L
@inject NavigationManager Navigation
@inject IServiceProvider Services
@inject LiveSessionService LiveSession
@inject InventorySelectionService Selection
@inject ItemUpgradeVocabularyService Upgrades

<PageTitle>@L.Resource("Common_AppName")</PageTitle>

<section class="hero native-empty-state live-connect">
    <h1>@L.Resource("Live_Title")</h1>

    @if (_vitals is null || _skills is null)
    {
        @if (_autoConnectInFlight)
        {
            <p class="lede">@L.Resource("Live_AutoConnecting")</p>
        }
        else
        {
            <p class="lede">@L.Resource("Live_ConnectSubtitle")</p>
            <div class="live-connect-form">
                <label>
                    @L.Resource("Live_Host")
                    <input @bind="_host" @bind:event="oninput" disabled="@_isConnecting" />
                </label>
                <label>
                    @L.Resource("Live_Port")
                    <input type="number" @bind="_port" @bind:event="oninput" disabled="@_isConnecting" />
                </label>
                <label>
                    @L.Resource("Live_Token")
                    <input type="password" @bind="_token" @bind:event="oninput" disabled="@_isConnecting" />
                </label>
                <button class="primary" type="button" @onclick="() => ConnectAsync(isAutoConnect: false)" disabled="@_isConnecting">
                    @(_isConnecting ? L.Resource("Live_Connecting") : L.Resource("Live_Connect"))
                </button>
                @if (_error is not null)
                {
                    <p class="error-text" role="alert">@_error</p>
                }
            </div>
            <p class="empty-note">@L.Resource("Live_ConnectHint")</p>
        }
    }
    else
    {
        @if (_autoConnected)
        {
            <p class="empty-note">
                @L.Resource("Live_AutoConnected")
                <button class="secondary" type="button" @onclick="UseManualConnection">@L.Resource("Live_UseManualConnection")</button>
            </p>
        }
        <p class="lede live-warning">@L.Resource("Live_ImmediateWarning")</p>

        @if (_directory is { Players.Count: > 1 })
        {
            <label class="live-player-picker">
                @L.Resource("Live_EditingPlayer")
                <select @bind="_selectedPlayerId" @bind:event="oninput" @bind:after="PlayerPickedAsync" disabled="@_isBusy">
                    @foreach (var player in _directory.Players)
                    {
                        <option value="@player.Id">@player.Name@(player.IsLocal ? $" ({L.Resource("Live_You")})" : null)</option>
                    }
                </select>
            </label>
        }

        <nav class="editor-tabs" role="tablist" aria-label="@L.Resource("Live_Sections")">
            <button type="button" role="tab" class="editor-tab @(_activeTab == "vitals" ? "active" : null)"
                    aria-selected="@(_activeTab == "vitals")" @onclick='() => _activeTab = "vitals"'>
                @L.Resource("PlayerVitals_CharacterStats")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "skills" ? "active" : null)"
                    aria-selected="@(_activeTab == "skills")" @onclick='() => _activeTab = "skills"'>
                @L.Resource("PlayerSkills_Skills")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "npcs" ? "active" : null)"
                    aria-selected="@(_activeTab == "npcs")" @onclick='() => _activeTab = "npcs"'>
                @L.Resource("LiveNpcs_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "inventory" ? "active" : null)"
                    aria-selected="@(_activeTab == "inventory")" @onclick='() => _activeTab = "inventory"'>
                @L.Resource("LiveInventory_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "transmog" ? "active" : null)"
                    aria-selected="@(_activeTab == "transmog")" @onclick='() => _activeTab = "transmog"'>
                @L.Resource("PlayerEditor_Transmog")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "world" ? "active" : null)"
                    aria-selected="@(_activeTab == "world")" @onclick='() => _activeTab = "world"'>
                @L.Resource("LiveWorld_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "flags" ? "active" : null)"
                    aria-selected="@(_activeTab == "flags")" @onclick='() => _activeTab = "flags"'>
                @L.Resource("LiveFlags_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "doors" ? "active" : null)"
                    aria-selected="@(_activeTab == "doors")" @onclick='() => _activeTab = "doors"'>
                @L.Resource("LiveDoors_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "containers" ? "active" : null)"
                    aria-selected="@(_activeTab == "containers")" @onclick='() => _activeTab = "containers"'>
                @L.Resource("LiveContainers_Title")
            </button>
            <button type="button" role="tab" class="editor-tab @(_activeTab == "dropped" ? "active" : null)"
                    aria-selected="@(_activeTab == "dropped")" @onclick='() => _activeTab = "dropped"'>
                @L.Resource("LiveDropped_Title")
            </button>
        </nav>
        <div class="player-tab-viewport">
            @if (_activeTab == "vitals")
            {
                <PlayerVitalsTab Vitals="_vitals.Vitals" OnChanged="() => {}" />
            }
            else if (_activeTab == "skills")
            {
                <PlayerSkillsTab Session="_skills" OnChanged="() => {}" />
            }
            else if (_activeTab == "npcs" && _npcs is not null)
            {
                <LiveNpcsTab Session="_npcs" OnChanged="() => {}" />
            }
            else if (_activeTab == "inventory" && _inventory is not null)
            {
                @* Same PlayerInventoryTab the file-backed player editor uses, bound to
                   IPlayerInventorySession instead of the concrete PlayerSaveSession - see
                   LiveInventorySession's own doc comment. *@
                <PlayerInventoryTab Session="_inventory" OnChanged="() => {}" />
            }
            else if (_activeTab == "transmog" && _inventory is not null)
            {
                @* Same session object as the inventory tab above (it implements both
                   interfaces), so a slot dragged between the two areas still works. *@
                <PlayerTransmogTab Session="_inventory" OnChanged="() => {}" />
            }
            else if (_activeTab == "world" && _story is not null && _flags is not null)
            {
                <WorldStoryTab Session="_story" Flags="_flags" OnError="e => _error = e" />
            }
            else if (_activeTab == "flags" && _flags is not null)
            {
                <WorldFlagsTab Session="_flags" OnError="e => _error = e" />
            }
            else if (_activeTab == "doors" && _doors is not null)
            {
                <WorldDoorsTab Session="_doors" />
            }
            else if (_activeTab == "containers" && _containers is not null)
            {
                @* Same tab the offline editor uses (IWorldContainersSession is the shared
                   boundary) - see LiveContainersSession for the live implementation. *@
                <WorldContainersTab Session="_containers" Title="@L.Resource("LiveContainers_Title")" />
            }
            else if (_activeTab == "dropped" && _dropped is not null)
            {
                @* Same tab the offline editor uses (IWorldDroppedItemsSession is the shared
                   boundary) - see LiveDroppedItemsSession for the live implementation. *@
                <WorldDroppedItemsTab Session="_dropped" Title="@L.Resource("LiveDropped_Title")" />
            }
            else if (_activeTab is "world" or "flags" or "doors" or "containers" or "dropped")
            {
                <p class="muted">@L.Resource("Live_WorldAreaUnavailable")</p>
            }
        </div>

        @* Every tab except vitals/skills applies immediately per row (each tab manages its own
           status/error) - the page-level APPLY/REVERT bar only makes sense for the staged
           vitals/skills tabs. *@
        @if (_activeTab is "vitals" or "skills")
        {
            <div class="live-connect-actions">
                <button class="primary" type="button" @onclick="ApplyAsync" disabled="@(!ActiveIsDirty || _isBusy)">
                    @L.Resource("Live_Apply")
                </button>
                <button class="secondary" type="button" @onclick="RevertActive" disabled="@(!ActiveIsDirty || _isBusy)">
                    @L.Resource("Common_Revert")
                </button>
                <button class="secondary" type="button" @onclick="DisconnectAsync" disabled="@_isBusy">
                    @L.Resource("Live_Disconnect")
                </button>
            </div>
            @if (ActiveStatus is not null)
            {
                <p class="status-text">@ActiveStatus</p>
            }
        }
        else
        {
            <div class="live-connect-actions">
                <button class="secondary" type="button" @onclick="DisconnectAsync" disabled="@_isBusy">
                    @L.Resource("Live_Disconnect")
                </button>
            </div>
        }
        @if (_error is not null)
        {
            <p class="error-text" role="alert">@_error</p>
        }
    }
</section>

@code {
    private string _host = "127.0.0.1";
    private int _port = 42117;
    private string _token = string.Empty;
    private bool _isConnecting;
    private bool _isBusy;
    private bool _autoConnectInFlight;
    private bool _autoConnected;
    private string? _error;
    private string _activeTab = "vitals";
    private ILiveGameChannel? _channel;
    private LivePlayerVitalsSession? _vitals;
    private LivePlayerSkillsSession? _skills;
    private LiveNpcSession? _npcs;
    private LiveInventorySession? _inventory;
    private LiveStorySession? _story;
    private LiveWorldFlagsSession? _flags;
    private IWorldDoorsSession? _doors;
    private LiveContainersSession? _containers;
    private LiveDroppedItemsSession? _dropped;
    private LivePlayerDirectory? _directory;
    private string? _selectedPlayerId;

    private bool ActiveIsDirty => _activeTab switch
    {
        "vitals" => _vitals?.IsDirty == true,
        "skills" => _skills?.IsDirty == true,
        _ => false,
    };
    private string? ActiveStatus => _activeTab switch
    {
        "vitals" => _vitals?.Status,
        "skills" => _skills?.Status,
        _ => null,
    };

    // A game running on this PC needs nothing typed in: the live-agent mod writes its token to a
    // well-known local file, and the desktop host can just read it (see
    // ILiveEditingCapability.TryReadLocalToken). Only a remote machine with no local file to read
    // still needs the manual host/port/token form below. This is the one place that distinction
    // is made; everything past here is the same connect path either way.
    protected override async Task OnInitializedAsync()
    {
        // The sidebar has no access to _vitals/_skills (they live on this page), so it asks
        // through LiveSessionService instead of switching players itself - see
        // WorkspaceShell.SwitchLivePlayerAsync, the only other caller of RequestPlayerSwitchAsync.
        LiveSession.PlayerSwitchRequested += HandlePlayerSwitchRequestedAsync;

        var localToken = Services.GetService<ILiveEditingCapability>()?.TryReadLocalToken();
        if (string.IsNullOrEmpty(localToken)) return;

        _token = localToken;
        _autoConnectInFlight = true;
        await ConnectAsync(isAutoConnect: true);
        _autoConnectInFlight = false;
    }

    private async Task HandlePlayerSwitchRequestedAsync(string playerId)
    {
        if (_vitals is null || _skills is null) return;
        _selectedPlayerId = playerId;
        await PlayerPickedAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void UseManualConnection()
    {
        _autoConnected = false;
        _ = DisconnectAsync();
    }

    private async Task ConnectAsync(bool isAutoConnect)
    {
        _error = null;
        _isConnecting = true;
        var channel = new TcpLiveGameChannel();
        try
        {
            await channel.ConnectAsync(new LiveConnectionInfo(_host, _port, _token));
            // Every area shares the one connection/token handshake - each gets its own channel
            // wrapper over it, the same shape the file-backed PlayerSaveSession's slices share
            // one PlayerSaveData. The directory is read first so vitals/skills can seed straight
            // from the local player's id instead of the mod's own "no playerId given" default -
            // the two happen to be the same player today, but reading the id explicitly is what
            // lets the picker below hand back a DIFFERENT one later without a special case.
            var directory = await new LivePlayerDirectoryChannel(channel).GetAsync();
            var localPlayerId = directory.Players.FirstOrDefault(player => player.IsLocal)?.Id;
            _vitals = await LivePlayerVitalsSession.ConnectAsync(new LivePlayerVitalsChannel(channel), localPlayerId);
            _skills = await LivePlayerSkillsSession.ConnectAsync(new LivePlayerSkillsChannel(channel), localPlayerId);
            _npcs = await LiveNpcSession.ConnectAsync(new LiveNpcChannel(channel));
            _inventory = await LiveInventorySession.ConnectAsync(new LiveInventoryChannel(channel), localPlayerId, Upgrades.Get());
            // The world areas need a loaded world (a player sitting in the main menu has no
            // DayNightManager, doors, or containers yet), so each one that fails to read is left
            // null and its tab says so, instead of failing the whole connection - the player
            // areas above still work from the menu.
            _story = await TryConnectWorldAreaAsync(() => LiveStorySession.ConnectAsync(new LiveStoryChannel(channel), new LiveWorldStateChannel(channel)));
            _flags = await TryConnectWorldAreaAsync(() => LiveWorldFlagsSession.ConnectAsync(new LiveWorldFlagsChannel(channel)));
            _doors = await TryConnectWorldAreaAsync(() => LiveDoorsSession.ConnectAsync(new LiveDoorsChannel(channel)));
            _containers = await TryConnectWorldAreaAsync(() => LiveContainersSession.ConnectAsync(new LiveContainersChannel(channel)));
            _dropped = await TryConnectWorldAreaAsync(() => LiveDroppedItemsSession.ConnectAsync(new LiveDroppedItemsChannel(channel)));
            _channel = channel;
            _autoConnected = isAutoConnect;
            _directory = directory;
            _selectedPlayerId = localPlayerId;
            LiveSession.Connected(directory, localPlayerId);
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = isAutoConnect
                ? Errors.Present(exception, "Connect to the game on this PC.",
                    "Make sure the game is running with the live-agent mod loaded, or enter a different computer's connection details below.")
                : Errors.Present(exception, "Connect to the running game.",
                    "Check the host, port and token, and that the live-agent mod is running.");
            await channel.DisposeAsync();
        }
        finally
        {
            _isConnecting = false;
        }
    }

    /// <summary>A world-area read that the agent rejects (no world loaded, or an older mod without
    /// that command) leaves that area unavailable rather than failing the connection. Transport
    /// failures still propagate: those mean the connection itself is gone.</summary>
    private static async Task<T?> TryConnectWorldAreaAsync<T>(Func<Task<T>> connect) where T : class
    {
        try
        {
            return await connect();
        }
        catch (LiveAgentException)
        {
            return null;
        }
    }

    private async Task ApplyAsync()
    {
        _isBusy = true;
        _error = null;
        try
        {
            if (_activeTab == "vitals" && _vitals is not null) await _vitals.SaveAsync();
            else if (_skills is not null) await _skills.SaveAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Apply the live edit.",
                "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void RevertActive()
    {
        if (_activeTab == "vitals") _vitals?.Revert();
        else _skills?.Revert();
    }

    /// <summary>Switches both tabs to a different connected player, discarding any unsaved edits
    /// for whoever was selected before - REVERT only ever undoes edits, never a player switch.</summary>
    private async Task PlayerPickedAsync()
    {
        if (_vitals is null || _skills is null) return;
        _isBusy = true;
        _error = null;
        try
        {
            await _vitals.SwitchPlayerAsync(_selectedPlayerId);
            await _skills.SwitchPlayerAsync(_selectedPlayerId);
            if (_inventory is not null)
            {
                await _inventory.SwitchPlayerAsync(_selectedPlayerId);
                // A different player's slots are not the same objects any more (see
                // LiveInventorySession.SwitchPlayerAsync); drop any sidebar slot selection so it
                // does not keep pointing at the previous player's now-orphaned slot.
                if (Selection.Current?.PlayerArea is not null) Selection.Clear();
            }
            LiveSession.PlayerSelected(_selectedPlayerId);
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Switch to a different player.",
                "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DisconnectAsync()
    {
        // The sidebar slot editor is rendered globally and reads live objects that are about to
        // go away; clear any selection so it does not keep showing a now-dead live slot.
        if (Selection.Current?.PlayerArea is not null) Selection.Clear();
        _vitals = null;
        _skills = null;
        _npcs = null;
        _inventory = null;
        _story = null;
        _flags = null;
        _doors = null;
        _containers = null;
        _dropped = null;
        _directory = null;
        _selectedPlayerId = null;
        if (_channel is not null) await _channel.DisposeAsync();
        _channel = null;
        _error = null;
        LiveSession.Disconnected();
    }

    public async ValueTask DisposeAsync()
    {
        LiveSession.PlayerSwitchRequested -= HandlePlayerSwitchRequestedAsync;
        LiveSession.Disconnected();
        if (_channel is not null) await _channel.DisposeAsync();
    }
}
