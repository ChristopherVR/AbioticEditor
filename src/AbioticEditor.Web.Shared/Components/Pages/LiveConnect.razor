@page "/live"
@using System.Reflection
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.Player
@using AbioticEditor.Core.LiveEditing.World
@using AbioticEditor.Core.WorldSaves
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Services
@implements IAsyncDisposable
@inject HostLanguageService L
@inject NavigationManager Navigation
@inject LiveSessionService LiveSession
@inject SaveWorkspaceSessionService Workspace
@inject InventorySelectionService Selection
@inject ItemUpgradeVocabularyService Upgrades
@inject TraderVocabularyService TraderVocabulary

<PageTitle>@L.Resource("Common_AppName")</PageTitle>

@if (_vitals is null || _skills is null)
{
    @* Reachable only for the brief moment between OnInitializedAsync finding nothing to adopt
       and the resulting redirect to the mode-select dialog landing - "where's the game
       running?", the "this PC or somewhere else?" choice, and all the waiting that follows
       either answer have exactly one home now (the dialog), and this page never renders any of
       that itself. The empty-state "hero" card styling belongs here, not on the editing surface
       below - that surface uses the same plain workspace wrapper the file editor uses instead
       (see the else branch), since it is a real multi-tab editor now, not a placeholder. *@
    <section class="hero native-empty-state live-connect">
        <h1>@L.Resource("Live_Title")</h1>
        <p class="lede" role="status" aria-live="polite"><span class="blocking-busy-spinner" aria-hidden="true"></span></p>
    </section>
}
else
{
    <section class="workspace single-workspace live-connect" aria-label="@L.Resource("Live_Title")">
        @if (_surface == LiveSurface.OfflinePlayerFile)
        {
            <p class="editing-mode-note">@L.Resource("Editing_OfflinePlayerNote")</p>
        }
        else
        {
            <LiveEditingGuide />
        }

        @* ONE surface at a time, exactly like the file editor's own single-workspace section:
           a player save's tabs OR a world save's tabs, never both stacked - see
           LiveSessionService.Surface and WorkspaceShell's live sidebar, which is what actually
           drives which one this renders now. The player picker that used to live here is gone:
           the sidebar's connected-players list does that job already, the same way the file
           editor has no such picker of its own. *@
        @if (_surface == LiveSurface.OfflinePlayerFile)
        {
            @* Round 78: a player who is NOT currently connected still has their own save file on
               disk, right there in the same world folder as everyone who is - the sidebar lists
               them (OFFLINE) alongside the connected players, and clicking one stages it on the
               shared file-editing service exactly the way the offline editor's own sidebar does
               (see WorkspaceShell's offline-player row handler). This renders the exact same
               <PlayerEditor> the file editor uses for a selected player save (see
               SaveEditorSurface.razor), just inside the live layout instead of the file one - the
               SAVE/REVERT toolbar above (WorkspaceShell's shell-status bar) already reuses its own
               file-mode markup for this surface too. *@
            @if (Workspace.Current is { SelectedSave: { } offlineSave, PlayerSession: { } offlinePlayer })
            {
                <PlayerEditor Title="@offlineSave.Name" Session="@offlinePlayer"
                              TransferWorldSession="@Workspace.TransferWorldSession"
                              OnChanged="HandleOfflinePlayerChangedAsync" />
            }
            else
            {
                <p class="lede live-waiting" role="status" aria-live="polite">
                    <span class="blocking-busy-spinner" aria-hidden="true"></span>
                    @L.Resource("Common_Working")
                </p>
            }
        }
        else if (_surface == LiveSurface.Player)
        {
            @* The player tabs are the exact same PlayerEditor.razor the file-based editor uses - see
               IPlayerEditorSession's own doc comment for why this reuse was worth a composite
               interface. Its own internal tab strip (vitals/skills/spawn/inventory/...) replaces
               what used to be a dozen hand-rolled buttons here. *@
            <PlayerEditor Session="_playerFacade" OnTabActivated="HandlePlayerTabActivatedAsync"
                          OnChanged="HandlePlayerChangedAsync" LoadingTabId="_connectingTabId">
                <LoadingContent>
                    <p class="lede live-waiting" role="status" aria-live="polite">
                        <span class="blocking-busy-spinner" aria-hidden="true"></span>
                        @L.Resource("Common_Working")
                    </p>
                </LoadingContent>
            </PlayerEditor>
            @* VITALS/SKILLS apply immediately now (debounced, see ScheduleAutoSave) - there is no
               APPLY/REVERT step left to offer, so the only thing shown here is what the last
               debounced push (or a background refresh) actually did. Every other tab reports its
               own status inline, the same way it already did before this page had an actions bar
               at all. *@
            @if (ActiveStatus is not null)
            {
                <p class="status-text">@ActiveStatus</p>
            }
        }
        else
        {
            @* The world tabs have no single shared "WorldEditor" component to delegate to the way
               PlayerEditor.razor exists for the player side (the file editor's own world-tabs strip
               is still inlined in SaveEditorSurface.razor) and live editing's world-area set is not a
               1:1 match for the file editor's feature-map-driven tab list (story/traders/portals/
               entitlements sit differently on each side) - so this mirrors the FILE editor's
               world-tabs markup/CSS shape (see SaveEditorSurface.razor) rather than forcing an
               awkward unification. The heading below is the same one and the same resource string
               the file editor's own world section uses (see SaveEditorSurface.razor's
               world-summary-heading). *@
            <section class="world-editor-summary">
                <header class="world-summary-heading">
                    <h2>@L.Resource("LiveWorld_Title")</h2>
                    @* Round 78: which of the two world tab sets this is - the region the game
                       currently has loaded, or the world-wide metadata (story/traders/containment/
                       entitlements) - so switching between a region row and the metadata row in
                       the sidebar reads as going somewhere different, not just a silent tab reset. *@
                    <span>@(_worldIsMetadata
                        ? WorldAreaCatalog.FriendlyName("MetaData")
                        : WorldAreaCatalog.FriendlyName(LiveSession.CurrentRegionToken) ?? L.Resource("Live_RegionUnknown"))</span>
                </header>
            </section>
            <nav class="world-tabs" role="tablist" aria-label="@L.Resource("LiveWorld_Title")">
                @if (_worldIsMetadata)
                {
                    <button role="tab" aria-selected="@(_worldTab == "world")" class="@(_worldTab == "world" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("world")'>@L.Resource("WorldEditor_TabStory")</button>
                    <button role="tab" aria-selected="@(_worldTab == "containment")" class="@(_worldTab == "containment" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("containment")'>@L.Resource("WorldEditor_TabContainment")</button>
                    <button role="tab" aria-selected="@(_worldTab == "traders")" class="@(_worldTab == "traders" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("traders")'>@L.Resource("WorldEditor_TabTraders")</button>
                    @* No ENTITLEMENTS tab here: it only ever showed an "edit the file instead"
                       placeholder in live mode, same reasoning as the removed live Advanced Data
                       tab above - a tab that never does anything is worse than no tab. *@
                }
                else
                {
                    <button role="tab" aria-selected="@(_worldTab == "flags")" class="@(_worldTab == "flags" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("flags")'>@L.Resource("WorldEditor_TabQuestFlags")</button>
                    <button role="tab" aria-selected="@(_worldTab == "doors")" class="@(_worldTab == "doors" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("doors")'>@L.Resource("WorldEditor_TabDoors")</button>
                    <button role="tab" aria-selected="@(_worldTab == "containers")" class="@(_worldTab == "containers" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("containers")'>@L.Resource("WorldEditor_TabContainers")</button>
                    <button role="tab" aria-selected="@(_worldTab == "dropped")" class="@(_worldTab == "dropped" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("dropped")'>@L.Resource("WorldEditor_TabDropped")</button>
                    <button role="tab" aria-selected="@(_worldTab == "npcs")" class="@(_worldTab == "npcs" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("npcs")'>@L.Resource("Live_TabWildlife")</button>
                    <button role="tab" aria-selected="@(_worldTab == "bases")" class="@(_worldTab == "bases" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("bases")'>@L.Resource("WorldEditor_TabBases")</button>
                    <button role="tab" aria-selected="@(_worldTab == "vehicles")" class="@(_worldTab == "vehicles" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("vehicles")'>@L.Resource("WorldEditor_TabVehicles")</button>
                    <button role="tab" aria-selected="@(_worldTab == "pets")" class="@(_worldTab == "pets" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("pets")'>@L.Resource("WorldEditor_TabPets")</button>
                    <button role="tab" aria-selected="@(_worldTab == "narrativenpcs")" class="@(_worldTab == "narrativenpcs" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("narrativenpcs")'>@L.Resource("WorldEditor_TabNpcs")</button>
                    <button role="tab" aria-selected="@(_worldTab == "portals")" class="@(_worldTab == "portals" ? "selected" : null)" @onclick='() => SelectWorldTabAsync("portals")'>@L.Resource("Live_TabPortals")</button>
                    @foreach (var feature in CareFeatures)
                    {
                        <button role="tab" aria-selected="@(_worldTab == feature.Id)" class="@(_worldTab == feature.Id ? "selected" : null)" @onclick="() => SelectWorldTabAsync(feature.Id)">@L.Resource(feature.TitleKey)</button>
                    }
                    @* No "Advanced data" (raw JSON) tab here: unlike the file editor, live editing
                       has no file tree to show at all, so this tab only ever rendered an "open the
                       world's save to use it" placeholder - a tab that never does anything is
                       worse than no tab. *@
                }
            </nav>
            @* No extra wrapper div here, matching SaveEditorSurface.razor exactly - each world tab's
               content component renders directly as a sibling of the nav, the same as the file
               editor, rather than reusing PlayerEditor's own "player-tab-viewport" wrapper class
               (which did nothing for this content anyway: that class's actual styling is Blazor
               scoped CSS private to PlayerEditor.razor, so it never applied outside that component). *@
            @if (_worldTab == "world" && _story is not null && _flags is not null)
            {
                <WorldStoryTab Session="_story" Flags="_flags" OnError="e => _error = e" />
            }
            else if (_worldTab == "flags" && _flags is not null)
            {
                <WorldFlagsTab Session="_flags" OnError="e => _error = e" />
            }
            else if (_worldTab == "doors" && _doors is not null)
            {
                <WorldDoorsTab Session="_doors" />
            }
            else if (_worldTab == "containers" && _containers is not null)
            {
                @* Same tab the offline editor uses (IWorldContainersSession is the shared
                   boundary) - see LiveContainersSession for the live implementation. *@
                <WorldContainersTab Session="_containers" LivePlayerSession="_inventory" Title="@L.Resource("LiveContainers_Title")" InitialFilter="@_careContainerFilter" PlayerPosition="_spawn?.LivePosition" />
            }
            else if (_worldTab == "dropped" && _dropped is not null)
            {
                @* Same tab the offline editor uses (IWorldDroppedItemsSession is the shared
                   boundary) - see LiveDroppedItemsSession for the live implementation. *@
                <WorldDroppedItemsTab Session="_dropped" Title="@L.Resource("LiveDropped_Title")" PlayerPosition="_spawn?.LivePosition" />
            }
            else if (_worldTab == "npcs" && _npcs is not null)
            {
                <LiveNpcsTab Session="_npcs" OnChanged="() => {}" />
            }
            else if (_worldTab == "bases" && _bases is not null)
            {
                <WorldBasesTab Session="_bases" Title="@L.Resource("WorldBases_BaseManager")" OnError="ShowWorldAreaError" />
            }
            else if (_worldTab == "vehicles" && _vehicles is not null)
            {
                <WorldVehiclesTab Session="_vehicles" Title="@L.Resource("WorldVehicles_VehiclesInThisWorld")" OnError="ShowWorldAreaError" />
            }
            else if (_worldTab == "pets" && _pets is not null)
            {
                <WorldPetsTab Session="_pets" Title="@L.Resource("WorldPets_TamedPetsInThisWorld")" OnError="ShowWorldAreaError" />
            }
            else if (_worldTab == "narrativenpcs" && _narrativeNpcs is not null)
            {
                @* Same shared tab the file editor uses (IWorldNpcsSession) - not to be confused
                   with the "npcs" tab above (LiveNpcsTab, CREATURES), which is every creature and
                   hostile NPC currently loaded, not story characters/traders. *@
                <WorldNpcsTab Session="_narrativeNpcs" OnError="ShowWorldAreaError" />
            }
            else if (_worldTab == "containment" && _containment is not null)
            {
                @* The exact same tab the file editor uses (WorldSaveSession implements the same
                   IWorldContainmentSession boundary) - no FileSession here, so the world-wide
                   discovery sweeps section (file-only, no live UObject) simply does not render. *@
                <WorldContainmentTab Session="_containment" OnError="SetError" />
                <p class="muted">@L.Resource("LiveContainment_OfflineWorldUnlocksNote")</p>
            }
            else if (_worldTab == "traders" && _traders is not null)
            {
                <LiveTradersTab Session="_traders" OnChanged="() => {}" />
            }
            else if (_worldTab == "portals" && _portals is not null)
            {
                @* Also the same shared tab the file editor's "World Teleporters" feature uses -
                   LivePortalsFeatureSession implements IWorldFeaturesSession for this one feature
                   only; every other feature id (power sockets, resource nodes, ...) has no live
                   equivalent and is not offered here. *@
                <WorldFeaturesTab Session="_portals" FeatureId="@LivePortalsFeatureSession.PortalsFeatureId" OnError="SetError" />
            }
            else if (_worldTab == "chemistry-benches" && _care.TryGetValue("chemistry-benches", out var chemistrySession))
            {
                @* Dedicated tab instead of the generic WorldFeaturesTab reuse below - see
                   LiveChemistryBenchTab's own header comment for why the "open flask contents"
                   deep link into the containers tab was replaced with slot editing built in. *@
                <LiveChemistryBenchTab Session="chemistrySession" OnChanged="() => {}" />
            }
            else if (_care.TryGetValue(_worldTab, out var careSession))
            {
                <WorldFeaturesTab Session="careSession" FeatureId="@_worldTab" OnError="SetError" OnOpenLink="OpenCareContainerAsync" />
            }
            else if (_connectingTabId == _worldTab)
            {
                @* The tab was just opened and its area is still being asked for - see
                   EnsureAreaConnectedAsync. Without this, the moment between opening a tab and
                   its data arriving showed nothing at all (or briefly flashed the "not available"
                   message below before the real content replaced it). *@
                <p class="lede live-waiting" role="status" aria-live="polite">
                    <span class="blocking-busy-spinner" aria-hidden="true"></span>
                    @L.Resource("Common_Working")
                </p>
            }
            else
            {
                <p class="muted">@L.Resource("Live_WorldAreaUnavailable")</p>
                @if (_lastWorldAreaError is { Length: > 0 } reason)
                {
                    <p class="muted">@reason</p>
                }
            }
        }
        @if (_error is not null)
        {
            <p class="error-text" role="alert">@_error</p>
        }
    </section>
}

@code {
    private string? _error;
    // Which player tab PlayerEditor currently has open, mirrored here via OnTabActivated - used
    // to know which area to lazily connect next, and (for vitals/skills) which session an edit
    // notification or a background refresh should target.
    private string _playerActiveTab = "vitals";
    // Which world tab this page's own world-tabs strip currently has open - independent of
    // _playerActiveTab; only one of the two sections renders at a time now (see _surface), but
    // each keeps its own "current tab" so switching back to a surface returns to where it was.
    private string _worldTab = "containers";
    // Which of the two mutually-exclusive sections below is on screen - driven entirely by the
    // sidebar now (WorkspaceShell's live player rows and its WORLD row), never by anything on
    // this page itself. Mirrored onto LiveSession.Surface so the sidebar can highlight the
    // selected row.
    private LiveSurface _surface = LiveSurface.Player;
    // Round 78: which of the two world tab sets the nav shows - see LiveSessionService.WorldSurfaceIsMetadata.
    private bool _worldIsMetadata;
    private static readonly HashSet<string> MetadataWorldTabs = new(StringComparer.Ordinal)
        { "world", "traders", "containment", "entitlements" };
    private readonly LivePlayerEditorSession _playerFacade = new();
    private ILiveGameChannel? _channel;
    private LiveWorldInfoChannel? _worldInfo;
    private LivePlayerVitalsSession? _vitals;
    private LivePlayerSkillsSession? _skills;
    private LivePlayerSpawnSession? _spawn;
    private LivePlayerCompanionsSession? _companions;
    private LiveNpcSession? _npcs;
    private LiveInventorySession? _inventory;
    private LiveStorySession? _story;
    private LivePlayerRecipesSession? _recipes;
    private LivePlayerCodexSession? _codex;
    private LivePlayerGeneralSession? _general;
    private LiveWorldFlagsSession? _flags;
    private IWorldDoorsSession? _doors;
    private LiveContainersSession? _containers;
    private LiveDroppedItemsSession? _dropped;
    private LiveBasesSession? _bases;
    private LiveVehiclesSession? _vehicles;
    private LivePetsSession? _pets;
    private LiveNarrativeNpcsSession? _narrativeNpcs;
    private LiveContainmentSession? _containment;
    private LiveTradersSession? _traders;
    private LivePortalsFeatureSession? _portals;
    private readonly Dictionary<string, LiveDeployedCareSession> _care = new(StringComparer.Ordinal);
    private static readonly (string Id, string TitleKey)[] CareFeatures =
        [("garden-plots", "Live_TabGardenPlots"), ("power-chairs", "Live_TabPowerChairs"), ("chemistry-benches", "Live_TabChemistryBenches")];
    private string? _careContainerFilter;

    private async Task OpenCareContainerAsync(string id)
    {
        _careContainerFilter = id;
        await SelectWorldTabAsync("containers");
    }
    private string? _selectedPlayerId;

    private string? ActiveStatus => _playerActiveTab switch
    {
        "vitals" => _vitals?.Status,
        "skills" => _skills?.Status,
        _ => null,
    };

    /// <summary>
    /// "Where's the game running?", "this PC or somewhere else?", and everything either
    /// answer waits on all live in the mode-select dialog now - this page's only job is to adopt
    /// the connection the dialog already proved works (a real TCP connect, hello handshake, and
    /// a real vitals read - see ModeSelectDialog.TryConnectAsync) and show the tabs, or send the
    /// player back to the dialog when there is nothing to adopt at all (a direct/bookmarked visit)
    /// or the handed-off channel stopped answering in the instant between the dialog's last check
    /// and this page loading (the game closed or crashed right then, say).
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        // The sidebar has no access to _vitals/_skills (they live on this page), so it asks
        // through LiveSessionService instead of switching players/surfaces itself - see
        // WorkspaceShell's live sidebar, the only other place these three requests come from.
        LiveSession.PlayerSwitchRequested += HandlePlayerSwitchRequestedAsync;
        LiveSession.WorldSurfaceRequested += HandleWorldSurfaceRequestedAsync;
        LiveSession.OfflinePlayerFileRequested += HandleOfflinePlayerFileRequestedAsync;
        LiveSession.DisconnectRequested += DisconnectAsync;

        if (LiveSession.TakeVerifiedConnection() is { } handoff)
        {
            await ConnectAsync(handoff.Channel);
            if (_vitals is not null) return;
        }

        RedirectToModeSelect();
    }

    /// <summary>"Where's the game running?" has exactly one home - the mode-select dialog - so
    /// this page never renders that question itself; anywhere it would otherwise have nothing
    /// left to show but that question sends the player back to the dialog instead.</summary>
    private void RedirectToModeSelect()
    {
        LiveSession.RequestModeSelect();
        Navigation.NavigateTo("browse");
    }

    // The sidebar ITEM CATALOG for INVENTORY/TRANSMOG/GATEPal is now published by the nested
    // <PlayerEditor> component itself (the exact same PublishPaletteContext the file editor
    // already used) - this page no longer needs its own copy of that logic.

    private async Task HandlePlayerSwitchRequestedAsync(string playerId)
    {
        // The surface flips back to the live player FIRST, before anything is awaited: coming
        // back from an offline save file (or the world tabs) must show the live editor again even
        // if reloading this player's areas is slow or one of them fails - a failure shows up as
        // the usual error banner on the live surface, never as being stuck on the file editor.
        _surface = LiveSurface.Player;
        await InvokeAsync(StateHasChanged);
        if (_vitals is null || _skills is null) return;
        // A pending debounced vitals/skills push belongs to whoever was selected before - letting
        // it fire after the switch would push a stale edit onto the player who is now selected.
        CancelPendingAutoSave();
        _selectedPlayerId = playerId;
        await PlayerPickedAsync();
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>A sidebar region or world-metadata row: same one-surface-at-a-time switch as
    /// picking a player, just with no player to load - the world session objects were already
    /// connected lazily by <see cref="EnsureAreaConnectedAsync"/> the first time this or any
    /// earlier visit opened a world tab. Switching metadata-ness resets the current tab to a
    /// sensible default for the new set when the old tab does not belong to it (round 78).</summary>
    private async Task HandleWorldSurfaceRequestedAsync(bool isMetadata)
    {
        _surface = LiveSurface.World;
        if (isMetadata != _worldIsMetadata)
        {
            _worldIsMetadata = isMetadata;
            var belongsToNewSet = MetadataWorldTabs.Contains(_worldTab) == isMetadata;
            if (!belongsToNewSet) _worldTab = isMetadata ? "world" : "containers";
        }
        LiveSession.WorldSurfaceSelected(isMetadata);
        await EnsureAreaConnectedAsync(_worldTab);
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>The sidebar's offline-player row: the file itself was already staged on
    /// <see cref="Workspace"/> by the sidebar before this runs (see WorkspaceShell's handler) -
    /// this just switches which surface is on screen, the same as the other two.</summary>
    private Task HandleOfflinePlayerFileRequestedAsync()
    {
        _surface = LiveSurface.OfflinePlayerFile;
        LiveSession.OfflinePlayerFileSelected();
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>File-mode's own edit-notification glue (see the file editor's own
    /// <c>PlayerChanged</c> handler) for the offline-player surface: an edit anywhere in the nested
    /// <c>&lt;PlayerEditor&gt;</c> needs to flip the shared workspace dirty flag so the SAVE/REVERT
    /// toolbar above (WorkspaceShell's shell-status bar) lights up.</summary>
    private Task HandleOfflinePlayerChangedAsync()
    {
        Workspace.Current?.PlayerSession?.MarkChanged();
        Workspace.NotifyEdited();
        return Task.CompletedTask;
    }

    /// <summary>Adopts an already-connected, already-verified channel: reads the player
    /// directory and connects vitals/skills for the default tab. Every other area connects
    /// lazily instead, the first time its own tab is opened - see EnsureAreaConnectedAsync. This
    /// used to be roughly twenty separate requests fired back-to-back the instant any connection
    /// succeeded, regardless of which tab (if any) the player was about to look at; if exactly
    /// one of those twenty handlers has a bug, that burst triggers it on literally every single
    /// connection. Only asking for the one area a just-opened tab actually needs turns "which of
    /// twenty things is doing this" into "whichever tab was open when it happened".</summary>
    private async Task ConnectAsync(ILiveGameChannel channel)
    {
        try
        {
            // The directory is read first so vitals/skills can seed straight from the local
            // player's id instead of the mod's own "no playerId given" default - the two happen
            // to be the same player today, but reading the id explicitly is what lets the sidebar
            // hand back a DIFFERENT one later without a special case.
            var directory = await new LivePlayerDirectoryChannel(channel).GetAsync();
            var localPlayerId = directory.Players.FirstOrDefault(player => player.IsLocal)?.Id;
            _vitals = await LivePlayerVitalsSession.ConnectAsync(new LivePlayerVitalsChannel(channel), localPlayerId);
            _skills = await LivePlayerSkillsSession.ConnectAsync(new LivePlayerSkillsChannel(channel), localPlayerId);
            _playerFacade.VitalsSession = _vitals;
            _playerFacade.SkillsSession = _skills;
            _channel = channel;
            // The channel already tells the truth about whether the transport itself is still
            // alive (Faulted, set only for a genuine transport failure - a dropped socket, not
            // an in-game handler rejecting one request, see TcpLiveGameChannel's own remarks on
            // that distinction) - nothing here used to listen. Every background read that hit a
            // dead connection (the periodic refresh loop, the region poll) silently swallowed the
            // failure and just tried again next tick forever, so the header/sidebar kept showing
            // "connected" no matter how long the game had actually been closed. Reusing
            // DisconnectAsync's own cleanup (the same path a manual DISCONNECT already takes)
            // instead of building a second one keeps there being exactly one way this page ever
            // leaves a connection behind.
            _channel.StateChanged += OnChannelStateChanged;
            _worldInfo = new LiveWorldInfoChannel(channel);
            _selectedPlayerId = localPlayerId;
            _surface = LiveSurface.Player;
            LiveSession.Connected(directory, localPlayerId);
            StartLiveRefreshLoop();
            // Round 78: which world folder on disk this connection's saves live in, so the
            // sidebar can list this world's other regions (disabled) and offline players
            // alongside the connected ones - see LiveWorldFolderLocator's own doc comment for why
            // the lookup runs this way round (a live connection only ever hands back a player id,
            // never a world/folder name). Off the request thread: it walks every discovered world
            // on this machine, and must never delay adopting the connection itself.
            _ = Task.Run(() => TryLocateLiveWorldFolderAsync(localPlayerId));
            SyncChangedSubscriptions();
            // Warms the item-upgrade catalog in the background the moment a live connection is
            // adopted, off the request that actually needs it. ItemUpgradeVocabularyService.Get()
            // is a plain in-memory Lazy<T> with its own try/catch (see that class) - unlike the
            // twenty-RPC burst this method's own doc comment warns against, a bug in here cannot
            // reach the running game or fail the connection, so firing it early carries none of
            // that risk. Left cold, the FIRST tab that needs it (inventory OR transmog, whichever
            // the player opens first) pays a full game-pak mount synchronously inside
            // EnsureAreaConnectedAsync - the "Transmog tab takes a few seconds to open" report was
            // really this mount landing on whichever of the two tabs happened to be opened first.
            _ = Task.Run(() => Upgrades.Get());
        }
        catch (Exception)
        {
            // Catches everything, not just the expected transport exceptions: this only ever
            // runs once, right after the dialog already proved the exact same channel worked -
            // an unexpected shape here (a bug in one of these three areas, or a mismatch with an
            // older/newer in-game mod build) must fail this one adoption attempt, same as a
            // dropped connection would, rather than crash the whole app out from under the
            // player the instant a game finishes loading a save. Silent: not worth an error
            // banner on a page that is about to redirect straight back to the dialog anyway (see
            // the caller in OnInitializedAsync).
            await channel.DisposeAsync();
        }
    }

    /// <summary>
    /// Finds this connection's world folder (see <see cref="LiveWorldFolderLocator"/>) and, when
    /// it is safe to, opens it on the shared file-editing service so the sidebar's region and
    /// offline-player rows have real save data to show (see WorkspaceShell's
    /// <c>IsLiveWorldOpen</c>). Never touches an already-open, unrelated FILE workspace that has
    /// edits staged in it - that folder stays exactly as the player left it, and the sidebar falls
    /// back to its own static region list instead.
    /// </summary>
    private async Task TryLocateLiveWorldFolderAsync(string? localPlayerId)
    {
        try
        {
            var world = LiveWorldFolderLocator.FindForPlayer(localPlayerId);
            LiveSession.SetWorldFolder(world?.FolderPath);
            if (world is null) return;

            var alreadyOpen = string.Equals(Workspace.Current?.WorldFolder, world.FolderPath, StringComparison.OrdinalIgnoreCase);
            if (alreadyOpen) return;
            if (Workspace.Current is not null && Workspace.HasStagedEdits) return;

            await Workspace.OpenAsync(world);
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Find this world's folder for the live sidebar");
        }
    }

    /// <summary>A world-area read that the agent rejects (no world loaded, or an older mod without
    /// that command) leaves that area unavailable rather than failing the connection. Transport
    /// failures still propagate: those mean the connection itself is gone.</summary>
    private async Task<T?> TryConnectWorldAreaAsync<T>(Func<Task<T>> connect) where T : class
    {
        try
        {
            var session = await connect();
            _lastWorldAreaError = null;
            return session;
        }
        catch (LiveAgentException exception)
        {
            // Kept for the "not available" message below: the game's own reason (no world loaded,
            // an older in-game script without this command, ...) is the one thing that tells the
            // player what to do about it.
            _lastWorldAreaError = Errors.Present(exception, "Open this area.", "The game may not have a world loaded yet.");
            return null;
        }
    }

    /// <summary>What the game said the last time a world area refused to connect - shown under the
    /// generic "not available" line so a blank world tab is never a mystery.</summary>
    private string? _lastWorldAreaError;

    /// <summary>The tab id currently being lazily connected, if any - PlayerEditor's LoadingTabId
    /// and the world viewport both compare their own active tab against this, so a connect in
    /// progress for one section never shows a spinner in the other.</summary>
    private string? _connectingTabId;

    private async Task HandlePlayerTabActivatedAsync(string tab)
    {
        _playerActiveTab = tab;
        // VITALS/SKILLS are already connected before <PlayerEditor> ever exists (see
        // ConnectAsync), so there is nothing to lazily connect here - and PlayerEditor now reports
        // its initial tab on every mount (including every remount after a detour to the WORLD
        // surface, which recreates it back at its own "vitals" default), so skipping the connect
        // dance for these two avoids a spurious loading flash on top of the tab the player was
        // already looking at.
        if (tab is "vitals" or "skills") return;
        await EnsureAreaConnectedAsync(tab);
    }

    private async Task SelectWorldTabAsync(string tab)
    {
        _worldTab = tab;
        await EnsureAreaConnectedAsync(tab);
    }

    /// <summary>
    /// Connects the one area a tab needs, the first time that tab is opened - see the comment
    /// on <see cref="ConnectAsync"/> for why this is lazy at all. The <c>??=</c> on every field
    /// makes revisiting an already-connected tab a no-op, and a world area that failed because no
    /// world was loaded yet is deliberately retried on a later visit rather than remembered as a
    /// permanent failure - the world can load mid-session. Every player-area case also mirrors its
    /// result onto <see cref="_playerFacade"/>, the same object <c>&lt;PlayerEditor&gt;</c> reads
    /// from - see <see cref="LivePlayerEditorSession"/>'s own doc comment.
    /// </summary>
    private async Task EnsureAreaConnectedAsync(string tab)
    {
        if (_channel is not { } channel) return;
        _connectingTabId = tab;
        await InvokeAsync(StateHasChanged);
        try
        {
            switch (tab)
            {
                case "npcs":
                    _npcs ??= await LiveNpcSession.ConnectAsync(new LiveNpcChannel(channel));
                    break;
                case "inventory" or "transmog":
                    _inventory ??= await LiveInventorySession.ConnectAsync(new LiveInventoryChannel(channel), _selectedPlayerId, Upgrades.Get(),
                        new LiveTransmogVisibilityChannel(channel));
                    _playerFacade.InventorySession = _inventory;
                    break;
                case "spawn":
                    _spawn ??= await LivePlayerSpawnSession.ConnectAsync(new LiveSpawnChannel(channel), _selectedPlayerId);
                    _playerFacade.SpawnSession = _spawn;
                    break;
                case "companions":
                    _companions ??= await LivePlayerCompanionsSession.ConnectAsync(new LiveCompanionsChannel(channel), _selectedPlayerId);
                    _playerFacade.CompanionsSession = _companions;
                    break;
                case "recipes":
                    _recipes ??= await LivePlayerRecipesSession.ConnectAsync(new LivePlayerRecipesChannel(channel), _selectedPlayerId);
                    _playerFacade.RecipesSession = _recipes;
                    break;
                case "gatepal":
                    // PlayerEditor's own tab strip calls this tab "gatepal" (the in-game
                    // GATEPAL device PlayerCodexTab represents), not "codex" - the mismatched
                    // case label here meant this switch never matched when that tab was opened,
                    // so _codex/_playerFacade.CodexSession were never connected and the tab
                    // always rendered empty ("Nothing matches (or game data is unavailable)"),
                    // regardless of what was actually unlocked in the running game.
                    _codex ??= await LivePlayerCodexSession.ConnectAsync(new LivePlayerCodexChannel(channel), _selectedPlayerId);
                    _playerFacade.CodexSession = _codex;
                    break;
                case "general":
                case "character":
                    // PlayerGeneralTab/PlayerCharacterTab both also need the recipes session
                    // (progress gating) - see their render conditions below. CHARACTER now binds
                    // to the same IPlayerGeneralSession GENERAL does (LivePlayerGeneralSession), so
                    // opening either tab first connects both.
                    _recipes ??= await LivePlayerRecipesSession.ConnectAsync(new LivePlayerRecipesChannel(channel), _selectedPlayerId);
                    _playerFacade.RecipesSession = _recipes;
                    _general ??= await LivePlayerGeneralSession.ConnectAsync(new LivePlayerGeneralChannel(channel), _selectedPlayerId, _selectedPlayerId);
                    _playerFacade.GeneralSession = _general;
                    break;
                case "world":
                    // WorldStoryTab needs both sessions - see its render condition below.
                    _story ??= await TryConnectWorldAreaAsync(() => LiveStorySession.ConnectAsync(new LiveStoryChannel(channel), new LiveWorldStateChannel(channel), new LiveWorldFlagsChannel(channel), new LiveWorldUnlocksChannel(channel)));
                    _flags ??= await TryConnectWorldAreaAsync(() => LiveWorldFlagsSession.ConnectAsync(new LiveWorldFlagsChannel(channel)));
                    break;
                case "flags":
                    _flags ??= await TryConnectWorldAreaAsync(() => LiveWorldFlagsSession.ConnectAsync(new LiveWorldFlagsChannel(channel)));
                    break;
                case "doors":
                    _doors ??= await TryConnectWorldAreaAsync(() => LiveDoorsSession.ConnectAsync(new LiveDoorsChannel(channel)));
                    break;
                case "containers":
                    _containers ??= await TryConnectWorldAreaAsync(() => LiveContainersSession.ConnectAsync(new LiveContainersChannel(channel)));
                    _inventory ??= await LiveInventorySession.ConnectAsync(new LiveInventoryChannel(channel), _selectedPlayerId, Upgrades.Get(),
                        new LiveTransmogVisibilityChannel(channel));
                    _playerFacade.InventorySession = _inventory;
                    // Also seeds the player's own position for PlayerPosition below (nearby-only
                    // filter) - see the "dropped" case's identical comment for why this is cheap
                    // and never lets a failure here take down the containers connect itself.
                    if (_spawn is null)
                    {
                        try { _spawn = await LivePlayerSpawnSession.ConnectAsync(new LiveSpawnChannel(channel), _selectedPlayerId); _playerFacade.SpawnSession = _spawn; }
                        catch (Exception) { }
                    }
                    break;
                case "dropped":
                    _dropped ??= await TryConnectWorldAreaAsync(() => LiveDroppedItemsSession.ConnectAsync(new LiveDroppedItemsChannel(channel)));
                    // Also seeds the player's own position for PlayerPosition below (distance
                    // sort/readout) - cheap (a single spawn.get, not a world scan) and never
                    // lets a failure here take down the dropped-items connect itself.
                    if (_spawn is null)
                    {
                        try { _spawn = await LivePlayerSpawnSession.ConnectAsync(new LiveSpawnChannel(channel), _selectedPlayerId); _playerFacade.SpawnSession = _spawn; }
                        catch (Exception) { }
                    }
                    break;
                case "bases":
                    _bases ??= await TryConnectWorldAreaAsync(() => LiveBasesSession.ConnectAsync(new LiveBasesChannel(channel)));
                    break;
                case "vehicles":
                    _vehicles ??= await TryConnectWorldAreaAsync(() => LiveVehiclesSession.ConnectAsync(new LiveVehiclesChannel(channel)));
                    break;
                case "pets":
                    _pets ??= await TryConnectWorldAreaAsync(() => LivePetsSession.ConnectAsync(new LivePetsChannel(channel)));
                    break;
                case "narrativenpcs":
                    _narrativeNpcs ??= await TryConnectWorldAreaAsync(() => LiveNarrativeNpcsSession.ConnectAsync(new LiveNarrativeNpcsChannel(channel)));
                    break;
                case "containment":
                    _containment ??= await TryConnectWorldAreaAsync(() => LiveContainmentSession.ConnectAsync(new LiveContainmentChannel(channel)));
                    break;
                case "traders":
                    // Trader gating is world-flag state, so it needs a loaded world like every
                    // other world area; the roster itself is static game data.
                    _traders ??= await TryConnectWorldAreaAsync(() => LiveTradersSession.ConnectAsync(new LiveTradersChannel(channel), TraderVocabulary.GetTraders()));
                    break;
                case "portals":
                    _portals ??= await TryConnectWorldAreaAsync(() => LivePortalsFeatureSession.ConnectAsync(new LivePortalsChannel(channel)));
                    break;
                case "garden-plots":
                case "power-chairs":
                case "chemistry-benches":
                    if (!_care.ContainsKey(_worldTab))
                    {
                        var care = await TryConnectWorldAreaAsync(() => LiveDeployedCareSession.ConnectAsync(new LiveDeployedCareChannel(channel), _worldTab));
                        if (care is not null) _care[care.FeatureId] = care;
                    }
                    break;
            }
        }
        catch (Exception exception)
        {
            _error = Errors.Present(exception, "Open this area.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _connectingTabId = null;
            SyncChangedSubscriptions();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ---- VITALS/SKILLS: apply immediately, debounced, never overlapping ----
    // Every other player tab pushes its own edits to the game the moment its own button/field
    // commits (PlayerSpawnTab's TELEPORT HERE, PlayerCompanionsTab's SEND, PlayerInventoryTab's
    // per-slot PushSlotAsync, ...) - PlayerEditor's OnChanged bubbles up from ALL of those too,
    // but only vitals/skills actually need this page to do anything about it: their tabs just
    // mutate the shared PlayerVitals/PlayerSkillEdit models in place on every keystroke/slider
    // tick and rely on something else to push the result, the same way the file editor's SAVE
    // button does for the staged copy. Live has no SAVE button any more, so this pushes on their
    // behalf - a short debounce so a dragged slider collapses into one push instead of dozens,
    // and a gate so a slow push never overlaps a second one for the same tab.
    private CancellationTokenSource? _autoSaveDebounce;
    private readonly SemaphoreSlim _autoSaveGate = new(1, 1);

    private Task HandlePlayerChangedAsync()
    {
        if (_playerActiveTab is "vitals" or "skills") ScheduleAutoSave(_playerActiveTab);
        return Task.CompletedTask;
    }

    private void ScheduleAutoSave(string tab)
    {
        CancelPendingAutoSave();
        var cts = new CancellationTokenSource();
        _autoSaveDebounce = cts;
        _ = DebouncedAutoSaveAsync(tab, cts.Token);
    }

    private void CancelPendingAutoSave()
    {
        _autoSaveDebounce?.Cancel();
        _autoSaveDebounce?.Dispose();
        _autoSaveDebounce = null;
    }

    /// <summary>Waits out the debounce window, then pushes the tab's current state to the game -
    /// serialized through <see cref="_autoSaveGate"/> so an in-flight push always finishes before
    /// the next one starts, however fast the player keeps editing.</summary>
    private async Task DebouncedAutoSaveAsync(string tab, CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromMilliseconds(200), token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await _autoSaveGate.WaitAsync(CancellationToken.None);
        try
        {
            if (token.IsCancellationRequested) return;
            if (tab == "vitals" && _vitals is not null) await _vitals.SaveAsync();
            else if (tab == "skills" && _skills is not null) await _skills.SaveAsync();
            _error = null;
        }
        catch (Exception exception)
        {
            _error = Errors.Present(exception, "Apply the live edit.",
                "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _autoSaveGate.Release();
            await InvokeAsync(StateHasChanged);
        }
    }

    // ---- Background refresh: pick up changes made in the running game itself ----
    // A single loop for the whole page lifetime rather than one started and stopped per tab/
    // surface switch: every tick below already checks the surface and active tab first and
    // simply does nothing when they do not match, which is exactly the same end result as
    // tearing the timer down and recreating it, with far less to get wrong around a fast switch
    // racing a tick. It stops for good in DisconnectAsync/DisposeAsync.
    private CancellationTokenSource? _liveRefreshCts;

    private void StartLiveRefreshLoop()
    {
        _liveRefreshCts = new CancellationTokenSource();
        _ = LiveRefreshLoopAsync(_liveRefreshCts.Token);
    }

    private void StopLiveRefreshLoop()
    {
        _liveRefreshCts?.Cancel();
        _liveRefreshCts?.Dispose();
        _liveRefreshCts = null;
    }

    private async Task LiveRefreshLoopAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
            while (await timer.WaitForNextTickAsync(token))
            {
                await PollCurrentRegionAsync();
                await RefreshActiveAreaAsync();
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    /// <summary>Round 78: which region of the world the game currently has loaded, for the
    /// sidebar's per-region rows (see WorkspaceShell). A cosmetic read - a transient failure here
    /// is silently ignored, the same as <see cref="RefreshActiveAreaAsync"/> below.</summary>
    private async Task PollCurrentRegionAsync()
    {
        if (_worldInfo is not { } worldInfo) return;
        try
        {
            var info = await worldInfo.GetAsync();
            var previousToken = LiveSession.CurrentRegionToken;
            LiveSession.SetCurrentRegion(info.LevelToken);
            // Every per-region world area (containers, doors, dropped items, creatures, bases,
            // vehicles, pets, narrative NPCs, portals, the care features) is backed by an
            // in-game FindAllOf sweep, which only ever sees whatever region the game currently
            // has loaded/streamed - see main.lua's loadedContainers()/allNpcs()/etc. Teleporting
            // (or walking) into a different region used to leave every one of those sessions
            // showing the PREVIOUS region's data forever: they connect once per LiveConnect
            // page lifetime (the `??=` in EnsureAreaConnectedAsync), not once per region, and
            // nothing ever told them the ground moved out from under them. Reset them all here
            // the moment the game's own region token actually changes, so the next tab visit
            // re-fetches fresh - world-wide state (story/flags/traders/containment/entitlements)
            // is untouched, since that is not region-scoped at all.
            if (previousToken is not null && !string.Equals(previousToken, info.LevelToken, StringComparison.OrdinalIgnoreCase))
            {
                ResetRegionScopedWorldSessions();
            }
        }
        catch (Exception)
        {
        }
    }

    /// <summary>
    /// Re-reads whichever live session backs the tab currently on screen, so a change made in the
    /// running game itself (damage taken, an item picked up, a door someone else opened) shows up
    /// here too - not only vitals/skills, which is all this used to cover. Generalised (round 78)
    /// to reach every area by calling <c>RefreshAsync()</c>/<c>IsDirty</c> through reflection
    /// (<see cref="LiveSessionReflection"/>) rather than a shared interface: several of these
    /// session classes are picking up that convention in other, concurrently in-flight changes,
    /// and reflecting on it by name means this loop keeps compiling and keeps working
    /// incrementally as each one does, instead of needing every session to land the members in
    /// lockstep with this file. A session with neither member yet is simply skipped - not an
    /// error - until it picks them up. Never refreshes a dirty session (an edit in progress); for
    /// vitals/skills specifically, also skipped while their own debounced push is pending or in
    /// flight (the exact guard this loop used to apply to only those two).
    /// </summary>
    private async Task RefreshActiveAreaAsync()
    {
        foreach (var session in ActiveLiveSessions())
        {
            if (session is null) continue;
            if ((ReferenceEquals(session, _vitals) || ReferenceEquals(session, _skills))
                && _autoSaveGate.CurrentCount == 0)
            {
                continue;
            }
            try
            {
                if (LiveSessionReflection.IsDirty(session)) continue;
                if (await LiveSessionReflection.TryRefreshAsync(session)) await InvokeAsync(StateHasChanged);
            }
            catch (Exception)
            {
                // A refresh is a nicety, not the player's own edit - a transient failure here is
                // not worth an error banner every couple of seconds. The next tick tries again.
            }
        }
    }

    /// <summary>Every live session object that could back the tab currently on screen, player or
    /// world - see <see cref="RefreshActiveAreaAsync"/>. "general" also refreshes recipes
    /// (progress-gating), mirroring how <see cref="EnsureAreaConnectedAsync"/> connects the two
    /// together. The offline-player-file surface has nothing live behind it, so nothing is
    /// yielded for it - its own SAVE/REVERT toolbar is the only way it changes.</summary>
    private IEnumerable<object?> ActiveLiveSessions()
    {
        if (_surface == LiveSurface.Player)
        {
            yield return _playerActiveTab switch
            {
                "vitals" => _vitals,
                "skills" => _skills,
                "inventory" or "transmog" => _inventory,
                "spawn" => _spawn,
                "companions" => _companions,
                "recipes" => _recipes,
                "gatepal" => _codex,
                "general" or "character" => _general,
                _ => null,
            };
            if (_playerActiveTab is "general" or "character") yield return _recipes;
        }
        else if (_surface == LiveSurface.World)
        {
            // -- Add a new world session's active-tab case here as it picks up RefreshAsync/IsDirty. --
            switch (_worldTab)
            {
                case "world": yield return _story; yield return _flags; break;
                case "flags": yield return _flags; break;
                case "doors": yield return _doors; break;
                // containers/npcs deliberately NOT auto-refreshed here: both back onto a full
                // world scan (every placed container/bench, or every loaded creature) with a
                // detail read per slot/actor, which on a long-played world can take several
                // seconds - reported live as the CONTAINERS tab freezing and timing out every
                // couple of seconds while it (or the player surface right next to it) was on
                // screen, since this loop re-ran that same expensive call on every 2-second tick.
                // A tab visit still gets one fetch (EnsureAreaConnectedAsync); after that it only
                // updates from the player's own edits, not a periodic re-poll.
                case "dropped": yield return _dropped; break;
                // bases: same reasoning as containers/npcs above - AbioticDeployed_ParentBP_C
                // covers every placeable in the world (crafting benches, storage, decorations,
                // everything), not only benches, so this is at least as large a sweep as
                // containers.list on a built-up base.
                case "vehicles": yield return _vehicles; break;
                case "pets": yield return _pets; break;
                case "narrativenpcs": yield return _narrativeNpcs; break;
                case "containment": yield return _containment; break;
                case "traders": yield return _traders; break;
                case "portals": yield return _portals; break;
                case "garden-plots":
                case "power-chairs":
                case "chemistry-benches":
                    if (_care.TryGetValue(_worldTab, out var care)) yield return care;
                    break;
                // "entitlements" has no live session backing it - offline-only.
            }
        }
    }

    /// <summary>
    /// Calls the <c>RefreshAsync()</c>/<c>IsDirty</c> members various live session classes are
    /// gaining (some already have them; others are picking this convention up in other,
    /// concurrently in-flight changes) by name, via reflection, instead of through a shared
    /// interface every session would need to implement in lockstep with this file. See <see
    /// cref="RefreshActiveAreaAsync"/> and <see cref="SyncChangedSubscriptions"/> (the same
    /// by-name approach for the <c>Changed</c> event).
    /// </summary>
    private static class LiveSessionReflection
    {
        private static readonly System.Collections.Concurrent.ConcurrentDictionary<Type, PropertyInfo?> IsDirtyProperties = new();
        private static readonly System.Collections.Concurrent.ConcurrentDictionary<Type, MethodInfo?> RefreshMethods = new();
        private static readonly System.Collections.Concurrent.ConcurrentDictionary<Type, EventInfo?> ChangedEvents = new();

        public static bool IsDirty(object session)
        {
            var property = IsDirtyProperties.GetOrAdd(session.GetType(), type => type.GetProperty("IsDirty", typeof(bool)));
            return property is not null && property.GetValue(session) is true;
        }

        public static async Task<bool> TryRefreshAsync(object session)
        {
            var method = RefreshMethods.GetOrAdd(session.GetType(), type => type.GetMethod("RefreshAsync", Type.EmptyTypes));
            if (method is null) return false;
            if (method.Invoke(session, null) is Task task) await task.ConfigureAwait(true);
            return true;
        }

        public static EventInfo? ChangedEvent(object session)
            => ChangedEvents.GetOrAdd(session.GetType(), type => type.GetEvent("Changed"));
    }

    // ---- Live "Changed" event subscriptions (round 78) ----
    // Separate from RefreshActiveAreaAsync's own polling: a session that fires Changed the moment
    // the running game's own state moves (rather than only when this loop next polls it) is
    // picked up immediately instead of waiting up to two seconds. Subscribed to every currently
    // connected session (not only the active tab's), so switching tabs never misses a change that
    // happened while that tab was in the background; unsubscribed as a whole on disconnect/dispose.
    private readonly HashSet<object> _changedSubscriptions = new();

    private void OnLiveSessionChanged() => Refresh();
    private Task OnLiveSessionChangedAsync() { Refresh(); return Task.CompletedTask; }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    private IEnumerable<object?> AllKnownLiveSessions() => new object?[]
    {
        _vitals, _skills, _spawn, _companions, _npcs, _inventory, _story, _recipes, _codex, _general,
        _flags, _doors, _containers, _dropped, _bases, _vehicles, _pets, _narrativeNpcs, _containment,
        _traders, _portals,
    }.Concat(_care.Values);

    /// <summary>Subscribes to every connected session's <c>Changed</c> event that is not already
    /// subscribed to. Safe to call repeatedly (called after <see cref="ConnectAsync"/> and after
    /// every <see cref="EnsureAreaConnectedAsync"/>, since either can hand back a newly connected
    /// session) - already-subscribed sessions are skipped, and a session with no <c>Changed</c>
    /// event yet, or one of a shape <see cref="MakeChangedHandler"/> does not recognise, is simply
    /// left unsubscribed rather than guessed at.</summary>
    private void SyncChangedSubscriptions()
    {
        foreach (var session in AllKnownLiveSessions())
        {
            if (session is null || !_changedSubscriptions.Add(session)) continue;
            var changedEvent = LiveSessionReflection.ChangedEvent(session);
            var handler = MakeChangedHandler(changedEvent);
            if (handler is null) { _changedSubscriptions.Remove(session); continue; }
            try { changedEvent!.AddEventHandler(session, handler); }
            catch (Exception) { _changedSubscriptions.Remove(session); }
        }
    }

    /// <summary>Unsubscribes every session <see cref="SyncChangedSubscriptions"/> subscribed to -
    /// called once on disconnect/dispose rather than per-session, since nothing here needs to
    /// unsubscribe earlier than that (a session that stops being the active tab still keeps its
    /// own state current in the background, which is harmless).</summary>
    private void UnsubscribeAllChangedEvents()
    {
        foreach (var session in _changedSubscriptions)
        {
            var handler = MakeChangedHandler(LiveSessionReflection.ChangedEvent(session));
            if (handler is null) continue;
            try { LiveSessionReflection.ChangedEvent(session)!.RemoveEventHandler(session, handler); }
            catch (Exception) { }
        }
        _changedSubscriptions.Clear();
    }

    /// <summary>Unsubscribes and forgets one session (see <see cref="UnsubscribeAllChangedEvents"/>
    /// for the same thing done to every session at once) - used by
    /// <see cref="ResetRegionScopedWorldSessions"/>, which only wants to drop a few of them.</summary>
    private void UnsubscribeChangedEvent(object? session)
    {
        if (session is null || !_changedSubscriptions.Remove(session)) return;
        var handler = MakeChangedHandler(LiveSessionReflection.ChangedEvent(session));
        if (handler is null) return;
        try { LiveSessionReflection.ChangedEvent(session)!.RemoveEventHandler(session, handler); }
        catch (Exception) { }
    }

    /// <summary>Drops every world session backed by a FindAllOf sweep of whatever region the game
    /// currently has loaded, so the next tab visit reconnects and fetches that region's own data
    /// instead of silently going on showing the region the player just left - see
    /// <see cref="PollCurrentRegionAsync"/>, the only caller. World-wide state (story/flags/
    /// traders/containment/entitlements) is untouched: none of it is region-scoped.</summary>
    private void ResetRegionScopedWorldSessions()
    {
        foreach (object? session in new object?[] { _containers, _doors, _dropped, _npcs, _bases, _vehicles, _pets, _narrativeNpcs, _portals }.Concat(_care.Values))
        {
            UnsubscribeChangedEvent(session);
        }
        _containers = null;
        _doors = null;
        _dropped = null;
        _npcs = null;
        _bases = null;
        _vehicles = null;
        _pets = null;
        _narrativeNpcs = null;
        _portals = null;
        _care.Clear();
        // Only the tab actually on screen right now gets re-fetched immediately - the other
        // eight get EnsureAreaConnectedAsync's usual lazy `??=` fetch whenever they are next
        // opened, rather than all firing a world scan on the game thread at once the moment the
        // player finishes teleporting. Skipped for the metadata tab set (story/traders/
        // containment/entitlements) - never touched by this reset in the first place.
        if (_surface == LiveSurface.World && !_worldIsMetadata) _ = EnsureAreaConnectedAsync(_worldTab);
    }

    /// <summary>Builds a delegate matching whichever event-handler shape a session's own
    /// <c>Changed</c> event declares. Every other "Changed" event in this codebase (<c>
    /// SaveWorkspaceSessionService.Changed</c>, <c>LiveSessionService.Changed</c>, ...) is a plain
    /// <c>Action</c>; this also accepts <c>Func&lt;Task&gt;</c> for a session that awaits
    /// something to raise it. A delegate built here works for both subscribing and unsubscribing:
    /// two separately-created delegates wrapping the same target and method are equal, so
    /// <c>RemoveEventHandler</c> finds the one <c>AddEventHandler</c> added without needing the
    /// exact same instance kept around.</summary>
    private Delegate? MakeChangedHandler(EventInfo? changedEvent)
    {
        if (changedEvent is null) return null;
        if (changedEvent.EventHandlerType == typeof(Action)) return new Action(OnLiveSessionChanged);
        if (changedEvent.EventHandlerType == typeof(Func<Task>)) return new Func<Task>(OnLiveSessionChangedAsync);
        return null;
    }

    /// <summary>OnError callback shape shared by WorldContainmentTab/WorldFeaturesTab (both take
    /// an EventCallback&lt;string?&gt;, matching every other file-editor tab's error surface).</summary>
    private Task SetError(string? message)
    {
        _error = message;
        return Task.CompletedTask;
    }

    /// <summary>Switches both tabs to a different connected player, discarding any unsaved edits
    /// for whoever was selected before.</summary>
    private async Task PlayerPickedAsync()
    {
        if (_vitals is null || _skills is null) return;
        _error = null;
        try
        {
            await _vitals.SwitchPlayerAsync(_selectedPlayerId);
            await _skills.SwitchPlayerAsync(_selectedPlayerId);
            if (_inventory is not null)
            {
                await _inventory.SwitchPlayerAsync(_selectedPlayerId);
                // A different player's slots are not the same objects any more (see
                // LiveInventorySession.SwitchPlayerAsync); drop any sidebar slot selection so it
                // does not keep pointing at the previous player's now-orphaned slot.
                if (Selection.Current?.PlayerArea is not null) Selection.Clear();
            }
            if (_spawn is not null) await _spawn.SwitchPlayerAsync(_selectedPlayerId);
            if (_companions is not null) await _companions.SwitchPlayerAsync(_selectedPlayerId);
            if (_inventory is not null) await _inventory.SwitchPlayerAsync(_selectedPlayerId);
            if (_recipes is not null) await _recipes.SwitchPlayerAsync(_selectedPlayerId);
            if (_codex is not null) await _codex.SwitchPlayerAsync(_selectedPlayerId);
            if (_general is not null) await _general.SwitchPlayerAsync(_selectedPlayerId, _selectedPlayerId);
            LiveSession.PlayerSelected(_selectedPlayerId);
        }
        catch (Exception exception)
        {
            _error = Errors.Present(exception, "Switch to a different player.",
                "The connection may have dropped; try reconnecting.");
        }
    }

    /// <summary>BASES/VEHICLES/PETS apply immediately per edit and report their own errors
    /// through the same OnError parameter the file editor's tabs already use.</summary>
    private Task ShowWorldAreaError(string? message)
    {
        _error = message;
        return InvokeAsync(StateHasChanged);
    }

    /// <summary>The channel's own signal that the transport itself has genuinely died (see the
    /// subscription in <see cref="ConnectAsync"/> for why nothing used to react to this at all).
    /// Runs the exact same cleanup a manual DISCONNECT already does, so a closed game actually
    /// shows as disconnected instead of the header/sidebar going on claiming "connected" forever
    /// while every background read silently fails and retries. <paramref name="state"/> only
    /// ever matters as Faulted here - Connecting/Connected/Disconnected are already handled by
    /// whichever caller drove that transition directly, not by this passive listener.</summary>
    private void OnChannelStateChanged(LiveConnectionState state)
    {
        if (state != LiveConnectionState.Faulted || _channel is null) return;
        _ = DisconnectAsync();
    }

    private async Task DisconnectAsync()
    {
        StopLiveRefreshLoop();
        CancelPendingAutoSave();
        UnsubscribeAllChangedEvents();
        // The sidebar slot editor is rendered globally and reads live objects that are about to
        // go away; clear any selection so it does not keep showing a now-dead live slot.
        if (Selection.Current?.PlayerArea is not null) Selection.Clear();
        _worldInfo = null;
        _worldIsMetadata = false;
        _vitals = null;
        _skills = null;
        _spawn = null;
        _companions = null;
        _npcs = null;
        _inventory = null;
        _story = null;
        _recipes = null;
        _codex = null;
        _general = null;
        _playerFacade.VitalsSession = null;
        _playerFacade.SkillsSession = null;
        _playerFacade.SpawnSession = null;
        _playerFacade.CompanionsSession = null;
        _playerFacade.InventorySession = null;
        _playerFacade.RecipesSession = null;
        _playerFacade.CodexSession = null;
        _playerFacade.GeneralSession = null;
        _playerActiveTab = "vitals";
        _worldTab = "containers";
        _surface = LiveSurface.Player;
        _connectingTabId = null;
        _flags = null;
        _doors = null;
        _containers = null;
        _dropped = null;
        _bases = null;
        _vehicles = null;
        _pets = null;
        _narrativeNpcs = null;
        _containment = null;
        _traders = null;
        _portals = null;
        _care.Clear();
        _careContainerFilter = null;
        _selectedPlayerId = null;
        if (_channel is not null)
        {
            _channel.StateChanged -= OnChannelStateChanged;
            await _channel.DisposeAsync();
        }
        _channel = null;
        _error = null;
        // DISCONNECT is a fresh start - back to "where's the game running", which lives in the
        // mode-select dialog, not rendered inline here.
        LiveSession.Disconnected();
        RedirectToModeSelect();
    }

    public async ValueTask DisposeAsync()
    {
        LiveSession.PlayerSwitchRequested -= HandlePlayerSwitchRequestedAsync;
        LiveSession.WorldSurfaceRequested -= HandleWorldSurfaceRequestedAsync;
        LiveSession.OfflinePlayerFileRequested -= HandleOfflinePlayerFileRequestedAsync;
        LiveSession.DisconnectRequested -= DisconnectAsync;
        StopLiveRefreshLoop();
        CancelPendingAutoSave();
        UnsubscribeAllChangedEvents();
        LiveSession.Disconnected();
        Selection.SetPaletteContext(null);
        if (_channel is not null)
        {
            _channel.StateChanged -= OnChannelStateChanged;
            await _channel.DisposeAsync();
        }
    }
}
