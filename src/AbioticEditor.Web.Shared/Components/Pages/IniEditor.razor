@page "/ini"
@page "/ini/{RequestedFileName}"
@implements IDisposable
@inject IniEditorSessionService IniSessions
@inject ItemCatalogService ItemCatalog
@inject SaveWorkspaceSessionService Workspace
@inject HostLanguageService Languages

<PageTitle>@Languages.Resource("Ini_EditorTitle") · @Languages.Resource("App_Title")</PageTitle>

@* Settings files are found by walking a folder path on the machine, which a browser tab cannot
   do - it only ever holds the handles the player granted. Without this the page rendered its
   pickers as normal, and FIND SETTINGS FILES failed on an empty path with "Settings files could
   not be checked", which reads like a broken editor rather than a thing browsers cannot do.
   Same gate, and the same wording, as the compare and create-world screens. *@
@if (!Workspace.HasLocalPaths)
{
    <section class="hero compact-hero">
        <p class="eyebrow">@Languages.Resource("Ini_WorkbenchEyebrow")</p>
        <h1>@Languages.Resource("Host_NeedsDesktopTitle")</h1>
        <p class="lede">@Languages.Resource("Host_NeedsDesktopBody")</p>
    </section>
}
else if (IniSessions.Current is { } document)
{
    <section class="ini-editor-panel">
        <header class="ini-editor-heading">
            <div><div class="ini-title-row"><h2>@document.FileName</h2><span class="ini-kind-badge">@document.KindLabel</span></div>
                <p class="muted">@Languages.Resource("IniUi_SaveHint")</p></div>
            <div class="editor-actions">
                <span class="ini-change-count" role="status">@Languages.Resource(document.IsDirty ? "IniUi_Changes" : "IniUi_NoChanges", ChangeCount(document))</span>
                <button class="secondary" type="button" disabled="@(!document.IsDirty)" @onclick="Revert">@Languages.Resource("Ini_Revert")</button>
                <button class="primary" type="button" disabled="@(!document.IsDirty)" @onclick="Save">@Languages.Resource("Ini_SaveIni")</button>
            </div>
        </header>
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
        @if (!document.IsDirty && document.StatusResourceKey is not null) { <p class="editor-status" role="status">@Languages.Resource(document.StatusResourceKey, document.FileName)</p> }
        <div class="ini-tools">
            <input class="ini-search" type="search" @bind="_filter" @bind:event="oninput" placeholder="@Languages.Resource("Editing_FindSetting")" aria-label="@Languages.Resource("Editing_FindSetting")" />
            <label><input type="checkbox" @bind="_advanced" /> @Languages.Resource("IniUi_Technical")</label>
        </div>
        @if (_advanced)
        {
            <div class="ini-file-details"><p class="path">@document.File.FullPath</p><p>@document.Description</p></div>
        }
        @if (document.File.Kind == AbioticIniKind.SandboxSettings)
        {
            <details class="ini-section">
                <summary @onclick="LoadSettings">Add a setting</summary>
                <p class="muted">Choose from your installed game. Changes apply after saving and reopening the world.</p>
                @if (_loadingSettings) { <p role="status">Loading game settings...</p> }
                else if (_settingsLoaded && _settings.Count == 0) { <p role="status">Set the game installation folder to discover supported settings.</p> }
                else if (_settingsLoaded)
                {
                    <label>Setting
                        <select @bind="_newSettingKey">
                            <option value="">Choose a setting</option>
                            @foreach (var setting in MissingSettings(document)) { <option value="@setting.Key">@setting.Label</option> }
                        </select>
                    </label>
                    @if (_settings.FirstOrDefault(s => s.Key == _newSettingKey) is { } chosen)
                    {
                        <p class="muted">Default: @chosen.DefaultValue</p>
                        <details><summary>What this changes</summary><p>@chosen.Description</p></details>
                        <button type="button" class="secondary" @onclick="() => AddKnownSetting(document, chosen)">Add setting</button>
                    }
                }
            </details>
        }
        @{ var visibleSections = document.Sections.Where(section => VisibleEntries(document, section).Any() || (_filter.Length == 0 && section.SuggestedNewKey is not null)).ToList(); }
        @if (visibleSections.Count == 0) { <p role="status">@Languages.Resource("Editing_NoSettingMatches")</p> }
        @foreach (var draft in visibleSections)
        {
            <section class="ini-section" @key="draft">
                <header><h3 title="@draft.Header">@(draft.Name.Length == 0 ? draft.Header : PlainNames.Words(draft.Name))</h3>
                    @if ((_advanced || document.File.Kind == AbioticIniKind.ServerAdmin) && draft.SuggestedNewKey is not null) { <button class="secondary" type="button" @onclick="() => Add(draft)">@Languages.Resource("Ini_Add")</button> }
                </header>
                @if (document.File.Kind == AbioticIniKind.SandboxSettings && !_advanced && draft.Entries.GroupBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase).Any(group => group.Count() > 1))
                { <p class="ini-section-hint">@Languages.Resource("IniUi_LastValues")</p> }
                @foreach (var entry in VisibleEntries(document, draft))
                {
                    <div class="ini-entry @(entry.IsDirty ? "is-changed" : null)" @key="entry">
                        <div class="ini-setting-name"><label for="@EntryId(entry)" title="@entry.Key">@(SettingDefinition(document, entry.Key)?.Label ?? SettingLabel(entry.Key))</label>
                            @if (_advanced) { <code>@entry.Key</code> }
                        </div>
                        @if (SettingDefinition(document, entry.Key) is { Options.Count: > 0 } definition)
                        {
                            <select id="@EntryId(entry)" @bind="entry.Value">
                                @if (!definition.Options.Any(o => o.Value == entry.Value)) { <option value="@entry.Value">@entry.Value (saved value)</option> }
                                @foreach (var option in definition.Options) { <option value="@option.Value">@option.Label</option> }
                            </select>
                        }
                        else if (bool.TryParse(entry.OriginalValue ?? SettingDefinition(document, entry.Key)?.DefaultValue, out _))
                        {
                            <select id="@EntryId(entry)" value="@entry.Value" @onchange="e => entry.Value = e.Value?.ToString() ?? entry.Value">
                                <option value="@BooleanText(entry, true)">@Languages.Resource("IniUi_On")</option>
                                <option value="@BooleanText(entry, false)">@Languages.Resource("IniUi_Off")</option>
                            </select>
                        }
                        else { <input id="@EntryId(entry)" @bind="entry.Value" @bind:event="oninput" spellcheck="false" /> }
                        <div class="ini-row-actions">
                            @if (entry.IsDirty && entry.OriginalValue is not null)
                            { <button class="secondary" type="button" aria-label="@Languages.Resource("IniUi_UndoSetting", SettingLabel(entry.Key))" @onclick="() => entry.Value = entry.OriginalValue">@Languages.Resource("IniUi_Undo")</button> }
                            @if (_advanced || document.File.Kind == AbioticIniKind.ServerAdmin) { <button class="secondary" type="button" aria-label="@Languages.Resource("Ini_RemoveAria", entry.Key)" @onclick="() => Remove(draft, entry)">×</button> }
                        </div>
                    </div>
                }
            </section>
        }
    </section>
}
else
{
    <section class="hero compact-hero">
        <p class="eyebrow">@Languages.Resource("Ini_WorkbenchEyebrow")</p>
        <h1>@Languages.Resource("Ini_EditorTitle")</h1>
        <p class="lede">@Languages.Resource("Ini_EditorDescription")</p>
        <div class="folder-open">
            <label for="ini-root">@Languages.Resource("Ini_FolderLabel")</label>
            <input id="ini-root" @bind="_path" @bind:event="oninput" placeholder="@Languages.Resource("Ini_FolderPlaceholder")" />
            <button class="primary" @onclick="Discover">@Languages.Resource("Ini_FindFiles")</button>
            @if (Workspace.Current is not null) { <button class="secondary" @onclick="UseOpenWorld">@Languages.Resource("Ini_UseOpenWorld")</button> }
        </div>
        @if (_error is not null) { <p class="error" role="alert">@_error</p> }
    </section>
    @if (_searched) { <section class="empty-state"><p class="eyebrow">@Languages.Resource("Ini_NoneEyebrow")</p><h2>@Languages.Resource("Ini_NoneTitle")</h2><p>@Languages.Resource("Ini_NoneDescription")</p></section> }
}

@code {
    [SupplyParameterFromQuery(Name = "root")]
    public string? RequestedRoot { get; set; }

    [SupplyParameterFromQuery(Name = "file")]
    public string? RequestedFile { get; set; }

    [Parameter]
    public string? RequestedFileName { get; set; }

    private IReadOnlyList<SandboxSettingDefinition> _settings = [];
    private bool _loadingSettings, _settingsLoaded;
    private string _newSettingKey = string.Empty;
    private async Task LoadSettings()
    {
        if (_settingsLoaded || _loadingSettings) return;
        _loadingSettings = true;
        try { _settings = await ItemCatalog.GetSandboxSettingsAsync(); _settingsLoaded = true; }
        finally { _loadingSettings = false; }
    }
    private SandboxSettingDefinition? SettingDefinition(IniDocumentSession document, string key)
        => document.File.Kind == AbioticIniKind.SandboxSettings ? _settings.FirstOrDefault(s => s.Key.Equals(key, StringComparison.OrdinalIgnoreCase)) : null;
    private IEnumerable<SandboxSettingDefinition> MissingSettings(IniDocumentSession document)
        => _settings.Where(s => !document.Sections.Where(section => section.Name.Equals("SandboxSettings", StringComparison.OrdinalIgnoreCase))
            .SelectMany(section => section.Entries).Any(e => e.Key.Equals(s.Key, StringComparison.OrdinalIgnoreCase)));
    private void AddKnownSetting(IniDocumentSession document, SandboxSettingDefinition setting)
    {
        document.AddSetting(setting);
        _newSettingKey = string.Empty;
        _filter = setting.Key;
    }
    private bool _advanced;
    private IniDocumentSession? _displayedDocument;
    private readonly Dictionary<IniEntryDraft, string> _entryIds = new();
    private string EntryId(IniEntryDraft entry)
    {
        if (!_entryIds.TryGetValue(entry, out var id)) _entryIds[entry] = id = $"ini-value-{Guid.NewGuid():N}";
        return id;
    }
    private static int ChangeCount(IniDocumentSession document) => document.Sections.Sum(section => section.Removed.Count + section.Entries.Count(entry => entry.IsDirty));
    private static string SettingLabel(string key)
    {
        if (key.Length > 1 && key[0] == 'b' && char.IsUpper(key[1])) key = key[1..];
        return string.Join(" / ", key.Split('.').Select(PlainNames.Words));
    }
    private static string BooleanText(IniEntryDraft entry, bool value)
    {
        var original = entry.OriginalValue ?? entry.Value;
        var text = value ? "True" : "False";
        return original == original.ToLowerInvariant() ? text.ToLowerInvariant()
            : original == original.ToUpperInvariant() ? text.ToUpperInvariant() : text;
    }
    private IEnumerable<IniEntryDraft> VisibleEntries(IniDocumentSession document, IniSectionDraft section)
    {
        IEnumerable<IniEntryDraft> entries = section.Entries;
        if (!_advanced && document.File.Kind == AbioticIniKind.SandboxSettings)
            entries = entries.GroupBy(entry => entry.Key, StringComparer.OrdinalIgnoreCase).Select(group => group.Last());
        var filter = _filter.Trim();
        return entries.Where(entry => section.Header.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || entry.Key.Contains(filter, StringComparison.OrdinalIgnoreCase)
            || SettingLabel(entry.Key).Contains(filter, StringComparison.OrdinalIgnoreCase));
    }
    private string _filter = string.Empty;
    private string _path = string.Empty;
    private bool _searched;
    private string? _error;

    protected override void OnInitialized() => IniSessions.Changed += SessionChanged;

    protected override void OnParametersSet()
    {
        var requestedRoot = RequestedRoot ?? Workspace.Current?.WorldFolder;
        if (string.IsNullOrWhiteSpace(requestedRoot)
            || (string.IsNullOrWhiteSpace(RequestedFile) && string.IsNullOrWhiteSpace(RequestedFileName)))
        {
            return;
        }

        _path = requestedRoot;
        _searched = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(RequestedFile))
            {
                if (!string.Equals(IniSessions.Current?.File.FullPath, Path.GetFullPath(RequestedFile), StringComparison.OrdinalIgnoreCase))
                    IniSessions.OpenDiscovered(requestedRoot, RequestedFile);
            }
            else if (!string.Equals(IniSessions.Current?.FileName, RequestedFileName, StringComparison.OrdinalIgnoreCase))
                IniSessions.OpenNamedDiscovered(requestedRoot, RequestedFileName!);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = Errors.Present(ex, Languages.Resource("Ini_OpenFailed"), Languages.Resource("Ini_OpenFailedHelp"));
        }
    }

    private void UseOpenWorld() { if (Workspace.Current is { } world) { _path = world.WorldFolder; Discover(); } }
    private void Discover() { try { IniSessions.Discover(_path); _searched = true; _error = null; } catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Ini_DiscoverFailed"), Languages.Resource("Ini_DiscoverFailedHelp")); } }
    private void Open(string path) { try { IniSessions.Open(path); _error = null; } catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Ini_OpenFailed"), Languages.Resource("Ini_OpenFailedHelp")); } }
    private void Add(IniSectionDraft section) { section.Add(); StateHasChanged(); }
    private void Remove(IniSectionDraft section, IniEntryDraft entry) { section.Remove(entry); StateHasChanged(); }
    private void Save() { try { IniSessions.Current?.Save(); } catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Ini_SaveFailed"), Languages.Resource("Ini_SaveFailedHelp")); } }
    private void Revert() { try { IniSessions.Current?.Revert(); } catch (Exception ex) { _error = Errors.Present(ex, Languages.Resource("Ini_ReloadFailed"), Languages.Resource("Ini_OpenFailedHelp")); } }
    private void SessionChanged()
    {
        if (!ReferenceEquals(_displayedDocument, IniSessions.Current))
        {
            _displayedDocument = IniSessions.Current;
            _filter = string.Empty;
            _entryIds.Clear();
        }
        _ = InvokeAsync(StateHasChanged);
    }
    public void Dispose() => IniSessions.Changed -= SessionChanged;
}
