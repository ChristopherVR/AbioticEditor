@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.World

@inject ItemCatalogService Catalog

@* Storage crates, lockers and cabinets currently loaded in the world. Pick one on the left, edit
   its slots on the right exactly like the live INVENTORY tab - each slot applies on its own. *@
<section class="editor-card" aria-label="@L.Resource("LiveContainers_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveContainers_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveContainers_NotHostWarning")</p>
    }
    <p class="muted">@L.Resource("LiveContainers_Intro", Session.Containers.Count)</p>

    <ItemPaletteDatalist />

    <div class="live-toolbar">
        <input aria-label="@L.Resource("WorldContainers_FilterPlaceholder")" @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("WorldContainers_FilterPlaceholder")" />
        <label class="checkbox-field"><input type="checkbox" @bind="_hideEmpty" /> @L.Resource("WorldContainers_HideEmpty")</label>
    </div>

    @if (Session.Containers.Count == 0)
    {
        <p class="muted">@L.Resource("LiveContainers_NoneFound")</p>
    }
    else
    {
        <div class="live-containers-split">
            <div class="shell-save-list live-containers-list" role="list">
                @foreach (var container in VisibleContainers)
                {
                    <div class="save-file-row kind-world @(container.Id == _selectedId ? "selected" : null)" role="listitem" @key="container.Id"
                         @onclick="() => Select(container.Id)">
                        <span class="save-kind-marker" aria-hidden="true"></span>
                        <span class="live-flag-texts">
                            <strong class="save-file-name">@DisplayName(container)</strong>
                            <small>@L.Resource("LiveContainers_Count", container.OccupiedCount, container.Slots.Count) · @Position(container)</small>
                        </span>
                    </div>
                }
            </div>
            <div class="live-containers-detail">
                @if (Selected is not { } selected)
                {
                    <p class="muted">@L.Resource("WorldContainers_SelectAContainer")</p>
                }
                else
                {
                    <h4 class="live-inventory-group">@DisplayName(selected)</h4>
                    <div class="shell-save-list">
                        @foreach (var draft in Drafts)
                        {
                            var entry = string.IsNullOrEmpty(draft.ItemId) || draft.ItemId == "Empty" ? null : Catalog.Find(draft.ItemId);
                            <div class="save-file-row kind-player" @key="draft.SlotIndex">
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@L.Resource("LiveInventory_Slot", draft.SlotIndex)@(entry is not null ? $" · {entry.DisplayName}" : null)</strong>
                                <div class="live-inventory-controls">
                                    <input list="shell-item-palette" @bind="draft.ItemId" placeholder="@L.Inventory("empty")" autocomplete="off" disabled="@(!Session.IsHost)" />
                                    <label class="live-inventory-field">@L.Inventory("count")<input type="number" min="0" @bind="draft.Stack" disabled="@(!Session.IsHost)" /></label>
                                    <label class="live-inventory-field">@L.Inventory("durability")<input type="number" min="0" step="any" @bind="draft.Durability" disabled="@(!Session.IsHost)" /></label>
                                    <label class="live-inventory-field">@L.Inventory("maxDurability")<input type="number" min="0" step="any" @bind="draft.MaxDurability" disabled="@(!Session.IsHost)" /></label>
                                    <button class="secondary" type="button" disabled="@(!Session.IsHost || _busy)" @onclick="() => ApplyAsync(selected.Id, draft)">@L.Resource("LiveInventory_Apply")</button>
                                    <button class="secondary" type="button" disabled="@(!Session.IsHost || _busy || draft.IsEmpty)" @onclick="() => ClearAsync(selected.Id, draft)">@L.Inventory("clear").ToUpperInvariant()</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveContainersSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private string _filter = string.Empty;
    private bool _hideEmpty;
    private string? _selectedId;
    private List<SlotDraft> _drafts = [];
    private LiveContainer? _draftedFrom;

    private LiveContainer? Selected => Session.Containers.FirstOrDefault(c => c.Id == _selectedId);

    private IEnumerable<LiveContainer> VisibleContainers
    {
        get
        {
            IEnumerable<LiveContainer> containers = Session.Containers;
            if (_hideEmpty) containers = containers.Where(c => c.OccupiedCount > 0);
            var filter = _filter.Trim();
            if (filter.Length > 0)
            {
                containers = containers.Where(c => DisplayName(c).Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || c.Slots.Any(s => !s.IsEmpty && s.ItemId.Contains(filter, StringComparison.OrdinalIgnoreCase)));
            }
            return containers;
        }
    }

    // Drafts are rebuilt only when the selected container's reading changes (a refresh after an
    // apply hands back a new LiveContainer instance), never on an unrelated re-render: doing it
    // on every render would wipe in-progress typing (the same reasoning LiveInventorySession
    // avoids by updating its slot objects in place on refresh instead of replacing them).
    private List<SlotDraft> Drafts
    {
        get
        {
            var selected = Selected;
            if (selected is null) return [];
            if (!ReferenceEquals(_draftedFrom, selected))
            {
                _draftedFrom = selected;
                _drafts = selected.Slots.Select(s => new SlotDraft(s)).ToList();
            }
            return _drafts;
        }
    }

    private static string DisplayName(LiveContainer container)
        => AbioticEditor.Web.Components.Shared.PlainNames.Thing(container.Label);

    private static string Position(LiveContainer container)
        => $"{container.X / 100:0}, {container.Y / 100:0}, {container.Z / 100:0} m";

    private void Select(string id) => _selectedId = id;

    private Task RefreshAsync() => RunAsync(() => Session.RefreshAsync());

    private Task ApplyAsync(string containerId, SlotDraft draft) => RunAsync(() => Session.ApplyAsync(containerId,
        new LiveContainerSlotEdit(draft.SlotIndex, ItemId: draft.ItemId, Stack: draft.Stack,
            Durability: draft.Durability, MaxDurability: draft.MaxDurability)));

    private Task ClearAsync(string containerId, SlotDraft draft) => RunAsync(() => Session.ApplyAsync(containerId,
        new LiveContainerSlotEdit(draft.SlotIndex, Clear: true)));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Edit this container.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class SlotDraft(LiveContainerSlot slot)
    {
        public int SlotIndex { get; } = slot.SlotIndex;
        public bool IsEmpty { get; } = slot.IsEmpty;
        public string ItemId { get; set; } = slot.IsEmpty ? string.Empty : slot.ItemId;
        public int Stack { get; set; } = slot.Stack;
        public double Durability { get; set; } = slot.Durability;
        public double MaxDurability { get; set; } = slot.MaxDurability;
    }
}
