    /// <summary>Progress from the viewer while it loads models ("models") or the level ("level").</summary>
    [JSInvokable]
    public Task OnModelProgress(string kind, int done, int total, string? note)
    {
        if (string.Equals(kind, "models", StringComparison.Ordinal))
        {
            _modelCounts = note == "error" ? (0, 0) : (done, total);
            _modelProgress = note == "error" ? L.Resource("World3D_ModelsError")
                : done >= total ? L.Resource("World3D_ModelsDone")
                : L.Resource("World3D_ModelsProgressFormat", done, total);
        }
        else if (string.Equals(kind, "textures", StringComparison.Ordinal))
        {
            _textureCounts = (done, total);
        }
        else
        {
            // For a finished level load, done is the piece count and total the files still being read.
            _levelBusy = note is "query" or "download" or "meshes" or "textures" || (note is null && total > 0);
            // The browser build downloading an area's level files (the slow part of a first look there).
            _levelFraction = note == "download" && total > 0 ? Math.Clamp((double)done / total, 0, 1) : null;
            _levelProgress = note switch
            {
                "query" => L.Resource("World3D_LevelQuerying"),
                "download" => L.Resource("World3D_LevelDownloadingFormat", done, total),
                "meshes" => L.Resource("World3D_LevelMeshesFormat", done, total),
                "textures" => L.Resource("World3D_LevelTextures"),
                "none" => L.Resource("World3D_LevelNone"),
                "error" => L.Resource("World3D_LevelError"),
                _ when total > 0 => L.Resource("World3D_LevelReadingFormat", done, total),
                _ => L.Resource("World3D_LevelShownFormat", done),
            };
            if (note is null && total == 0) _ = RunPlacementChecksAsync(); // the level is in: checks can see it
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

