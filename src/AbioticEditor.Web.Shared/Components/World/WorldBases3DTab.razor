    /// <summary>
    /// The gizmo drag ended. The viewer-space result is converted back to the save's space here
    /// (PlacedSceneSpace) and staged; only the member the chosen handle changes is staged, so a
    /// translate never rewrites the rotation and the other way round.
    /// </summary>
    [JSInvokable]
    public async Task OnGizmoCommitted(string key, string mode, double[] position, double[] rotation)
    {
        PlacedTransformStageResult result;
        if (string.Equals(mode, "translate", StringComparison.Ordinal))
        {
            var t = PlacedSceneSpace.FromViewer(new PlacedVector(position[0], position[1], position[2]));
            result = Session.StagePlacedTransform(key, t, null);
        }
        else
        {
            var r = PlacedSceneSpace.FromViewer(new PlacedQuaternion(rotation[0], rotation[1], rotation[2], rotation[3]));
            result = Session.StagePlacedTransform(key, null, r);
        }
        await AfterEditAsync(result);
    }

