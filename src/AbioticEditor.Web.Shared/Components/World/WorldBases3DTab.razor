@namespace AbioticEditor.Web.Components.World
@using System.Globalization
@using AbioticEditor.Web.Models
@using AbioticEditor.Core.WorldSaves
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject SaveWorkspaceSessionService Workspace
@inject GameArtService Art
@inject ItemCatalogService Catalog
@inject IServiceProvider Services
@inject GameClassFactsService ClassFacts
@implements IAsyncDisposable

@* Base-building roadmap phases 3 and 4 (UI half): a 3D view of one region's placed objects, and
   staged move/rotate for player-built pieces. This component owns state and the inspector; the
   drawing lives in wwwroot/base3d.js (Three.js, vendored, no CDN). Conversion between the save's
   left-handed Z-up centimetres and the viewer's right-handed Y-up metres is Core's
   PlacedSceneSpace, so JavaScript never converts and the maths is unit tested. *@
<section class="world-editor world-native-tab b3d @(_fullscreen ? "b3d-fullscreen" : null)" aria-label="@L.Resource("World3D_Title")" data-b3d="root" @ref="_root">
    @if (_webGlMissing)
    {
        <p class="error-text" role="alert" data-b3d="no-webgl">@L.Resource("World3D_NoWebGl")</p>
    }
    else
    {
    <div class="b3d-layout">
        <div class="b3d-stage">
            <div class="b3d-viewport" @ref="_viewport" @ondragover:preventDefault="true" @ondrop="DropOnViewAsync">
                <div @ref="_host" class="b3d-canvas" role="img" aria-label="@L.Resource("World3D_ViewLabel")" data-b3d="canvas"></div>

                @* The browser build asks before downloading its scenery (tens of megabytes an area). *@
                @if (_askScenery)
                {
                    <div class="b3d-scenery-ask" role="dialog" aria-labelledby="b3d-scenery-ask-title" data-b3d="scenery-ask">
                        <strong id="b3d-scenery-ask-title">@L.Resource("World3D_SceneryAskTitle")</strong>
                        <p>@L.Resource("World3D_SceneryAskBody")</p>
                        <div class="b3d-scenery-ask-actions">
                            <button type="button" class="wt-btn" data-b3d="scenery-yes" @onclick="AllowSceneryAsync">@L.Resource("World3D_SceneryAskYes")</button>
                            <button type="button" class="wt-btn wt-plain" data-b3d="scenery-no" @onclick="() => _askScenery = false">@L.Resource("World3D_SceneryAskNo")</button>
                        </div>
                    </div>
                }

                @* View controls float over the top of the view, so the view itself can take the height. *@
                <div class="b3d-hud b3d-hud-top" data-b3d="hud">
                    <button type="button" class="b3d-hud-btn @(_fullscreen ? "on" : null)" data-b3d="fullscreen" aria-pressed="@(_fullscreen ? "true" : "false")"
                            @onclick="ToggleFullscreen">@L.Resource(_fullscreen ? "World3D_FullscreenExit" : "World3D_Fullscreen")</button>
                    <button type="button" class="b3d-hud-btn" @onclick="FrameAllAsync">@L.Resource("World3D_FrameAll")</button>
                    <button type="button" class="b3d-hud-btn" disabled="@(_selected.Count == 0)" @onclick="FrameSelectionAsync">@L.Resource("World3D_FrameSelection")</button>
                    <button type="button" class="b3d-hud-btn @(_walkOn ? "on" : null)" aria-pressed="@(_walkOn ? "true" : "false")" data-b3d="walk-toggle"
                            @onclick="() => SetWalkAsync(!_walkOn)">@L.Resource(_walkOn ? "World3D_WalkStop" : "World3D_Walk")</button>
                    @if (_walkOn)
                    {
                        <label class="b3d-hud-check"><input type="checkbox" checked="@_walkFloor" data-b3d="walk-floor" @onchange="e => SetWalkFloorAsync(e.Value is true)" /> @L.Resource("World3D_WalkFloor")</label>
                    }
                    <button type="button" class="b3d-hud-btn b3d-hud-edit @(_moveOptIn ? "on" : null)" aria-pressed="@(_moveOptIn ? "true" : "false")" data-b3d="edit-quick"
                            @onclick="() => SetMoveOptInAsync(!_moveOptIn)">@L.Resource("World3D_MoveOptIn")</button>
                    @if (_moveOptIn)
                    {
                        <button type="button" class="b3d-hud-btn" data-b3d="place-open" @onclick="OpenPlaceAsync">@L.Resource("World3D_AddObject")</button>
                    }
                    @if (_basePreview is not null || Session.LastBaseEditRefusal.Count > 0)
                    {
                        <button type="button" class="b3d-hud-btn b3d-hud-changes @(_showStaged ? "on" : null)" aria-expanded="@(_showStaged ? "true" : "false")" data-b3d="staged-toggle"
                                @onclick="() => _showStaged = !_showStaged">@L.Resource("World3D_ChangesFormat", StagedCount)</button>
                    }
                    <span class="b3d-hud-sep" aria-hidden="true"></span>
                    @* What is drawn, folded into one menu so the view is not covered in checkboxes. *@
                    <div class="b3d-hud-menu">
                        <button type="button" class="b3d-hud-btn @(_showMenu ? "on" : null)" aria-expanded="@(_showMenu ? "true" : "false")" data-b3d="show-menu"
                                @onclick="() => _showMenu = !_showMenu">@L.Resource("World3D_ShowMenu") &#9662;</button>
                        @if (_showMenu)
                        {
                            <div class="b3d-hud-popover b3d-show-popover" data-b3d="show-popover">
                            <section class="b3d-menu-section">
                                <span class="b3d-menu-title">@L.Resource("World3D_ShowMenu")</span>
                            <label class="b3d-menu-check"><input type="checkbox" checked="@_labels" @onchange="e => SetLabelsAsync(e.Value is true)" /> @L.Resource("World3D_Labels")</label>
                            <label class="b3d-menu-check"><input type="checkbox" checked="@_doorsOn" data-b3d="doors-toggle" @onchange="e => SetDoorsVisibleAsync(e.Value is true)" /> @L.Resource("World3D_Doors")</label>
                            <label class="b3d-menu-check"><input type="checkbox" checked="@_npcsOn" data-b3d="npcs-toggle" @onchange="e => SetNpcsVisibleAsync(e.Value is true)" /> @L.Resource("World3D_Npcs")</label>
                            <label class="b3d-menu-check"><input type="checkbox" checked="@_itemsOn" data-b3d="items-toggle" @onchange="e => SetItemsVisibleAsync(e.Value is true)" /> @L.Resource("World3D_GroundItemsToggle")</label>
                            @if (!InBrowser)
                            {
                                <label class="b3d-menu-check"><input type="checkbox" checked="@_thingsOn" data-b3d="things-toggle" @onchange="e => SetThingsVisibleAsync(e.Value is true)" /> @L.Resource("World3D_ThingsToggle")</label>
                            }
                            @if (_modelStatus is { Available: true } && LevelRegion is not null)
                            {
                                <label class="b3d-menu-check"><input type="checkbox" checked="@_levelOn" data-b3d="level-quick" @onchange="e => SetLevelAsync(e.Value is true)" /> @L.Resource("World3D_LevelQuick")</label>
                            }
                            </section>
                            <section class="b3d-menu-section" data-b3d="filters-section">
                <div class="wt-card b3d-panel" data-b3d="filters">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_Filters")</span>
                    <label class="wt-check"><input type="checkbox" checked="@_filter.ShowPlayerBuilt" @onchange="e => SetFilter(_filter with { ShowPlayerBuilt = e.Value is true })" /> @L.Resource("World3D_PlayerBuilt")</label>
                    <label class="wt-check"><input type="checkbox" checked="@_filter.ShowLevelPlaced" @onchange="e => SetFilter(_filter with { ShowLevelPlaced = e.Value is true })" /> @L.Resource("World3D_LevelPlaced")</label>
                    <div class="b3d-cats">
                        @foreach (var category in PlacedObjectCategoryCatalog.All)
                        {
                            var c = category;
                            <label class="wt-check" @key="c">
                                <span class="b3d-swatch" style="background:@CategoryColor(c)"></span>
                                <input type="checkbox" checked="@(!_filter.HiddenCategories.Contains(c))" @onchange="e => ToggleCategory(c, e.Value is true)" />
                                @L.Resource("World3D_Category_" + c)
                            </label>
                        }
                    </div>
                    <span class="wt-label">@L.Resource("World3D_HeightBand")</span>
                    <div class="b3d-band">
                        <label>@L.Resource("World3D_HeightFrom")
                            <input type="number" class="wt-input" step="50" placeholder="@_scene.MinZCm.ToString("F0", CultureInfo.InvariantCulture)"
                                   value="@FormatOptional(_filter.MinZCm)" @onchange="e => SetBand(e.Value?.ToString(), true)" /></label>
                        <label>@L.Resource("World3D_HeightTo")
                            <input type="number" class="wt-input" step="50" placeholder="@_scene.MaxZCm.ToString("F0", CultureInfo.InvariantCulture)"
                                   value="@FormatOptional(_filter.MaxZCm)" @onchange="e => SetBand(e.Value?.ToString(), false)" /></label>
                    </div>
                    <button type="button" class="wt-btn wt-plain" @onclick="ResetFilters">@L.Resource("World3D_ResetFilters")</button>
                </div>
                            </section>
                            <section class="b3d-menu-section" data-b3d="display-section">
                @if (InBrowser && _modelStatus is not { Available: true })
                {
                    <div class="wt-card b3d-panel" data-b3d="models">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_ModelsTitle")</span>
                        @if (HostedScenery is not null && LevelRegion is not null)
                        {
                            <small class="wt-muted" data-b3d="models-offer">@L.Resource("World3D_SceneryOffer")</small>
                            <button type="button" class="wt-btn" data-b3d="scenery-start" @onclick="AllowSceneryAsync">@L.Resource("World3D_SceneryAskYes")</button>
                        }
                        else
                        {
                            <small class="wt-muted" data-b3d="models-browser">@L.Resource("World3D_ModelsBrowser")</small>
                        }
                    </div>
                }
                else if (_modelStatus is { } ms)
                {
                    <div class="wt-card b3d-panel" data-b3d="models">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_ModelsTitle")</span>
                        @if (!ms.Available)
                        {
                            <p class="wt-muted" data-b3d="models-nogame">@L.Resource("World3D_ModelsNoGame")</p>
                        }
                        else
                        {
                            @if (InBrowser)
                            {
                                @* The website's prepared scenery: the level only, placed objects stay boxes. *@
                                <small class="wt-muted" data-b3d="models-hosted">@L.Resource("World3D_ModelsBrowserScenery")</small>
                            }
                            else
                            {
                                <label class="wt-check">
                                    <input type="checkbox" checked="@_modelsOn" data-b3d="models-toggle" @onchange="e => SetModelsAsync(e.Value is true)" />
                                    @L.Resource("World3D_ModelsShow")
                                </label>
                            }
                            @if (!string.IsNullOrEmpty(ms.Plugin)) { <small class="wt-muted">@L.Resource("World3D_ModelsFromFormat", ms.Plugin)</small> }
                            @if (_modelsOn && _modelProgress is not null) { <small class="wt-muted" data-b3d="models-progress">@_modelProgress</small> }

                            @if (LevelRegion is null)
                            {
                                <small class="wt-muted">@L.Resource("World3D_LevelNoRegion")</small>
                            }
                            else
                            {
                                <label class="wt-check">
                                    <input type="checkbox" checked="@_levelOn" data-b3d="level-toggle" @onchange="e => SetLevelAsync(e.Value is true)" />
                                    @L.Resource("World3D_LevelShow")
                                </label>
                                @if (_levelOn)
                                {
                                    <div class="b3d-band">
                                        <label>@L.Resource("World3D_LevelRadius")
                                            <select class="wt-input" data-b3d="level-radius" @onchange="e => SetLevelRadiusAsync(e.Value?.ToString())">
                                                @foreach (var r in LevelRadii)
                                                {
                                                    <option value="@r" selected="@(r == _levelRadius)">@L.Resource("World3D_MetresFormat", r)</option>
                                                }
                                            </select>
                                        </label>
                                        <label>@L.Resource("World3D_LevelCut")
                                            <select class="wt-input" data-b3d="level-cut" @onchange="e => SetLevelCutAsync(e.Value?.ToString())">
                                                @foreach (var c in LevelCuts)
                                                {
                                                    <option value="@c" selected="@(c == _levelCut)">@(c == 0 ? L.Resource("World3D_LevelCutOff") : L.Resource("World3D_MetresFormat", c))</option>
                                                }
                                            </select>
                                        </label>
                                    </div>
                                    <label class="wt-check">
                                        <input type="checkbox" checked="@_lampsOn" data-b3d="lamps-toggle" @onchange="e => SetLampsAsync(e.Value is true)" />
                                        @L.Resource("World3D_LevelLamps")
                                    </label>
                                    <button type="button" class="wt-btn" data-b3d="level-reload" @onclick="ReloadLevelAsync">@L.Resource("World3D_LevelReload")</button>
                                    @if (_levelProgress is not null) { <small class="wt-muted" data-b3d="level-progress">@_levelProgress</small> }
                                    <small class="wt-muted">@L.Resource("World3D_LevelHint")</small>
                                }
                            }
                            @if (InBrowser)
                            {
                                <button type="button" class="wt-btn wt-plain" data-b3d="scenery-stop" @onclick="StopSceneryAsync">@L.Resource("World3D_SceneryStop")</button>
                            }
                        }
                    </div>
                }
                            </section>
                            </div>
                        }
                    </div>
                    <div class="b3d-hud-menu b3d-hud-menu-end">
                        <button type="button" class="b3d-hud-btn @(_help ? "on" : null)" aria-expanded="@(_help ? "true" : "false")" data-b3d="help"
                                title="@L.Resource("World3D_HelpTitle")" @onclick="() => _help = !_help">?</button>
                        @if (_help)
                        {
                            <div class="b3d-hud-popover b3d-hud-help" data-b3d="help-card">
                                <strong>@L.Resource("World3D_HelpTitle")</strong>
                                <dl>
                                    <dt>@L.Resource("World3D_HelpDragKey")</dt><dd>@L.Resource("World3D_HelpDrag")</dd>
                                    <dt>@L.Resource("World3D_HelpRightDragKey")</dt><dd>@L.Resource("World3D_HelpRightDrag")</dd>
                                    <dt>@L.Resource("World3D_HelpScrollKey")</dt><dd>@L.Resource("World3D_HelpScroll")</dd>
                                    <dt>@L.Resource("World3D_HelpDoubleKey")</dt><dd>@L.Resource("World3D_HelpDouble")</dd>
                                    <dt>W A S D</dt><dd>@L.Resource("World3D_HelpMove")</dd>
                                    <dt>Q / E</dt><dd>@L.Resource("World3D_HelpUpDown")</dd>
                                    <dt>Shift</dt><dd>@L.Resource("World3D_HelpFaster")</dd>
                                    <dt>@L.Resource("World3D_Walk")</dt><dd>@L.Resource("World3D_HelpWalk")</dd>
                                    <dt>@L.Resource("World3D_MoveOptIn")</dt><dd>@L.Resource("World3D_DragHint")</dd>
                                    <dt>R / Shift+R</dt><dd>@L.Resource("World3D_HelpRotateKey")</dd>
                                    <dt>Delete</dt><dd>@L.Resource("World3D_HelpDeleteKey")</dd>
                                    <dt>Ctrl+D</dt><dd>@L.Resource("World3D_HelpCopyKey")</dd>
                                    <dt>Esc</dt><dd>@L.Resource("World3D_HelpEscape")</dd>
                                </dl>
                            </div>
                        }
                    </div>
                    <span class="b3d-hud-count" data-b3d="count">@L.Resource("World3D_ShowingFormat", _visible.Length, _scene.Objects.Count)</span>
                </div>

                @* What the view is still loading, shown on the view itself: models and textures swap in as they arrive. *@
                @if (LoadingLines() is { Count: > 0 } loading)
                {
                    <div class="b3d-hud b3d-hud-status" role="status" aria-live="polite" data-b3d="loading">
                        <span class="b3d-spinner" aria-hidden="true"></span>
                        <div class="b3d-status-lines">
                            @foreach (var line in loading)
                            {
                                <span>@line.Text</span>
                                @if (line.Fraction is { } f) { <span class="b3d-progress"><span style="width:@((f * 100).ToString("F0", CultureInfo.InvariantCulture))%"></span></span> }
                            }
                        </div>
                    </div>
                }
                @if (_curtain)
                {
                    <div class="b3d-curtain" role="status" aria-live="polite" data-b3d="curtain">
                        <span class="b3d-spinner" aria-hidden="true"></span>
                        <span>@L.Resource("World3D_GettingReady")</span>
                        @foreach (var line in LoadingLines()) { <small>@line.Text</small> }
                    </div>
                }
                @if (_walkOn) { <p class="b3d-hud b3d-hud-walk" data-b3d="walk-hint">@L.Resource("World3D_WalkHint")</p> }
                @if (_locateNote is not null) { <p class="b3d-hud b3d-hud-locate" role="status" data-b3d="locate-note">@_locateNote</p> }
            </div>
            <p class="wt-muted b3d-hint">@L.Resource(_modelsOn ? "World3D_HintModels" : "World3D_HintBoxes") @L.Resource("World3D_MultiSelectHint")</p>
            @if (_doorsNote is not null) { <p class="wt-muted b3d-hint" data-b3d="doors-note">@_doorsNote</p> }

        </div>

        <aside class="b3d-side @(SelectedObject is not null || _pickedMarker is not null ? "picked" : null)">
            @* What you picked is always shown at the top (clicking never switches tabs); the
               place, remove and copy panels open here too. The lists sit in tabs below. *@
            <div class="b3d-inspect" data-b3d="inspect-pane">
                @* The changes waiting for SAVE, only when asked for (the button on the view). *@
                @if (_showStaged)
                {
                @if (Session.LastBaseEditRefusal.Count > 0)
                {
                    <div class="wt-card b3d-panel b3d-refusal" role="alert" data-b3d="save-refused">
                        <span class="wt-label">@L.Resource("World3D_SaveRefusedTitle")</span>
                        <p>@L.Resource("World3D_SaveRefusedIntro")</p>
                        @IssueList(Session.LastBaseEditRefusal, "save-refused-issues")
                    </div>
                }

                @if (_basePreview is { } bp)
                {
                    <div class="wt-card b3d-panel b3d-staged" data-b3d="staged">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_Staged")</span>
                        <p class="wt-muted b3d-warning" data-b3d="staged-unverified">@L.Resource("World3D_EditUnverified")</p>
                        <p class="wt-muted" data-b3d="staged-summary">@L.Resource("World3D_StagedSummaryFormat", bp.Transforms.Count, bp.Deletions.Count, bp.Duplications.Count, bp.ObjectsBefore, bp.ObjectsAfter, bp.ItemsDeleted, bp.ItemsCopied, bp.ReferencesAffected)</p>

                        @if (_preview.Count > 0)
                        {
                            <span class="wt-label">@L.Resource("World3D_StagedMoves")</span>
                            <div class="b3d-table-wrap">
                                <table class="b3d-table" data-b3d="staged-moves">
                                    <thead>
                                        <tr>
                                            <th>@L.Resource("World3D_ColObject")</th>
                                            <th>@L.Resource("World3D_ColBefore")</th>
                                            <th>@L.Resource("World3D_ColAfter")</th>
                                            <th>@L.Resource("World3D_ColMoved")</th>
                                            <th>@L.Resource("World3D_ColTurned")</th>
                                            <th>@L.Resource("World3D_ColWarnings")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (row, rowKey) in RenderKeys.With(_preview, r => r.Key))
                                        {
                                            <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)">
                                                <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.Key, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                                <td class="b3d-mono">@Describe(row.Before)</td>
                                                <td class="b3d-mono">@Describe(row.After)</td>
                                                <td class="b3d-mono">@(row.DistanceCm is { } d ? Num(d) : "-")</td>
                                                <td class="b3d-mono">@(row.YawDeltaDegrees is { } y ? Num(y) : "-")</td>
                                                <td class="b3d-notes">@string.Join(" ", row.Warnings)</td>
                                                <td><button type="button" class="wt-btn wt-plain" @onclick="() => RevertObjectAsync(row.Key)">@L.Resource("World3D_RevertObject")</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (bp.Deletions.Count > 0)
                        {
                            <span class="wt-label">@L.Resource("World3D_StagedDeletions")</span>
                            <div class="b3d-table-wrap">
                                <table class="b3d-table b3d-table-delete" data-b3d="staged-deletions">
                                    <thead>
                                        <tr>
                                            <th>@L.Resource("World3D_ColObject")</th>
                                            <th>@L.Resource("World3D_ColItems")</th>
                                            <th>@L.Resource("World3D_ColLinks")</th>
                                            <th>@L.Resource("World3D_ColWarnings")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (row, rowKey) in RenderKeys.With(bp.Deletions, r => r.Key))
                                        {
                                            <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)" data-b3d="staged-delete-row">
                                                <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.Key, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                                <td class="b3d-mono">@row.Contents.Sum(c => Math.Max(c.Count, 1))</td>
                                                <td class="b3d-mono">@(row.OwnedSocketIds.Count + row.InboundLinks.Count)</td>
                                                <td class="b3d-notes">@string.Join(" ", row.Issues.Select(i => i.Message))</td>
                                                <td><button type="button" class="wt-btn wt-plain" data-b3d="revert-deletion" @onclick="() => RevertDeletionAsync(row.Key)">@L.Resource("World3D_RevertObject")</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (bp.Duplications.Count > 0)
                        {
                            <span class="wt-label">@L.Resource("World3D_StagedCopies")</span>
                            <div class="b3d-table-wrap">
                                <table class="b3d-table b3d-table-copy" data-b3d="staged-copies">
                                    <thead>
                                        <tr>
                                            <th>@L.Resource("World3D_ColObject")</th>
                                            <th>@L.Resource("World3D_ColCopiedTo")</th>
                                            <th>@L.Resource("World3D_ColItems")</th>
                                            <th>@L.Resource("World3D_ColLinks")</th>
                                            <th>@L.Resource("World3D_ColWarnings")</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var (row, rowKey) in RenderKeys.With(bp.Duplications, r => r.NewKey))
                                        {
                                            <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)" data-b3d="staged-copy-row">
                                                <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.NewKey, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                                <td class="b3d-mono">@Describe(row.After)</td>
                                                <td class="b3d-mono">@(row.Contents == ContentsMode.Copy ? row.SourceContents.Sum(c => Math.Max(c.Count, 1)) : 0)</td>
                                                <td class="b3d-mono">@row.Sockets.Count</td>
                                                <td class="b3d-notes">@string.Join(" ", row.Issues.Select(i => i.Message))</td>
                                                <td><button type="button" class="wt-btn wt-plain" data-b3d="revert-duplication" @onclick="() => RevertDuplicationAsync(row.DuplicationId)">@L.Resource("World3D_RevertCopy")</button></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <span class="wt-label">@L.Resource("World3D_Issues")</span>
                        @IssueList(bp.Issues, "staged-issues")
                        @HintList(bp.ProximityHints)
                        <div class="b3d-links">
                            <button type="button" class="wt-btn" data-b3d="revert-all" @onclick="RevertAllAsync">@L.Resource("World3D_RevertAll")</button>
                        </div>
                    </div>
                }
                }
                @if (_moveOptIn) { <p class="wt-muted b3d-edit-note" data-b3d="move-warning">@L.Resource("World3D_MoveWarning")</p> }

                @if (_moveOptIn && _placeOpen)
                {
                    var kinds = PlaceKinds;
                    <div class="wt-card b3d-panel b3d-op" data-b3d="place-panel">
                        <div class="b3d-panel-head">
                            <span class="wt-label accent-orange-text">@L.Resource("World3D_PlaceTitle")</span>
                            <button type="button" class="b3d-close" aria-label="@L.Resource("World3D_Cancel")" data-b3d="place-close" @onclick="ClosePlace">&#x2715;</button>
                        </div>
                        <p class="wt-muted b3d-palette-hint">@L.Resource("World3D_PaletteHint")</p>
                        <input type="search" class="wt-input" data-b3d="palette-search" placeholder="@L.Resource("World3D_PaletteSearch")"
                               value="@_paletteQuery" @oninput="e => _paletteQuery = e.Value?.ToString() ?? string.Empty" />
                        @{ var palette = PaletteItems(); }
                        @if (palette.Count == 0)
                        {
                            <p class="wt-muted" data-b3d="place-none">@L.Resource(Session.OtherWorldsLoaded ? "World3D_PlaceNoKindsAnywhere" : "World3D_PlaceNoKinds")</p>
                        }
                        <div class="b3d-palette" data-b3d="palette">
                            @foreach (var (item, itemKey) in RenderKeys.With(palette, i => i.Value))
                            {
                                var it = item;
                                <button type="button" class="b3d-palette-item @(string.Equals(it.Value, _placeClass, StringComparison.Ordinal) ? "selected" : null)" @key="itemKey"
                                        draggable="true" data-b3d="palette-item" title="@it.Label"
                                        @ondragstart="() => _dragValue = it.Value" @ondragend="() => _dragValue = null"
                                        @onclick="() => PlaceFromPaletteAsync(it.Value)">
                                    <span class="b3d-palette-art">
                                        @if (WorldThumbnails.ForPlaced(it.ClassName) is { } art) { <img src="@art" alt="" loading="lazy" draggable="false" /> }
                                        else { <span class="material-symbol" aria-hidden="true">deployed_code</span> }
                                    </span>
                                    <span class="b3d-palette-name">@it.Label</span>
                                    <small>@it.Subtitle</small>
                                </button>
                            }
                        </div>
                        @if (!Session.OtherWorldsLoaded)
                        {
                            <button type="button" class="wt-btn wt-plain" data-b3d="place-other-worlds" disabled="@_placeScanning" @onclick="LoadOtherWorldsAsync">@L.Resource(_placeScanning ? "World3D_PlaceScanningOtherWorlds" : "World3D_PlaceShowOtherWorlds")</button>
                        }
                        <label class="wt-check">
                            <input type="checkbox" checked="@_placeOnFloor" data-b3d="place-on-floor" @onchange="e => _placeOnFloor = e.Value is true" />
                            @L.Resource("World3D_PlaceOnFloor")
                        </label>
                        @* Exact numbers, for those who want them; most just drag a piece onto the view. *@
                        <details class="b3d-details">
                            <summary>@L.Resource("World3D_PlaceExact")</summary>
                            <div class="b3d-numbers">
                                <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" @bind="_placeX" @bind:event="oninput" data-b3d="place-x" /></label>
                                <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" @bind="_placeY" @bind:event="oninput" data-b3d="place-y" /></label>
                                <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" @bind="_placeZ" @bind:event="oninput" data-b3d="place-z" /></label>
                                <label>@L.Resource("World3D_PlaceTurn")<input class="wt-input" inputmode="decimal" @bind="_placeYaw" @bind:event="oninput" data-b3d="place-yaw" /></label>
                            </div>
                            <div class="b3d-links">
                                <button type="button" class="wt-btn wt-plain" data-b3d="place-here" @onclick="UseViewCentreAsync">@L.Resource("World3D_PlaceUseView")</button>
                                <button type="button" class="wt-btn" data-b3d="place-confirm" disabled="@(_placeClass is null)" @onclick="ConfirmPlaceAsync">@L.Resource("World3D_PlaceConfirm")</button>
                            </div>
                        </details>
                        @if (_placeLastId is not null)
                        {
                            <p class="wt-muted" data-b3d="place-done">@L.Resource("World3D_PlaceDone")</p>
                            @if (_placeLastKey is { } placedKey) { @PlacementWarnings(placedKey) }
                            @IssueList(LastPlaceIssues, "place-issues")
                        }
                        @if (_placeError is not null) { <p class="error-text" role="alert" data-b3d="place-error">@_placeError</p> }
                    </div>
                }

                @if (_moveOptIn && _deleteOpen)
                {
                    <div class="wt-card b3d-panel b3d-op b3d-op-delete" data-b3d="delete-panel">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_DeleteTitleFormat", _deleteKeys.Count)</span>
                        <p class="error-text b3d-warning" role="alert" data-b3d="delete-unverified">@L.Resource("World3D_EditUnverified")</p>
                        @if (_deleteBusy)
                        {
                            <p class="wt-muted" data-b3d="delete-scanning">@L.Resource("World3D_ScanningOtherSaves")</p>
                        }
                        else if (_deletePreview is { } dp)
                        {
                            var rows = dp.Deletions.Where(r => _deleteKeys.Contains(r.Key)).ToList();
                            var itemGroups = rows.SelectMany(r => r.Contents).GroupBy(c => c.ItemId).Select(g => (Item: g.Key, Count: g.Sum(c => Math.Max(c.Count, 1)))).OrderByDescending(g => g.Count).ToList();
                            var linkCount = rows.Sum(r => r.OwnedSocketIds.Count + r.InboundLinks.Count);
                            <dl class="b3d-fields" data-b3d="delete-summary">
                                <dt>@L.Resource("World3D_DeleteObjectsRemoved")</dt><dd data-b3d="delete-objects">@rows.Count</dd>
                                <dt>@L.Resource("World3D_DeleteItemsDeleted")</dt><dd data-b3d="delete-items">@itemGroups.Sum(g => g.Count)</dd>
                                <dt>@L.Resource("World3D_DeleteReferences")</dt><dd data-b3d="delete-refs">@linkCount</dd>
                            </dl>
                            <small class="wt-muted" data-b3d="delete-scope" title="@string.Join(", ", Session.OtherSaveNames)">@(Session.OtherSaveNames.Count > 0
                                ? L.Resource("World3D_ScopeOtherSavesFormat", Session.OtherSaveNames.Count)
                                : L.Resource("World3D_ScopeThisSaveOnly"))@(Session.OtherSaveFailures.Count > 0 ? " " + L.Resource("World3D_ScopeUnreadableFormat", string.Join(", ", Session.OtherSaveFailures)) : "")</small>
                            @if (itemGroups.Count > 0)
                            {
                                <span class="wt-label">@L.Resource("World3D_DeleteItemList")</span>
                                <ul class="b3d-list" data-b3d="delete-item-list">
                                    @foreach (var g in itemGroups.Take(40)) { <li>@g.Item x @g.Count</li> }
                                    @if (itemGroups.Count > 40) { <li class="wt-muted">@L.Resource("World3D_SelectionMoreFormat", itemGroups.Count - 40)</li> }
                                </ul>
                            }
                            @if (linkCount > 0 || rows.Any(r => r.Bindings.Count > 0))
                            {
                                <span class="wt-label">@L.Resource("World3D_DeleteReferenceList")</span>
                                <ul class="b3d-list" data-b3d="delete-ref-list">
                                    @foreach (var r in rows.Take(40))
                                    {
                                        @if (r.OwnedSocketIds.Count > 0) { <li>@Base3DScene.FriendlyClass(r.ClassName): @L.Resource("World3D_RefOwnedFormat", r.OwnedSocketIds.Count)</li> }
                                        @foreach (var link in r.InboundLinks.Take(6)) { <li>@Base3DScene.FriendlyClass(r.ClassName): @L.Resource("World3D_RefInboundFormat", link.SourceSave, link.SourceEntryKey)</li> }
                                        @foreach (var b in r.Bindings) { <li>@Base3DScene.FriendlyClass(r.ClassName): @b.Kind (@b.Detail)</li> }
                                    }
                                </ul>
                            }
                            @if (rows.Any(r => r.Actions.Count > 0))
                            {
                                <span class="wt-label">@L.Resource("World3D_DeleteActions")</span>
                                <ul class="b3d-list">
                                    @foreach (var a in rows.SelectMany(r => r.Actions).GroupBy(a => a).Take(12)) { <li>@a.Key@(a.Count() > 1 ? $" (x{a.Count()})" : "")</li> }
                                </ul>
                            }
                            <span class="wt-label">@L.Resource("World3D_Issues")</span>
                            @IssueList(IssuesFor(dp.Issues, _deleteKeys, includeGeneral: false), "delete-issues")

                            <span class="wt-label">@L.Resource("World3D_PolicyTitle")</span>
                            <div class="b3d-policies" data-b3d="delete-policies">
                                @foreach (var row in DeletePolicyRows())
                                {
                                    <label class="b3d-policy" @key="row.LabelKey">
                                        <span>@L.Resource(row.LabelKey)</span>
                                        <select class="wt-input" data-b3d="@row.Id" @onchange="e => row.Set(ParsePolicy(e.Value?.ToString()))">
                                            @foreach (var option in row.Allowed)
                                            {
                                                <option value="@option" selected="@(option == row.Current)">@L.Resource("World3D_Policy_" + option)</option>
                                            }
                                        </select>
                                        <small class="wt-muted">@L.Resource(row.HelpKey)</small>
                                    </label>
                                }
                            </div>
                            @if (!dp.CanApply) { <p class="error-text" role="alert" data-b3d="delete-blocked">@L.Resource("World3D_CannotStage")</p> }
                        }
                        else
                        {
                            <p class="wt-muted">@L.Resource("World3D_NothingToEdit")</p>
                        }
                        <div class="b3d-links">
                            <button type="button" class="wt-btn b3d-danger" data-b3d="delete-confirm" disabled="@(_deleteBusy || _deletePreview is null || !_deletePreview.CanApply || _deleteKeys.Count == 0)"
                                    @onclick="ConfirmDeleteAsync">@L.Resource("World3D_StageDelete")</button>
                            <button type="button" class="wt-btn wt-plain" data-b3d="delete-cancel" @onclick="CloseOperationPanels">@L.Resource("World3D_Cancel")</button>
                        </div>
                    </div>
                }

                @if (_moveOptIn && _dupOpen)
                {
                    <div class="wt-card b3d-panel b3d-op b3d-op-duplicate" data-b3d="duplicate-panel">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_DuplicateTitleFormat", _dupKeys.Count)</span>
                        <p class="error-text b3d-warning" role="alert" data-b3d="duplicate-unverified">@L.Resource("World3D_EditUnverified")</p>
                        <span class="wt-label">@L.Resource("World3D_DupOffset")</span>
                        <div class="b3d-numbers b3d-numbers3">
                            <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" value="@_dupX" data-b3d="dup-x" @onchange="OnDupXChanged" /></label>
                            <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" value="@_dupY" data-b3d="dup-y" @onchange="OnDupYChanged" /></label>
                            <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" value="@_dupZ" data-b3d="dup-z" @onchange="OnDupZChanged" /></label>
                        </div>
                        <div class="b3d-numbers">
                            <label>@L.Resource("World3D_GroupYawDegrees")<input class="wt-input" inputmode="decimal" value="@_dupYaw" data-b3d="dup-yaw" @onchange="OnDupYawChanged" /></label>
                            <label>@L.Resource("World3D_Pivot")
                                <select class="wt-input" data-b3d="dup-pivot" @onchange="OnDupPivotChanged">
                                    <option value="@PivotCentroid" selected="@(_dupPivot == PivotCentroid)">@L.Resource("World3D_PivotCentroid")</option>
                                    @foreach (var pk in _dupKeys.Take(60))
                                    {
                                        <option value="@pk" selected="@(_dupPivot == pk)">@SelectionLabel(pk)</option>
                                    }
                                </select></label>
                        </div>
                        @if (_dupError is not null) { <p class="error-text" role="alert">@_dupError</p> }
                        <span class="wt-label">@L.Resource("World3D_PolicyTitle")</span>
                        <label class="wt-check">
                            <input type="checkbox" data-b3d="dup-contents" checked="@_dupCopyContents" @onchange="OnDupContentsChanged" />
                            @L.Resource("World3D_DupCopyContents")
                        </label>
                        @if (_dupCopyContents) { <p class="error-text b3d-warning" role="alert" data-b3d="dup-contents-warning">@L.Resource("World3D_DupContentsWarning")</p> }
                        <div class="b3d-policies" data-b3d="duplicate-policies">
                            @foreach (var row in DuplicatePolicyRows())
                            {
                                <label class="b3d-policy" @key="row.LabelKey">
                                    <span>@L.Resource(row.LabelKey)</span>
                                    <select class="wt-input" data-b3d="@row.Id" @onchange="e => row.Set(ParsePolicy(e.Value?.ToString()))">
                                        @foreach (var option in row.Allowed)
                                        {
                                            <option value="@option" selected="@(option == row.Current)">@L.Resource("World3D_Policy_" + option)</option>
                                        }
                                    </select>
                                    <small class="wt-muted">@L.Resource(row.HelpKey)</small>
                                </label>
                            }
                        </div>
                        @if (_dupPreview is { } up)
                        {
                            var rows = up.Duplications.Where(r => r.DuplicationId == _dupPreviewId).ToList();
                            <dl class="b3d-fields" data-b3d="duplicate-summary">
                                <dt>@L.Resource("World3D_DupObjectsCreated")</dt><dd data-b3d="dup-objects">@rows.Count</dd>
                                <dt>@L.Resource("World3D_DupItemsCopied")</dt><dd data-b3d="dup-items">@rows.Where(r => r.Contents == ContentsMode.Copy).Sum(r => r.SourceContents.Sum(c => Math.Max(c.Count, 1)))</dd>
                                <dt>@L.Resource("World3D_DupOutlets")</dt><dd>@rows.Sum(r => r.Sockets.Count)</dd>
                            </dl>
                            <span class="wt-label">@L.Resource("World3D_Issues")</span>
                            @IssueList(IssuesFor(up.Issues, _dupKeys, includeGeneral: true), "duplicate-issues")
                            @HintList(up.ProximityHints)
                            @if (!up.CanApply) { <p class="error-text" role="alert" data-b3d="duplicate-blocked">@L.Resource("World3D_CannotStage")</p> }
                        }
                        <div class="b3d-links">
                            <button type="button" class="wt-btn" data-b3d="duplicate-confirm" disabled="@(_dupPreview is null || !_dupPreview.CanApply || _dupKeys.Count == 0 || _dupError is not null)"
                                    @onclick="ConfirmDuplicateAsync">@L.Resource("World3D_StageDuplicate")</button>
                            <button type="button" class="wt-btn wt-plain" data-b3d="duplicate-cancel" @onclick="CloseOperationPanels">@L.Resource("World3D_Cancel")</button>
                        </div>
                    </div>
                }
                @if (_levelPicked is not null)
                {
                    <div class="wt-card b3d-panel" data-b3d="level-card">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_LevelCard")</span>
                        @* The thing the piece belongs to (a calculator to salvage, a lamp), by its own name and
                           picture when the level says which actor it is; the mesh name stays in Details. *@
                        <div class="b3d-title-row">
                            @if (LevelActorPicture() is { } levelPicture) { <img class="b3d-title-art" src="@levelPicture" alt="" data-zoom /> }
                            <strong class="b3d-title" data-b3d="level-picked">@(LevelActorLabel() ?? _levelPicked)</strong>
                        </div>
                        <p class="wt-muted">@L.Resource(_levelPickedActor is null ? "World3D_LevelCardHelp" : "World3D_LevelActorHelp")</p>
                        @if (_levelPickedActor is not null)
                        {
                            <details class="b3d-details"><summary>@L.Resource("World3D_Details")</summary><span class="b3d-mono">@_levelPicked · @_levelPickedActor</span></details>
                        }
                        <div class="b3d-links">
                            <button type="button" class="wt-btn wt-plain" @onclick="() => OnLevelPicked(null)">@L.Resource("World3D_DoorCardClose")</button>
                        </div>
                    </div>
                }
                @if (PickedItem is { } groundItem)
                {
                    <div class="wt-card b3d-panel" data-b3d="item-card">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_ItemCard")</span>
                        <strong class="b3d-title" data-b3d="item-title">@ItemName(groundItem)</strong>
                        <dl class="b3d-fields">
                            <dt>@L.Resource("World3D_ItemCount")</dt><dd>@Math.Max(1, groundItem.Slot.Count)</dd>
                            <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Num(groundItem.X), @Num(groundItem.Y), @Num(groundItem.Z)</dd>
                        </dl>
                        <div class="b3d-links">
                            @if (OnOpenTab.HasDelegate)
                            {
                                <button type="button" class="wt-btn" data-b3d="item-open-tab" @onclick="@(() => OnOpenTab.InvokeAsync("dropped"))">@L.Resource("World3D_OpenGroundItems")</button>
                            }
                            <button type="button" class="wt-btn wt-plain" @onclick="CloseMarkerCardAsync">@L.Resource("World3D_DoorCardClose")</button>
                        </div>
                    </div>
                }
                else if (PickedThing is { } thing)
                {
                    <div class="wt-card b3d-panel" data-b3d="thing-card">
                        <span class="wt-label accent-orange-text">@thing.FeatureName</span>
                        <div class="b3d-title-row">
                            @if (ThingPicture(thing) is { } thingPicture) { <img class="b3d-title-art" src="@thingPicture" alt="" data-zoom /> }
                            else if (thing.FeatureId == "npc-spawns" && Catalog.SpawnedCreature(thing.Key) is { } creature)
                            {
                                <span class="b3d-title-art">
                                    <GameArtImage GameRefs="@AbioticEditor.Core.WorldSaves.PetCatalog.CompendiumTextureRefs(creature.Class)"
                                                  WikiFiles="@AbioticEditor.Core.Codex.CreatureWikiImages.CandidatesFor(creature.Name)"
                                                  Alt="@creature.Name" />
                                </span>
                            }
                            <strong class="b3d-title" data-b3d="thing-title" title="@thing.Key">@thing.Label</strong>
                        </div>
                        @* Its settings, changed right here (the same as in its list's tab). *@
                        <FeatureEntryEditor Session="Session" FeatureId="@thing.FeatureId" EntryKey="@thing.Key" OnChanged="ThingChangedAsync" />
                        <details class="b3d-details">
                            <summary>@L.Resource("World3D_Details")</summary>
                            <dl class="b3d-fields">
                                <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Num(thing.At.X), @Num(thing.At.Y), @Num(thing.At.Z)</dd>
                                <dt>@L.Resource("World3D_Key")</dt><dd class="b3d-mono">@thing.Key</dd>
                            </dl>
                        </details>
                        @* A wall socket built into the level: plug a device into it right here (in its own area's save). *@
                        @if (thing.FeatureId == "power-sockets" && OtherAreaOf(thing) is { } otherArea)
                        {
                            <p class="wt-muted" data-b3d="other-area">@L.Resource("World3D_OtherAreaFormat", otherArea.Replace('_', ' '))</p>
                            <ShowIn3DButton Target="@(new WorldLocateTarget(WorldLocateKind.LevelActor, thing.Key, thing.Label) { SaveFileName = $"WorldSave_{otherArea}.sav", LevelName = otherArea })" />
                        }
                        else if (thing.FeatureId == "power-sockets")
                        {
                            <PowerRewirePanel Session="Session" SocketKey="@thing.Key" OnChanged="PowerChangedAsync" />
                        }
                        <div class="b3d-links">
                            @if (OnOpenTab.HasDelegate)
                            {
                                <button type="button" class="wt-btn wt-plain" data-b3d="thing-open-tab" @onclick="@(() => OnOpenTab.InvokeAsync("feature:" + thing.FeatureId))">@L.Resource("World3D_OpenListFormat", thing.FeatureName)</button>
                            }
                            <button type="button" class="wt-btn wt-plain" @onclick="CloseMarkerCardAsync">@L.Resource("World3D_DoorCardClose")</button>
                        </div>
                    </div>
                }

                @if (SelectedDoor is { } door)
                {
                    var (doorMap, doorActor) = DoorIdParser.Parse(door.Id);
                    var doorInfo = DoorClassCatalog.Lookup(DoorIdParser.ClassNameFromActor(doorActor));
                    <div class="wt-card b3d-panel" data-b3d="door-card">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_DoorCard")</span>
                        <strong class="b3d-title" data-b3d="door-title">@(L.ResourceOrNull($"WorldDoors_Class_{doorInfo.ClassName}_DisplayName") ?? doorInfo.DisplayName)</strong>
                        <dl class="b3d-fields">
                            <dt>@L.Resource("World3D_SubLevel")</dt><dd>@doorMap</dd>
                            <dt>@L.Resource("World3D_Key")</dt><dd class="b3d-mono">@doorActor</dd>
                            <dt>@L.Resource("World3D_DoorState")</dt><dd data-b3d="door-state">@DoorStateText(door)</dd>
                        </dl>
                        @if (door.Kind == WorldDoorKind.Simple)
                        {
                            var raw = door.DoorState ?? DoorClosed;
                            <label>@L.Resource("World3D_DoorSetState")
                                <select class="wt-input" data-b3d="door-state-select" @onchange="e => SetDoorStateAsync(door.Id, e.Value?.ToString())">
                                    @if (!StableDoorStates.Contains(raw)) { <option value="@raw" selected>@StateLabel(raw)</option> }
                                    @foreach (var s in StableDoorStates)
                                    {
                                        <option value="@s" selected="@(s == raw)">@StateLabel(s)</option>
                                    }
                                </select>
                            </label>
                        }
                        else if (door.Kind == WorldDoorKind.Security)
                        {
                            <label class="wt-check">
                                <input type="checkbox" checked="@(door.IsDoorOpen == true)" data-b3d="door-open" @onchange="e => SetDoorOpenAsync(door.Id, e.Value is true)" />
                                @L.Resource("World3D_DoorOpen")
                            </label>
                        }
                        <div class="b3d-links">
                            <button type="button" class="wt-btn wt-plain" data-b3d="door-close-card" @onclick="CloseDoorCardAsync">@L.Resource("World3D_DoorCardClose")</button>
                        </div>
                    </div>
                }

                @if (SelectedNpc is { } npc)
                {
                    <div class="wt-card b3d-panel" data-b3d="npc-card">
                        <span class="wt-label accent-orange-text">@L.Resource(npc.IsPet ? "World3D_PetCard" : "World3D_NpcCard")</span>
                        @if (!npc.IsPet)
                        {
                            <CharacterCard3D Npc="@npc" Name="@NpcName(npc)" />
                        }
                        else
                        {
                            <strong class="b3d-title" data-b3d="npc-title" title="@npc.Id">@NpcName(npc)</strong>
                        }
                        <details class="b3d-details">
                        <summary>@L.Resource("World3D_Details")</summary>
                        <dl class="b3d-fields">
                            <dt>@L.Resource("World3D_Key")</dt><dd class="b3d-mono">@npc.ActorName</dd>
                            @if (npc.X != 0 || npc.Y != 0 || npc.Z != 0)
                            {
                                <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Num(npc.X), @Num(npc.Y), @Num(npc.Z)</dd>
                            }
                            else
                            {
                                <dt>@L.Resource("World3D_Position")</dt><dd>@L.Resource("World3D_NpcAtLevelSpot")</dd>
                            }
                            @if (npc.IsDead && npc.IsPet) { <dt>@L.Resource("World3D_NpcStatus")</dt><dd data-b3d="npc-status">@L.Resource("WorldPets_StatusDead")</dd> }
                        </dl>
                        </details>
                        <div class="b3d-links">
                            @if (OnOpenTab.HasDelegate)
                            {
                                <button type="button" class="wt-btn" data-b3d="npc-open-tab" @onclick="@(() => OnOpenTab.InvokeAsync(npc.IsPet ? "pets" : "npcs"))">@L.Resource(npc.IsPet ? "World3D_OpenPets" : "World3D_OpenNpcs")</button>
                            }
                            <button type="button" class="wt-btn wt-plain" data-b3d="npc-close-card" @onclick="CloseNpcCardAsync">@L.Resource("World3D_DoorCardClose")</button>
                        </div>
                    </div>
                }

                @if (_selected.Count > 1)
                {
                    <div class="wt-card b3d-panel b3d-selection-bar" data-b3d="selection">
                        <div class="b3d-panel-head">
                            <span class="wt-label accent-orange-text">@L.Resource("World3D_SelectionFormat", _selected.Count)</span>
                            <button type="button" class="wt-btn wt-plain" data-b3d="clear-selection" @onclick="ClearSelectionAsync">@L.Resource("World3D_ClearSelection")</button>
                        </div>
                        <div class="b3d-object-list b3d-selection-list">
                            @foreach (var (selKey, rowKey) in RenderKeys.With(_selected.Take(60).ToList(), k => k))
                            {
                                var k = selKey;
                                <div class="b3d-selection-row @(k == _selectedKey ? "primary" : null)" @key="rowKey" data-b3d="selection-row">
                                    <button type="button" class="wt-btn wt-plain b3d-selection-name" @onclick="() => SetPrimaryAsync(k)" title="@L.Resource("World3D_MakePrimary")">@SelectionLabel(k)@(k == _selectedKey ? " *" : "")</button>
                                    <button type="button" class="wt-btn wt-plain" aria-label="@L.Resource("World3D_RemoveFromSelection")" @onclick="() => RemoveFromSelectionAsync(k)">x</button>
                                </div>
                            }
                            @if (_selected.Count > 60) { <small class="wt-muted">@L.Resource("World3D_SelectionMoreFormat", _selected.Count - 60)</small> }
                        </div>
                    </div>
                }

                @if (_selectedKey is { } vehicleKey && Session.Vehicles.Any(v => v.Id == vehicleKey))
                {
                    <div class="wt-card b3d-panel" data-b3d="vehicle-card">
                        <WorldVehiclesTab Session="Session" InspectorVehicleId="@vehicleKey" OnOpenContainer="OpenVehicleContainerAsync" OnChanged="ThingChangedAsync" />
                    </div>
                }
                @if (SelectedObject is not null || SelectedCopy is not null || (_selectedKey is null && SelectedDoor is null && SelectedNpc is null && _pickedMarker is null && _levelPicked is null))
                {
                    <div class="wt-card b3d-panel" data-b3d="inspector">
                        <div class="b3d-panel-head">
                            <span class="wt-label accent-orange-text">@L.Resource("World3D_Inspector")</span>
                            @if (_selected.Count == 1) { <button type="button" class="b3d-close" aria-label="@L.Resource("World3D_ClearSelection")" data-b3d="clear-one" @onclick="ClearSelectionAsync">&#x2715;</button> }
                        </div>
                        @if (SelectedObject is not { } obj)
                        {
                            @if (SelectedCopy is { } copy)
                            {
                                <strong class="b3d-title">@Base3DScene.FriendlyClass(copy.ClassName)</strong>
                                <p class="wt-muted" data-b3d="copy-inspector">@L.Resource("World3D_CopyInspectorFormat", copy.NewKey)</p>
                                <dl class="b3d-fields">
                                    <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Describe(copy.After)</dd>
                                </dl>
                                @PlacementWarnings(copy.NewKey)
                                <button type="button" class="wt-btn wt-plain" data-b3d="revert-copy" @onclick="() => RevertDuplicationAsync(copy.DuplicationId)">@L.Resource("World3D_RevertCopy")</button>
                                @* A new object can be wired up before SAVE: it and its outlets are written first. *@
                                @if (UsesPower(copy.NewKey, copy.ClassName)) { @PowerCard(copy.NewKey) }
                            }
                            else
                            {
                                @if (SelectedDoor is null && SelectedNpc is null && _pickedMarker is null) { <p class="wt-muted">@L.Resource("World3D_NothingSelected")</p> }
                            }
                        }
                        else
                        {
                            var current = Session.CurrentPlacedTransform(obj.Key) ?? obj.Transform;
                            var built = obj.DeployedByPlayer == true;
                            <div class="b3d-title-row">
                                @if (WorldThumbnails.For("containers", obj.ClassName) is { } objPicture) { <img class="b3d-title-art" src="@objPicture" alt="" data-zoom /> }
                                <div class="b3d-title-text">
                                    <strong class="b3d-title">@Base3DScene.LabelOf(obj)</strong>
                                    <small class="wt-muted" data-b3d="origin">@L.Resource(built ? "World3D_BuiltByPlayer" : "World3D_CameWithLevel")</small>
                                </div>
                            </div>
                            @PlacementWarnings(obj.Key)
                            @if (_moveOptIn && Session.IsPlacedTransformStaged(obj.Key) && CheckOf(obj.Key) is { LevelLoaded: true })
                            {
                                <button type="button" class="wt-btn wt-plain" data-b3d="stand-on-floor" @onclick="() => StandOnFloorAsync(obj.Key)">@L.Resource("World3D_StandOnFloor")</button>
                            }

                            @* What can be done with it comes first: its contents, then remove and copy. *@
                            @* A garden plot shows what is growing in it (and its water and fertilizer); a
                               lamp, a power chair and the like their own settings. Same fields as their lists. *@
                            <PlacedFeatureCard3D Session="Session" PieceKey="@obj.Key" OnChanged="StateHasChanged" />
                            @if (ShowsStorage(obj.Key))
                            {
                                <ContainerSlotsPanel Session="@Session" ContainerId="@obj.Key" ClassPath="@(obj.ClassPath ?? obj.ClassName)" />
                            }
                            @* A containment cell: the creature it holds, changed or released right here. *@
                            <ContainmentCard3D Session="Session" UnitKey="@obj.Key" />
                            @* A bench's upgrades and a piece's paint colour. *@
                            <DeployableCard3D Session="Session" PieceKey="@obj.Key" ClassPath="@obj.ClassPath" OnChanged="StateHasChanged" />

                            @* EXTENSION POINT (delete and duplicate): wired. The buttons act on the whole selection,
                               open a confirmation panel with a preview (Core's StagedBaseEdits.Preview), and stage
                               through the same session as the move controls, so the unsaved-edit indicator, the staged
                               table and REVERT cover them. Pressing one turns Edit mode on. A piece that came with the
                               level cannot be removed (the game puts it back from its own files); copying it places a
                               new piece of the player's own beside it, made from one they built. *@
                            <div class="b3d-actions" data-extension-point="placed-object-delete-duplicate">
                                @if (Session.IsPlacedDeletionStaged(obj.Key))
                                {
                                    <p class="error-text" data-b3d="staged-delete-note">@L.Resource("World3D_StagedForDeletion")
                                        <button type="button" class="wt-btn wt-plain" @onclick="() => RevertDeletionAsync(obj.Key)">@L.Resource("World3D_RevertObject")</button></p>
                                }
                                <div class="b3d-links">
                                    @if (built)
                                    {
                                        <button type="button" class="wt-btn b3d-danger" data-b3d="delete-open" disabled="@(_selected.Count == 0)"
                                                @onclick="StartDeleteAsync">@L.Resource("World3D_DeleteButtonFormat", _selected.Count)</button>
                                        <button type="button" class="wt-btn" data-b3d="duplicate-open" disabled="@(_selected.Count == 0)"
                                                @onclick="StartDuplicateAsync">@L.Resource("World3D_DuplicateButtonFormat", _selected.Count)</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="wt-btn" data-b3d="level-copy" disabled="@_levelCopyBusy"
                                                @onclick="() => CopyLevelPieceAsync(obj)">@L.Resource("World3D_LevelCopy")</button>
                                    }
                                </div>
                                @if (!built) { <small class="wt-muted" data-b3d="level-note">@L.Resource("World3D_LevelPieceNote")</small> }
                                @if (_levelCopyNote is not null) { <p class="wt-muted" role="status" data-b3d="level-copy-note">@_levelCopyNote</p> }
                            </div>

                            @* Power for the selected object: where it takes power from, plugging it in elsewhere
                               (nearest outlets first), and its own outlets. Stages with the other base edits. *@
                            @if (built && obj.Key.Length == 32 && UsesPower(obj.Key, obj.ClassPath ?? obj.ClassName))
                            {
                                @PowerCard(obj.Key)
                            }
                            @if (OnOpenPowerSockets.HasDelegate && PowerSocketsAvailable
                                && (obj.PoweredBySocketIds.Count > 0 || PlacedObjectCategoryCatalog.Classify(obj.ClassName, obj.InventoryCount > 0) == PlacedObjectCategory.Power))
                            {
                                <div class="b3d-links">
                                    <button type="button" class="wt-btn wt-plain" data-b3d="open-power" @onclick="() => OnOpenPowerSockets.InvokeAsync()">@L.Resource("World3D_OpenPower")</button>
                                </div>
                            }

                            @if (_moveOptIn)
                            {
                                @* A level piece already says why it stays put (the note under its buttons). *@
                                @if (built && (obj.Transform?.Translation is null || obj.Transform.Rotation is null))
                                {
                                    <p class="error-text" role="alert" data-b3d="move-refused">@L.Resource("World3D_MoveOmittedRefused")</p>
                                }
                                else if (built)
                                {
                                    <div class="b3d-move" data-b3d="move-controls">
                                        <p class="wt-muted" data-b3d="drag-hint">@L.Resource("World3D_DragHint")</p>
                                    <span class="wt-label">@L.Resource("World3D_MoveGizmo")</span>
                                        <div class="b3d-gizmo-modes" role="radiogroup" aria-label="@L.Resource("World3D_MoveGizmo")">
                                            @foreach (var mode in GizmoModes)
                                            {
                                                var m = mode;
                                                <label class="wt-check" @key="m">
                                                    <input type="radio" name="b3d-gizmo" checked="@(_gizmo == m)" @onchange="() => SetGizmoAsync(m)" />
                                                    @L.Resource("World3D_Gizmo" + char.ToUpperInvariant(m[0]) + m[1..])
                                                </label>
                                            }
                                        </div>
                                        <div class="b3d-numbers">
                                            <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" @bind="_xText" @bind:event="oninput" data-b3d="x" /></label>
                                            <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" @bind="_yText" @bind:event="oninput" data-b3d="y" /></label>
                                            <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" @bind="_zText" @bind:event="oninput" data-b3d="z" /></label>
                                            <label>@L.Resource("World3D_Yaw")<input class="wt-input" inputmode="decimal" @bind="_yawText" @bind:event="oninput" data-b3d="yaw" /></label>
                                        </div>
                                        @if (_numberError is not null) { <p class="error-text" role="alert">@_numberError</p> }
                                        <div class="b3d-links">
                                            <button type="button" class="wt-btn" data-b3d="stage-numbers" @onclick="StageNumbersAsync">@L.Resource("World3D_StageNumbers")</button>
                                            <button type="button" class="wt-btn wt-plain" disabled="@(!Session.IsPlacedTransformStaged(obj.Key))" data-b3d="revert-object"
                                                    @onclick="() => RevertObjectAsync(obj.Key)">@L.Resource("World3D_RevertObject")</button>
                                        </div>
                                    </div>
                                }
                            }

                            @* The numbers behind it (where it is, which file it comes from), folded away. *@
                            <details class="b3d-details" data-b3d="details">
                                <summary>@L.Resource("World3D_Details")</summary>
                                <dl class="b3d-fields">
                                    <dt>@L.Resource("World3D_Class")</dt><dd>@(obj.ClassName ?? "-")</dd>
                                    <dt>@L.Resource("World3D_Origin")</dt><dd>@(obj.DeployedByPlayer == true ? L.Resource("World3D_OriginPlayer") : L.Resource("World3D_OriginLevel"))</dd>
                                    <dt>@L.Resource("World3D_Key")</dt><dd class="b3d-mono">@obj.Key</dd>
                                    @if (obj.ActorPath is not null) { <dt>@L.Resource("World3D_ActorPath")</dt><dd class="b3d-mono">@obj.ActorPath</dd> }
                                    @if (obj.SubLevel is not null) { <dt>@L.Resource("World3D_SubLevel")</dt><dd>@obj.SubLevel</dd> }
                                    @if (current?.Translation is { } t)
                                    {
                                        <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Num(t.X), @Num(t.Y), @Num(t.Z)</dd>
                                    }
                                    @if (current?.Rotation is { } r)
                                    {
                                        <dt>@L.Resource("World3D_Rotation")</dt><dd class="b3d-mono">yaw @Num(r.YawDegrees), pitch @Num(r.PitchDegrees), roll @Num(r.RollDegrees)</dd>
                                    }
                                    @if (current?.Scale3D is { } sc)
                                    {
                                        <dt>@L.Resource("World3D_Scale")</dt><dd class="b3d-mono">@Num(sc.X, 2), @Num(sc.Y, 2), @Num(sc.Z, 2)</dd>
                                    }
                                    @if (obj.CustomName is not null && obj.OwnerName is null) { <dt>@L.Resource("World3D_Name")</dt><dd>@obj.CustomName</dd> }
                                    @if (obj.OwnerName is not null) { <dt>@L.Resource("World3D_Owner")</dt><dd>@obj.OwnerName</dd> }
                                    @if (obj.StoredItemCount > 0) { <dt>@L.Resource("World3D_Items")</dt><dd>@obj.StoredItemCount</dd> }
                                    @if (obj.PoweredBySocketIds.Count > 0) { <dt>@L.Resource("World3D_PoweredBy")</dt><dd class="b3d-mono">@string.Join(", ", obj.PoweredBySocketIds)</dd> }
                                </dl>
                            </details>
                        }
                    </div>
                }

                @if (_moveOptIn && _selected.Count > 0)
                {
                    <div class="wt-card b3d-panel" data-b3d="group-tools">
                        <span class="wt-label accent-orange-text">@L.Resource("World3D_GroupTools")</span>
                        <p class="wt-muted">@L.Resource("World3D_GroupToolsIntro")</p>
                        <span class="wt-label">@L.Resource("World3D_GroupMove")</span>
                        <div class="b3d-numbers b3d-numbers3">
                            <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" @bind="_grpDx" @bind:event="oninput" data-b3d="grp-dx" /></label>
                            <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" @bind="_grpDy" @bind:event="oninput" data-b3d="grp-dy" /></label>
                            <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" @bind="_grpDz" @bind:event="oninput" data-b3d="grp-dz" /></label>
                        </div>
                        <button type="button" class="wt-btn" data-b3d="grp-move" @onclick="StageGroupMoveAsync">@L.Resource("World3D_GroupMoveButton")</button>

                        <span class="wt-label">@L.Resource("World3D_GroupRotate")</span>
                        <div class="b3d-numbers">
                            <label>@L.Resource("World3D_GroupYawDegrees")<input class="wt-input" inputmode="decimal" @bind="_grpYaw" @bind:event="oninput" data-b3d="grp-yaw" /></label>
                            <label>@L.Resource("World3D_Pivot")
                                <select class="wt-input" data-b3d="grp-pivot" @onchange="OnGroupPivotChanged">
                                    <option value="@PivotCentroid" selected="@(_grpPivot == PivotCentroid)">@L.Resource("World3D_PivotCentroid")</option>
                                    @foreach (var pk in _selected.Take(60))
                                    {
                                        <option value="@pk" selected="@(_grpPivot == pk)">@SelectionLabel(pk)</option>
                                    }
                                </select></label>
                        </div>
                        <button type="button" class="wt-btn" data-b3d="grp-rotate" @onclick="StageGroupRotateAsync">@L.Resource("World3D_GroupRotateButton")</button>

                        <span class="wt-label">@L.Resource("World3D_GroupSnap")</span>
                        <div class="b3d-numbers b3d-numbers3">
                            <label>@L.Resource("World3D_SnapStepXY")<input class="wt-input" inputmode="decimal" @bind="_snapXY" @bind:event="oninput" data-b3d="snap-xy" /></label>
                            <label>@L.Resource("World3D_SnapStepZ")<input class="wt-input" inputmode="decimal" @bind="_snapZ" @bind:event="oninput" data-b3d="snap-z" /></label>
                            <label>@L.Resource("World3D_SnapStepYaw")<input class="wt-input" inputmode="decimal" @bind="_snapYaw" @bind:event="oninput" data-b3d="snap-yaw" /></label>
                        </div>
                        <button type="button" class="wt-btn" data-b3d="grp-snap" @onclick="StageGroupSnapAsync">@L.Resource("World3D_GroupSnapButton")</button>

                        <span class="wt-label">@L.Resource("World3D_GroupArrange")</span>
                        <div class="b3d-links">
                            <button type="button" class="wt-btn" data-b3d="grp-align" disabled="@(_selectedKey is null || _selected.Count < 2)" @onclick="StageGroupAlignAsync">@L.Resource("World3D_GroupAlignYaw")</button>
                            <select class="wt-input b3d-axis" data-b3d="grp-axis" aria-label="@L.Resource("World3D_Axis")" @onchange="OnAxisChanged">
                                @foreach (var axis in new[] { "X", "Y", "Z" })
                                {
                                    <option value="@axis" selected="@(_distAxis == axis)">@axis</option>
                                }
                            </select>
                            <button type="button" class="wt-btn" data-b3d="grp-distribute" disabled="@(_selected.Count < 3)" @onclick="StageGroupDistributeAsync">@L.Resource("World3D_GroupDistribute")</button>
                        </div>
                        @if (_groupFeedback is not null) { <p class="b3d-feedback" role="status" data-b3d="grp-feedback">@_groupFeedback</p> }
                    </div>
                }
            </div>
            @* What is in the view, searchable. What is drawn and how (filters, level, models) is in the
               view's Show menu, next to the other things it shows. *@
            <div class="b3d-objects-head">
                <span class="wt-label">@L.Resource("World3D_TabObjectsFormat", _visible.Length)</span>
            </div>
            <div class="b3d-tab-body" data-b3d="objects-pane">
                <div class="b3d-objects-tools">
                    <input type="search" class="wt-input b3d-search" value="@_filter.Search" placeholder="@L.Resource("World3D_SearchPlaceholder")"
                           aria-label="@L.Resource("World3D_Search")" @oninput="OnSearchInput" />
                    <button type="button" class="wt-btn" data-b3d="select-all" disabled="@(_visible.Length == 0)" @onclick="SelectAllShownAsync">@L.Resource("World3D_SelectAllShown")</button>
                </div>
        <div class="wt-card b3d-panel" data-b3d="objects">
            <span class="wt-label">@L.Resource("World3D_Select")</span>
            <div class="b3d-object-list b3d-object-list-tall">
                @foreach (var (index, rowKey) in RenderKeys.With(ListedIndexes(), i => _scene.Objects[i].Key))
                {
                    var o = _scene.Objects[index];
                    <button type="button" class="wt-row b3d-object-row @(IsSelected(o.Key) ? "selected" : null)" @key="rowKey" data-b3d="object-row"
                            @onclick="e => ClickListAsync(o.Key, e)">
                        <span class="b3d-swatch" style="background:@CategoryColor((PlacedObjectCategory)o.Cat)"></span>
                        <span class="wt-row-text">@o.Label</span>
                        <small>@(o.Built ? L.Resource("World3D_PlayerBuilt") : L.Resource("World3D_LevelPlaced"))</small>
                    </button>
                }
            </div>
        </div>

        @if (_scene.Unresolved.Count > 0)
        {
            <div class="wt-card b3d-panel" data-b3d="unresolved">
                <span class="wt-label">@L.Resource("World3D_UnresolvedTitle", _scene.Unresolved.Count)</span>
                <p class="wt-muted">@L.Resource("World3D_UnresolvedIntro")</p>
                <div class="b3d-object-list">
                    @foreach (var (item, rowKey) in RenderKeys.With(_scene.Unresolved.Take(200), u => u.Key))
                    {
                        <button type="button" class="wt-row b3d-object-row @(item.Key == _selectedKey ? "selected" : null)" @key="rowKey"
                                @onclick="() => SelectUnresolved(item.Key)">
                            <span class="wt-row-text">@item.Label</span>
                            <small>@L.Resource("World3D_UnresolvedReasonFormat", item.Built ? L.Resource("World3D_PlayerBuilt") : L.Resource("World3D_LevelPlaced"), item.Reason)</small>
                        </button>
                    }
                </div>
            </div>
        }
            </div>
        </aside>
    </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public WorldSaveSession Session { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "World editor";
    [Parameter] public EventCallback<string?> OnError { get; set; }

    /// <summary>Jump to the CONTAINERS tab filtered to this object's key.</summary>
    [Parameter] public EventCallback<string> OnOpenContainer { get; set; }

    /// <summary>Jump to the power sockets tab.</summary>
    [Parameter] public EventCallback OnOpenPowerSockets { get; set; }

    /// <summary>True when this save has a power sockets tab to jump to.</summary>
    [Parameter] public bool PowerSocketsAvailable { get; set; }

    /// <summary>
    /// The base chosen in the Bases tab; the view frames its objects when it changes (null shows the
    /// whole region). The surrounding level, when on, is loaded around it.
    /// </summary>
    [Parameter] public WorldBase? FocusBase { get; set; }

    private string? _framedBase;

    // ---- doors and walking ---------------------------------------------------------------------
    private const string DoorClosed = "E_DoorStates::NewEnumerator0";
    private static readonly string[] StableDoorStates = [DoorClosed, "E_DoorStates::NewEnumerator1", "E_DoorStates::NewEnumerator2"];
    private bool _doorsOn = true;
    private bool _doorsDirty = true;
    private string? _doorStamp, _npcStamp;

    private string DoorStateStamp()
        => string.Join('|', Session.Doors.Select(d => d.Id + "=" + d.DoorState + "/" + d.IsDoorOpen));

    private string NpcStateStamp()
        => string.Join('|', Session.Npcs.Select(n => n.Id + "=" + n.IsDead + "/" + n.X + "," + n.Y + "," + n.Z));
    private int _doorsToken;
    private string? _doorsNote;
    private string? _selectedDoorId;
    private bool _walkOn;
    private bool _walkFloor = true;

    private WorldDoor? SelectedDoor => _selectedDoorId is null ? null
        : Session.Doors.FirstOrDefault(d => string.Equals(d.Id, _selectedDoorId, StringComparison.Ordinal));

    private string StateLabel(string? raw)
    {
        var friendly = DoorStateNames.Friendly(raw);
        return L.ResourceOrNull("WorldDoors_State_" + friendly) ?? friendly;
    }

    private string DoorStateText(WorldDoor door) => door.Kind == WorldDoorKind.Security
        ? L.Resource(door.IsDoorOpen == true ? "WorldDoors_State_Open" : "WorldDoors_State_Closed")
        : StateLabel(door.DoorState ?? DoorClosed);

    /// <summary>Marker colour by state: open green, closed grey (security doors blue), destroyed or smashed orange.</summary>
    internal static int DoorColor(WorldDoor door)
    {
        if (door.Kind == WorldDoorKind.Security) return door.IsDoorOpen == true ? 0x34c759 : 0x5e8bff;
        return DoorStateNames.Friendly(door.DoorState ?? DoorClosed) switch
        {
            "OpenInwards" or "OpenOutwards" => 0x34c759,
            "Destroyed" or "SmashedInwards" or "SmashedOutwards" => 0xff9f0a,
            _ => 0x9aa3b2,
        };
    }

    /// <summary>
    /// Sends the region's doors to the view as markers at their place in the world (the level
    /// files give each door's position; a sub-level's doors are moved by its placement). Positions
    /// are read once per level, so later pushes after an edit only recolour.
    /// </summary>
    private async Task PushDoorsAsync()
    {
        // Door positions come from the installed game's level files, which the browser does not have.
        if (_view is null || InBrowser) return;
        var token = ++_doorsToken;
        var doors = Session.Doors;
        var markers = new List<object>();
        var missing = 0;
        foreach (var group in doors.GroupBy(d => DoorIdParser.Parse(d.Id).Map, StringComparer.OrdinalIgnoreCase))
        {
            IReadOnlyDictionary<string, DoorWorldLocation> positions;
            try { positions = await Art.GetWorldDoorPositionsForMapAsync(group.Key); }
            catch (Exception ex) when (ex is IOException or InvalidOperationException) { positions = new Dictionary<string, DoorWorldLocation>(); }
            if (token != _doorsToken || _disposed) return;
            foreach (var door in group)
            {
                if (!positions.TryGetValue(DoorIdParser.Parse(door.Id).Actor, out var at)) { missing++; continue; }
                var v = PlacedSceneSpace.ToViewer(new PlacedVector(at.X, at.Y, at.Z));
                markers.Add(new { id = door.Id, p = new[] { v.X, v.Y, v.Z }, color = DoorColor(door) });
            }
        }
        _doorsNote = doors.Count == 0 ? null
            : markers.Count == 0 ? L.Resource("World3D_DoorsNoPositions")
            : missing > 0 ? L.Resource("World3D_DoorsShownFormat", markers.Count, doors.Count)
            : null;
        try
        {
            await _view.InvokeVoidAsync("setDoors", markers);
            await _view.InvokeVoidAsync("setDoorSelection", _selectedDoorId);
        }
        catch (JSDisconnectedException) { }
        await InvokeAsync(StateHasChanged);
    }

