    private void LoadNumbers()
    {
        _numberError = null;
        var current = _selectedKey is null ? null : Session.CurrentPlacedTransform(_selectedKey);
        var t = current?.Translation;
        _xText = t is { } a ? Num(a.X, 2, plain: true) : "";
        _yText = t is { } b ? Num(b.Y, 2, plain: true) : "";
        _zText = t is { } c ? Num(c.Z, 2, plain: true) : "";
        _yawText = current?.Rotation is { } r ? Num(r.YawDegrees, 2, plain: true) : "";
    }

    /// <summary>Numeric entry: absolute X/Y/Z in centimetres and an absolute yaw in degrees.</summary>
    private async Task StageNumbersAsync()
    {
        if (_selectedKey is not { } key || Session.FindPlacedObject(key) is not { } obj) return;
        var current = Session.CurrentPlacedTransform(key);
        if (!TryNumber(_xText, out var x) || !TryNumber(_yText, out var y) || !TryNumber(_zText, out var z) || !TryNumber(_yawText, out var yaw))
        {
            _numberError = L.Resource("World3D_InvalidNumber");
            return;
        }
        _numberError = null;
        // The fields show values rounded to two decimals. A field the player left as it was keeps
        // the exact saved value, so moving along X alone never rewrites Y, Z or the rotation with
        // their rounded display (which would nudge the object slightly).
        if (current?.Translation is { } exact)
        {
            if (_xText == Num(exact.X, 2, plain: true)) x = exact.X;
            if (_yText == Num(exact.Y, 2, plain: true)) y = exact.Y;
            if (_zText == Num(exact.Z, 2, plain: true)) z = exact.Z;
        }
        var target = new PlacedVector(x, y, z);
        PlacedVector? newT = current?.Translation is { } now && now == target ? null : target;
        PlacedQuaternion? newR = null;
        if (current?.Rotation is { } q && _yawText != Num(q.YawDegrees, 2, plain: true))
        {
            var delta = ((yaw - q.YawDegrees) % 360.0 + 540.0) % 360.0 - 180.0;
            if (Math.Abs(delta) > 1e-6) newR = PlacedSceneSpace.ComposeYaw(q, delta);
        }
        if (newT is null && newR is null) return;
        await AfterEditAsync(Session.StagePlacedTransform(obj.Key, newT, newR));
    }

    private static bool TryNumber(string text, out double value)
        => double.TryParse(text?.Trim(), NumberStyles.Float, CultureInfo.InvariantCulture, out value)
           || double.TryParse(text?.Trim(), NumberStyles.Float, CultureInfo.CurrentCulture, out value);

    private async Task RevertObjectAsync(string key)
    {
        Session.RevertPlacedTransform(key);
        await AfterEditAsync(PlacedTransformStageResult.Ok);
    }

    private async Task RevertAllAsync()
    {
        Session.RevertAllBaseEdits();
        await AfterEditAsync(PlacedTransformStageResult.Ok);
    }

    /// <summary>Common tail of every staging change: report a refusal, refresh the view and tell the shell.</summary>
    private async Task AfterEditAsync(PlacedTransformStageResult result)
    {
        if (!result.Staged)
        {
            await OnError.InvokeAsync(result.Refusal switch
            {
                PlacedTransformRefusal.LevelPlaced => L.Resource("World3D_MoveLevelRefused"),
                PlacedTransformRefusal.MemberOmitted => L.Resource("World3D_MoveOmittedRefused"),
                _ => L.Resource("World3D_MoveNotFound"),
            });
        }
        else
        {
            await OnError.InvokeAsync(null);
        }
        SyncFromSession();
        Workspace.NotifyEdited();
        StateHasChanged();
        // The stage or revert may have changed the object under the gizmo (a revert moves it back).
        if (_view is not null && _pushScene)
        {
            _pushScene = false;
            await PushSceneAsync();
        }
    }

    // ---- shared fragments ---------------------------------------------------------------------
    /// <summary>Findings, blocking ones first and highlighted, then warnings, then notes.</summary>
    private RenderFragment IssueList(IReadOnlyList<BaseEditIssue> issues, string id) => __builder =>
    {
        if (issues.Count == 0)
        {
            __builder.OpenElement(0, "p");
            __builder.AddAttribute(1, "class", "wt-muted");
            __builder.AddContent(2, L.Resource("World3D_NoIssues"));
            __builder.CloseElement();
            return;
        }
        __builder.OpenElement(3, "ul");
        __builder.AddAttribute(4, "class", "b3d-list b3d-issues");
        __builder.AddAttribute(5, "data-b3d", id);
        var n = 6;
        // The same finding often repeats once per outlet or per object; show it once with a count.
        foreach (var group in issues.GroupBy(i => (i.Severity, i.Code, i.Message)).OrderByDescending(g => g.Key.Severity).Take(40))
        {
            var issue = group.First();
            __builder.OpenElement(n++, "li");
            __builder.AddAttribute(n++, "class", "b3d-issue " + issue.Severity.ToString().ToLowerInvariant());
            __builder.AddAttribute(n++, "data-severity", issue.Severity.ToString());
            __builder.AddAttribute(n++, "data-code", issue.Code);
            __builder.AddContent(n++, (issue.IsBlocking ? L.Resource("World3D_Blocking") + " " : "") + issue.Message
                + (group.Count() > 1 ? " " + L.Resource("World3D_IssueTimesFormat", group.Count()) : ""));
            __builder.CloseElement();
        }
        __builder.CloseElement();
    };

    /// <summary>
    /// The findings about the objects a panel is acting on. A panel's preview includes every edit
    /// already staged, so without this the delete panel also listed the findings of a staged copy.
    /// Findings not tied to an object are kept only where they concern the panel's kind of edit.
    /// </summary>
    private static List<BaseEditIssue> IssuesFor(IReadOnlyList<BaseEditIssue> issues, IReadOnlyCollection<string> keys, bool includeGeneral)
        => issues.Where(i => i.Key is null ? includeGeneral || i.Code == "scan-scope" : keys.Contains(i.Key)).ToList();

    /// <summary>Proximity hints with the Core disclaimer (hints only, not a collision test).</summary>
    private RenderFragment HintList(IReadOnlyList<ProximityHint> hints) => __builder =>
    {
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "b3d-hints");
        __builder.AddAttribute(2, "data-b3d", "hints");
        __builder.OpenElement(3, "span");
        __builder.AddAttribute(4, "class", "wt-label");
        __builder.AddContent(5, L.Resource("World3D_Hints", hints.Count));
        __builder.CloseElement();
        __builder.OpenElement(6, "small");
        __builder.AddAttribute(7, "class", "wt-muted");
        __builder.AddAttribute(8, "data-b3d", "hint-disclaimer");
        __builder.AddContent(9, ProximityHints.Disclaimer);
        __builder.CloseElement();
        if (hints.Count > 0)
        {
            __builder.OpenElement(10, "ul");
            __builder.AddAttribute(11, "class", "b3d-list");
            var n = 12;
            foreach (var h in hints.Take(8))
            {
                __builder.OpenElement(n++, "li");
                __builder.AddContent(n++, L.Resource("World3D_HintFormat", Base3DScene.FriendlyClass(h.ClassA), Base3DScene.FriendlyClass(h.ClassB), Num(h.DistanceCm, 0)));
                __builder.CloseElement();
            }
            __builder.CloseElement();
        }
        __builder.CloseElement();
    };

