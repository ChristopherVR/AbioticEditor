    private void WorkspaceChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            SyncFromSession();
            // Markers are resent only when what they show changed (any workspace edit raises this).
            var doorState = DoorStateStamp();
            if (doorState != _doorStamp) { _doorStamp = doorState; _doorsDirty = true; }
            var npcState = NpcStateStamp();
            if (npcState != _npcStamp) { _npcStamp = npcState; _npcsDirty = true; }
            var itemCount = Session.DroppedItems.Count;
            if (itemCount != _itemStamp) { _itemStamp = itemCount; _markersDirty = true; }
            StateHasChanged();
        });
    }

    /// <summary>Rebuilds the scene when the session's saved objects or staged edits changed (SAVE, REVERT, an edit).</summary>
    private void SyncFromSession()
    {
        // This component is reused when another region's save is opened; the new region's
        // objects must be framed and its level loaded, not the previous region's view kept.
        if (!ReferenceEquals(Session, _sceneSession))
        {
            if (_sceneSession is not null)
            {
                _framedOnce = false;
                _framedBase = null;
                _regionChanged = true;
                _levelProgress = null;
                _doorsDirty = true;
                _selectedDoorId = null;
                _npcsDirty = true;
                _selectedNpcId = null;
                _markersDirty = true;
                _pickedMarker = null;
            }
            _sceneSession = Session;
        }
        var source = Session.PlacedObjects;
        var revision = Session.PlacedTransformsRevision;
        if (ReferenceEquals(source, _sceneSource) && revision == _sceneRevision) return;
        _sceneSource = source;
        _sceneRevision = revision;
        _basePreview = Session.HasStagedBaseEdits ? Session.PreviewBaseEdits() : null;
        _preview = _basePreview?.Transforms ?? [];
        _scene = Base3DScene.Build(source, Session.CurrentPlacedTransform,
            Session.StagedPlacedDeletions.Keys.ToHashSet(StringComparer.Ordinal), CopiesToDraw(), Session.Vehicles);
        _visible = _scene.Apply(_filter);
        _pushScene = true;
        PruneSelection();
        LoadNumbers();
        RefreshOpenPanels();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            try
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/AbioticEditor.Web.Shared/base3d.js");
                if (!await _module.InvokeAsync<bool>("isWebGlAvailable"))
                {
                    _webGlMissing = true;
                    StateHasChanged();
                    return;
                }
                _self = DotNetObjectReference.Create(this);
                _view = await _module.InvokeAsync<IJSObjectReference>("createView", _host, _self, ParkKey);
                _fit = await _module.InvokeAsync<IJSObjectReference>("fitToWindow", _root);
                _viewReady = true;
                await AfterViewCreatedAsync();
                StateHasChanged();
                await InitModelsAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
            {
                _webGlMissing = true;
                StateHasChanged();
                return;
            }
        }
        if (_view is not null && _pushScene)
        {
            _pushScene = false;
            await PushSceneAsync();
        }
        if (_view is not null && _regionChanged)
        {
            _regionChanged = false;
            await PushLevelAsync();
        }
        if (_view is not null && _framedOnce && _framedBase != FocusBase?.Name)
        {
            _framedBase = FocusBase?.Name;
            try
            {
                if (FocusBase is null || !await _view.InvokeAsync<bool>("frameKeys", (object)FocusKeys(FocusBase)))
                    await _view.InvokeVoidAsync("frameVisible", true);
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException) { }
        }
        await PushCablesAsync();
        if (_view is not null && _doorsDirty)
        {
            _doorsDirty = false;
            _ = PushDoorsAsync(); // the first read of a level's doors is slow; the markers arrive when ready
        }
        if (_view is not null && _npcsDirty)
        {
            _npcsDirty = false;
            _ = PushNpcsAsync();
        }
        if (_view is not null && _markersDirty && _framedOnce)
        {
            _markersDirty = false;
            _ = PushMarkersAsync();
        }
        await ProcessLocateAsync();
    }

    /// <summary>The objects last sent to the viewer, so a move or turn can be sent on its own.</summary>
    private IReadOnlyList<Base3DObject>? _sentObjects;
    private int[]? _sentVisible;

    /// <summary>
    /// When the scene differs from what the viewer has only in where some objects stand (a move or a turn),
    /// the changed objects are updated in place instead of resending and rebuilding the whole scene.
    /// Null when anything else changed (objects added, removed, marked or repainted).
    /// </summary>
    private List<Base3DObject>? MovedSinceLastPush()
    {
        if (_sentObjects is not { } sent || sent.Count != _scene.Objects.Count) return null;
        var moved = new List<Base3DObject>();
        for (var i = 0; i < sent.Count; i++)
        {
            var (a, b) = (sent[i], _scene.Objects[i]);
            if (a.Key != b.Key || a.Cat != b.Cat || a.Mark != b.Mark || a.Cls != b.Cls || a.Variant != b.Variant
                || a.Paint != b.Paint || a.Label != b.Label || !a.S.AsSpan().SequenceEqual(b.S)) return null;
            if (!a.P.AsSpan().SequenceEqual(b.P) || !a.Q.AsSpan().SequenceEqual(b.Q)) moved.Add(b);
        }
        return moved;
    }

    private async Task PushSceneAsync()
    {
        if (_view is null) return;
        if (MovedSinceLastPush() is { } moved && moved.Count <= 200)
        {
            try
            {
                foreach (var o in moved) await _view.InvokeVoidAsync("setObjectTransform", o.Key, o.P, o.Q);
                await PushGhostsAsync();
                if (_sentVisible is null || !_sentVisible.AsSpan().SequenceEqual(_visible))
                {
                    await _view.InvokeVoidAsync("setVisible", _visible);
                    _sentVisible = _visible;
                }
                _sentObjects = _scene.Objects;
                _ = RunPlacementChecksAsync();
            }
            catch (JSDisconnectedException) { }
            return;
        }
        try
        {
            await _view.InvokeVoidAsync("setScene", _scene.Objects);
            _sentObjects = _scene.Objects;
            _sentVisible = _visible;
            await _view.InvokeVoidAsync("setVisible", _visible);
            await PushGhostsAsync();
            await _view.InvokeVoidAsync("setLabels", _labels);
            await _view.InvokeVoidAsync("setSelection", _selected, _selectedKey);
            await _view.InvokeVoidAsync("setGizmo", EffectiveGizmo);
            await _view.InvokeVoidAsync("setDraggable", _moveOptIn);
            _ = RunPlacementChecksAsync();
            if (!_framedOnce)
            {
                // Ready once the first scene is in, even an empty one (a region with nothing built can
                // still be looked at, and "Show in 3D" waits for this).
                _framedOnce = true;
                _framedBase = FocusBase?.Name;
                if (_scene.Objects.Count > 0 && (FocusBase is null || !await _view.InvokeAsync<bool>("frameKeys", (object)FocusKeys(FocusBase))))
                    await _view.InvokeVoidAsync("frameVisible", true);
            }
        }
        catch (JSDisconnectedException) { }
    }

