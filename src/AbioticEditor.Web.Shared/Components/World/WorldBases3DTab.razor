    private static string Num(double value, int decimals = 1, bool plain = false)
        => value.ToString(plain ? "0.##" : "F" + decimals, CultureInfo.InvariantCulture);

    private static string FormatOptional(double? value) => value?.ToString("0.##", CultureInfo.InvariantCulture) ?? "";

    private static string Describe(PlacedObjectTransform? t)
        => t?.Translation is { } p
            ? $"{Num(p.X)}, {Num(p.Y)}, {Num(p.Z)}" + (t.Rotation is { } r ? $"  yaw {Num(r.YawDegrees)}" : "")
            : "-";

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Workspace.Changed -= WorkspaceChanged;
        try
        {
            if (_view is not null)
            {
                await _view.InvokeVoidAsync("dispose");
                await _view.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or OperationCanceledException) { }
        _self?.Dispose();
    }
