@namespace AbioticEditor.Web.Components.World
@using System.Globalization
@using AbioticEditor.Web.Models
@using AbioticEditor.Core.WorldSaves
@using Microsoft.JSInterop
@inject IJSRuntime Js
@inject SaveWorkspaceSessionService Workspace
@implements IAsyncDisposable

@* Base-building roadmap phases 3 and 4 (UI half): a 3D view of one region's placed objects, and
   staged move/rotate for player-built pieces. This component owns state and the inspector; the
   drawing lives in wwwroot/base3d.js (Three.js, vendored, no CDN). Conversion between the save's
   left-handed Z-up centimetres and the viewer's right-handed Y-up metres is Core's
   PlacedSceneSpace, so JavaScript never converts and the maths is unit tested. *@
<section class="world-editor world-native-tab b3d" aria-label="@L.Resource("World3D_Title")">
    <div class="b3d-head">
        <h2 class="wt-h2">@L.Resource("World3D_Title")</h2>
    </div>
    <p class="wt-intro">@L.Resource(_modelsOn ? "World3D_IntroModels" : "World3D_Intro")</p>

    @if (_webGlMissing)
    {
        <p class="error-text" role="alert" data-b3d="no-webgl">@L.Resource("World3D_NoWebGl")</p>
    }
    else
    {
    <div class="b3d-layout">
        <div class="b3d-stage">
            <div class="b3d-toolbar">
                <input type="search" class="wt-input b3d-search" value="@_filter.Search" placeholder="@L.Resource("World3D_SearchPlaceholder")"
                       aria-label="@L.Resource("World3D_Search")" @oninput="OnSearchInput" />
                <button type="button" class="wt-btn" disabled="@(_selected.Count == 0)" @onclick="FrameSelectionAsync">@L.Resource("World3D_FrameSelection")</button>
                <button type="button" class="wt-btn" data-b3d="select-all" disabled="@(_visible.Length == 0)" @onclick="SelectAllShownAsync">@L.Resource("World3D_SelectAllShown")</button>
                <button type="button" class="wt-btn wt-plain" data-b3d="clear-selection" disabled="@(_selected.Count == 0)" @onclick="ClearSelectionAsync">@L.Resource("World3D_ClearSelection")</button>
                <button type="button" class="wt-btn" @onclick="FrameAllAsync">@L.Resource("World3D_FrameAll")</button>
                <label class="wt-check">
                    <input type="checkbox" checked="@_labels" @onchange="e => SetLabelsAsync(e.Value is true)" />
                    @L.Resource("World3D_Labels")
                </label>
                <span class="wt-readout b3d-count" data-b3d="count">@L.Resource("World3D_ShowingFormat", _visible.Length, _scene.Objects.Count)</span>
            </div>
            @if (!_viewReady) { <span class="b3d-loading">@L.Resource("World3D_Loading")</span> }
            <div @ref="_host" class="b3d-canvas" role="img" aria-label="@L.Resource("World3D_ViewLabel")" data-b3d="canvas"></div>
            <p class="wt-muted b3d-hint">@L.Resource("World3D_AxesHint") @L.Resource("World3D_MultiSelectHint")</p>
            @if (_levelPicked is not null) { <p class="wt-muted b3d-hint" data-b3d="level-picked">@L.Resource("World3D_LevelPickedFormat", _levelPicked)</p> }
        </div>

        <aside class="b3d-side">
            <div class="wt-card b3d-panel" data-b3d="filters">
                <span class="wt-label accent-orange-text">@L.Resource("World3D_Filters")</span>
                <label class="wt-check"><input type="checkbox" checked="@_filter.ShowPlayerBuilt" @onchange="e => SetFilter(_filter with { ShowPlayerBuilt = e.Value is true })" /> @L.Resource("World3D_PlayerBuilt")</label>
                <label class="wt-check"><input type="checkbox" checked="@_filter.ShowLevelPlaced" @onchange="e => SetFilter(_filter with { ShowLevelPlaced = e.Value is true })" /> @L.Resource("World3D_LevelPlaced")</label>
                <div class="b3d-cats">
                    @foreach (var category in PlacedObjectCategoryCatalog.All)
                    {
                        var c = category;
                        <label class="wt-check" @key="c">
                            <span class="b3d-swatch" style="background:@CategoryColor(c)"></span>
                            <input type="checkbox" checked="@(!_filter.HiddenCategories.Contains(c))" @onchange="e => ToggleCategory(c, e.Value is true)" />
                            @L.Resource("World3D_Category_" + c)
                        </label>
                    }
                </div>
                <span class="wt-label">@L.Resource("World3D_HeightBand")</span>
                <div class="b3d-band">
                    <label>@L.Resource("World3D_HeightFrom")
                        <input type="number" class="wt-input" step="50" placeholder="@_scene.MinZCm.ToString("F0", CultureInfo.InvariantCulture)"
                               value="@FormatOptional(_filter.MinZCm)" @onchange="e => SetBand(e.Value?.ToString(), true)" /></label>
                    <label>@L.Resource("World3D_HeightTo")
                        <input type="number" class="wt-input" step="50" placeholder="@_scene.MaxZCm.ToString("F0", CultureInfo.InvariantCulture)"
                               value="@FormatOptional(_filter.MaxZCm)" @onchange="e => SetBand(e.Value?.ToString(), false)" /></label>
                </div>
                <button type="button" class="wt-btn wt-plain" @onclick="ResetFilters">@L.Resource("World3D_ResetFilters")</button>
            </div>

            @if (_modelStatus is { } ms)
            {
                <div class="wt-card b3d-panel" data-b3d="models">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_ModelsTitle")</span>
                    @if (!ms.Available)
                    {
                        <p class="wt-muted" data-b3d="models-nogame">@L.Resource("World3D_ModelsNoGame")</p>
                    }
                    else
                    {
                        <label class="wt-check">
                            <input type="checkbox" checked="@_modelsOn" data-b3d="models-toggle" @onchange="e => SetModelsAsync(e.Value is true)" />
                            @L.Resource("World3D_ModelsShow")
                        </label>
                        @if (!string.IsNullOrEmpty(ms.Plugin)) { <small class="wt-muted">@L.Resource("World3D_ModelsFromFormat", ms.Plugin)</small> }
                        @if (_modelsOn && _modelProgress is not null) { <small class="wt-muted" data-b3d="models-progress">@_modelProgress</small> }

                        @if (LevelRegion is null)
                        {
                            <small class="wt-muted">@L.Resource("World3D_LevelNoRegion")</small>
                        }
                        else
                        {
                            <label class="wt-check">
                                <input type="checkbox" checked="@_levelOn" data-b3d="level-toggle" @onchange="e => SetLevelAsync(e.Value is true)" />
                                @L.Resource("World3D_LevelShow")
                            </label>
                            @if (_levelOn)
                            {
                                <div class="b3d-band">
                                    <label>@L.Resource("World3D_LevelRadius")
                                        <select class="wt-input" data-b3d="level-radius" @onchange="e => SetLevelRadiusAsync(e.Value?.ToString())">
                                            @foreach (var r in LevelRadii)
                                            {
                                                <option value="@r" selected="@(r == _levelRadius)">@L.Resource("World3D_MetresFormat", r)</option>
                                            }
                                        </select>
                                    </label>
                                    <label>@L.Resource("World3D_LevelCut")
                                        <select class="wt-input" data-b3d="level-cut" @onchange="e => SetLevelCutAsync(e.Value?.ToString())">
                                            @foreach (var c in LevelCuts)
                                            {
                                                <option value="@c" selected="@(c == _levelCut)">@(c == 0 ? L.Resource("World3D_LevelCutOff") : L.Resource("World3D_MetresFormat", c))</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                                <button type="button" class="wt-btn" data-b3d="level-reload" @onclick="ReloadLevelAsync">@L.Resource("World3D_LevelReload")</button>
                                @if (_levelProgress is not null) { <small class="wt-muted" data-b3d="level-progress">@_levelProgress</small> }
                                <small class="wt-muted">@L.Resource("World3D_LevelHint")</small>
                            }
                        }
                    }
                </div>
            }

            <div class="wt-card b3d-panel" data-b3d="move-optin">
                <label class="wt-check b3d-optin">
                    <input type="checkbox" checked="@_moveOptIn" data-b3d="optin" @onchange="e => SetMoveOptInAsync(e.Value is true)" />
                    <strong>@L.Resource("World3D_MoveOptIn")</strong>
                </label>
                @if (_moveOptIn) { <p class="error-text b3d-warning" role="alert" data-b3d="move-warning">@L.Resource("World3D_MoveWarning")</p> }
            </div>

            @if (_moveOptIn && _deleteOpen)
            {
                <div class="wt-card b3d-panel b3d-op b3d-op-delete" data-b3d="delete-panel">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_DeleteTitleFormat", _deleteKeys.Count)</span>
                    <p class="error-text b3d-warning" role="alert" data-b3d="delete-unverified">@L.Resource("World3D_EditUnverified")</p>
                    @if (_deleteBusy)
                    {
                        <p class="wt-muted" data-b3d="delete-scanning">@L.Resource("World3D_ScanningOtherSaves")</p>
                    }
                    else if (_deletePreview is { } dp)
                    {
                        var rows = dp.Deletions.Where(r => _deleteKeys.Contains(r.Key)).ToList();
                        var itemGroups = rows.SelectMany(r => r.Contents).GroupBy(c => c.ItemId).Select(g => (Item: g.Key, Count: g.Sum(c => Math.Max(c.Count, 1)))).OrderByDescending(g => g.Count).ToList();
                        var linkCount = rows.Sum(r => r.OwnedSocketIds.Count + r.InboundLinks.Count);
                        <dl class="b3d-fields" data-b3d="delete-summary">
                            <dt>@L.Resource("World3D_DeleteObjectsRemoved")</dt><dd data-b3d="delete-objects">@rows.Count</dd>
                            <dt>@L.Resource("World3D_DeleteItemsDeleted")</dt><dd data-b3d="delete-items">@itemGroups.Sum(g => g.Count)</dd>
                            <dt>@L.Resource("World3D_DeleteReferences")</dt><dd data-b3d="delete-refs">@linkCount</dd>
                        </dl>
                        <small class="wt-muted" data-b3d="delete-scope" title="@string.Join(", ", Session.OtherSaveNames)">@(Session.OtherSaveNames.Count > 0
                            ? L.Resource("World3D_ScopeOtherSavesFormat", Session.OtherSaveNames.Count)
                            : L.Resource("World3D_ScopeThisSaveOnly"))@(Session.OtherSaveFailures.Count > 0 ? " " + L.Resource("World3D_ScopeUnreadableFormat", string.Join(", ", Session.OtherSaveFailures)) : "")</small>
                        @if (itemGroups.Count > 0)
                        {
                            <span class="wt-label">@L.Resource("World3D_DeleteItemList")</span>
                            <ul class="b3d-list" data-b3d="delete-item-list">
                                @foreach (var g in itemGroups.Take(40)) { <li>@g.Item x @g.Count</li> }
                                @if (itemGroups.Count > 40) { <li class="wt-muted">@L.Resource("World3D_SelectionMoreFormat", itemGroups.Count - 40)</li> }
                            </ul>
                        }
                        @if (linkCount > 0 || rows.Any(r => r.Bindings.Count > 0))
                        {
                            <span class="wt-label">@L.Resource("World3D_DeleteReferenceList")</span>
                            <ul class="b3d-list" data-b3d="delete-ref-list">
                                @foreach (var r in rows.Take(40))
                                {
                                    @if (r.OwnedSocketIds.Count > 0) { <li>@Base3DScene.FriendlyClass(r.ClassName): @L.Resource("World3D_RefOwnedFormat", r.OwnedSocketIds.Count)</li> }
                                    @foreach (var link in r.InboundLinks.Take(6)) { <li>@Base3DScene.FriendlyClass(r.ClassName): @L.Resource("World3D_RefInboundFormat", link.SourceSave, link.SourceEntryKey)</li> }
                                    @foreach (var b in r.Bindings) { <li>@Base3DScene.FriendlyClass(r.ClassName): @b.Kind (@b.Detail)</li> }
                                }
                            </ul>
                        }
                        @if (rows.Any(r => r.Actions.Count > 0))
                        {
                            <span class="wt-label">@L.Resource("World3D_DeleteActions")</span>
                            <ul class="b3d-list">
                                @foreach (var a in rows.SelectMany(r => r.Actions).GroupBy(a => a).Take(12)) { <li>@a.Key@(a.Count() > 1 ? $" (x{a.Count()})" : "")</li> }
                            </ul>
                        }
                        <span class="wt-label">@L.Resource("World3D_Issues")</span>
                        @IssueList(IssuesFor(dp.Issues, _deleteKeys, includeGeneral: false), "delete-issues")

                        <span class="wt-label">@L.Resource("World3D_PolicyTitle")</span>
                        <div class="b3d-policies" data-b3d="delete-policies">
                            @foreach (var row in DeletePolicyRows())
                            {
                                <label class="b3d-policy" @key="row.LabelKey">
                                    <span>@L.Resource(row.LabelKey)</span>
                                    <select class="wt-input" data-b3d="@row.Id" @onchange="e => row.Set(ParsePolicy(e.Value?.ToString()))">
                                        @foreach (var option in row.Allowed)
                                        {
                                            <option value="@option" selected="@(option == row.Current)">@L.Resource("World3D_Policy_" + option)</option>
                                        }
                                    </select>
                                    <small class="wt-muted">@L.Resource(row.HelpKey)</small>
                                </label>
                            }
                        </div>
                        @if (!dp.CanApply) { <p class="error-text" role="alert" data-b3d="delete-blocked">@L.Resource("World3D_CannotStage")</p> }
                    }
                    else
                    {
                        <p class="wt-muted">@L.Resource("World3D_NothingToEdit")</p>
                    }
                    <div class="b3d-links">
                        <button type="button" class="wt-btn b3d-danger" data-b3d="delete-confirm" disabled="@(_deleteBusy || _deletePreview is null || !_deletePreview.CanApply || _deleteKeys.Count == 0)"
                                @onclick="ConfirmDeleteAsync">@L.Resource("World3D_StageDelete")</button>
                        <button type="button" class="wt-btn wt-plain" data-b3d="delete-cancel" @onclick="CloseOperationPanels">@L.Resource("World3D_Cancel")</button>
                    </div>
                </div>
            }

            @if (_moveOptIn && _dupOpen)
            {
                <div class="wt-card b3d-panel b3d-op b3d-op-duplicate" data-b3d="duplicate-panel">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_DuplicateTitleFormat", _dupKeys.Count)</span>
                    <p class="error-text b3d-warning" role="alert" data-b3d="duplicate-unverified">@L.Resource("World3D_EditUnverified")</p>
                    <span class="wt-label">@L.Resource("World3D_DupOffset")</span>
                    <div class="b3d-numbers b3d-numbers3">
                        <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" value="@_dupX" data-b3d="dup-x" @onchange="OnDupXChanged" /></label>
                        <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" value="@_dupY" data-b3d="dup-y" @onchange="OnDupYChanged" /></label>
                        <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" value="@_dupZ" data-b3d="dup-z" @onchange="OnDupZChanged" /></label>
                    </div>
                    <div class="b3d-numbers">
                        <label>@L.Resource("World3D_GroupYawDegrees")<input class="wt-input" inputmode="decimal" value="@_dupYaw" data-b3d="dup-yaw" @onchange="OnDupYawChanged" /></label>
                        <label>@L.Resource("World3D_Pivot")
                            <select class="wt-input" data-b3d="dup-pivot" @onchange="OnDupPivotChanged">
                                <option value="@PivotCentroid" selected="@(_dupPivot == PivotCentroid)">@L.Resource("World3D_PivotCentroid")</option>
                                @foreach (var pk in _dupKeys.Take(60))
                                {
                                    <option value="@pk" selected="@(_dupPivot == pk)">@SelectionLabel(pk)</option>
                                }
                            </select></label>
                    </div>
                    @if (_dupError is not null) { <p class="error-text" role="alert">@_dupError</p> }
                    <span class="wt-label">@L.Resource("World3D_PolicyTitle")</span>
                    <label class="wt-check">
                        <input type="checkbox" data-b3d="dup-contents" checked="@_dupCopyContents" @onchange="OnDupContentsChanged" />
                        @L.Resource("World3D_DupCopyContents")
                    </label>
                    @if (_dupCopyContents) { <p class="error-text b3d-warning" role="alert" data-b3d="dup-contents-warning">@L.Resource("World3D_DupContentsWarning")</p> }
                    <div class="b3d-policies" data-b3d="duplicate-policies">
                        @foreach (var row in DuplicatePolicyRows())
                        {
                            <label class="b3d-policy" @key="row.LabelKey">
                                <span>@L.Resource(row.LabelKey)</span>
                                <select class="wt-input" data-b3d="@row.Id" @onchange="e => row.Set(ParsePolicy(e.Value?.ToString()))">
                                    @foreach (var option in row.Allowed)
                                    {
                                        <option value="@option" selected="@(option == row.Current)">@L.Resource("World3D_Policy_" + option)</option>
                                    }
                                </select>
                                <small class="wt-muted">@L.Resource(row.HelpKey)</small>
                            </label>
                        }
                    </div>
                    @if (_dupPreview is { } up)
                    {
                        var rows = up.Duplications.Where(r => r.DuplicationId == _dupPreviewId).ToList();
                        <dl class="b3d-fields" data-b3d="duplicate-summary">
                            <dt>@L.Resource("World3D_DupObjectsCreated")</dt><dd data-b3d="dup-objects">@rows.Count</dd>
                            <dt>@L.Resource("World3D_DupItemsCopied")</dt><dd data-b3d="dup-items">@rows.Where(r => r.Contents == ContentsMode.Copy).Sum(r => r.SourceContents.Sum(c => Math.Max(c.Count, 1)))</dd>
                            <dt>@L.Resource("World3D_DupOutlets")</dt><dd>@rows.Sum(r => r.Sockets.Count)</dd>
                        </dl>
                        <span class="wt-label">@L.Resource("World3D_Issues")</span>
                        @IssueList(IssuesFor(up.Issues, _dupKeys, includeGeneral: true), "duplicate-issues")
                        @HintList(up.ProximityHints)
                        @if (!up.CanApply) { <p class="error-text" role="alert" data-b3d="duplicate-blocked">@L.Resource("World3D_CannotStage")</p> }
                    }
                    <div class="b3d-links">
                        <button type="button" class="wt-btn" data-b3d="duplicate-confirm" disabled="@(_dupPreview is null || !_dupPreview.CanApply || _dupKeys.Count == 0 || _dupError is not null)"
                                @onclick="ConfirmDuplicateAsync">@L.Resource("World3D_StageDuplicate")</button>
                        <button type="button" class="wt-btn wt-plain" data-b3d="duplicate-cancel" @onclick="CloseOperationPanels">@L.Resource("World3D_Cancel")</button>
                    </div>
                </div>
            }

            @if (_selected.Count > 0)
            {
                <div class="wt-card b3d-panel" data-b3d="selection">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_SelectionFormat", _selected.Count)</span>
                    <div class="b3d-object-list b3d-selection-list">
                        @foreach (var (selKey, rowKey) in RenderKeys.With(_selected.Take(60).ToList(), k => k))
                        {
                            var k = selKey;
                            <div class="b3d-selection-row @(k == _selectedKey ? "primary" : null)" @key="rowKey" data-b3d="selection-row">
                                <button type="button" class="wt-btn wt-plain b3d-selection-name" @onclick="() => SetPrimaryAsync(k)" title="@L.Resource("World3D_MakePrimary")">@SelectionLabel(k)@(k == _selectedKey ? " *" : "")</button>
                                <button type="button" class="wt-btn wt-plain" aria-label="@L.Resource("World3D_RemoveFromSelection")" @onclick="() => RemoveFromSelectionAsync(k)">x</button>
                            </div>
                        }
                        @if (_selected.Count > 60) { <small class="wt-muted">@L.Resource("World3D_SelectionMoreFormat", _selected.Count - 60)</small> }
                    </div>
                </div>
            }

            <div class="wt-card b3d-panel" data-b3d="inspector">
                <span class="wt-label accent-orange-text">@L.Resource("World3D_Inspector")</span>
                @if (SelectedObject is not { } obj)
                {
                    @if (SelectedCopy is { } copy)
                    {
                        <strong class="b3d-title">@Base3DScene.FriendlyClass(copy.ClassName)</strong>
                        <p class="wt-muted" data-b3d="copy-inspector">@L.Resource("World3D_CopyInspectorFormat", copy.NewKey)</p>
                        <dl class="b3d-fields">
                            <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Describe(copy.After)</dd>
                        </dl>
                        <button type="button" class="wt-btn wt-plain" data-b3d="revert-copy" @onclick="() => RevertDuplicationAsync(copy.DuplicationId)">@L.Resource("World3D_RevertCopy")</button>
                    }
                    else
                    {
                        <p class="wt-muted">@L.Resource("World3D_NothingSelected")</p>
                    }
                }
                else
                {
                    var current = Session.CurrentPlacedTransform(obj.Key) ?? obj.Transform;
                    <strong class="b3d-title">@Base3DScene.LabelOf(obj)</strong>
                    <dl class="b3d-fields">
                        <dt>@L.Resource("World3D_Class")</dt><dd>@(obj.ClassName ?? "-")</dd>
                        <dt>@L.Resource("World3D_Origin")</dt><dd>@(obj.DeployedByPlayer == true ? L.Resource("World3D_OriginPlayer") : L.Resource("World3D_OriginLevel"))</dd>
                        <dt>@L.Resource("World3D_Key")</dt><dd class="b3d-mono">@obj.Key</dd>
                        @if (obj.ActorPath is not null) { <dt>@L.Resource("World3D_ActorPath")</dt><dd class="b3d-mono">@obj.ActorPath</dd> }
                        @if (obj.SubLevel is not null) { <dt>@L.Resource("World3D_SubLevel")</dt><dd>@obj.SubLevel</dd> }
                        @if (current?.Translation is { } t)
                        {
                            <dt>@L.Resource("World3D_Position")</dt><dd class="b3d-mono">@Num(t.X), @Num(t.Y), @Num(t.Z)</dd>
                        }
                        @if (current?.Rotation is { } r)
                        {
                            <dt>@L.Resource("World3D_Rotation")</dt><dd class="b3d-mono">yaw @Num(r.YawDegrees), pitch @Num(r.PitchDegrees), roll @Num(r.RollDegrees)</dd>
                        }
                        @if (current?.Scale3D is { } sc)
                        {
                            <dt>@L.Resource("World3D_Scale")</dt><dd class="b3d-mono">@Num(sc.X, 2), @Num(sc.Y, 2), @Num(sc.Z, 2)</dd>
                        }
                        @if (obj.CustomName is not null && obj.OwnerName is null) { <dt>@L.Resource("World3D_Name")</dt><dd>@obj.CustomName</dd> }
                        @if (obj.OwnerName is not null) { <dt>@L.Resource("World3D_Owner")</dt><dd>@obj.OwnerName</dd> }
                        @if (obj.StoredItemCount > 0) { <dt>@L.Resource("World3D_Items")</dt><dd>@obj.StoredItemCount</dd> }
                        @if (obj.PoweredBySocketIds.Count > 0) { <dt>@L.Resource("World3D_PoweredBy")</dt><dd class="b3d-mono">@string.Join(", ", obj.PoweredBySocketIds)</dd> }
                    </dl>
                    <div class="b3d-links">
                        @if (OnOpenContainer.HasDelegate && HasContainer(obj.Key))
                        {
                            <button type="button" class="wt-btn" data-b3d="open-container" @onclick="() => OnOpenContainer.InvokeAsync(obj.Key)">@L.Resource("World3D_OpenContainer")</button>
                        }
                        @if (OnOpenPowerSockets.HasDelegate && PowerSocketsAvailable
                            && (obj.PoweredBySocketIds.Count > 0 || PlacedObjectCategoryCatalog.Classify(obj.ClassName, obj.InventoryCount > 0) == PlacedObjectCategory.Power))
                        {
                            <button type="button" class="wt-btn" data-b3d="open-power" @onclick="() => OnOpenPowerSockets.InvokeAsync()">@L.Resource("World3D_OpenPower")</button>
                        }
                    </div>

                    @* EXTENSION POINT (delete and duplicate): wired. The buttons act on the whole selection,
                       open a confirmation panel with a preview (Core's StagedBaseEdits.Preview), and stage
                       through the same session as the move controls, so the unsaved-edit indicator, the staged
                       table and REVERT cover them. *@
                    <div class="b3d-extension-point" data-extension-point="placed-object-delete-duplicate">
                        @if (!_moveOptIn)
                        {
                            <span class="wt-muted">@L.Resource("World3D_EditNeedsOptIn")</span>
                        }
                        else
                        {
                            @if (Session.IsPlacedDeletionStaged(obj.Key))
                            {
                                <p class="error-text" data-b3d="staged-delete-note">@L.Resource("World3D_StagedForDeletion")
                                    <button type="button" class="wt-btn wt-plain" @onclick="() => RevertDeletionAsync(obj.Key)">@L.Resource("World3D_RevertObject")</button></p>
                            }
                            <div class="b3d-links">
                                <button type="button" class="wt-btn b3d-danger" data-b3d="delete-open" disabled="@(_selected.Count == 0)"
                                        @onclick="OpenDeleteAsync">@L.Resource("World3D_DeleteButtonFormat", _selected.Count)</button>
                                <button type="button" class="wt-btn" data-b3d="duplicate-open" disabled="@(_selected.Count == 0)"
                                        @onclick="OpenDuplicate">@L.Resource("World3D_DuplicateButtonFormat", _selected.Count)</button>
                            </div>
                        }
                    </div>

                    @if (_moveOptIn)
                    {
                        @if (obj.DeployedByPlayer != true)
                        {
                            <p class="error-text" role="alert" data-b3d="move-refused">@L.Resource("World3D_MoveLevelRefused")</p>
                        }
                        else if (obj.Transform?.Translation is null || obj.Transform.Rotation is null)
                        {
                            <p class="error-text" role="alert" data-b3d="move-refused">@L.Resource("World3D_MoveOmittedRefused")</p>
                        }
                        else
                        {
                            <div class="b3d-move" data-b3d="move-controls">
                                <span class="wt-label">@L.Resource("World3D_MoveGizmo")</span>
                                <div class="b3d-gizmo-modes" role="radiogroup" aria-label="@L.Resource("World3D_MoveGizmo")">
                                    @foreach (var mode in GizmoModes)
                                    {
                                        var m = mode;
                                        <label class="wt-check" @key="m">
                                            <input type="radio" name="b3d-gizmo" checked="@(_gizmo == m)" @onchange="() => SetGizmoAsync(m)" />
                                            @L.Resource("World3D_Gizmo" + char.ToUpperInvariant(m[0]) + m[1..])
                                        </label>
                                    }
                                </div>
                                <div class="b3d-numbers">
                                    <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" @bind="_xText" @bind:event="oninput" data-b3d="x" /></label>
                                    <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" @bind="_yText" @bind:event="oninput" data-b3d="y" /></label>
                                    <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" @bind="_zText" @bind:event="oninput" data-b3d="z" /></label>
                                    <label>@L.Resource("World3D_Yaw")<input class="wt-input" inputmode="decimal" @bind="_yawText" @bind:event="oninput" data-b3d="yaw" /></label>
                                </div>
                                @if (_numberError is not null) { <p class="error-text" role="alert">@_numberError</p> }
                                <div class="b3d-links">
                                    <button type="button" class="wt-btn" data-b3d="stage-numbers" @onclick="StageNumbersAsync">@L.Resource("World3D_StageNumbers")</button>
                                    <button type="button" class="wt-btn wt-plain" disabled="@(!Session.IsPlacedTransformStaged(obj.Key))" data-b3d="revert-object"
                                            @onclick="() => RevertObjectAsync(obj.Key)">@L.Resource("World3D_RevertObject")</button>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            @if (_moveOptIn && _selected.Count > 0)
            {
                <div class="wt-card b3d-panel" data-b3d="group-tools">
                    <span class="wt-label accent-orange-text">@L.Resource("World3D_GroupTools")</span>
                    <p class="wt-muted">@L.Resource("World3D_GroupToolsIntro")</p>
                    <span class="wt-label">@L.Resource("World3D_GroupMove")</span>
                    <div class="b3d-numbers b3d-numbers3">
                        <label>@L.Resource("World3D_X")<input class="wt-input" inputmode="decimal" @bind="_grpDx" @bind:event="oninput" data-b3d="grp-dx" /></label>
                        <label>@L.Resource("World3D_Y")<input class="wt-input" inputmode="decimal" @bind="_grpDy" @bind:event="oninput" data-b3d="grp-dy" /></label>
                        <label>@L.Resource("World3D_Z")<input class="wt-input" inputmode="decimal" @bind="_grpDz" @bind:event="oninput" data-b3d="grp-dz" /></label>
                    </div>
                    <button type="button" class="wt-btn" data-b3d="grp-move" @onclick="StageGroupMoveAsync">@L.Resource("World3D_GroupMoveButton")</button>

                    <span class="wt-label">@L.Resource("World3D_GroupRotate")</span>
                    <div class="b3d-numbers">
                        <label>@L.Resource("World3D_GroupYawDegrees")<input class="wt-input" inputmode="decimal" @bind="_grpYaw" @bind:event="oninput" data-b3d="grp-yaw" /></label>
                        <label>@L.Resource("World3D_Pivot")
                            <select class="wt-input" data-b3d="grp-pivot" @onchange="OnGroupPivotChanged">
                                <option value="@PivotCentroid" selected="@(_grpPivot == PivotCentroid)">@L.Resource("World3D_PivotCentroid")</option>
                                @foreach (var pk in _selected.Take(60))
                                {
                                    <option value="@pk" selected="@(_grpPivot == pk)">@SelectionLabel(pk)</option>
                                }
                            </select></label>
                    </div>
                    <button type="button" class="wt-btn" data-b3d="grp-rotate" @onclick="StageGroupRotateAsync">@L.Resource("World3D_GroupRotateButton")</button>

                    <span class="wt-label">@L.Resource("World3D_GroupSnap")</span>
                    <div class="b3d-numbers b3d-numbers3">
                        <label>@L.Resource("World3D_SnapStepXY")<input class="wt-input" inputmode="decimal" @bind="_snapXY" @bind:event="oninput" data-b3d="snap-xy" /></label>
                        <label>@L.Resource("World3D_SnapStepZ")<input class="wt-input" inputmode="decimal" @bind="_snapZ" @bind:event="oninput" data-b3d="snap-z" /></label>
                        <label>@L.Resource("World3D_SnapStepYaw")<input class="wt-input" inputmode="decimal" @bind="_snapYaw" @bind:event="oninput" data-b3d="snap-yaw" /></label>
                    </div>
                    <button type="button" class="wt-btn" data-b3d="grp-snap" @onclick="StageGroupSnapAsync">@L.Resource("World3D_GroupSnapButton")</button>

                    <span class="wt-label">@L.Resource("World3D_GroupArrange")</span>
                    <div class="b3d-links">
                        <button type="button" class="wt-btn" data-b3d="grp-align" disabled="@(_selectedKey is null || _selected.Count < 2)" @onclick="StageGroupAlignAsync">@L.Resource("World3D_GroupAlignYaw")</button>
                        <select class="wt-input b3d-axis" data-b3d="grp-axis" aria-label="@L.Resource("World3D_Axis")" @onchange="OnAxisChanged">
                            @foreach (var axis in new[] { "X", "Y", "Z" })
                            {
                                <option value="@axis" selected="@(_distAxis == axis)">@axis</option>
                            }
                        </select>
                        <button type="button" class="wt-btn" data-b3d="grp-distribute" disabled="@(_selected.Count < 3)" @onclick="StageGroupDistributeAsync">@L.Resource("World3D_GroupDistribute")</button>
                    </div>
                    @if (_groupFeedback is not null) { <p class="b3d-feedback" role="status" data-b3d="grp-feedback">@_groupFeedback</p> }
                </div>
            }

        </aside>
    </div>

    @if (Session.LastBaseEditRefusal.Count > 0)
    {
        <div class="wt-card b3d-panel b3d-refusal" role="alert" data-b3d="save-refused">
            <span class="wt-label">@L.Resource("World3D_SaveRefusedTitle")</span>
            <p>@L.Resource("World3D_SaveRefusedIntro")</p>
            @IssueList(Session.LastBaseEditRefusal, "save-refused-issues")
        </div>
    }

    @if (_basePreview is { } bp)
    {
        <div class="wt-card b3d-panel b3d-staged" data-b3d="staged">
            <span class="wt-label accent-orange-text">@L.Resource("World3D_Staged")</span>
            <p class="error-text b3d-warning" role="alert" data-b3d="staged-unverified">@L.Resource("World3D_EditUnverified")</p>
            <p class="wt-muted" data-b3d="staged-summary">@L.Resource("World3D_StagedSummaryFormat", bp.Transforms.Count, bp.Deletions.Count, bp.Duplications.Count, bp.ObjectsBefore, bp.ObjectsAfter, bp.ItemsDeleted, bp.ItemsCopied, bp.ReferencesAffected)</p>

            @if (_preview.Count > 0)
            {
                <span class="wt-label">@L.Resource("World3D_StagedMoves")</span>
                <div class="b3d-table-wrap">
                    <table class="b3d-table" data-b3d="staged-moves">
                        <thead>
                            <tr>
                                <th>@L.Resource("World3D_ColObject")</th>
                                <th>@L.Resource("World3D_ColBefore")</th>
                                <th>@L.Resource("World3D_ColAfter")</th>
                                <th>@L.Resource("World3D_ColMoved")</th>
                                <th>@L.Resource("World3D_ColTurned")</th>
                                <th>@L.Resource("World3D_ColWarnings")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, rowKey) in RenderKeys.With(_preview, r => r.Key))
                            {
                                <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)">
                                    <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.Key, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                    <td class="b3d-mono">@Describe(row.Before)</td>
                                    <td class="b3d-mono">@Describe(row.After)</td>
                                    <td class="b3d-mono">@(row.DistanceCm is { } d ? Num(d) : "-")</td>
                                    <td class="b3d-mono">@(row.YawDeltaDegrees is { } y ? Num(y) : "-")</td>
                                    <td class="b3d-notes">@string.Join(" ", row.Warnings)</td>
                                    <td><button type="button" class="wt-btn wt-plain" @onclick="() => RevertObjectAsync(row.Key)">@L.Resource("World3D_RevertObject")</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (bp.Deletions.Count > 0)
            {
                <span class="wt-label">@L.Resource("World3D_StagedDeletions")</span>
                <div class="b3d-table-wrap">
                    <table class="b3d-table b3d-table-delete" data-b3d="staged-deletions">
                        <thead>
                            <tr>
                                <th>@L.Resource("World3D_ColObject")</th>
                                <th>@L.Resource("World3D_ColItems")</th>
                                <th>@L.Resource("World3D_ColLinks")</th>
                                <th>@L.Resource("World3D_ColWarnings")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, rowKey) in RenderKeys.With(bp.Deletions, r => r.Key))
                            {
                                <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)" data-b3d="staged-delete-row">
                                    <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.Key, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                    <td class="b3d-mono">@row.Contents.Sum(c => Math.Max(c.Count, 1))</td>
                                    <td class="b3d-mono">@(row.OwnedSocketIds.Count + row.InboundLinks.Count)</td>
                                    <td class="b3d-notes">@string.Join(" ", row.Issues.Select(i => i.Message))</td>
                                    <td><button type="button" class="wt-btn wt-plain" data-b3d="revert-deletion" @onclick="() => RevertDeletionAsync(row.Key)">@L.Resource("World3D_RevertObject")</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (bp.Duplications.Count > 0)
            {
                <span class="wt-label">@L.Resource("World3D_StagedCopies")</span>
                <div class="b3d-table-wrap">
                    <table class="b3d-table b3d-table-copy" data-b3d="staged-copies">
                        <thead>
                            <tr>
                                <th>@L.Resource("World3D_ColObject")</th>
                                <th>@L.Resource("World3D_ColCopiedTo")</th>
                                <th>@L.Resource("World3D_ColItems")</th>
                                <th>@L.Resource("World3D_ColLinks")</th>
                                <th>@L.Resource("World3D_ColWarnings")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (row, rowKey) in RenderKeys.With(bp.Duplications, r => r.NewKey))
                            {
                                <tr @key="rowKey" class="@(row.Blocked ? "blocked" : null)" data-b3d="staged-copy-row">
                                    <td><button type="button" class="wt-btn wt-plain" @onclick="() => SelectAsync(row.NewKey, frame: true)">@Base3DScene.FriendlyClass(row.ClassName)</button></td>
                                    <td class="b3d-mono">@Describe(row.After)</td>
                                    <td class="b3d-mono">@(row.Contents == ContentsMode.Copy ? row.SourceContents.Sum(c => Math.Max(c.Count, 1)) : 0)</td>
                                    <td class="b3d-mono">@row.Sockets.Count</td>
                                    <td class="b3d-notes">@string.Join(" ", row.Issues.Select(i => i.Message))</td>
                                    <td><button type="button" class="wt-btn wt-plain" data-b3d="revert-duplication" @onclick="() => RevertDuplicationAsync(row.DuplicationId)">@L.Resource("World3D_RevertCopy")</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <span class="wt-label">@L.Resource("World3D_Issues")</span>
            @IssueList(bp.Issues, "staged-issues")
            @HintList(bp.ProximityHints)
            <div class="b3d-links">
                <button type="button" class="wt-btn" data-b3d="revert-all" @onclick="RevertAllAsync">@L.Resource("World3D_RevertAll")</button>
            </div>
        </div>
    }

    <div class="b3d-lists">
        <div class="wt-card b3d-panel" data-b3d="objects">
            <span class="wt-label">@L.Resource("World3D_Select")</span>
            <div class="b3d-object-list">
                @foreach (var (index, rowKey) in RenderKeys.With(ListedIndexes(), i => _scene.Objects[i].Key))
                {
                    var o = _scene.Objects[index];
                    <button type="button" class="wt-row b3d-object-row @(IsSelected(o.Key) ? "selected" : null)" @key="rowKey" data-b3d="object-row"
                            @onclick="e => ClickListAsync(o.Key, e)">
                        <span class="b3d-swatch" style="background:@CategoryColor((PlacedObjectCategory)o.Cat)"></span>
                        <span class="wt-row-text">@o.Label</span>
                        <small>@(o.Built ? L.Resource("World3D_PlayerBuilt") : L.Resource("World3D_LevelPlaced"))</small>
                    </button>
                }
            </div>
        </div>

        @if (_scene.Unresolved.Count > 0)
        {
            <div class="wt-card b3d-panel" data-b3d="unresolved">
                <span class="wt-label">@L.Resource("World3D_UnresolvedTitle", _scene.Unresolved.Count)</span>
                <p class="wt-muted">@L.Resource("World3D_UnresolvedIntro")</p>
                <div class="b3d-object-list">
                    @foreach (var (item, rowKey) in RenderKeys.With(_scene.Unresolved.Take(200), u => u.Key))
                    {
                        <button type="button" class="wt-row b3d-object-row @(item.Key == _selectedKey ? "selected" : null)" @key="rowKey"
                                @onclick="() => SelectUnresolved(item.Key)">
                            <span class="wt-row-text">@item.Label</span>
                            <small>@L.Resource("World3D_UnresolvedReasonFormat", item.Built ? L.Resource("World3D_PlayerBuilt") : L.Resource("World3D_LevelPlaced"), item.Reason)</small>
                        </button>
                    }
                </div>
            </div>
        }
    </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public WorldSaveSession Session { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "World editor";
    [Parameter] public EventCallback<string?> OnError { get; set; }

    /// <summary>Jump to the CONTAINERS tab filtered to this object's key.</summary>
    [Parameter] public EventCallback<string> OnOpenContainer { get; set; }

    /// <summary>Jump to the power sockets tab.</summary>
    [Parameter] public EventCallback OnOpenPowerSockets { get; set; }

    /// <summary>True when this save has a power sockets tab to jump to.</summary>
    [Parameter] public bool PowerSocketsAvailable { get; set; }


    private static readonly string[] GizmoModes = ["off", "translate", "rotate"];
    private const int ListLimit = 150;

    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _view;
    private DotNetObjectReference<WorldBases3DTab>? _self;
    private bool _viewReady;
    private bool _webGlMissing;
    private bool _disposed;
    private bool _pushScene = true;

    private Base3DScene _scene = Base3DScene.Build([], _ => null);
    private IReadOnlyList<PlacedObjectSummary>? _sceneSource;
    private int _sceneRevision = -1;
    private Base3DFilter _filter = new();
    private int[] _visible = [];
    private IReadOnlyList<TransformPreviewRow> _preview = [];
    private string? _selectedKey; // the primary selection; every selected key is in _selected
    private bool _labels;
    private bool _moveOptIn;
    private string _gizmo = "off";
    private string _xText = "", _yText = "", _zText = "", _yawText = "";
    private string? _numberError;

    private PlacedObjectSummary? SelectedObject => _selectedKey is null ? null : Session.FindPlacedObject(_selectedKey);

    protected override void OnInitialized() => Workspace.Changed += WorkspaceChanged;

    protected override void OnParametersSet() => SyncFromSession();

    private void WorkspaceChanged()
    {
        if (_disposed) return;
        _ = InvokeAsync(() =>
        {
            SyncFromSession();
            StateHasChanged();
        });
    }

    /// <summary>Rebuilds the scene when the session's saved objects or staged edits changed (SAVE, REVERT, an edit).</summary>
    private void SyncFromSession()
    {
        var source = Session.PlacedObjects;
        var revision = Session.PlacedTransformsRevision;
        if (ReferenceEquals(source, _sceneSource) && revision == _sceneRevision) return;
        _sceneSource = source;
        _sceneRevision = revision;
        _basePreview = Session.HasStagedBaseEdits ? Session.PreviewBaseEdits() : null;
        _preview = _basePreview?.Transforms ?? [];
        _scene = Base3DScene.Build(source, Session.CurrentPlacedTransform,
            Session.StagedPlacedDeletions.Keys.ToHashSet(StringComparer.Ordinal), CopiesToDraw());
        _visible = _scene.Apply(_filter);
        _pushScene = true;
        PruneSelection();
        LoadNumbers();
        RefreshOpenPanels();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            try
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/AbioticEditor.Web.Shared/base3d.js");
                if (!await _module.InvokeAsync<bool>("isWebGlAvailable"))
                {
                    _webGlMissing = true;
                    StateHasChanged();
                    return;
                }
                _self = DotNetObjectReference.Create(this);
                _view = await _module.InvokeAsync<IJSObjectReference>("createView", _host, _self);
                _viewReady = true;
                StateHasChanged();
                await InitModelsAsync();
            }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
            {
                _webGlMissing = true;
                StateHasChanged();
                return;
            }
        }
        if (_view is not null && _pushScene)
        {
            _pushScene = false;
            await PushSceneAsync();
        }
    }

    private async Task PushSceneAsync()
    {
        if (_view is null) return;
        try
        {
            await _view.InvokeVoidAsync("setScene", _scene.Objects);
            await _view.InvokeVoidAsync("setVisible", _visible);
            await PushGhostsAsync();
            await _view.InvokeVoidAsync("setLabels", _labels);
            await _view.InvokeVoidAsync("setSelection", _selected, _selectedKey);
            await _view.InvokeVoidAsync("setGizmo", EffectiveGizmo);
            if (!_framedOnce && _scene.Objects.Count > 0)
            {
                _framedOnce = true;
                await _view.InvokeVoidAsync("frameVisible", true);
            }
        }
        catch (JSDisconnectedException) { }
    }

    private bool _framedOnce;

    /// <summary>Pink outlines at the saved location of every moved object; red outlines around objects staged for deletion.</summary>
    private async Task PushGhostsAsync()
    {
        if (_view is null) return;
        var ghosts = new List<object>();
        foreach (var edit in Session.StagedPlacedTransforms)
        {
            if (Session.FindPlacedObject(edit.Key) is { Transform: { } saved } row) ghosts.Add(Base3DScene.ToViewerObject(row, saved));
        }
        foreach (var key in Session.StagedPlacedDeletions.Keys)
        {
            if (Session.FindPlacedObject(key) is { } row && (Session.CurrentPlacedTransform(key) ?? row.Transform) is { } now)
            {
                var o = Base3DScene.ToViewerObject(row, now);
                ghosts.Add(new { o.Cat, o.P, o.Q, o.S, o.Cls, Color = 0xff3b30 });
            }
        }
        await _view.InvokeVoidAsync("setGhosts", ghosts);
    }

    // ---- game models (optional plugin) ---------------------------------------------------------
    /// <summary>What the host's model endpoint reports (see SceneModelHostService).</summary>
    public sealed record ModelStatus(bool Available, bool Installed, string? Title, string? Plugin);

    private static readonly int[] LevelRadii = [20, 40, 80, 150];
    private static readonly int[] LevelCuts = [0, 2, 3, 5, 10];

    private ModelStatus? _modelStatus;
    private bool _modelsOn;
    private string? _modelProgress;
    private bool _levelOn;
    private int _levelRadius = 40;
    private int _levelCut = 2;
    private string? _levelProgress;

    /// <summary>The region this save covers, which names the game level to draw (null for a non-region save).</summary>
    private string? LevelRegion => Base3DScene.RegionOf(Session.Path);

    /// <summary>
    /// Game models are on by default whenever the optional plugin can supply them; the level (slow
    /// the very first time) waits until it is asked for. A failure here only leaves the boxes.
    /// </summary>
    private async Task InitModelsAsync()
    {
        if (_view is null) return;
        try
        {
            _modelStatus = await _view.InvokeAsync<ModelStatus>("modelStatus");
            _modelsOn = _modelStatus.Available;
            if (_modelsOn) await _view.InvokeVoidAsync("setModelsEnabled", true);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or System.Text.Json.JsonException or NotSupportedException)
        {
            AbioticEditor.Core.Diagnostics.EditorLog.Warn("Scene", $"Game models unavailable in the 3D view ({ex.GetType().Name})");
            _modelStatus = null;
            _modelsOn = false;
        }
        StateHasChanged();
    }

    private async Task SetModelsAsync(bool on)
    {
        _modelsOn = on;
        if (_view is not null) await _view.InvokeVoidAsync("setModelsEnabled", on);
    }

    private async Task SetLevelAsync(bool on)
    {
        _levelOn = on;
        _levelProgress = null;
        await PushLevelAsync();
    }

    private async Task SetLevelRadiusAsync(string? value)
    {
        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var r) && LevelRadii.Contains(r)) _levelRadius = r;
        await PushLevelAsync();
    }

    private async Task SetLevelCutAsync(string? value)
    {
        if (int.TryParse(value, NumberStyles.Integer, CultureInfo.InvariantCulture, out var c) && LevelCuts.Contains(c)) _levelCut = c;
        if (_view is not null) await _view.InvokeVoidAsync("setLevelCut", _levelCut);
    }

    private async Task ReloadLevelAsync()
    {
        if (_view is not null) await _view.InvokeVoidAsync("reloadLevel");
    }

    private async Task PushLevelAsync()
    {
        if (_view is null) return;
        await _view.InvokeVoidAsync("setLevel", new
        {
            enabled = _levelOn && LevelRegion is not null,
            region = LevelRegion,
            radius = _levelRadius,
            cutAbove = _levelCut,
            excludeActors = _scene.LevelActorNames(),
        });
    }

    /// <summary>A click on level geometry (reference only) names the piece; a click elsewhere clears it.</summary>
    [JSInvokable]
    public Task OnLevelPicked(string? name)
    {
        if (_levelPicked == name) return Task.CompletedTask;
        _levelPicked = name;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private string? _levelPicked;

    /// <summary>Progress from the viewer while it loads models ("models") or the level ("level").</summary>
    [JSInvokable]
    public Task OnModelProgress(string kind, int done, int total, string? note)
    {
        if (string.Equals(kind, "models", StringComparison.Ordinal))
        {
            _modelProgress = note == "error" ? L.Resource("World3D_ModelsError")
                : done >= total ? L.Resource("World3D_ModelsDone")
                : L.Resource("World3D_ModelsProgressFormat", done, total);
        }
        else
        {
            // For a finished level load, done is the piece count and total the files still being read.
            _levelProgress = note switch
            {
                "query" => L.Resource("World3D_LevelQuerying"),
                "meshes" => L.Resource("World3D_LevelMeshesFormat", done, total),
                "none" => L.Resource("World3D_LevelNone"),
                "error" => L.Resource("World3D_LevelError"),
                _ when total > 0 => L.Resource("World3D_LevelReadingFormat", done, total),
                _ => L.Resource("World3D_LevelShownFormat", done),
            };
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

