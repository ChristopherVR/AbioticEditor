    private HostedSceneryReader? HostedScenery => InBrowser ? Services.GetService(typeof(HostedSceneryReader)) as HostedSceneryReader : null;

    /// <summary>The "download the level?" card is up. Shown each time the view opens until the player says yes.</summary>
    private bool _askScenery;

    /// <summary>The player agreed: remembered in this browser, then the level loads.</summary>
    private async Task AllowSceneryAsync()
    {
        HostedScenery?.SetAllowed(true);
        _askScenery = false;
        await InitModelsAsync();
    }

    /// <summary>Forgets the agreement and goes back to boxes; nothing more is downloaded.</summary>
    private async Task StopSceneryAsync()
    {
        HostedScenery?.SetAllowed(false);
        _modelStatus = null;
        _levelProgress = null;
        if (_module is not null) await _module.InvokeVoidAsync("useHostedScenery", (object?)null);
        await PushLevelAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Game models and the level around the view are on by default whenever the game files can be
    /// read; both load in the background. A failure here only leaves the boxes.
    /// </summary>
    private async Task InitModelsAsync()
    {
        if (_view is null) return;
        try
        {
            if (InBrowser)
            {
                // No game here: the level comes from the website's prepared scenery, when this host has a reader for
                // it and the player has agreed to the download (asked here, each time, until they do).
                if (_module is null || HostedScenery is not { } hosted || LevelRegion is null) return;
                if (!hosted.Allowed)
                {
                    _askScenery = true;
                    StateHasChanged();
                    return;
                }
                _hostedScenery ??= DotNetObjectReference.Create(hosted);
                await _module.InvokeVoidAsync("useHostedScenery", _hostedScenery);
            }
            _modelStatus = await _view.InvokeAsync<ModelStatus>("modelStatus");
            // Only level scenery is hosted, so in the browser placed objects keep their boxes.
            _modelsOn = _modelStatus.Available && !InBrowser && (_keptModelsOn ?? true);
            if (_modelsOn) await _view.InvokeVoidAsync("setModelsEnabled", true);
            // The level waits for this answer: without the game files there is no level to draw.
            if (_levelOn && _modelStatus.Available) await PushLevelAsync();
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException or System.Text.Json.JsonException or NotSupportedException)
        {
            AbioticEditor.Core.Diagnostics.EditorLog.Warn("Scene", $"Game models unavailable in the 3D view ({ex.GetType().Name})");
            _modelStatus = null;
            _modelsOn = false;
        }
        StateHasChanged();
    }

