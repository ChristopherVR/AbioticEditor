    /// <summary>Pink outlines at the saved location of every moved object; red outlines around objects staged for deletion.</summary>
    private async Task PushGhostsAsync()
    {
        if (_view is null) return;
        var ghosts = new List<object>();
        foreach (var edit in Session.StagedPlacedTransforms)
        {
            if (Session.FindPlacedObject(edit.Key) is { Transform: { } saved } row) ghosts.Add(Base3DScene.ToViewerObject(row, saved));
        }
        foreach (var key in Session.StagedPlacedDeletions.Keys)
        {
            if (Session.FindPlacedObject(key) is { } row && (Session.CurrentPlacedTransform(key) ?? row.Transform) is { } now)
            {
                var o = Base3DScene.ToViewerObject(row, now);
                ghosts.Add(new { o.Cat, o.P, o.Q, o.S, o.Cls, Color = 0xff3b30 });
            }
        }
        await _view.InvokeVoidAsync("setGhosts", ghosts);
    }

