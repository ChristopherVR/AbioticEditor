    /// <summary>
    /// The POWER card for one object, saved or staged to be placed: where it takes power from, plugging
    /// it in elsewhere (nearest outlets first), and its own outlets.
    /// </summary>
    private RenderFragment PowerCard(string key) =>
        @<div class="b3d-power" data-b3d="power-card">
            <span class="wt-label">@L.Resource("World3D_Power")</span>
            @if (Session.PowerFeedOf(key) is { } feed)
            {
                <p class="wt-muted" data-b3d="power-feed">@(feed.File is null ? L.Resource("World3D_PowerFedFormat", feed.Label) : L.Resource("World3D_PowerFedElsewhereFormat", feed.Label, feed.File))</p>
                @if (feed.File is null)
                {
                    <button type="button" class="wt-btn wt-plain" data-b3d="power-unplug" @onclick="() => UnplugPowerAsync(feed.SocketId)">@L.Resource("PowerRewire_Unplug")</button>
                }
            }
            else
            {
                <p class="wt-muted" data-b3d="power-feed">@L.Resource("World3D_PowerNotPlugged")</p>
            }
            <label class="b3d-power-plug">@L.Resource("World3D_PowerPlugInto")
                <select class="wt-input" data-b3d="power-socket" @onchange="e => _powerSocketChoice = e.Value?.ToString()">
                    <option value="">@L.Resource("World3D_PowerChooseSocket")</option>
                    @foreach (var s in Session.PowerSocketsNear(key))
                    {
                        <option value="@s.SocketId" selected="@(_powerSocketChoice == s.SocketId)">@PowerSocketText(s)</option>
                    }
                </select>
            </label>
            @if (_moveOptIn)
            {
                @* A routed cable is a chain of plugs through cable reroutes; the route tool places them. *@
                <label class="wt-check">
                    <input type="checkbox" checked="@_routeOn" data-b3d="power-route" @onchange="e => { _routeOn = e.Value is true; _routeError = null; }" />
                    @L.Resource("World3D_RouteThrough")
                </label>
                @if (_routeOn)
                {
                    <p class="wt-muted" data-b3d="route-hint">@(_routePoints.Count == 0 ? L.Resource("World3D_RouteStraightHint") : L.Resource("World3D_RoutePointsFormat", _routePoints.Count))</p>
                    <div class="b3d-links">
                        <button type="button" class="wt-btn wt-plain" data-b3d="route-add" @onclick="AddRoutePointAsync">@L.Resource("World3D_RouteAddPoint")</button>
                        @if (_routePoints.Count > 0) { <button type="button" class="wt-btn wt-plain" data-b3d="route-clear" @onclick="() => _routePoints.Clear()">@L.Resource("World3D_RouteClear")</button> }
                    </div>
                }
                @if (_routeError is not null) { <p class="error-text" role="alert" data-b3d="route-error">@_routeError</p> }
            }
            <button type="button" class="wt-btn" data-b3d="power-plug" disabled="@string.IsNullOrEmpty(_powerSocketChoice)" @onclick="() => PlugPowerAsync(key)">@L.Resource("PowerRewire_Plug")</button>
            @foreach (var issue in Session.PreviewBaseEdits().PowerLinks.Where(r => r.DeviceAfter == key).SelectMany(r => r.Issues).DistinctBy(i => i.Message))
            {
                <p class="wt-muted @(issue.IsBlocking ? "error-text" : null)" data-b3d="power-finding">@issue.Message</p>
            }
            @if (Session.FirstOutletOf(key) is { } outlet)
            {
                <PowerRewirePanel Session="Session" SocketKey="@outlet" OnChanged="PowerChangedAsync" />
            }
        </div>;

    private async Task PlugPowerAsync(string deviceKey)
    {
        if (_powerSocketChoice is not { Length: > 0 } socket) return;
        _routeError = null;
        if (_moveOptIn && _routeOn)
        {
            if (Session.CableRerouteDonor() is not { } donor)
            {
                _routeError = L.Resource("World3D_RouteNoReroute");
                return;
            }
            var points = _routePoints.ToList();
            if (points.Count == 0)
            {
                // A straight run between the two ends, when both have a place in this save.
                if (WorldSaveSession.SocketOwner(socket) is not { } owner || Session.PositionAfterStaging(owner) is not { } a
                    || Session.PositionAfterStaging(deviceKey) is not { } b)
                {
                    _routeError = L.Resource("World3D_RouteNeedsPoints");
                    return;
                }
                points = [.. WorldSaveSession.StraightRoute(a, b)];
            }
            if (Session.StagePowerRoute(socket, deviceKey, points, donor) is null)
            {
                _routeError = L.Resource("World3D_PlaceRefused");
                return;
            }
            _routePoints.Clear();
        }
        else
        {
            Session.StagePowerPlug(socket, deviceKey);
        }
        _powerSocketChoice = null;
        await PowerChangedAsync();
    }

    private bool _routeOn;
    private string? _routeError;
    private readonly List<PlacedVector> _routePoints = [];

    /// <summary>Adds the point under the middle of the view (a wall or ceiling the cable should hang from) to the route.</summary>
    private async Task AddRoutePointAsync()
    {
        if (_view is null) return;
        try
        {
            var p = await _view.InvokeAsync<double[]>("placementPoint");
            if (p is { Length: 3 }) _routePoints.Add(PlacedSceneSpace.FromViewer(new PlacedVector(p[0], p[1], p[2])));
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException) { }
    }

    private async Task UnplugPowerAsync(string socketId)
    {
        Session.StagePowerUnplug(socketId);
        await PowerChangedAsync();
    }

    private async Task PowerChangedAsync()
    {
        Workspace.NotifyEdited();
        await AfterEditAsync(PlacedTransformStageResult.Ok);
    }

    /// <summary>
    /// Draws the power cables of the selected object (its feed and what its outlets power), staged
    /// changes included, as lines between saved positions.
    /// </summary>
    private async Task PushCablesAsync()
    {
        if (_view is null) return;
        if (_cablesFor == _selectedKey && _cablesRevision == Session.PlacedTransformsRevision) return;
        _cablesFor = _selectedKey;
        _cablesRevision = Session.PlacedTransformsRevision;
        var cables = new List<double[]>();
        if (_selectedKey is { } key)
        {
            foreach (var (from, to) in Session.PowerLinksAround(key))
            {
                if (Session.PositionAfterStaging(from) is not { } a || Session.PositionAfterStaging(to) is not { } b) continue;
                var va = PlacedSceneSpace.ToViewer(a);
                var vb = PlacedSceneSpace.ToViewer(b);
                cables.Add([va.X, va.Y, va.Z, vb.X, vb.Y, vb.Z]);
            }
        }
        try { await _view.InvokeVoidAsync("setCables", cables); }
        catch (JSDisconnectedException) { }
    }

    // ---- JS callbacks -------------------------------------------------------------------------
    /// <summary>A click in the 3D view: a plain click selects one object, ctrl/shift-click adds or removes one.</summary>
    [JSInvokable]
    public async Task OnPicked(string? key, bool additive)
    {
        await PickAsync(key, additive, frame: false);
        StateHasChanged();
    }

    /// <summary>
    /// The gizmo drag ended. The viewer-space result is converted back to the save's space here
    /// (PlacedSceneSpace) and staged; only the member the chosen handle changes is staged, so a
    /// translate never rewrites the rotation and the other way round.
    /// </summary>
    [JSInvokable]
    public async Task OnGizmoCommitted(string key, string mode, double[] position, double[] rotation)
    {
        PlacedTransformStageResult result;
        if (string.Equals(mode, "translate", StringComparison.Ordinal))
        {
            var t = PlacedSceneSpace.FromViewer(new PlacedVector(position[0], position[1], position[2]));
            result = Session.StagePlacedTransform(key, t, null);
        }
        else
        {
            var r = PlacedSceneSpace.FromViewer(new PlacedQuaternion(rotation[0], rotation[1], rotation[2], rotation[3]));
            result = Session.StagePlacedTransform(key, null, r);
        }
        await AfterEditAsync(result);
    }

    /// <summary>A selection of several pieces was dragged: staged as one group move (viewer metres to save centimetres).</summary>
    [JSInvokable]
    public async Task OnGroupDragged(double[] from, double[] to)
    {
        var a = PlacedSceneSpace.FromViewer(new PlacedVector(from[0], from[1], from[2]));
        var b = PlacedSceneSpace.FromViewer(new PlacedVector(to[0], to[1], to[2]));
        await RunGroupAsync(keys => Session.StageGroupMove(keys, b.X - a.X, b.Y - a.Y, b.Z - a.Z));
        StateHasChanged();
    }

    /// <summary>R (or Shift+R) in Edit mode: turns the selection about its centre.</summary>
    [JSInvokable]
    public async Task OnRotateKey(double degrees)
    {
        if (!_moveOptIn || _selected.Count == 0) return;
        await RunGroupAsync(keys => Session.StageGroupRotate(keys, degrees, PivotFor(PivotCentroid, keys)));
        StateHasChanged();
    }

    /// <summary>Delete in Edit mode: opens the removal check for the selection.</summary>
    [JSInvokable]
    public async Task OnDeleteKey()
    {
        if (!_moveOptIn || _selected.Count == 0) return;
        await StartDeleteAsync();
        StateHasChanged();
    }

    /// <summary>
    /// Ctrl+D in Edit mode: copies the selection beside itself straight away when nothing needs a
    /// decision; otherwise the copy panel opens with the choices to make.
    /// </summary>
    [JSInvokable]
    public async Task OnDuplicateKey()
    {
        if (!_moveOptIn || _selected.Count == 0) return;
        await StartDuplicateAsync();
        if (_dupPreview is { CanApply: true } preview && !preview.Issues.Any(i => i.Severity == BaseEditSeverity.Blocking) && _dupError is null)
            await ConfirmDuplicateAsync();
        StateHasChanged();
    }

