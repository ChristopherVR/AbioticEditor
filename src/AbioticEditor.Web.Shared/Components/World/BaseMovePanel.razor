@namespace AbioticEditor.Web.Components.World
@using System.Globalization
@inject SaveWorkspaceSessionService Workspace
@inject ISaveExporter Exporter
@inject AbioticEditor.Ui.IFilePicker FilePicker
@inject ToastService Toasts

@* Moving a base (GitHub issue 69), shared by the Bases map and the 3D view:
     - Move: the chosen pieces go to another area: another world on this computer, or another area of
       this world (a portal world, say). They go to a place picked from a list (the same spot, a
       sector of the Facility, beside a base already there) and can be shifted and turned first; a
       picture shows them over what already stands there. One SAVE writes both saves (the one
       receiving them first).
     - Export: the pieces go into a base file, to keep or share, optionally removed from this world.
     - Import: a base file, or a base brought straight from another world or area, is put down here.
       In the 3D view it can then be dragged and turned like any piece until SAVE.
   Only pieces a player built ever move. Everything stored inside them comes along, links between
   them are kept and links to anything left behind are dropped. *@
<div class="wt-card b3d-panel b3d-op base-move" data-base-move-panel="@Mode">
    <div class="b3d-panel-head">
        <span class="wt-label accent-orange-text">@Title()</span>
        <button type="button" class="b3d-close" aria-label="@L.Resource("World3D_Cancel")" data-base-move="close" @onclick="CloseAsync">&#x2715;</button>
    </div>

    @if (Mode == ImportMode && _package is null)
    {
        @* Where an imported base comes from: a base file, or straight from another world or area. *@
        <p class="wt-muted">@L.Resource("BaseMove_ImportIntro")</p>
        <div class="b3d-links">
            <button type="button" class="wt-btn" data-base-move="pick-file" disabled="@_busy" @onclick="PickFileAsync">@L.Resource("BaseMove_PickFile")</button>
        </div>
        @if (_areas.Count > 0)
        {
            <span class="wt-label">@L.Resource("BaseMove_BringTitle")</span>
            <p class="wt-muted">@L.Resource("BaseMove_BringIntro")</p>
            <BaseAreaPicker Areas="AreaList" Purpose="@BaseAreaPicker.FromPurpose" SelectedPath="@_sourcePath" Disabled="@_busy" OnPicked="ChooseSourceAsync" />
            @if (_source is not null)
            {
                @if (_sourceBases.Count == 0)
                {
                    <p class="wt-muted" data-base-move="no-bases">@L.Resource("BaseMove_NoBasesThere")</p>
                }
                else
                {
                    <label class="wt-field">
                        <span>@L.Resource("BaseMove_BringWhich")</span>
                        <select class="wt-input" data-base-move="source-base" disabled="@_busy" @onchange="e => ChooseSourceBaseAsync(e.Value?.ToString())">
                            <option value="" selected="true">@L.Resource("BaseMove_ChooseBase")</option>
                            @foreach (var b in _sourceBases)
                            {
                                <option value="@b.Base.Name">@L.Resource("BaseMove_BaseOptionFormat", b.Base.Name, b.Keys.Count)</option>
                            }
                        </select>
                    </label>
                }
            }
        }
        @if (_busy) { <p class="wt-muted" data-base-move="loading">@L.Resource("BaseMove_LoadingWorld")</p> }
        @if (_error is not null) { <p class="error-text" role="alert" data-base-move="error">@_error</p> }
    }
    else if (_package is null)
    {
        @if (_error is not null) { <p class="error-text" role="alert" data-base-move="error">@_error</p> }
        else { <p class="wt-muted">@L.Resource("BaseMove_NothingToMove")</p> }
    }
    else
    {
        var package = _package;
        @* What moves: the pieces by kind, what is inside them, and what was left out. *@
        <dl class="b3d-fields" data-base-move="summary">
            <dt>@L.Resource("BaseMove_Pieces")</dt><dd data-base-move="pieces">@package.Pieces.Count</dd>
            <dt>@L.Resource("BaseMove_ItemsInside")</dt><dd data-base-move="items">@package.StoredItems</dd>
            @if (Mode == ImportMode && SourceLabel() is { } from) { <dt>@L.Resource("BaseMove_FromWorld")</dt><dd>@from</dd> }
        </dl>
        @if (_skippedLevel > 0) { <p class="wt-muted" data-base-move="skipped">@L.Resource("BaseMove_SkippedLevelFormat", _skippedLevel)</p> }
        @if (OtherFloorCount > 0) { <p class="wt-muted" data-base-move="other-floors">@L.Resource("BaseMove_OtherFloorsFormat", OtherFloorCount)</p> }
        <details class="b3d-details" data-base-move="kinds">
            <summary>@L.Resource("BaseMove_WhatMoves")</summary>
            <ul class="b3d-list">
                @{ var kinds = package.Pieces.GroupBy(p => Base3DScene.FriendlyClass(p.ClassName)).OrderByDescending(g => g.Count()).ThenBy(g => g.Key, StringComparer.CurrentCultureIgnoreCase).ToList(); }
                @foreach (var (kind, kindKey) in RenderKeys.With(kinds, g => g.Key))
                {
                    var items = kind.Sum(p => p.StoredItems);
                    <li @key="kindKey">@kind.Key x @kind.Count()@(items > 0 ? " · " + L.Resource("BaseMove_KindItemsFormat", items) : "")</li>
                }
            </ul>
        </details>

        @if (Mode == MoveMode)
        {
            @if (_staged is not null)
            {
                <p class="b3d-feedback" role="status" data-base-move="moved">@L.Resource("BaseMove_MovedFormat", package.Pieces.Count, _targetLabel ?? "")</p>
                @if (_fitNote is not null) { <p class="wt-muted b3d-warning" data-base-move="fit-note">@_fitNote</p> }
                <p class="wt-muted">@L.Resource("BaseMove_SaveWritesBoth")</p>
                <div class="b3d-links">
                    <button type="button" class="wt-btn" data-base-move="change-spot" @onclick="OpenPlacing">@L.Resource("BaseMove_ChangeSpot")</button>
                    <button type="button" class="wt-btn wt-plain" data-base-move="undo" @onclick="UndoMoveAsync">@L.Resource("BaseMove_Undo")</button>
                    <button type="button" class="wt-btn" data-base-move="done" @onclick="CloseAsync">@L.Resource("BaseMove_Done")</button>
                </div>
            }
            else if (_areas.Count == 0)
            {
                <p class="wt-muted" data-base-move="no-worlds">@L.Resource(Session.CanReachOtherWorlds ? "BaseMove_NoOtherWorlds" : "BaseMove_NoOtherWorldsHere")</p>
                @if (SwitchMode.HasDelegate)
                {
                    <button type="button" class="wt-btn" data-base-move="to-export" @onclick="() => SwitchMode.InvokeAsync(ExportMode)">@L.Resource("BaseMove_UseExport")</button>
                }
            }
            else
            {
                <BaseAreaPicker Areas="AreaList" SelectedPath="@_targetPath" Disabled="@_busy" OnPicked="ChooseTargetAsync" />
                @if (_busy) { <p class="wt-muted" data-base-move="loading">@L.Resource("BaseMove_LoadingWorld")</p> }
            }
        }

        @if ((Mode == ImportMode) || (Mode == MoveMode && _target is not null && _staged is null))
        {
            @Placement()
        }

        @if (RemovalSession is { } remover && _staged is null && (Mode == ExportMode || (Mode == MoveMode && _target is not null) || (Mode == ImportMode && _source is not null)))
        {
            <label class="wt-check">
                <input type="checkbox" data-base-move="remove" checked="@_removeHere" @onchange="OnRemoveChanged" />
                @(Mode switch
                {
                    MoveMode => L.Resource("BaseMove_RemoveAfterMove"),
                    ImportMode => L.Resource("BaseMove_RemoveFromSourceFormat", SourceLabel() ?? ""),
                    _ => L.Resource("BaseMove_RemoveAfterExport"),
                })
            </label>
            @if (_removeHere && _scanning)
            {
                <p class="wt-muted" data-base-move="scanning">@L.Resource("World3D_ScanningOtherSaves")</p>
            }
            else if (_removeHere && _removal is { } removal)
            {
                var blocking = removal.Issues.Where(i => i.IsBlocking).ToList();
                @if (blocking.Count > 0)
                {
                    <p class="error-text" role="alert" data-base-move="remove-blocked">@L.Resource("BaseMove_RemoveBlocked")</p>
                    <ul class="b3d-list">@foreach (var i in blocking.Select(i => i.Message).Distinct().Take(6)) { <li>@i</li> }</ul>
                }
                @if (removal.Issues.Any(i => i.Code is "external-reference" or "cross-save-link"))
                {
                    <label class="wt-check">
                        <input type="checkbox" data-base-move="leave-links" checked="@_leaveLinks" @onchange="OnLeaveLinksChanged" />
                        @L.Resource("BaseMove_LeaveLinks")
                    </label>
                }
            }
        }

        @if (Mode == ExportMode)
        {
            <BaseFootprint Incoming="@PiecePositions(package)" Label="@L.Resource("BaseMove_Picture")" />
            <p class="wt-muted">@L.Resource(Exporter.OffersSaveExport ? "BaseMove_ExportWhereBrowser" : "BaseMove_ExportWhereDesktop")</p>
            @if (_exported) { <p class="b3d-feedback" role="status" data-base-move="exported">@L.Resource(_removeHere ? "BaseMove_ExportedRemoved" : "BaseMove_Exported")</p> }
            <div class="b3d-links">
                <button type="button" class="wt-btn" data-base-move="export" disabled="@(_busy || _scanning || _exported || RemovalBlocked)" @onclick="ExportAsync">@L.Resource("BaseMove_ExportButton")</button>
                @if (_exported) { <button type="button" class="wt-btn wt-plain" @onclick="CloseAsync">@L.Resource("BaseMove_Done")</button> }
            </div>
        }

        @if (Mode == MoveMode && _target is not null && _staged is null)
        {
            <div class="b3d-links">
                <button type="button" class="wt-btn" data-base-move="move" disabled="@(_busy || _scanning || _preview is null || !_preview.Preview.CanApply || RemovalBlocked)"
                        @onclick="MoveAsync">@(_busy ? L.Resource("BaseMove_Working") : L.Resource("BaseMove_PlaceIn3D"))</button>
            </div>
        }

        @if (Mode == ImportMode)
        {
            <div class="b3d-links">
                @if (_staged is null)
                {
                    <button type="button" class="wt-btn" data-base-move="import" disabled="@(_busy || _scanning || _preview is null || !_preview.Preview.CanApply || RemovalBlocked)" @onclick="ImportAsync">@(_busy ? L.Resource("BaseMove_Working") : L.Resource(_source is null ? "BaseMove_PutDown" : "BaseMove_BringHere"))</button>
                    <button type="button" class="wt-btn wt-plain" data-base-move="start-over" @onclick="StartOver">@L.Resource("BaseMove_StartOver")</button>
                }
                else
                {
                    @if (FloorUnder is null)
                    {
                        <button type="button" class="wt-btn" data-base-move="change-spot" @onclick="OpenPlacing">@L.Resource("BaseMove_ChangeSpot")</button>
                    }
                    <button type="button" class="wt-btn wt-plain" data-base-move="undo-import" @onclick="UndoImportAsync">@L.Resource("BaseMove_Undo")</button>
                    <button type="button" class="wt-btn" data-base-move="done" @onclick="CloseAsync">@L.Resource("BaseMove_Done")</button>
                }
            </div>
            @if (_staged is not null)
            {
                @if (_fitNote is not null) { <p class="wt-muted b3d-warning" data-base-move="fit-note">@_fitNote</p> }
                @if (FloorUnder is not null) { <p class="wt-muted" data-base-move="imported">@L.Resource("BaseMove_ImportedHint")</p> }
                @if (_source is not null) { <p class="wt-muted">@L.Resource("BaseMove_SaveWritesBoth")</p> }
            }
        }
        @if (_error is not null) { <p class="error-text" role="alert" data-base-move="error">@_error</p> }
    }
</div>

@if (_placing && PlacingSession is { } placingSession && _staged is not null)
{
    <BasePlacementDialog Session="placingSession" CopyId="_staged.Id" Where="@(Mode == MoveMode ? _targetLabel : L.Resource("BaseMove_HereLabel"))" OnDone="PlacingDoneAsync" />
}

@code {
    public const string MoveMode = "move";
    public const string ExportMode = "export";
    public const string ImportMode = "import";

    /// <summary>The save the pieces are in (move, export) or land in (import).</summary>
    [Parameter, EditorRequired] public WorldSaveSession Session { get; set; } = default!;

    /// <summary>The chosen pieces (move and export). Level pieces in it are left out and counted.</summary>
    [Parameter] public IReadOnlyList<string> Keys { get; set; } = [];

    /// <summary><see cref="MoveMode"/>, <see cref="ExportMode"/> or <see cref="ImportMode"/>.</summary>
    [Parameter] public string Mode { get; set; } = MoveMode;

    [Parameter] public EventCallback OnClose { get; set; }

    /// <summary>Something was staged or unstaged in <see cref="Session"/> (the host redraws).</summary>
    [Parameter] public EventCallback OnStaged { get; set; }

    /// <summary>An import was put down: the keys of its new pieces (the 3D view selects them).</summary>
    [Parameter] public EventCallback<IReadOnlyList<string>> OnImported { get; set; }

    /// <summary>Lets "there is nowhere to move to" offer the export instead.</summary>
    [Parameter] public EventCallback<string> SwitchMode { get; set; }

    /// <summary>Pieces of the chosen base on a floor far above or below, left out of the move (the Map passes it).</summary>
    [Parameter] public int PiecesOnOtherFloors { get; set; }

    private int _sourceOtherFloors;

    private int OtherFloorCount => Mode == ImportMode ? _sourceOtherFloors : PiecesOnOtherFloors;

    /// <summary>The 3D view's floor under a point (save Z, cm), or null where it has no level loaded.</summary>
    [Parameter] public Func<PlacedVector, Task<double?>>? FloorUnder { get; set; }

    private string? _floorNote;

    // ---- choosing the spot in a 3D view of the receiving world -------------------------------

    private bool _placing;
    private bool _placedOnce;
    private string? _fitNote;

    /// <summary>The save the staged copy is in: the chosen world for a move, this one for an import.</summary>
    private WorldSaveSession? PlacingSession => Mode == MoveMode ? _target : Session;

    private void OpenPlacing()
    {
        if (_staged is not null && PlacingSession is not null) _placing = true;
    }

    /// <summary>
    /// Back from the 3D view. Done keeps the base where it was put (and says when some pieces have no
    /// floor under them); Cancel on a first placing takes the move or import back.
    /// </summary>
    private async Task PlacingDoneAsync(bool keep)
    {
        _placing = false;
        if (PlacingSession is not { } landing || _staged is null) return;
        if (!keep && !_placedOnce)
        {
            if (Mode == MoveMode) await UndoMoveAsync();
            else await UndoImportAsync();
            return;
        }
        _placedOnce = true;
        _staged = landing.StagedPlacedDuplications.FirstOrDefault(d => d.Id == _staged.Id) ?? _staged;
        _fitNote = landing.LastFloorFit is { OverDrop.Count: > 0 } fit ? L.Resource("BaseMove_OverDropFormat", fit.OverDrop.Count) : null;
        Workspace.NotifyEdited();
        RecomputePreview();
        if (keep && Mode == MoveMode && _package is not null) Toasts.Show(L.Resource("BaseMove_MovedToastFormat", _package.Pieces.Count, _targetLabel ?? ""), ToastKind.Success);
        await OnStaged.InvokeAsync();
    }

    /// <summary>
    /// Stands every piece of the staged base on the floor found under it at its new place (the base
    /// keeps its layout seen from above). Found in the game: a base put down on a flat floor kept the
    /// heights of its old place, so pieces floated and the game dropped them, and a bench was lost.
    /// </summary>
    private async Task StandOnFloorAsync()
    {
        if (FloorUnder is null || _staged is null) return;
        _busy = true;
        try
        {
            var id = _staged.Id;
            var fit = await Session.FitStagedCopyToFloorAsync(id, FloorUnder);
            _staged = Session.StagedPlacedDuplications.FirstOrDefault(d => d.Id == id) ?? _staged;
            _floorNote = fit is null || fit.NoLevel
                ? L.Resource("BaseMove_FloorNotLoaded")
                : fit.OverDrop.Count > 0
                    ? L.Resource("BaseMove_OverDropFormat", fit.OverDrop.Count)
                    : L.Resource("BaseMove_StoodOnFloorFormat", fit.Stood, fit.Heights.Count);
            RecomputePreview();
            await OnStaged.InvokeAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>The 3D view's "where I'm looking" point (save space, cm), when the host has one.</summary>
    [Parameter] public Func<Task<PlacedVector?>>? ViewPoint { get; set; }

    private BasePackage? _package;
    private int _skippedLevel;
    private string? _error;
    private bool _busy;

    // where it lands
    private double _dx, _dy, _dz, _yaw;
    private string _destination = "";
    private IReadOnlyList<BaseDestination> _destinations = [];
    private BasePreviewResult? _preview;

    // move (this save gives the pieces to _target)
    private string? _targetPath, _targetLabel;
    private WorldSaveSession? _target;
    private StagedDuplication? _staged;

    // bring (this save takes the pieces from _source)
    private string? _sourcePath;
    private WorldSaveSession? _source;
    private IReadOnlyList<(WorldBase Base, IReadOnlyList<string> Keys)> _sourceBases = [];

    // removal from the giving save
    private bool _removeHere = true, _leaveLinks;
    private BaseEditPreview? _removal;

    private bool _exported;
    private IReadOnlyList<WorldSaveSession.AreaChoice> _areas = [];

    /// <summary>The areas in the shape the picker takes (made once per opening).</summary>
    private IReadOnlyList<WorldArea> AreaList
    {
        get
        {
            if (!ReferenceEquals(_areaListFor, _areas))
            {
                _areaListFor = _areas;
                _areaList = _areas.Select(a => new WorldArea(a.World, a.Area, a.FilePath, a.IsThisWorld)).ToList();
            }
            return _areaList;
        }
    }

    private IReadOnlyList<WorldSaveSession.AreaChoice>? _areaListFor;
    private IReadOnlyList<WorldArea> _areaList = [];
    private string? _lastMode;
    private IReadOnlyList<string>? _lastKeys;
    private bool _scanning;

    /// <summary>The save the pieces land in: the chosen area for a move, this one for an import.</summary>
    private WorldSaveSession? Landing => Mode == ImportMode ? Session : _target;

    /// <summary>The save the pieces leave: this one for a move or export, the chosen area when bringing a base here.</summary>
    private WorldSaveSession? RemovalSession => Mode == ImportMode ? _source : Session;

    private bool RemovalBlocked => _removeHere && RemovalSession is not null && _removal is { CanApply: false };

    private string AreaLabel(WorldSaveSession.AreaChoice a)
        => a.IsThisWorld ? L.Resource("BaseMove_ThisWorldAreaFormat", a.Area) : L.Resource("BaseMove_AreaOptionFormat", a.World, a.Area);

    private string? SourceLabel()
        => _source is not null && _areas.FirstOrDefault(a => string.Equals(a.FilePath, _sourcePath, StringComparison.OrdinalIgnoreCase)) is { } a
            ? AreaLabel(a)
            : _package?.SourceWorld;

    /// <summary>
    /// Removing pieces must see what the world's other saves (other areas, the story save) say about
    /// them, or a link found only at SAVE would stop the removal after the other save got its copy.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (!ApplyParameters() || Mode == ImportMode || _package is null) return;
        await ScanRemovalSideAsync(Session);
    }

    private async Task ScanRemovalSideAsync(WorldSaveSession giver)
    {
        if (!giver.OtherSavesLoaded)
        {
            _scanning = true;
            StateHasChanged();
            try { await giver.LoadOtherSavesAsync(); }
            finally { _scanning = false; }
        }
        RecomputeRemoval();
    }

    /// <summary>Resets the panel when it is opened for a new selection or mode. False when nothing changed.</summary>
    private bool ApplyParameters()
    {
        if (_lastMode == Mode && ReferenceEquals(_lastKeys, Keys)) return false;
        _lastMode = Mode;
        _lastKeys = Keys;
        ResetState();
        // Read the folders once per opening, not on every render.
        _areas = Mode == ExportMode ? [] : Session.OtherAreas();
        if (Mode == ImportMode) { _package = null; return true; }
        try
        {
            _package = Session.CreateBasePackage(Keys, out var skipped);
            _skippedLevel = skipped.Count(s => s.Reason == "level-placed");
        }
        catch (InvalidOperationException)
        {
            _package = null;
            _skippedLevel = Keys.Count;
            _error = L.Resource("BaseMove_NothingToMove");
        }
        RecomputeRemoval();
        return true;
    }

    private void ResetState()
    {
        _error = null;
        _exported = false;
        _staged = null;
        _preview = null;
        _target = null;
        _targetPath = null;
        _source = null;
        _sourcePath = null;
        _sourceBases = [];
        _removeHere = Mode != ExportMode;
        _leaveLinks = false;
        _destination = "";
        _destinations = [];
        _dx = _dy = _dz = _yaw = 0;
    }

    private void StartOver()
    {
        ResetState();
        _package = null;
    }

    private string Title() => Mode switch
    {
        ExportMode => L.Resource("BaseMove_ExportTitleFormat", _package?.Pieces.Count ?? 0),
        ImportMode => L.Resource("BaseMove_ImportTitle"),
        _ => L.Resource("BaseMove_MoveTitleFormat", _package?.Pieces.Count ?? 0),
    };

    // ---- placement --------------------------------------------------------------------------

    private RenderFragment Placement() => __builder =>
    {
        var landing = Landing;
        var rows = _preview?.Rows ?? [];
        var mine = rows.Select(r => r.NewKey).ToHashSet(StringComparer.Ordinal);
        // Pieces, not pairs: one new piece close to three old ones counts once.
        var hints = _preview?.Preview.ProximityHints.SelectMany(h => new[] { h.KeyA, h.KeyB }).Where(mine.Contains).Distinct(StringComparer.Ordinal).Count() ?? 0;
        var blocking = _preview?.Preview.Issues.Where(i => i.IsBlocking).Select(i => i.Message).Distinct().ToList() ?? [];
        var otherMap = _package is not null && landing is not null && landing.IsOtherMap(_package);
        var levelNote = _preview?.Preview.Issues.FirstOrDefault(i => i.Code == "other-map" && !i.IsBlocking);

        <span class="wt-label">@L.Resource("BaseMove_StartNear")</span>
        @if (otherMap) { <p class="wt-muted b3d-warning" data-base-move="other-map">@L.Resource("BaseMove_OtherMapNote")</p> }
        @if (levelNote is { Severity: BaseEditSeverity.Warning }) { <p class="wt-muted b3d-warning" data-base-move="level-guess">@L.Resource("BaseMove_OtherMapNoPieces")</p> }
        @* Just a list of places by name: the same spot, a part of the Facility, next to a base already
           there. No numbers; fine adjustment is dragging the pieces in the 3D view. *@
        <select class="wt-input" aria-label="@L.Resource("BaseMove_WhereItLands")" data-base-move="destination" @onchange="e => ChooseDestinationAsync(e.Value?.ToString())">
            @if (_destination.Length == 0)
            {
                <option value="" selected="true">@L.Resource(_staged is not null ? "BaseMove_DestWhereDragged" : "BaseMove_DestChoose")</option>
            }
            @foreach (var group in DestinationGroups())
            {
                <optgroup label="@group.Label">
                    @foreach (var (d, i) in group.Items)
                    {
                        var value = i.ToString(CultureInfo.InvariantCulture);
                        <option value="@value" selected="@(_destination == value)">@DestinationLabel(d)</option>
                    }
                </optgroup>
            }
        </select>
        <small class="wt-muted" data-base-move="place-hint">@L.Resource(FloorUnder is not null && Mode == ImportMode ? "BaseMove_StartNearHint3D" : "BaseMove_StartNearHint")</small>
        @if (ViewPoint is not null && Mode == ImportMode)
        {
            <div class="b3d-links">
                <button type="button" class="wt-btn wt-plain" data-base-move="to-view" @onclick="ToViewAsync">@L.Resource("BaseMove_WhereImLooking")</button>
            </div>
        }
        @if (Mode == ImportMode && _staged is not null && FloorUnder is not null)
        {
            <div class="b3d-links">
                <button type="button" class="wt-btn" data-base-move="stand-on-floor" disabled="@_busy" @onclick="() => StandOnFloorAsync()">@L.Resource("BaseMove_StandOnFloor")</button>
            </div>
            @if (_floorNote is not null) { <small class="wt-muted" data-base-move="floor-note">@_floorNote</small> }
        }
        @if (Mode == ImportMode && _staged is not null && ViewPoint is not null) { <small class="wt-muted">@L.Resource("BaseMove_DragHint")</small> }
        @if (hints > 0) { <p class="wt-muted b3d-warning" data-base-move="close-by">@L.Resource("BaseMove_CloseByFormat", hints)</p> }
        @if (blocking.Count > 0)
        {
            <p class="error-text" role="alert" data-base-move="blocked">@L.Resource("BaseMove_CannotLand")</p>
            <ul class="b3d-list">@foreach (var b in blocking.Take(6)) { <li>@b</li> }</ul>
        }
    };

    private sealed record DestinationGroup(string Label, IReadOnlyList<(BaseDestination Place, int Index)> Items);

    /// <summary>The places in a few plain groups, in the order a player looks for them.</summary>
    private IEnumerable<DestinationGroup> DestinationGroups()
    {
        var indexed = _destinations.Select((d, i) => (d, i)).ToList();
        foreach (var (kind, label) in new[]
        {
            (BaseDestinationKind.SameSpot, "BaseMove_GroupSameSpot"),
            (BaseDestinationKind.AreaMiddle, "BaseMove_GroupArea"),
            (BaseDestinationKind.Sector, "BaseMove_GroupSectors"),
            (BaseDestinationKind.BesideBase, "BaseMove_GroupBases"),
        })
        {
            var items = indexed.Where(x => x.d.Kind == kind).ToList();
            if (items.Count > 0) yield return new DestinationGroup(L.Resource(label), items);
        }
    }

    private string DestinationLabel(BaseDestination d) => d.Kind switch
    {
        BaseDestinationKind.SameSpot => L.Resource("BaseMove_DestSameSpot"),
        BaseDestinationKind.Sector => L.Resource("BaseMove_DestSectorFormat", d.Name),
        BaseDestinationKind.AreaMiddle => L.Resource("BaseMove_DestAreaMiddle"),
        _ when d.NearSector is { } sector => L.Resource("BaseMove_DestBaseNearFormat", d.Name, sector),
        _ => L.Resource("BaseMove_DestBaseFormat", d.Name),
    };

    private static IReadOnlyList<PlacedVector> PiecePositions(BasePackage package)
        => package.Pieces.Where(p => p.Position is not null).Select(p => p.Position!.Value).ToList();

    /// <summary>The places in the landing save, and a first choice: the same spot when it is the same map, else the first place listed.</summary>
    private void LoadDestinations()
    {
        _destinations = [];
        _destination = "";
        if (_package is null || Landing is not { } landing) return;
        _destinations = landing.BaseDestinationsFor(_package);
        if (_destinations.Count == 0) return;
        _destination = "0";
        var offset = _destinations[0].OffsetFor(_package);
        (_dx, _dy, _dz, _yaw) = (offset.X, offset.Y, offset.Z, 0);
    }

    private async Task ChooseDestinationAsync(string? value)
    {
        _destination = value ?? "";
        if (_package is null || !int.TryParse(value, NumberStyles.None, CultureInfo.InvariantCulture, out var i) || i >= _destinations.Count) return;
        var offset = _destinations[i].OffsetFor(_package);
        (_dx, _dy, _dz, _yaw) = (offset.X, offset.Y, offset.Z, 0);
        await PlacementChangedAsync();
    }

    /// <summary>Puts the middle of the pieces where the 3D view is looking, standing on the floor found there.</summary>
    private async Task ToViewAsync()
    {
        if (ViewPoint is null || _package?.Centre is not { } centre || _package.FloorZ is not { } floor) return;
        if (await ViewPoint() is not { } at) return;
        _dx = Math.Round(at.X - centre.X);
        _dy = Math.Round(at.Y - centre.Y);
        _dz = Math.Round(at.Z - floor);
        _destination = "";
        await PlacementChangedAsync();
    }

    /// <summary>A staged import follows the controls at once; otherwise only the preview changes.</summary>
    private async Task PlacementChangedAsync()
    {
        if (_staged is not null && Mode == ImportMode)
        {
            Session.RestageCopy(_staged.Id, new PlacedVector(_dx, _dy, _dz), _yaw);
            _staged = Session.StagedPlacedDuplications.FirstOrDefault(d => d.Id == _staged.Id) ?? _staged;
            RecomputePreview();
            await OnStaged.InvokeAsync();
            await StandOnFloorAsync();
            return;
        }
        RecomputePreview();
    }

    /// <summary>Picks up a staged import's spot when it was dragged or turned in the 3D view.</summary>
    public async Task SyncFromStagedAsync()
    {
        if (_staged is null || Session.StagedPlacedDuplications.FirstOrDefault(d => d.Id == _staged.Id) is not { } now)
        {
            if (_staged is not null && Mode == ImportMode) _staged = null;
            return;
        }
        _staged = now;
        (_dx, _dy, _dz, _yaw) = (now.Offset.X, now.Offset.Y, now.Offset.Z, now.YawDegrees);
        _destination = "";
        RecomputePreview();
        if (Mode == ImportMode && now.PieceHeights is null) await StandOnFloorAsync();
        StateHasChanged();
    }

    private void RecomputePreview()
    {
        _preview = null;
        if (_package is null || Landing is not { } landing) return;
        if (_staged is not null && Mode == ImportMode)
        {
            _preview = new BasePreviewResult(landing.PreviewBaseEdits(), _staged.Id);
            return;
        }
        _preview = landing.PreviewBaseTransplant(_package, new PlacedVector(_dx, _dy, _dz), _yaw);
    }

    // ---- removal from the giving save -------------------------------------------------------

    private void RecomputeRemoval()
    {
        _removal = null;
        if (!_removeHere || _package is null || RemovalSession is not { } giver) return;
        _removal = giver.PreviewMoveAway(_package.Pieces.Select(p => p.Key).ToList(), _leaveLinks);
    }

    private void OnRemoveChanged(ChangeEventArgs e)
    {
        _removeHere = e.Value is true;
        RecomputeRemoval();
    }

    private void OnLeaveLinksChanged(ChangeEventArgs e)
    {
        _leaveLinks = e.Value is true;
        RecomputeRemoval();
    }

    // ---- move -------------------------------------------------------------------------------

    private async Task ChooseTargetAsync(string? path)
    {
        _error = null;
        _target = null;
        _preview = null;
        _targetPath = string.IsNullOrEmpty(path) ? null : path;
        _targetLabel = _areas.FirstOrDefault(a => string.Equals(a.FilePath, path, StringComparison.OrdinalIgnoreCase)) is { } area ? AreaLabel(area) : null;
        if (_targetPath is null || _package is null) return;
        _busy = true;
        StateHasChanged();
        try
        {
            _target = await Workspace.GetTransferWorldAsync(_targetPath);
            if (_target is null) { _error = L.Resource("BaseMove_WorldUnreadable"); return; }
            LoadDestinations();
            RecomputePreview();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or InvalidOperationException or NotSupportedException)
        {
            _error = Errors.Present(ex, L.Resource("BaseMove_WorldUnreadable"), L.Resource("PlayerUi_CheckFileReadable"));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MoveAsync()
    {
        if (_package is null || _target is null) return;
        _error = null;
        // Staging a big base takes a few seconds: show it before the work starts.
        _busy = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            _staged = Session.StageMoveTo(_target, _package, new PlacedVector(_dx, _dy, _dz), _yaw, _removeHere, _leaveLinks);
            Workspace.RegisterTransfer(Session, _target);
            Workspace.NotifyEdited();
            _placedOnce = false;
            _placing = true;
            await OnStaged.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _staged = null;
            _error = Errors.Present(ex, L.Resource("BaseMove_MoveFailed"), L.Resource("BaseMove_MoveFailedHint"));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UndoMoveAsync()
    {
        var move = Session.StagedBaseMoves.FirstOrDefault(m => _staged is not null && m.TargetCopyId == _staged.Id && ReferenceEquals(m.Target, _target));
        if (move is not null) Session.UndoMove(move);
        else if (_target is not null && _staged is not null) _target.RevertPlacedDuplication(_staged.Id);
        _staged = null;
        Workspace.NotifyEdited();
        RecomputeRemoval();
        RecomputePreview();
        await OnStaged.InvokeAsync();
    }

    // ---- export -----------------------------------------------------------------------------

    private async Task ExportAsync()
    {
        if (_package is null) return;
        _busy = true;
        _error = null;
        try
        {
            await Exporter.ExportAsync(_package.SuggestedFileName(), _package.ToJson());
            _exported = true;
            if (_removeHere)
            {
                Session.StageMoveAway(_package.Pieces.Select(p => p.Key).ToList(), _leaveLinks);
                Workspace.NotifyEdited();
                await OnStaged.InvokeAsync();
            }
            Toasts.Show(L.Resource("BaseMove_ExportedToastFormat", _package.Pieces.Count), ToastKind.Success);
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidOperationException or Microsoft.JSInterop.JSException)
        {
            _error = Errors.Present(ex, L.Resource("BaseMove_ExportFailed"), L.Resource("BaseMove_ExportFailedHint"));
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- import: from a file ----------------------------------------------------------------

    private async Task PickFileAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            var picked = await FilePicker.PickFileAsync(new()
            {
                Title = L.Resource("BaseMove_PickFile"),
                FileTypes = [new(L.Resource("BaseMove_FileType"), [".json"])],
            });
            if (picked is null) return;
            await using var stream = await picked.OpenReadAsync(CancellationToken.None);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);
            _package = BasePackage.Parse(buffer.ToArray());
            _source = null;
            _removeHere = false;
            LoadDestinations();
            RecomputePreview();
        }
        catch (InvalidDataException)
        {
            _error = L.Resource("BaseMove_NotABaseFile");
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or Microsoft.JSInterop.JSException)
        {
            _error = Errors.Present(ex, L.Resource("BaseMove_FileUnreadable"), L.Resource("PlayerUi_CheckFileReadable"));
        }
        finally
        {
            _busy = false;
        }
    }

    // ---- import: brought straight from another world or area --------------------------------

    private async Task ChooseSourceAsync(string? path)
    {
        _error = null;
        _source = null;
        _sourceBases = [];
        _sourcePath = string.IsNullOrEmpty(path) ? null : path;
        if (_sourcePath is null) return;
        _busy = true;
        StateHasChanged();
        try
        {
            _source = await Workspace.GetTransferWorldAsync(_sourcePath);
            if (_source is null) { _error = L.Resource("BaseMove_WorldUnreadable"); return; }
            _sourceBases = _source.MovableBases();
        }
        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or InvalidDataException or InvalidOperationException or NotSupportedException)
        {
            _error = Errors.Present(ex, L.Resource("BaseMove_WorldUnreadable"), L.Resource("PlayerUi_CheckFileReadable"));
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChooseSourceBaseAsync(string? name)
    {
        if (_source is null || _sourceBases.FirstOrDefault(b => b.Base.Name == name) is not { Keys.Count: > 0 } chosen) return;
        _error = null;
        try
        {
            _package = _source.CreateBasePackage(chosen.Keys, out var skipped);
            _sourceOtherFloors = _source.PiecesOnOtherFloors(chosen.Base);
            _skippedLevel = skipped.Count(s => s.Reason == "level-placed");
        }
        catch (InvalidOperationException)
        {
            _error = L.Resource("BaseMove_NothingToMove");
            return;
        }
        _removeHere = true;
        LoadDestinations();
        RecomputePreview();
        await ScanRemovalSideAsync(_source);
    }

    private async Task ImportAsync()
    {
        if (_package is null) return;
        _error = null;
        _busy = true;
        StateHasChanged();
        await Task.Yield();
        try
        {
            if (_source is not null)
            {
                // Brought straight from another save: staged here (the copy) and there (the removal),
                // linked so one SAVE writes both, the save that receives the pieces first.
                _staged = _source.StageMoveTo(Session, _package, new PlacedVector(_dx, _dy, _dz), _yaw, _removeHere, _leaveLinks);
                Workspace.RegisterTransfer(_source, Session);
            }
            else
            {
                _staged = Session.StageBaseTransplant(_package, new PlacedVector(_dx, _dy, _dz), _yaw);
            }
        }
        catch (Exception ex) when (ex is InvalidOperationException or ArgumentException)
        {
            _staged = null;
            _error = Errors.Present(ex, L.Resource("BaseMove_MoveFailed"), L.Resource("BaseMove_MoveFailedHint"));
            _busy = false;
            return;
        }
        _busy = false;
        Workspace.NotifyEdited();
        RecomputePreview();
        await OnStaged.InvokeAsync();
        await OnImported.InvokeAsync(_staged.NewKeys.Values.ToList());
        if (FloorUnder is null)
        {
            // No 3D view here (the Bases map): the spot is chosen in one, with the world drawn around it.
            _placedOnce = false;
            _placing = true;
            return;
        }
        await StandOnFloorAsync();
    }

    private async Task UndoImportAsync()
    {
        if (_staged is not null)
        {
            if (_source?.StagedBaseMoves.FirstOrDefault(m => m.TargetCopyId == _staged.Id && ReferenceEquals(m.Target, Session)) is { } move) _source.UndoMove(move);
            else Session.RevertPlacedDuplication(_staged.Id);
        }
        _staged = null;
        Workspace.NotifyEdited();
        RecomputeRemoval();
        RecomputePreview();
        await OnStaged.InvokeAsync();
    }

    private Task CloseAsync() => OnClose.InvokeAsync();
}
