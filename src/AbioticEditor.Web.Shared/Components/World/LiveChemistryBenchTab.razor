@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.World
@using AbioticEditor.Core.Items
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Core.WorldSaves
@using AbioticEditor.Web.Components.Shared
@inject ItemCatalogService Catalog
@inject RecipeVocabularyService Recipes
@implements IDisposable

@* Dedicated live tab, not the generic WorldFeaturesTab: a chemistry bench's four flask slots
   (three inputs, one computed output) used to show as bare "flask:0".."flask:3" text fields that
   were also read-only in the running game, and finding the bench at all meant following an "open
   flask contents" link into the CONTAINERS tab filtered to this bench's id - a link a player
   reported breaking when the containers tab's own "nearby only" filter (now off by default
   elsewhere) hid the very container the link pointed at. This tab lists every chemistry bench and
   lets the three input slots be set directly, with a recipe hint computed from the same chemistry
   recipe table the file editor's recipe browser reads (RecipeCatalog, Source == "Chemistry") -
   see LiveTradersTab's own remarks for why a dedicated flat tab exists instead of reusing the
   split-pane layout the offline world tabs use. *@
<section class="editor-card" aria-label="@L.Resource("LiveChemistryBenches_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveChemistryBenches_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveChemistryBenches_NotHostWarning")</p>
    }
    <p class="muted">@L.Resource("LiveChemistryBenches_Intro")</p>

    @if (Session.Entries.Count == 0)
    {
        <p class="muted">@L.Resource("LiveChemistryBenches_NoneFound")</p>
    }
    else
    {
        <div class="shell-save-list" role="listbox" aria-label="@L.Resource("LiveChemistryBenches_Title")">
            @foreach (var bench in OrderedEntries)
            {
                var expanded = _selectedId == bench.Id;
                <div @key="bench.Id">
                    <button type="button" role="option" aria-selected="@(expanded ? "true" : "false")"
                            class="save-file-row kind-player @(expanded ? "selected" : null)" @onclick="() => Toggle(bench.Id)">
                        <span class="save-kind-marker" aria-hidden="true"></span>
                        <strong class="save-file-name">@bench.Label</strong>
                    </button>
                    @if (expanded)
                    {
                        <div class="detail-card detail-card--terminal" aria-label="@bench.Label">
                            @* The bench itself is a real, placeable item (Deployable_Bench_Chemistry)
                               with its own catalog icon, the same as any item - no separate
                               wiki/game-texture lookup needed, matching how the garden-plot crop
                               preview reuses ItemIcon instead of a new artwork source. *@
                            <div class="wt-portrait cb-portrait">
                                <ItemIcon ItemId="@BenchItemId" Alt="@bench.Label" />
                            </div>
                            @foreach (var flask in bench.Fields.Where(f => f.Id.StartsWith("flask:", StringComparison.Ordinal)))
                            {
                                <div class="wt-field" @key="flask.Id">
                                    <span class="wt-label">@flask.Label</span>
                                    <span class="wt-field-inline">
                                        @* Right-click opens the "send to..." choice for this flask (a player, or a
                                           chest picked from the ones nearest this bench) - the same gesture the
                                           containers screen uses for a slot - scoped to the icon only (not the input
                                           box next to it) so it never steals the input's own right-click
                                           (copy/paste). *@
                                        <span class="rb-row-icon" title="@SendToPlayerHint(flask)"
                                              @oncontextmenu="() => OpenSendPicker(bench, flask)" @oncontextmenu:preventDefault>
                                            <ItemIcon ItemId="@flask.Value" Alt="@ItemName(flask.Value)" />
                                        </span>
                                        @if (flask.Editable)
                                        {
                                            <input class="wt-input" list="chembench-item-palette" value="@(IsEmptySlot(flask.Value) ? string.Empty : flask.Value)"
                                                   placeholder="@L.Inventory("empty")" disabled="@_busy"
                                                   @onchange="e => SetFlaskAsync(bench.Id, flask.Id, e.Value?.ToString())" />
                                            <button class="wt-btn wt-plain" type="button" disabled="@(_busy || IsEmptySlot(flask.Value))"
                                                    @onclick="() => SetFlaskAsync(bench.Id, flask.Id, string.Empty)">@L.Inventory("clear").ToUpperInvariant()</button>
                                        }
                                        else
                                        {
                                            <span class="world-feature-field-value">@ItemName(flask.Value)</span>
                                        }
                                    </span>
                                </div>
                                @if (_sendPicker is { } picker && picker.BenchId == bench.Id && picker.FlaskId == flask.Id && !IsEmptySlot(flask.Value))
                                {
                                    <div class="cb-send-picker" role="group" aria-label="@L.Resource("LiveChemistryBenches_SendTitleFormat", ItemName(flask.Value))">
                                        <p class="wt-muted">@L.Resource("LiveChemistryBenches_SendTitleFormat", ItemName(flask.Value))</p>
                                        <div class="cb-send-row">
                                            @if (LivePlayerSession is not null || PlayerSession is not null)
                                            {
                                                <button class="wt-btn wt-yellow" type="button" disabled="@_busy"
                                                        @onclick="() => SendFlaskToPlayerAsync(bench, flask)">@L.Resource("LiveChemistryBenches_SendToPlayerButton")</button>
                                            }
                                            @{ var chests = NearbyChests(bench); }
                                            @if (Containers is null || !Containers.IsHost)
                                            {
                                                <span class="wt-muted">@L.Resource("LiveChemistryBenches_SendToChestNeedsHost")</span>
                                            }
                                            else if (chests.Count == 0)
                                            {
                                                <span class="wt-muted">@L.Resource("LiveChemistryBenches_NoChestsNearby")</span>
                                            }
                                            else
                                            {
                                                <select class="wt-input cb-send-select" disabled="@_busy" @bind="_sendChestId" aria-label="@L.Resource("LiveChemistryBenches_SendChestPickerLabel")">
                                                    @foreach (var chest in chests)
                                                    {
                                                        <option value="@chest.Id">@ChestOption(bench, chest)</option>
                                                    }
                                                </select>
                                                <button class="wt-btn wt-yellow" type="button" disabled="@(_busy || string.IsNullOrEmpty(_sendChestId))"
                                                        @onclick="() => SendFlaskToChestAsync(bench, flask)">@L.Resource("LiveChemistryBenches_SendToChestButton")</button>
                                            }
                                            <button class="wt-btn wt-plain" type="button" disabled="@_busy" @onclick="CloseSendPicker">@L.Resource("Slot_Cancel")</button>
                                        </div>
                                    </div>
                                }
                            }
                            @{ var hint = RecipeHint(bench); }
                            @if (hint is not null)
                            {
                                <p class="wt-muted">@hint</p>
                            }
                            @* Placing inputs never starts a mix by itself - in game you turn the bench's
                               valve. This is that valve: the game's own activation call, which decides
                               for itself whether the inputs make a recipe. *@
                            @if (IsMixing(bench))
                            {
                                <p class="wt-muted">@L.Resource("LiveChemistryBenches_MixingInProgress")</p>
                            }
                            else if (InputItemIds(bench).Count > 0)
                            {
                                <button class="wt-btn wt-yellow" type="button" disabled="@(_busy || !Session.IsHost)"
                                        @onclick='() => SetFlaskAsync(bench.Id, "process", "start")'>@L.Resource("LiveChemistryBenches_StartMixing")</button>
                            }
                            @* An empty output with a matched recipe is not stuck - the game's own mixing
                               genuinely takes real time (the recipe's own craft duration), and the running
                               game's own view of the flasks only reaches this screen on the next refresh
                               anyway. Naming the wait instead of leaving a blank output looking broken. *@
                            @if (OutputPendingDuration(bench) is { } pendingSeconds)
                            {
                                <p class="wt-muted">@L.Resource("LiveChemistryBenches_MixingTakesFormat", pendingSeconds)</p>
                            }
                            @if (_fieldErrors.TryGetValue(bench.Id, out var benchError))
                            {
                                <p class="error-text" role="alert">@benchError</p>
                            }
                        </div>
                    }
                </div>
            }
        </div>

        @if (_selectedId is { } selectedBenchId)
        {
            @* Browsing what CAN be made, not just reacting to what is already in the flasks -
               RecipeHint above only ever answers "what would these inputs make", which is no help
               deciding what to build toward in the first place. *@
            <div class="detail-card detail-card--terminal cb-recipe-browser" aria-label="@L.Resource("LiveChemistryBenches_RecipesTitle")">
                <h4>@L.Resource("LiveChemistryBenches_RecipesTitle")</h4>
                <input type="search" class="wt-input" value="@_recipeFilter" @oninput="e => _recipeFilter = e.Value?.ToString() ?? string.Empty"
                       placeholder="@L.Resource("LiveChemistryBenches_RecipesSearch")" aria-label="@L.Resource("LiveChemistryBenches_RecipesSearch")" />
                <div class="cb-recipe-list">
                    @foreach (var recipe in FilteredRecipes)
                    {
                        <div class="cb-recipe-row" @key="recipe.Id">
                            <span class="cb-recipe-ingredients">
                                @foreach (var ingredient in recipe.IngredientList)
                                {
                                    <span class="rb-row-icon" title="@ItemName(ingredient.ItemId)"><ItemIcon ItemId="@ingredient.ItemId" Alt="@ItemName(ingredient.ItemId)" /></span>
                                }
                            </span>
                            <span class="cb-recipe-arrow" aria-hidden="true">-></span>
                            <span class="rb-row-icon" title="@ItemName(recipe.CreatesItemId)"><ItemIcon ItemId="@recipe.CreatesItemId" Alt="@ItemName(recipe.CreatesItemId)" /></span>
                            <span class="cb-recipe-name">@ItemName(recipe.CreatesItemId)</span>
                            @if (recipe.CraftDurationSeconds is { } seconds)
                            {
                                <span class="cb-recipe-duration">@L.Resource("LiveChemistryBenches_RecipeDurationFormat", seconds)</span>
                            }
                            <button class="wt-btn wt-plain" type="button" disabled="@(_busy || recipe.IngredientList.Count == 0 || recipe.IngredientList.Count > 3)"
                                    @onclick="() => ApplyRecipeAsync(selectedBenchId, recipe)">@L.Resource("LiveChemistryBenches_SetInputs")</button>
                        </div>
                    }
                    @if (FilteredRecipes.Count == 0)
                    {
                        <p class="muted">@L.Resource("LiveChemistryBenches_NoRecipesMatch")</p>
                    }
                </div>
            </div>
        }
    }
    <datalist id="chembench-item-palette">
        @foreach (var item in ChemistryIngredientItems)
        {
            <option value="@item.Id">@item.DisplayName</option>
        }
    </datalist>

    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveDeployedCareSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    // "Send to player" destinations - exactly the same two-way shape WorldContainersTab already
    // exposes (a connected live player, or a player save staged alongside this world), so a host
    // wiring this tab up can offer either without this component caring which one it got.
    [Parameter] public PlayerSaveSession? PlayerSession { get; set; }
    [Parameter] public LiveInventorySession? LivePlayerSession { get; set; }
    /// <summary>The live containers session (round 91) - the "send to a chest" half of the
    /// flask picker lists its containers nearest this bench and moves the flask through the same
    /// one-request transfer the containers screen itself uses. Null (no picker chest half) when
    /// the host page could not connect it.</summary>
    [Parameter] public LiveContainersSession? Containers { get; set; }
    /// <summary>The connected character's current position (round 89) - when known, benches list
    /// closest-first instead of whatever order the game happens to report them in, the same
    /// "nearby" convenience containers/dropped items already have (see those tabs' own
    /// PlayerPosition parameter). Null until the eager spawn connect this tab's own host page
    /// makes resolves, in which case the list just keeps the game's own order.</summary>
    [Parameter] public (double X, double Y, double Z)? PlayerPosition { get; set; }

    private IReadOnlyList<LiveCareEntry> OrderedEntries
        => PlayerPosition is { } position
            ? Session.Entries.OrderBy(bench => bench.DistanceTo(position.X, position.Y, position.Z)).ToList()
            : Session.Entries;

    private bool _busy;
    private string? _error;
    private string? _selectedId;
    /// <summary>Which flask the "send to..." choice is open for, if any, and the chest currently
    /// picked in it. Opened by right-clicking a flask's icon; closed by any send or CANCEL.</summary>
    private (string BenchId, string FlaskId)? _sendPicker;
    private string? _sendChestId;
    /// <summary>How many of the nearest chests the picker offers - enough to always include the
    /// crates around a base's chemistry corner without becoming a scroll through the whole map.</summary>
    private const int NearbyChestLimit = 30;
    private string _recipeFilter = string.Empty;
    private readonly Dictionary<string, string> _fieldErrors = new(StringComparer.Ordinal);
    private IReadOnlyList<RecipeInfo>? _chemistryRecipes;

    /// <summary>
    /// The periodic background refresh in the page hosting this tab re-reads this session every
    /// couple of seconds (so a bench's output flask catches up once the game finishes mixing), but
    /// only that page's own StateHasChanged call is guaranteed to reach this component - if
    /// anything between it and here ever short-circuits a re-render (a `@key`, a future
    /// ShouldRender override), an expanded bench would keep showing stale flask values with no
    /// other signal telling it otherwise. Subscribing directly, the same way every other live tab
    /// with a Changed event already does, removes that assumption entirely.
    /// </summary>
    protected override void OnInitialized() => Session.Changed += Refresh;
    public void Dispose() => Session.Changed -= Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);

    /// <summary>The bench's own item id (a real, placeable item with its own catalog icon -
    /// Deployable_Bench_Chemistry), not to be confused with any of the items INSIDE it. This
    /// game has exactly one chemistry bench item, unlike garden plots' several size variants, so
    /// a single constant is enough here.</summary>
    private const string BenchItemId = "Deployable_Bench_Chemistry";

    private static bool IsEmptySlot(string? value) => string.IsNullOrEmpty(value) || value is "Empty" or "None";

    private string ItemName(string? itemId)
        => IsEmptySlot(itemId) ? L.Inventory("empty") : Catalog.Find(itemId!)?.DisplayName ?? PlainNames.Words(itemId!);

    private void Toggle(string id)
    {
        _selectedId = _selectedId == id ? null : id;
        _fieldErrors.Remove(id);
    }

    /// <summary>Every item this game's chemistry recipes actually consume, so the picker suggests
    /// real chemistry ingredients instead of the whole ~1,600-item catalog.</summary>
    private IEnumerable<ItemCatalogEntry> ChemistryIngredientItems
    {
        get
        {
            var ids = new HashSet<string>(ChemistryRecipes.SelectMany(r => r.IngredientList).Select(i => i.ItemId), StringComparer.Ordinal);
            return Catalog.Entries.Where(item => ids.Contains(item.Id)).OrderBy(item => item.DisplayName, StringComparer.OrdinalIgnoreCase);
        }
    }

    private IReadOnlyList<RecipeInfo> ChemistryRecipes
        => _chemistryRecipes ??= Recipes.GetRecipeInfos().Where(r => string.Equals(r.Source, "Chemistry", StringComparison.Ordinal)).ToList();

    /// <summary>Recipes with a real output and at least one real ingredient, filtered by the
    /// search box against the output item's own name - matching by what you are trying to MAKE,
    /// since that is what a player browsing this list is actually looking for.</summary>
    private IReadOnlyList<RecipeInfo> FilteredRecipes
    {
        get
        {
            var candidates = ChemistryRecipes.Where(r => r.CreatesItemId is { Length: > 0 } && r.IngredientList.Count > 0);
            if (string.IsNullOrWhiteSpace(_recipeFilter)) return candidates.ToList();
            var filter = _recipeFilter.Trim();
            return candidates.Where(r => ItemName(r.CreatesItemId).Contains(filter, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    /// <summary>Fills a bench's three input slots with one recipe's ingredients (each distinct
    /// ingredient into its own slot, up to three) - the same one-item-per-slot, no-stack-count
    /// limitation RecipeHint's own remarks already document, since the flask fields have no
    /// stack-count to set even if a recipe calls for more than one of something. Applies the
    /// writes one at a time and stops at the first rejection, same as any other flask edit.</summary>
    private async Task ApplyRecipeAsync(string benchId, RecipeInfo recipe)
    {
        var inputs = recipe.IngredientList.Take(3).ToList();
        for (var i = 0; i < 3; i++)
        {
            var value = i < inputs.Count ? inputs[i].ItemId : string.Empty;
            await SetFlaskAsync(benchId, $"flask:{i}", value);
            if (_fieldErrors.ContainsKey(benchId)) return;
        }
    }

    /// <summary>
    /// Which chemistry recipe the bench's current inputs would match, purely by which items are
    /// in the three input slots (the flask fields carry no stack-count, so a recipe needing more
    /// than one of an ingredient cannot be told apart from needing just one here - the hint says
    /// "would produce", not "will produce", for exactly that reason). The actual mixing still runs
    /// in the game; this is a legibility aid, not a simulation of it.
    /// </summary>
    private string? RecipeHint(LiveCareEntry bench)
    {
        var inputs = InputItemIds(bench);
        if (inputs.Count == 0) return null;
        var match = MatchedRecipe(bench);
        if (match?.CreatesItemId is { Length: > 0 } createsId)
            return L.Resource("LiveChemistryBenches_WouldProduce", ItemName(createsId));
        return L.Resource("LiveChemistryBenches_NoMatchingRecipe");
    }

    private static IReadOnlyList<string> InputItemIds(LiveCareEntry bench)
        => bench.Fields.Where(f => f.Id.StartsWith("flask:", StringComparison.Ordinal) && f.Id != "flask:3" && !IsEmptySlot(f.Value))
            .Select(f => f.Value!).ToList();

    /// <summary>The bench's own replicated "a mix is running" flag, reported by the live side
    /// as the plain token "active" (anything else, including a missing field on an older mod
    /// build, reads as idle).</summary>
    private static bool IsMixing(LiveCareEntry bench)
        => bench.Fields.FirstOrDefault(f => f.Id == "mixing")?.Value == "active";

    /// <summary>Shared by <see cref="RecipeHint"/> (which only needs the output name) and <see
    /// cref="OutputPendingDuration"/> (which also needs the matched recipe's own craft time) so
    /// both read the same match instead of two copies of the same set-equality check drifting
    /// apart.</summary>
    private RecipeInfo? MatchedRecipe(LiveCareEntry bench)
    {
        var inputSet = new HashSet<string>(InputItemIds(bench), StringComparer.Ordinal);
        if (inputSet.Count == 0) return null;
        return ChemistryRecipes.FirstOrDefault(r =>
            new HashSet<string>(r.IngredientList.Select(i => i.ItemId), StringComparer.Ordinal).SetEquals(inputSet));
    }

    /// <summary>How many seconds the game's own recipe says this mix takes, only while that is
    /// actually useful information: real inputs are set, they match a known recipe, the output
    /// flask has not produced anything yet, and the recipe's own duration is known at all. Null
    /// in every other case - an already-full output, an unmatched combination, or a recipe this
    /// game's data does not carry a duration for all mean this has nothing worth saying.</summary>
    private double? OutputPendingDuration(LiveCareEntry bench)
    {
        var output = bench.Fields.FirstOrDefault(f => f.Id == "flask:3");
        if (output is null || !IsEmptySlot(output.Value)) return null;
        return MatchedRecipe(bench)?.CraftDurationSeconds;
    }

    private string? SendToPlayerHint(LiveCareField flask)
        => !IsEmptySlot(flask.Value) && (LivePlayerSession is not null || PlayerSession is not null || Containers is not null)
            ? L.Resource("LiveChemistryBenches_SendToPlayerHelp") : null;

    private void OpenSendPicker(LiveCareEntry bench, LiveCareField flask)
    {
        if (IsEmptySlot(flask.Value)) return;
        _fieldErrors.Remove(bench.Id);
        _sendPicker = (bench.Id, flask.Id);
        _sendChestId = NearbyChests(bench).FirstOrDefault()?.Id;
    }

    private void CloseSendPicker()
    {
        _sendPicker = null;
        _sendChestId = null;
    }

    /// <summary>The live containers nearest this bench (the bench's own position when the game
    /// reported one, else the player's), never the bench itself. Distance is from the bench, not
    /// the player, because "a nearby chest" means near where the output is.</summary>
    private IReadOnlyList<WorldContainer> NearbyChests(LiveCareEntry bench)
    {
        if (Containers is null) return [];
        var others = Containers.Containers.Where(c => !string.Equals(c.Id, bench.Id, StringComparison.Ordinal));
        var origin = bench.X != 0 || bench.Y != 0 || bench.Z != 0 ? (bench.X, bench.Y, bench.Z) : PlayerPosition;
        return origin is { } o
            ? others.OrderBy(c => c.DistanceTo(o.Item1, o.Item2, o.Item3)).Take(NearbyChestLimit).ToList()
            : others.Take(NearbyChestLimit).ToList();
    }

    private string ChestOption(LiveCareEntry bench, WorldContainer chest)
    {
        var name = chest.Name is { Length: > 0 } custom ? custom
            : chest.ClassName is { Length: > 0 } className ? PlainNames.Thing(className) : PlainNames.Words(chest.Id);
        var free = chest.Inventories.Count > 0 ? chest.Inventories[0].Slots.Count(s => s.IsEmpty) : 0;
        var origin = bench.X != 0 || bench.Y != 0 || bench.Z != 0 ? (bench.X, bench.Y, bench.Z) : PlayerPosition;
        return origin is { } o
            ? L.Resource("LiveChemistryBenches_ChestOptionFormat", name, chest.DistanceTo(o.Item1, o.Item2, o.Item3) / 100, free)
            : L.Resource("LiveChemistryBenches_ChestOptionNoDistanceFormat", name, free);
    }

    /// <summary>Moves the flask into the picked chest's first empty slot as ONE real move in the
    /// running game (the same transfer the containers screen uses between two crates), so the
    /// flask's own durability, liquid and any other instance data travel with it - nothing is
    /// duplicated from the catalog and nothing is cleared separately. The bench and the chest
    /// are each re-read on their own afterwards; the bench's flask fields follow on this
    /// session's next refresh.</summary>
    private async Task SendFlaskToChestAsync(LiveCareEntry bench, LiveCareField flask)
    {
        if (Containers is null || IsEmptySlot(flask.Value) || _sendChestId is not { Length: > 0 } chestId) return;
        if (!TryFlaskSlotIndex(flask, out var flaskIndex)) return;
        _fieldErrors.Remove(bench.Id);
        var chest = Containers.Containers.FirstOrDefault(c => string.Equals(c.Id, chestId, StringComparison.Ordinal));
        if (chest is null) { _fieldErrors[bench.Id] = L.Resource("LiveChemistryBenches_ChestGone"); return; }
        var free = chest.Inventories.Count > 0 ? chest.Inventories[0].Slots.FirstOrDefault(s => s.IsEmpty) : null;
        if (free is null) { _fieldErrors[bench.Id] = L.Resource("LiveChemistryBenches_ChestFull"); return; }
        _busy = true;
        try
        {
            await Containers.TransferAsync(new LiveInventoryEndpoint(flaskIndex, ContainerId: bench.Id),
                new LiveInventoryEndpoint(free.Index, ContainerId: chestId));
            CloseSendPicker();
            await Session.RefreshAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _fieldErrors[bench.Id] = Errors.Present(exception, "Send this to a chest.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A flask field's id is "flask:N" where N is its slot in the bench's own inventory
    /// (three inputs then the output) - the exact slot index a transfer endpoint needs.</summary>
    private static bool TryFlaskSlotIndex(LiveCareField flask, out int index)
    {
        index = -1;
        return flask.Id.StartsWith("flask:", StringComparison.Ordinal)
            && int.TryParse(flask.Id.AsSpan("flask:".Length), out index) && index >= 0;
    }

    /// <summary>Right-click send, the exact same destination logic WorldContainersTab's own
    /// SendToPlayerAsync uses (a connected live player's first empty backpack slot, else the
    /// hotbar; failing that, a staged offline player save the same way) - adapted for a flask's
    /// bare item id instead of an existing PlayerInventorySlotEdit to copy, via the same
    /// SlotDropRules.FillFromCatalog a palette give already uses to build a fresh item instance
    /// from a catalog entry. The flask is only cleared after the player side genuinely accepted
    /// the item - a failed send leaves the flask alone rather than losing what was in it.</summary>
    private async Task SendFlaskToPlayerAsync(LiveCareEntry bench, LiveCareField flask)
    {
        if (IsEmptySlot(flask.Value) || Catalog.Find(flask.Value!) is not { } entry) return;
        _fieldErrors.Remove(bench.Id);
        CloseSendPicker();
        if (LivePlayerSession is { } livePlayer)
        {
            var (destination, area) = livePlayer.Backpack.FirstOrDefault(slot => slot.IsEmpty) is { } backpack
                ? (backpack, PlayerInventoryArea.Backpack)
                : (livePlayer.Hotbar.FirstOrDefault(slot => slot.IsEmpty), PlayerInventoryArea.Hotbar);
            if (destination is null) { _fieldErrors[bench.Id] = L.Resource("LiveChemistryBenches_PlayerInventoryFull"); return; }
            try
            {
                SlotDropRules.FillFromCatalog(destination, entry);
                await livePlayer.PushSlotAsync(area, destination);
            }
            catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
                or IOException or OperationCanceledException)
            {
                _fieldErrors[bench.Id] = Errors.Present(exception, "Send this to a player.", "The connection may have dropped; try reconnecting.");
                return;
            }
            await SetFlaskAsync(bench.Id, flask.Id, string.Empty);
            return;
        }
        if (PlayerSession is not { } player) { _fieldErrors[bench.Id] = L.Resource("WorldContainers_NoPlayerSaveFound"); return; }
        var (offlineDestination, _) = player.Backpack.FirstOrDefault(slot => slot.IsEmpty) is { } offlineBackpack
            ? (offlineBackpack, PlayerInventoryArea.Backpack)
            : (player.Hotbar.FirstOrDefault(slot => slot.IsEmpty), PlayerInventoryArea.Hotbar);
        if (offlineDestination is null) { _fieldErrors[bench.Id] = L.Resource("LiveChemistryBenches_PlayerInventoryFull"); return; }
        SlotDropRules.FillFromCatalog(offlineDestination, entry);
        player.MarkChanged();
        await SetFlaskAsync(bench.Id, flask.Id, string.Empty);
    }

    private async Task RefreshAsync() => await RunAsync(() => Session.RefreshAsync());

    private async Task SetFlaskAsync(string benchId, string fieldId, string? value)
    {
        _busy = true;
        _fieldErrors.Remove(benchId);
        try
        {
            var result = await Session.SetFieldAsync(benchId, fieldId, value);
            if (result.IsError)
            {
                _fieldErrors[benchId] = result.Error is { Length: > 0 } explanation ? explanation : L.Resource("WorldFeature_ChangeRefused");
            }
            else
            {
                await OnChanged.InvokeAsync();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Edit chemistry benches.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
