@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.Codex
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Components.Shared
@inject ItemCatalogService Items

@* Dedicated live tab rather than a reuse of WorldTradersTab: that component's right-hand detail
   pane leans on InventorySelectionService's master-detail split (a layout LiveConnect.razor's
   flat single-column page does not have) plus file-only services (StoryFlagSyncService,
   RecipeProgressGateService) for cross-region flag resolution a live session does not need
   (the running game's flags ARE the current truth, no sibling-file merge required). The roster
   and gating logic are the same (TraderCatalog/TraderLore, HasWorldFlag), just presented flat -
   including a trader's stock: what a trader sells/accepts is curated game data
   (TraderInfo.Sells/Accepts), the same as the file tab, never something a live read is needed
   for, so tapping a row to expand it needs no new wire command. *@
<section class="editor-card" aria-label="@L.Resource("LiveTraders_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveTraders_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveTraders_NotHostWarning")</p>
    }
    <p class="muted">@L.Resource("LiveTraders_Intro")</p>

    <div class="shell-save-list">
        @foreach (var trader in Session.Roster.Where(t => !TraderLore.NonTraders.Contains(t.Id))
            .OrderBy(t => TraderLore.ById.ContainsKey(t.Id) ? 0 : 1).ThenBy(t => t.Id, StringComparer.OrdinalIgnoreCase))
        {
            var missing = Session.MissingFlags(trader);
            var available = Session.IsAvailable(trader);
            var expanded = _expandedTraderId == trader.Id;
            <div class="save-file-row kind-player wt-live-row @(expanded ? "selected" : null)" @key="trader.Id"
                 role="button" tabindex="0" aria-expanded="@(expanded ? "true" : "false")"
                 @onclick="() => ToggleStock(trader)" @onkeydown="e => StockKeyDown(e, trader)">
                <span class="save-kind-marker" aria-hidden="true"></span>
                @* save-file-name keeps the shared row grid's own column/row placement (see
                   parity.css); the portrait lives INSIDE it as a small flex row rather than as
                   its own grid child, so it does not disturb that placement. *@
                <span class="save-file-name wt-live-name">
                    <span class="wt-live-portrait">
                        <GameArtImage GameRef="@trader.ImageAssetPath" Alt="@DisplayName(trader)">
                            <span class="material-symbol" aria-hidden="true">person</span>
                        </GameArtImage>
                    </span>
                    <strong>@DisplayName(trader)</strong>
                </span>
                <div class="live-npc-controls">
                    <span>@(available ? L.Resource("WorldTraders_Card_AvailableHere") : L.Resource("WorldTraders_Card_NotYetHere", PlainNames.Flags(L, missing)))</span>
                    @if (missing.Count > 0)
                    {
                        <button class="secondary" type="button" disabled="@(!Session.IsHost || _busy)"
                                @onclick:stopPropagation="true" @onclick="() => UnlockAsync(missing)">@L.Resource("LiveTraders_Unlock")</button>
                    }
                </div>
            </div>
            @if (expanded)
            {
                <div class="wt-live-stock" @onclick:stopPropagation="true">
                    <span class="wm-label">@L.Resource("Slot_WhatTheyAcceptAsPayment")</span>
                    <p class="wt-accepts">@AcceptsText(trader)</p>
                    <span class="wm-label">@L.Resource("Slot_WhatTheySellTapAnItemToInspectTickLockedItemsToUnlock")</span>
                    @if (trader.Sells.Count == 0)
                    {
                        <p class="muted">@L.Resource("WorldTraders_Card_NoStockTable")</p>
                    }
                    else
                    {
                        <div class="wt-offer-list">
                            @foreach (var offer in trader.Sells)
                            {
                                var name = Items.Find(offer.ItemId)?.DisplayName ?? PlainNames.Words(offer.ItemId);
                                var text = offer.Count > 1 ? $"{offer.Count}× {name}" : name;
                                var unlocked = offer.RequiredFlag is null || Session.HasWorldFlag(offer.RequiredFlag);
                                var status = offer.RequiredFlag is null ? L.Resource("WorldTraders_Card_AlwaysStocked")
                                    : unlocked ? L.Resource("WorldTraders_Card_UnlockedFlagSet", PlainNames.Flag(L, offer.RequiredFlag))
                                    : L.Resource("WorldTraders_Card_LockedNeedsFlag", PlainNames.Flag(L, offer.RequiredFlag));
                                <div class="wt-offer-row wt-live-offer-row" @key="offer.ItemId">
                                    <span class="wt-offer-icon"><ItemIcon ItemId="@offer.ItemId" Alt="@text" /></span>
                                    <span class="wt-offer-text"><strong>@text</strong><small>@status</small></span>
                                    @if (!unlocked && offer.RequiredFlag is { } flag)
                                    {
                                        <button type="button" class="secondary" disabled="@(!Session.IsHost || _busy)"
                                                @onclick="() => UnlockAsync([flag])">@L.Resource("LiveTraders_Unlock")</button>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveTradersSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private string? _expandedTraderId;

    // Full localized lore names (WorldTraders_Lore_{id}_Name) are the file tab's job; this
    // dedicated live view keeps to plain, always-available names instead of duplicating that
    // resx-driven lookup for a tab that exists only because the split-pane detail view does not
    // fit this page's layout.
    private static string DisplayName(TraderInfo trader) => PlainNames.Words(trader.Id);

    /// <summary>Tap-to-toggle, no shared detail pane on this flat page (see the class remarks):
    /// the stock list just expands inline under the tapped row instead.</summary>
    private void ToggleStock(TraderInfo trader) => _expandedTraderId = _expandedTraderId == trader.Id ? null : trader.Id;

    private void StockKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs args, TraderInfo trader)
    {
        if (args.Key is "Enter" or " ") ToggleStock(trader);
    }

    private string AcceptsText(TraderInfo trader)
    {
        var names = trader.Accepts
            .Select(offer => offer.Count > 1
                ? $"{offer.Count}× {Items.Find(offer.ItemId)?.DisplayName ?? PlainNames.Words(offer.ItemId)}"
                : Items.Find(offer.ItemId)?.DisplayName ?? PlainNames.Words(offer.ItemId))
            .Distinct()
            .ToList();
        return names.Count == 0 ? L.Resource("WorldTraders_Card_AcceptsVaries") : string.Join(", ", names);
    }

    private async Task RefreshAsync() => await RunAsync(() => Session.RefreshAsync());

    private async Task UnlockAsync(IReadOnlyList<string> flags) => await RunAsync(() => Session.UnlockAsync(flags));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Edit trader availability.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
