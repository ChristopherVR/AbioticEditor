@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.World
@using AbioticEditor.Core.WorldSaves

@* Every door currently loaded around the players. Each change applies immediately (see
   LiveDoorsSession); the state names are the same E_DoorStates the file editor's doors tab uses. *@
<section class="editor-card" aria-label="@L.Resource("LiveDoors_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveDoors_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveDoors_NotHostWarning")</p>
    }
    <p class="muted">@L.Resource("LiveDoors_Intro", Session.Doors.Count)</p>

    <div class="live-toolbar">
        <input aria-label="@L.Resource("WorldDoors_FilterPlaceholder")" @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("WorldDoors_FilterPlaceholder")" />
    </div>

    @if (Session.Doors.Count == 0)
    {
        <p class="muted">@L.Resource("LiveDoors_NoneFound")</p>
    }
    else
    {
        <div class="shell-save-list">
            @foreach (var door in VisibleDoors)
            {
                <div class="save-file-row kind-world" @key="door.Id">
                    <span class="save-kind-marker" aria-hidden="true"></span>
                    <span class="live-flag-texts">
                        <strong class="save-file-name">@FriendlyClass(door)</strong>
                        <small>@(door.Kind == LiveDoorKind.Security ? L.Resource("LiveDoors_KindSecurity") : L.Resource("LiveDoors_KindSimple")) · @Position(door)</small>
                    </span>
                    <div class="live-npc-controls">
                        @if (door.Kind == LiveDoorKind.Simple)
                        {
                            <label class="live-npc-faction">
                                @L.Resource("WorldDoors_State")
                                <select value="@door.State" disabled="@(!Session.IsHost || _busy)" @onchange="e => SetStateAsync(door, e)">
                                    <option value="0">@L.Resource("WorldDoors_State_Closed")</option>
                                    <option value="1">@L.Resource("WorldDoors_State_Open")</option>
                                    <option value="2">@L.Resource("WorldDoors_State_Locked")</option>
                                    @if (door.State > 2) { <option value="@door.State">@DoorStateNames.Friendly(door.State.ToString())</option> }
                                </select>
                            </label>
                            <label class="checkbox-field">
                                <input type="checkbox" checked="@door.OneWayUnlocked" disabled="@(!Session.IsHost || _busy)"
                                       @onchange="e => SetOneWayAsync(door, (bool)e.Value!)" />
                                @L.Resource("LiveDoors_OneWayUnlocked")
                            </label>
                            <label class="checkbox-field">
                                <input type="checkbox" checked="@door.Disabled" disabled="@(!Session.IsHost || _busy)"
                                       @onchange="e => SetDisabledAsync(door, (bool)e.Value!)" />
                                @L.Resource("LiveNpcs_Disabled")
                            </label>
                        }
                        else
                        {
                            <button class="secondary" type="button" disabled="@(!Session.IsHost || _busy)" @onclick="() => ToggleSecurityAsync(door)">
                                @(door.IsOpen ? L.Resource("LiveDoors_Close") : L.Resource("LiveDoors_Open"))
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveDoorsSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private string _filter = string.Empty;

    private IEnumerable<LiveDoor> VisibleDoors
    {
        get
        {
            var filter = _filter.Trim();
            IEnumerable<LiveDoor> doors = Session.Doors;
            if (filter.Length > 0)
            {
                doors = doors.Where(d => d.Id.Contains(filter, StringComparison.OrdinalIgnoreCase)
                    || FriendlyClass(d).Contains(filter, StringComparison.OrdinalIgnoreCase));
            }
            return doors;
        }
    }

    private static string FriendlyClass(LiveDoor door)
    {
        var info = DoorClassCatalog.Lookup(door.Label);
        return string.IsNullOrEmpty(info.DisplayName) || info.DisplayName == door.Label
            ? AbioticEditor.Web.Components.Shared.PlainNames.Thing(door.Label)
            : info.DisplayName;
    }

    private static string Position(LiveDoor door)
        => $"{door.X / 100:0}, {door.Y / 100:0}, {door.Z / 100:0} m";

    private Task RefreshAsync() => RunAsync(() => Session.RefreshAsync());

    private Task SetStateAsync(LiveDoor door, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var state)) return Task.CompletedTask;
        return RunAsync(() => Session.ApplyAsync(new LiveDoorEdit(door.Id, door.Kind, State: state)));
    }

    private Task SetOneWayAsync(LiveDoor door, bool value) =>
        RunAsync(() => Session.ApplyAsync(new LiveDoorEdit(door.Id, door.Kind, OneWayUnlocked: value)));

    private Task SetDisabledAsync(LiveDoor door, bool value) =>
        RunAsync(() => Session.ApplyAsync(new LiveDoorEdit(door.Id, door.Kind, Disabled: value)));

    private Task ToggleSecurityAsync(LiveDoor door) =>
        RunAsync(() => Session.ApplyAsync(new LiveDoorEdit(door.Id, door.Kind, IsOpen: !door.IsOpen)));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Change this door.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
