@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@inject AbioticEditor.Ui.IExternalNavigationService ExternalNavigation
@inject AbioticEditor.Ui.IFilePicker FilePicker
@inject AbioticEditor.Web.Services.ISaveFileSystem Files
@inject AbioticEditor.Web.Services.ISaveExporter Exporter

@* Faithful port of the native WorldRawTab (the RAW JSON tab): one panel with the RAW SAVE
   JSON export -> edit externally -> import workflow and a status readout, mirroring the
   player DATA tab. The native tab has no in-app property editor, so this tab does not
   either. *@
<section class="editor-card raw-json-card" aria-label="@L.Resource("WorldRaw_RawSaveJson")">
    <h3>@L.Resource("WorldRaw_RawSaveJson")</h3>
    <p class="muted">@L.Resource("WorldRaw_RawJsonIntro")</p>
    <p class="raw-json-path">@L.Resource("Common_JsonFileFormat", Session.JsonPath)</p>
    <div class="editor-actions">
        <button type="button" class="accent-orange" disabled="@_jsonBusy" @onclick="ExportJsonAsync">@L.Resource("WorldRaw_ExportJsonOpen")</button>
        @* Import asks which file to use, so it stays available even when nothing was exported
           beside this save yet. *@
        <button type="button" class="accent-orange" disabled="@_jsonBusy" @onclick="ImportJsonAsync">@L.Resource("WorldRaw_ImportJsonSave")</button>
        @if (_jsonBusy) { <span class="header-busy-spinner" role="status" aria-label="@L.Resource("PlayerUi_Working")"></span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(_jsonStatus)) { <p class="raw-json-status" role="status">@_jsonStatus</p> }
</section>

@code {
    [Parameter, EditorRequired] public WorldSaveSession Session { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "World editor";
    private string? _jsonStatus;
    private bool _jsonBusy;

    private async Task ExportJsonAsync()
    {
        _jsonBusy = true; _jsonStatus = L.Resource("WorldEditor_ExportingJson");
        try
        {
            // A browser has no folder to write the JSON into, so it arrives as a download instead.
            // Writing it beside the save used to be attempted anyway, which failed outright.
            if (!Files.HasLocalPaths)
            {
                var name = Session.JsonPath[(Session.JsonPath.LastIndexOfAny(['/', '\\']) + 1)..];
                var bytes = await Session.ExportJsonBytesAsync();
                await Exporter.ExportAsync(name, bytes);
                _jsonStatus = L.Resource("WorldEditor_ExportedJsonFormat", bytes.Length / 1024d / 1024d, name);
                return;
            }

            await Session.ExportJsonToFileAsync();
            _jsonStatus = L.Resource("WorldEditor_ExportedJsonFormat", new FileInfo(Session.JsonPath).Length / 1024d / 1024d, Path.GetFileName(Session.JsonPath));
        }
        catch (Exception ex) { _jsonStatus = L.Resource("WorldEditor_ExportFailedFormat", Errors.Present(ex, "The world data could not be exported.", "The save was not changed; try again after reopening it.")); return; }
        finally { _jsonBusy = false; }
        // Showing the finished file in the file manager is a courtesy: if it fails, the export
        // still succeeded, so never let it replace the success message with an export error.
        try { await ExternalNavigation.RevealPathAsync(Session.JsonPath); }
        catch (Exception ex) { Errors.Record(ex, "Reveal the exported world JSON file"); }
    }

    // Import asks which JSON to put back rather than only accepting the file sitting beside the
    // save, so an edited copy kept anywhere (or one from another machine) can override this world.
    private async Task ImportJsonAsync()
    {
        string chosen;
        bool temporary;
        try
        {
            if (await RawJsonImport.ChooseAsync(FilePicker, L.Resource("Common_ChooseJsonFile")) is not { } picked)
            {
                _jsonStatus = L.Resource("Common_ImportJsonCancelled");
                return;
            }
            (chosen, temporary) = picked;
        }
        catch (Exception ex)
        {
            _jsonStatus = L.Resource("WorldEditor_ImportFailedFormat", Errors.Present(ex, "The file could not be chosen.", "The save was not replaced; try again."));
            return;
        }

        _jsonBusy = true; _jsonStatus = L.Resource("WorldEditor_ImportingJson");
        try { await Session.ImportJsonFromFileAsync(chosen); _jsonStatus = L.Resource("WorldEditor_ImportedJsonFormat", DateTime.Now); }
        catch (Exception ex) { _jsonStatus = L.Resource("WorldEditor_ImportFailedFormat", Errors.Present(ex, "The world data could not be imported.", "The save was not replaced; check the JSON and try again.")); }
        finally { _jsonBusy = false; RawJsonImport.CleanUp(chosen, temporary); }
    }
}
