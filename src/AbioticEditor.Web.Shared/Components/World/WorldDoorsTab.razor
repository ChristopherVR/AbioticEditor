    private static StoryChapter? RegionChapterForToken(string? token)
    {
        if (string.IsNullOrEmpty(token)) return null;
        var lower = token.ToLowerInvariant();
        foreach (var (t, row) in FileRegionMap)
        {
            if (lower.Contains(t, StringComparison.Ordinal)) return StoryProgressionCatalog.Find(row);
        }
        return null;
    }

    private StoryChapter? RegionChapterForFile()
    {
        var name = System.IO.Path.GetFileNameWithoutExtension(Session.Path).ToLowerInvariant();
        return RegionChapterForToken(name);
    }

    /// <summary>The door's own sub-level maps to a chapter first; otherwise fall back to
    /// whichever chapter the loaded save file itself represents.</summary>
    private StoryChapter? RegionChapterFor(string? doorMapName) => RegionChapterForToken(doorMapName) ?? RegionChapterForFile();
