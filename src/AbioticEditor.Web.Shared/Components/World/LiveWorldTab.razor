@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.World

@* World clock and weather of the running game. Each button is one immediate action (see
   LiveWorldStateSession) - the clock keeps ticking on its own, so there is nothing to stage. *@
<section class="editor-card" aria-label="@L.Resource("LiveWorld_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveWorld_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.State.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveWorld_NotHostWarning")</p>
    }
    <p class="muted">@L.Resource("LiveWorld_Intro")</p>

    <div class="live-world-grid">
        <div class="live-world-block">
            <h4 class="live-inventory-group">@L.Resource("LiveWorld_Clock")</h4>
            <p class="live-world-readout">
                @L.Resource("LiveWorld_Readout", Session.State.Day, Session.State.Hour.ToString("00"), Session.State.Minute.ToString("00"))
                <span class="live-world-chip">@(Session.State.IsNight ? L.Resource("LiveWorld_Night") : L.Resource("LiveWorld_Day"))</span>
                @if (Session.State.Paused) { <span class="live-world-chip">@L.Resource("LiveWorld_Paused")</span> }
            </p>
            <div class="live-inventory-controls live-world-controls">
                <label class="live-inventory-field">@L.Resource("LiveWorld_Hour")<input type="number" min="0" max="23" @bind="_hour" /></label>
                <label class="live-inventory-field">@L.Resource("LiveWorld_Minute")<input type="number" min="0" max="59" @bind="_minute" /></label>
                <button class="secondary" type="button" disabled="@(!Session.State.IsHost || _busy)" @onclick="SetTimeAsync">@L.Resource("LiveWorld_SetTime")</button>
            </div>
            <div class="live-inventory-controls live-world-controls">
                <label class="live-inventory-field">@L.Resource("LiveWorld_DayNumber")<input type="number" min="1" @bind="_day" /></label>
                <button class="secondary" type="button" disabled="@(!Session.State.IsHost || _busy)" @onclick="SetDayAsync">@L.Resource("LiveWorld_SetDay")</button>
            </div>
        </div>

        <div class="live-world-block">
            <h4 class="live-inventory-group">@L.Resource("LiveWorld_Weather")</h4>
            <p class="live-world-readout">@L.Resource("LiveWorld_CurrentWeather", WeatherLabel(Session.State.CurrentWeather))</p>
            <div class="live-inventory-controls live-world-controls">
                <select @bind="_weather" disabled="@_busy">
                    @foreach (var option in Session.State.WeatherOptions)
                    {
                        <option value="@option">@WeatherLabel(option)</option>
                    }
                </select>
                <button class="secondary" type="button" disabled="@(!Session.State.IsHost || _busy)" @onclick="TriggerWeatherAsync">@L.Resource("LiveWorld_TriggerNow")</button>
                <button class="secondary" type="button" disabled="@(!Session.State.IsHost || _busy || _weather == "None")" @onclick="QueueWeatherAsync">@L.Resource("LiveWorld_QueueTomorrow")</button>
            </div>
            <p class="muted">@L.Resource("LiveWorld_WeatherHelp")</p>
        </div>
    </div>

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveWorldStateSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private int _hour;
    private int _minute;
    private int _day;
    private string _weather = "None";
    private LiveWorldState? _seededFrom;

    protected override void OnParametersSet()
    {
        // Seed the inputs from the game once per fresh reading, never while the user is typing.
        if (ReferenceEquals(_seededFrom, Session.State)) return;
        _seededFrom = Session.State;
        _hour = Session.State.Hour;
        _minute = Session.State.Minute;
        _day = Session.State.Day;
        if (!Session.State.WeatherOptions.Contains(_weather)) _weather = Session.State.WeatherOptions.FirstOrDefault() ?? "None";
    }

    private string WeatherLabel(string raw) => raw switch
    {
        "None" or "" => L.Resource("LiveWorld_WeatherNone"),
        _ => AbioticEditor.Web.Components.Shared.PlainNames.Words(raw),
    };

    private Task RefreshAsync() => RunAsync(() => Session.RefreshAsync());
    private Task SetTimeAsync() => RunAsync(() => Session.SetTimeAsync(_hour, _minute));
    private Task SetDayAsync() => RunAsync(() => Session.ApplyAsync(new LiveWorldStateEdit(Day: Math.Max(1, _day))));
    private Task TriggerWeatherAsync() => RunAsync(() => Session.ApplyAsync(new LiveWorldStateEdit(Weather: _weather)));
    private Task QueueWeatherAsync() => RunAsync(() => Session.ApplyAsync(new LiveWorldStateEdit(NextWeather: _weather)));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Change the world clock or weather.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
