@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.Items
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Core.WorldSaves
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime Js
@inject InventorySelectionService Selection
@inject SlotDragDropService Dnd
@inject ItemCatalogService Items
@inject ItemUpgradeVocabularyService Upgrades
@inject SaveWorkspaceSessionService Workspace

@* Faithful port of the native WorldContainersTab.xaml: filter + HIDE EMPTY row, then the
   two-column master/detail body (container list on the left, the selected container's
   6-across slot grid on the right), then the drag and right-click-send help lines.
   Tapping a slot opens it in the right-hand sidebar slot editor, exactly like native. *@
<section class="world-editor wc-tab" aria-label="@L.Resource("WorldContainers_SelectAContainer")">
    @if (!Session.CanEditContainers)
    {
        <p class="empty">@L.Resource("WorldContainers_NoContainersMatch")</p>
    }
    else
    {
        @if (Session.AppliesImmediately && !Session.IsHost)
        {
            <p class="error-text" role="alert">@L.Resource("LiveContainers_NotHostWarning")</p>
        }
        <div class="wc-filter-row">
            <input aria-label="@L.Resource("WorldContainers_FilterPlaceholder")" @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("WorldContainers_FilterPlaceholder")" />
            <label class="wc-hide-empty"><input type="checkbox" @bind="_hideEmpty" /> <span>@L.Resource("WorldContainers_HideEmpty")</span></label>
            @if (PlayerPosition is not null)
            {
                <label class="wc-hide-empty"><input type="checkbox" @bind="_nearbyOnly" /> <span>@L.Resource("WorldDropped_NearbyOnly")</span></label>
                @if (_nearbyOnly)
                {
                    <input type="number" min="100" step="100" class="wt-readout-input" aria-label="@L.Resource("WorldDropped_NearbyRadius")" @bind="_nearbyRadius" />
                }
            }
        </div>
        <div class="wc-split">
            <div class="wc-master" role="list" aria-label="@L.Resource("WorldContainers_SelectAContainer")">
                @{ var visible = VisibleContainers; }
                @if (visible.Count == 0) { <p class="wc-empty">@L.Resource("WorldContainers_NoContainersMatch")</p> }
                @foreach (var container in visible)
                {
                    var key = (container.Source, container.Id);
                    @* A crate is named for what it is and what is in it. The long reference
                       the game files it under is not shown anywhere: it is not something a
                       player can act on. *@
                    <div class="wc-row @(_selectedKey == key ? "selected" : null)" role="listitem" @key="ContainerKey(container)"
                         @ondragover:preventDefault
                         @ondrop="() => DropOnContainer(container)">
                        <button class="wc-row-select" type="button" @onclick="() => TapContainer(container)">
                        @* Same "name" grid-area the row's own named-area layout already reserves
                           for the label alone - the icon and the name share it as a small flex
                           row instead of the area gaining a second track, so the row's own
                           grid-template-areas/grid-template-columns (fixed this round to stop the
                           position line clipping under the name) is untouched. *@
                        <span class="wc-row-name">
                            @if (ContainerItemId(container) is { Length: > 0 } previewId)
                            {
                                <ItemIcon ItemId="@previewId" Alt="" Class="wc-row-icon" />
                            }
                            <strong>@DisplayName(container)</strong>
                        </span>
                        <span class="wc-count">@CountText(container)</span>
                        @if (HealthText(container) is { Length: > 0 } rowHealth) { <span class="wc-health">@rowHealth</span> }
                        <small>@WhereText(container)</small>
                        </button>
                    </div>
                }
            </div>
            <div class="wc-detail">
                @if (SelectedContainer is not { } selected || _slotEdits is null)
                {
                    <p class="wc-select-label">@L.Resource("WorldContainers_SelectAContainer")</p>
                    <p class="wc-select-help">@L.Resource("WorldContainers_SelectContainerHelp")</p>
                }
                else
                {
                    <h3 class="wc-title">@DisplayName(selected)</h3>
                    @if (HealthText(selected) is { Length: > 0 } detailHealth) { <p class="wc-health">@detailHealth</p> }
                    <p class="wc-id">@WhereText(selected)</p>
                    @if (selected.Source == WorldContainerSource.Deployed || selected.Source == WorldContainerSource.Live)
                    {
                        <label class="wc-rename">
                            <span class="wc-rename-label">@L.Resource("WorldContainers_DetailCustomName")</span>
                            <input class="wt-input" value="@selected.Name" placeholder="@AutoDisplayName(selected)"
                                   disabled="@(Session.AppliesImmediately && !Session.IsHost)"
                                   @onchange="e => RenameContainerAsync(selected, e.Value?.ToString())" />
                        </label>
                        <small class="wt-muted">@L.Resource("WorldContainers_DetailCustomNameHint")</small>
                        @if (IsVoidChest(selected))
                        {
                            <small class="wt-muted">@L.Resource("WorldContainers_VoidChestSharedNameHint")</small>
                        }
                    }
                    <button type="button" class="wt-btn wt-yellow" disabled="@(Session.AppliesImmediately && !Session.IsHost)" @onclick="() => SortAsync(selected)">@L.Resource("WorldContainers_Sort")</button>
                    <div class="wc-divider"></div>
                    <div class="wc-slot-grid">
                        @foreach (var edit in _slotEdits)
                        {
                            var isActive = Selection.Current?.Slot == edit;
                            <button type="button"
                                    class="wc-slot @(isActive ? "selected" : null)"
                                    aria-pressed="@isActive"
                                    aria-label="@($"[{edit.Index:D2}] {SlotName(edit)}")"
                                    title="@L.Resource("WorldContainers_SendHelp")"
                                    draggable="@(!edit.IsEmpty ? "true" : "false")"
                                    @ondragstart="() => _dragEdit = edit"
                                    @ondragend="() => _dragEdit = null"
                                    @ondragover:preventDefault
                                    @ondrop="() => DropOnSlot(edit)"
                                    @onclick="() => TapSlot(edit)"
                                    @oncontextmenu="() => SendToPlayerAsync(edit)"
                                    @oncontextmenu:preventDefault>
                                @if (!edit.IsEmpty && edit.ItemId is { } itemId)
                                {
                                    <span class="wc-slot-icon"><ItemIcon ItemId="@itemId" Alt="@SlotName(edit)" /></span>
                                    @if (edit.Count > 1) { <span class="wc-slot-count">@edit.Count</span> }
                                    @if (UpgradeCatalog.UpgradeFor(itemId) is not null) { <span class="wc-slot-upg">▲</span> }
                                    <span class="wc-slot-name">@SlotName(edit)</span>
                                }
                                else
                                {
                                    <span class="wc-slot-index">[@edit.Index.ToString("D2")]</span>
                                }
                            </button>
                        }
                    </div>

                    @* Pick-then-place, plus a button for handing an item to a player. Both
                       exist because dragging and right-clicking need a mouse, so both are
                       offered only where there is no mouse; nothing about the desktop
                       layout changes. *@
                    <SlotMoveBar Touch="@_touch" Holding="@IsHolding" CanStart="@CanStartMove"
                                 Message="@HoldingMessage" OnStart="StartMove" OnCancel="CancelMove" />
                    @if (_touch && (PlayerSession is not null || LivePlayerSession is not null) && Selection.Current?.Slot is { IsEmpty: false } sendable && _slotEdits?.Contains(sendable) == true)
                    {
                        <div class="editor-actions">
                            <button type="button" class="secondary" @onclick="() => SendToPlayerAsync(sendable)">@L.Resource("WorldPets_SendToPlayer")</button>
                        </div>
                    }
                }
            </div>
        </div>
        @* The instructions have to match what the device can do: dragging a slot and
           right-clicking are mouse-only, so a touch screen is told about the buttons instead. *@
        <p class="wc-help">@L.Resource(_touch ? "PlayerUi_MoveBetweenAreasHelp" : "WorldContainers_DragHelp")</p>
        @if (!_touch) { <p class="wc-help">@L.Resource("WorldContainers_SendHelp")</p> }
        @* Sending to a sibling player only reaches a save already open next to this one. Moving
           items into a wholly different world (another region set, another playthrough) is a
           separate tool, since it needs its own file picker rather than this tab's session. *@
        @if (!Session.AppliesImmediately)
        {
            <p class="wc-help"><NavLink href="transfer-items">@L.Resource("WorldContainers_TransferItemsLink")</NavLink></p>
        }
        @if (_moveStatus is { } status) { <p class="wc-status">@status</p> }
        @if (Session.AppliesImmediately && Session.Status is not null) { <p class="status-text">@Session.Status</p> }
        @if (_liveError is not null) { <p class="error-text" role="alert">@_liveError</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public IWorldContainersSession Session { get; set; } = null!;
    [Parameter] public PlayerSaveSession? PlayerSession { get; set; }
    [Parameter] public LiveInventorySession? LivePlayerSession { get; set; }
    [Parameter] public string Title { get; set; } = "World editor";
    [Parameter] public EventCallback<string?> OnError { get; set; }
    // Set only while an edit is talking to a live game; the file session's own methods
    // complete synchronously so this never has anything to wait on there.
    private bool _busy;
    private string? _liveError;
    /// <summary>Set by the host (e.g. a "view on-board storage" jump from the Vehicles tab) to
    /// pre-fill the filter box once when this tab is shown; the user's own typing after that
    /// is never overwritten.</summary>
    [Parameter] public string? InitialFilter { get; set; }
    /// <summary>The connected character's current position (live only - null for the file
    /// session). See the matching parameter on the ground-items tab for why a distance cutoff,
    /// not a real area boundary, is the best this can do: the Facility is one continuous map, and
    /// containers.list always reports every placed container anywhere on it, not just nearby
    /// ones (reported live: a container search finding things from a completely different area
    /// while standing somewhere else entirely).</summary>
    [Parameter] public (double X, double Y, double Z)? PlayerPosition { get; set; }
    private string? _appliedInitialFilter;
    private string _filter = string.Empty;
    // Off by default (round 83): the native app hid empty containers until unticked, but a live
    // report showed this defeating the same "jump straight to one specific container" links the
    // nearby-only filter's own round-81 fix already protects (see that field's remarks right
    // below) - a container someone just clicked EDIT on can easily be empty (a chemistry bench
    // with no flask contents yet, an unused chest). Left available for anyone who wants it.
    private bool _hideEmpty = false;
    // Off by default (round 81): a live report showed the nearby-only filter defaulting ON broke
    // the care-feature "EDIT" links below (OpenCareContainerAsync/InitialFilter jump straight to
    // one specific container by id, wherever it actually is - a chemistry bench, garden plot, or
    // power chair is exactly as likely to be far from the player as a Void Chest is) - the filter
    // silently hid the very thing the player just clicked to open, with the search box already
    // matching it. Left available (never removed) for someone who genuinely wants it on a very
    // cluttered map, just no longer surprising anyone by default.
    private bool _nearbyOnly;
    private double _nearbyRadius = 10000;
    private (WorldContainerSource Source, string Id)? _selectedKey;
    private List<PlayerInventorySlotEdit>? _slotEdits;
    private PlayerInventorySlotEdit? _dragEdit;
    private string? _moveStatus;

    protected override void OnInitialized()
    {
        Selection.Changed += Refresh;
        Dnd.Changed += Refresh;
        // Warm the upgrade catalog off-thread so the ▲ badges appear without blocking the UI.
        _ = Task.Run(() => Upgrades.Get()).ContinueWith(_ => InvokeAsync(StateHasChanged));
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(InitialFilter) && !string.Equals(InitialFilter, _appliedInitialFilter, StringComparison.Ordinal))
        {
            _appliedInitialFilter = InitialFilter;
            _filter = InitialFilter;
            // Native OpenVehicleInventory: the jump target is usually empty, so HIDE EMPTY
            // would drop it before the keyword filter even runs.
            _hideEmpty = false;
            // Belt and suspenders alongside the field's own off-by-default (see its remarks):
            // a jump-to-this-container link must never be defeated by a distance filter, however
            // far away that specific container turns out to be.
            _nearbyOnly = false;
        }
        // A redraw driven from outside this tab means the world moved on (a save, an undo, an
        // edit made elsewhere), so the kept crate summaries are read again.
        InvalidateSummaries();
        SyncEditsFromSession();
    }

    private ItemUpgradeCatalog UpgradeCatalog => Upgrades.TryGet(out var catalog) ? catalog : ItemUpgradeCatalog.Empty;

    private WorldContainer? SelectedContainer => _selectedKey is { } key
        ? Session.Containers.FirstOrDefault(container => container.Source == key.Source && string.Equals(container.Id, key.Id, StringComparison.Ordinal))
        : null;

    /// <summary>Native filter: the container itself OR any item stored inside it, so "find
    /// which crate holds my keypad hacker" is a one-box search. HIDE EMPTY runs first.</summary>
    private List<WorldContainer> VisibleContainers
    {
        get
        {
            IEnumerable<WorldContainer> q = Session.Containers;
            if (_hideEmpty) q = q.Where(container => OccupiedCount(container) > 0);
            if (!string.IsNullOrWhiteSpace(_filter))
            {
                var f = _filter.Trim();
                q = q.Where(container => SearchText(container).Contains(f, StringComparison.OrdinalIgnoreCase));
            }
            if (PlayerPosition is { } position)
            {
                if (_nearbyOnly)
                    q = q.Where(container => container.DistanceTo(position.X, position.Y, position.Z) <= _nearbyRadius);
                q = q.OrderBy(container => container.DistanceTo(position.X, position.Y, position.Z));
            }
            return q.ToList();
        }
    }

    private static IReadOnlyList<InventoryItemSlot> FirstInventorySlots(WorldContainer container)
        => container.Inventories.Count > 0 ? container.Inventories[0].Slots : Array.Empty<InventoryItemSlot>();

    private static int OccupiedCount(WorldContainer container) => FirstInventorySlots(container).Count(slot => !slot.IsEmpty);
    private static string CountText(WorldContainer container) => $"{OccupiedCount(container)}/{FirstInventorySlots(container).Count}";

    /// <summary>Null (no readout at all) for a deployable this game version does not track
    /// durability for, or for a file-save container (durability is never stored in the save,
    /// only read live from the running game - see <c>WorldContainer.Health</c>'s own remarks).</summary>
    private string? HealthText(WorldContainer container)
        => container.Health is { } current && container.MaxHealth is { } max
            ? L.Resource("WorldContainers_HealthFormat", current.ToString("0", System.Globalization.CultureInfo.InvariantCulture), max.ToString("0", System.Globalization.CultureInfo.InvariantCulture))
            : null;

    /// <summary>What to show for this crate: the name a player actually typed on it, when
    /// there is one - a container search already matched real ones like "Food/Cooking" or
    /// "Liquid/Meds" - else <see cref="AutoDisplayName"/>'s generic guess.</summary>
    private string DisplayName(WorldContainer container)
        => container.Name is { Length: > 0 } custom ? custom : AutoDisplayName(container);

    /// <summary>Every placed Void Chest is one chest in the game (one shared pool, one name) -
    /// the live side renames all of them together, and this is where the box says so.</summary>
    private static bool IsVoidChest(WorldContainer container)
        => container.ClassName?.Contains("StorageCrate_Void", StringComparison.OrdinalIgnoreCase) == true;

    /// <summary>
    /// A container's own picture, if this session can tell which real placeable item it is - a
    /// deployed container's <see cref="WorldContainer.ClassName"/> is a Blueprint asset name
    /// (e.g. <c>Deployed_StorageCrate_Void_C</c>), not the item id <see cref="ItemCatalogService"/>
    /// knows icons by (e.g. <c>storagecrate_void</c>), and the two do not follow one single
    /// mechanical rule - some strip cleanly ("Deployed_" prefix and "_C" suffix off, matched
    /// case-insensitively: Void/Freezer/the numbered storage-crate tiers/the two named "HGatekeeper"/
    /// "HOrnate" event crates all work this way), several genuinely do not (a "Deployed_Container_"
    /// actor is a "Deployable_" item; the T4 storage crate and the charging/hazard crates drop or
    /// swap words entirely; a bench's own item id puts "Bench" first, the actor class does not) -
    /// verified for real against this game's own registry data and a real save fixture's actually
    /// observed classes, not guessed. Every entry below is a confirmed real id; a class not listed
    /// here is either genuinely not its own separate placeable item (e.g. a locker-room fixture) or
    /// simply not yet catalogued - either way this returns null and the row shows no picture rather
    /// than a guessed, possibly wrong one (<see cref="ItemIcon"/> already renders nothing sensible
    /// for an id that is not real, so a wrong guess would not even fail loudly).
    /// </summary>
    private static readonly Dictionary<string, string> ContainerClassItemIds = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Deployed_Bench_AmmoStation_C"] = "Deployable_Bench_Ammo",
        ["Deployed_Bench_CookingStation_C"] = "Deployable_Bench_Cooking",
        ["Deployed_ChemistryBench_C"] = "Deployable_Bench_Chemistry",
        ["Deployed_Container_FilingCabinet_Small_C"] = "Deployable_FilingCabinet_Small",
        ["Deployed_Container_FilingCabinet_Medium_C"] = "Deployable_FilingCabinet_Medium",
        ["Deployed_Container_FilingCabinet_Large_C"] = "Deployable_FilingCabinet_Large",
        ["Deployed_Container_FilingCabinet_Huge_C"] = "Deployable_FilingCabinet_Huge",
        ["Deployed_Container_Medkit_C"] = "Deployable_Medkit",
        ["Deployed_Container_Stocking_C"] = "stocking",
        ["Deployed_Container_TrashCan_C"] = "Deployable_TrashCan_01",
        ["Deployed_Container_TrashCan_Small_C"] = "Deployable_TrashCan_Small",
        ["Deployed_CraftingBench_Default_C"] = "Deployable_Bench_Crafting",
        ["Deployed_CraftingBench_Repair_C"] = "Deployable_Bench_Repair",
        ["Deployed_CraftingBench_Upgrade_C"] = "Deployable_Bench_Upgrade",
        ["Deployed_DistillationBench_C"] = "Deployable_Bench_Distillation",
        ["Deployed_HazardCrate_C"] = "storage_hazardcrate",
        ["Deployed_LiquidContainer_Barrel_C"] = "Deployable_Barrel",
        ["Deployed_LiquidContainer_Cauldron_Tech_C"] = "cauldron",
        ["Deployed_StorageCrate_Charging_C"] = "crate_charging",
        ["Deployed_StorageCrate_Makeshift_T4_C"] = "storagecrate_t4",
        ["Deployed_ArmoryLocker_C"] = "Deployable_ArmoryLocker",
    };

    private string? ContainerItemId(WorldContainer container)
    {
        if (container.ClassName is not { Length: > 0 } className) return null;
        if (ContainerClassItemIds.TryGetValue(className, out var mapped)) return Items.Find(mapped) is not null ? mapped : null;
        // The general case: most classes really are just "Deployed_" + the item id + "_C" - see
        // this method's own remarks for which ones are not, and are covered by the table above
        // instead. Only returned when that guess actually resolves to a real, icon-bearing item -
        // an unmatched guess is exactly as "no picture" as a class this method has never heard of.
        var guess = className;
        if (guess.StartsWith("Deployed_", StringComparison.OrdinalIgnoreCase)) guess = guess["Deployed_".Length..];
        if (guess.EndsWith("_C", StringComparison.OrdinalIgnoreCase)) guess = guess[..^"_C".Length];
        return Items.Find(guess) is not null ? guess : null;
    }

    /// <summary>What this crate is, in words, ignoring any player-given name. Deployed
    /// containers are named after the thing the player built; the named storage the game keeps
    /// separately already has a name. A crate never changes what it is, so each guess is worked
    /// out once and kept: the list redraws on every keystroke in the search box and there can be
    /// hundreds of crates.</summary>
    private string AutoDisplayName(WorldContainer container)
    {
        var cacheKey = ContainerKey(container);
        if (_names.TryGetValue(cacheKey, out var cached)) return cached;
        var name = ItemNameForDeployedClass(container.ClassName)
            ?? (container.ClassName is { Length: > 0 } className ? PlainNames.Thing(className) : PlainNames.Words(container.Id));
        _names[cacheKey] = name;
        return name;
    }

    /// <summary>
    /// The real, player-facing name for a deployed container - "Void Chest" rather than
    /// "Deployed Storage Crate Void" - resolved through the item that places it, when a
    /// deployed class follows the game's own <c>Deployed_&lt;ItemId in PascalCase&gt;_C</c>
    /// naming (confirmed live for <c>Deployed_StorageCrate_Void_C</c> -> item id
    /// <c>storagecrate_void</c>, DisplayName "Void Chest" - see
    /// <c>assets/registry/registry.en.json</c>). <see cref="PlainNames.Thing"/> stays the
    /// fallback for named storage that has no placing item (trams, built-in furniture) or a
    /// class this naming guess does not match, since a wrong guess here is just a slightly
    /// worse label, never a broken one.
    /// </summary>
    private string? ItemNameForDeployedClass(string? className)
    {
        if (string.IsNullOrWhiteSpace(className)) return null;
        var tail = className;
        if (tail.EndsWith("_C", StringComparison.Ordinal)) tail = tail[..^2];
        foreach (var prefix in new[] { "Deployed_", "Deployable_" })
        {
            if (tail.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) { tail = tail[prefix.Length..]; break; }
        }
        return Items.Find(tail.ToLowerInvariant())?.DisplayName;
    }

    private readonly Dictionary<string, string> _names = new(StringComparer.Ordinal);

    /// <summary>
    /// A glance at what is inside, which is how a player actually recognises one crate from
    /// another. The stored reference used to sit here instead, which told nobody anything.
    ///
    /// <para>Working this out means reading every slot of the crate and looking each item up
    /// by name. A big world has hundreds of crates and the list redraws on every keystroke in
    /// the search box, so each crate's summary is worked out once and kept until its contents
    /// change (or the editor is switched to another language).</para>
    /// </summary>
    private string WhereText(WorldContainer container)
    {
        // A live container has no fixed "what's inside" summary worth caching the way a
        // file crate does (its contents can change out from under this tab at any moment,
        // refreshed after every edit) - and unlike a file container, it has a real world
        // position, which is the more useful "where" for a crate you can walk up to right
        // now. Same units and rounding as the live tab this replaces.
        if (container.Source == WorldContainerSource.Live)
            return $"{container.X / 100:0}, {container.Y / 100:0}, {container.Z / 100:0} m";
        DropSummariesIfLanguageChanged();
        var cacheKey = ContainerKey(container);
        if (_summaries.TryGetValue(cacheKey, out var cached)) return cached;
        var summary = BuildWhereText(container);
        _summaries[cacheKey] = summary;
        return summary;
    }

    private readonly Dictionary<string, string> _summaries = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _searchTexts = new(StringComparer.Ordinal);
    private string? _summaryLanguage;

    private void DropSummariesIfLanguageChanged()
    {
        if (string.Equals(_summaryLanguage, L.CurrentCode, StringComparison.Ordinal)) return;
        InvalidateSummaries();
        _summaryLanguage = L.CurrentCode;
    }

    /// <summary>Forgets the kept summaries, so the next redraw reads the crates again. Called
    /// whenever an edit lands, since that is the only thing that changes what is inside.</summary>
    private void InvalidateSummaries()
    {
        _summaries.Clear();
        _searchTexts.Clear();
    }

    /// <summary>
    /// Everything about one crate the search box can match on: its name, the reference the
    /// game files it under, and the name of every item inside it. Searching still finds "the
    /// crate with my keypad hacker in it".
    ///
    /// <para>This is worked out once per crate and kept, because the list redraws on every
    /// keystroke and a big world holds hundreds of crates with dozens of slots each. It is
    /// forgotten again whenever an edit lands or the editor changes language, exactly like
    /// the summary line beneath each row.</para>
    /// </summary>
    private string SearchText(WorldContainer container)
    {
        DropSummariesIfLanguageChanged();
        var cacheKey = ContainerKey(container);
        if (_searchTexts.TryGetValue(cacheKey, out var cached)) return cached;
        // Both names are searchable: DisplayName alone would drop the auto-generated guess
        // entirely once a player-given name is set, and a crate is still "that storage crate"
        // to someone who never saw what it was later renamed to.
        var builder = new System.Text.StringBuilder()
            .Append(DisplayName(container)).Append('\n')
            .Append(AutoDisplayName(container)).Append('\n')
            .Append(container.Id);
        foreach (var slot in FirstInventorySlots(container))
        {
            if (slot.IsEmpty) continue;
            builder.Append('\n').Append(slot.ItemId);
            if (Items.Find(slot.ItemId)?.DisplayName is { Length: > 0 } itemName)
                builder.Append('\n').Append(itemName);
        }
        var text = builder.ToString();
        _searchTexts[cacheKey] = text;
        return text;
    }

    private string BuildWhereText(WorldContainer container)
    {
        var names = FirstInventorySlots(container)
            .Where(slot => !slot.IsEmpty)
            .Select(slot => Items.Find(slot.ItemId)?.DisplayName ?? PlainNames.Words(slot.ItemId))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();
        if (names.Count == 0) return L.Inventory("empty");
        var shown = names.Take(3).ToList();
        return string.Join(", ", shown)
            + (names.Count > shown.Count ? " " + L.Resource("WorldTraders_Card_MoreItems", names.Count - shown.Count) : string.Empty);
    }

    private static string ContainerKey(WorldContainer container) => $"{container.Source}:{container.Id}";

    private string SlotName(PlayerInventorySlotEdit edit)
        => edit.IsEmpty ? string.Empty : Items.Find(edit.ItemId)?.DisplayName ?? PlainNames.Words(edit.ItemId);

    // ---------- pick-then-place (the touch path) ----------

    /// <summary>The slot waiting for a destination tap, if any.</summary>
    private PlayerInventorySlotEdit? _holding;
    private bool _touch;
    private IJSObjectReference? _dnd;

    private bool CanStartMove
        => Selection.Current?.Slot is { IsEmpty: false } slot && _slotEdits?.Contains(slot) == true;

    /// <summary>
    /// True while anything is being carried, wherever it was picked up: a slot from this
    /// crate, an item taken from the item catalog, or a slot picked up on the character's own
    /// screens. Every slot screen reads the same carried item, so the bar (and the way out of
    /// it) says the same thing everywhere.
    /// </summary>
    private bool IsHolding => _holding is not null || Dnd.IsDragging;

    private string? HoldingMessage => Dnd.PaletteItem is { } palette
        ? palette.DisplayName
        : Dnd.Source is { } carried ? SlotName(carried.Slot)
        : _holding is { } held ? SlotName(held) : null;

    private void StartMove()
    {
        // Only one thing is ever carried, so picking this slot up puts down whatever was
        // being carried from somewhere else.
        Dnd.End();
        if (Selection.Current?.Slot is { IsEmpty: false } slot && _slotEdits?.Contains(slot) == true) _holding = slot;
    }

    private void CancelMove() { _holding = null; Dnd.End(); _moveStatus = null; }

    /// <summary>
    /// A tap on a slot. Normally it opens the slot for editing. While something is being
    /// carried - a slot picked up here, an item taken from the catalog, or a slot picked up
    /// on the character's own screens - the tap puts it down here instead. Mouse dragging is
    /// untouched: a drag never raises a tap.
    /// </summary>
    private async Task TapSlot(PlayerInventorySlotEdit edit)
    {
        if (_busy) return;
        if (Dnd.PaletteItem is not null) { _holding = null; await DropOnSlot(edit); return; }
        if (Dnd.Source is { } carried) { _holding = null; await TakeFromCharacterAsync(carried, edit); return; }
        if (_holding is { } held)
        {
            _holding = null;
            if (ReferenceEquals(held, edit)) return;
            await SwapAsync((held.Index, edit.Index));
            SelectSlot(edit);
            return;
        }
        SelectSlot(edit);
    }

    /// <summary>A tap on a crate in the list. While an item is being carried it moves in
    /// there, which is what dropping a slot onto the row does with a mouse.</summary>
    private async Task TapContainer(WorldContainer container)
    {
        if (_busy) return;
        if (Dnd.PaletteItem is { } palette) { _holding = null; await GiveToContainerAsync(container, palette); return; }
        if (Dnd.Source is { } carried) { _holding = null; await TakeFromCharacterAsync(carried, container); return; }
        if (_holding is { } held && !held.IsEmpty)
        {
            _holding = null;
            await MoveToContainerAsync(container, held);
            return;
        }
        SelectContainer(container);
    }

    /// <summary>
    /// Puts an item carried over from the character's inventory into one slot of the crate
    /// being viewed. Whatever was in that slot goes back to the character, which is the same
    /// straight trade the SEND TO PLAYER button makes in the other direction. File saves stay
    /// staged; a connected host transfers both current slots in one operation.
    /// </summary>
    private async Task TakeFromCharacterAsync(SlotDragSource carried, PlayerInventorySlotEdit target)
    {
        Dnd.End();
        if (_slotEdits is null || _selectedKey is not { } key) return;
        var position = _slotEdits.IndexOf(target);
        if (position < 0) return;
        await TransferFromCharacterAsync(carried, key.Source, key.Id, position);
    }

    /// <summary>The same move onto a whole crate: the item lands in its first free space.</summary>
    private async Task TakeFromCharacterAsync(SlotDragSource carried, WorldContainer container)
    {
        Dnd.End();
        if (FirstEmptySlot(container) is not { } position)
        {
            _moveStatus = L.Resource("WorldContainers_ContainerFullFormat", DisplayName(container));
            return;
        }
        await TransferFromCharacterAsync(carried, container.Source, container.Id, position);
    }

    private async Task TransferFromCharacterAsync(SlotDragSource carried, WorldContainerSource source, string containerId, int position)
    {
        if (Session is LiveContainersSession live)
        {
            var player = carried.Session as LiveInventorySession ?? (carried.Session as LivePlayerEditorSession)?.InventorySession as LiveInventorySession;
            if (player is null || !ReferenceEquals(player, LivePlayerSession))
            { _moveStatus = L.Resource("WorldContainers_LivePlayerTransferUnavailable"); return; }
            if (!await TryLiveTransferAsync(live, PlayerEndpoint(player, carried.Area, carried.Slot.Index),
                new(position, ContainerId: containerId), player)) return;
            InvalidateSummaries(); SyncEditsFromSession();
            return;
        }
        // File sessions stage both sides together; connected inventories use the host operation above.
        if (Session is not WorldSaveSession worldSession) { _moveStatus = L.Resource("WorldContainers_LivePlayerTransferUnavailable"); return; }
        var moved = SlotName(carried.Slot);
        // Any typing still sitting in the slot editor is written into the world first, so the
        // trade below starts from what is actually on screen.
        await ApplyEditsAsync();
        if (!InventoryTransferService.TrySwapPlayerAndContainer(
                carried.Session, carried.Area, carried.Slot.Index, worldSession, source, containerId, 0, position))
        {
            _moveStatus = L.Resource("WorldContainers_MoveNotPossible");
            return;
        }
        Workspace.NotifyEdited();
        InvalidateSummaries();
        SyncEditsFromSession();
        _moveStatus = L.Resource("WorldContainers_MovedIntoFormat", moved, ContainerNameFor(source, containerId));
        StateHasChanged();
    }

    /// <summary>Drops a fresh copy of an item carried out of the item catalog into a crate's
    /// first free space, the same as letting go of it over the crate with a mouse.</summary>
    private async Task GiveToContainerAsync(WorldContainer container, ItemCatalogEntry palette)
    {
        Dnd.End();
        if (SlotDropRules.ValidateForSlot(L, null, null, palette) is { } problem)
        {
            _moveStatus = L.Resource("Slot_MsgBlocked", problem);
            return;
        }
        if (FirstEmptySlot(container) is not { } position)
        {
            _moveStatus = L.Resource("WorldContainers_ContainerFullFormat", DisplayName(container));
            return;
        }
        await ApplyEditsAsync();
        var fresh = new PlayerInventorySlotEdit(FirstInventorySlots(container)[position]);
        SlotDropRules.FillFromCatalog(fresh, palette);
        if (!await TrySetSlotAsync(container.Source, container.Id, 0, position, fresh.ToInventorySlot()))
        {
            _moveStatus = L.Resource("WorldContainers_MoveNotPossible");
            return;
        }
        Workspace.NotifyEdited();
        InvalidateSummaries();
        SyncEditsFromSession();
        _moveStatus = L.Resource("WorldContainers_MovedIntoFormat", palette.DisplayName, DisplayName(container));
        StateHasChanged();
    }

    private static int? FirstEmptySlot(WorldContainer container)
    {
        var slots = FirstInventorySlots(container);
        for (var i = 0; i < slots.Count; i++) { if (slots[i].IsEmpty) return i; }
        return null;
    }

    private string ContainerNameFor(WorldContainerSource source, string containerId)
        => Session.Containers.FirstOrDefault(container => container.Source == source
            && string.Equals(container.Id, containerId, StringComparison.Ordinal)) is { } match
            ? DisplayName(match)
            : PlainNames.Words(containerId);

    private void SelectContainer(WorldContainer container)
    {
        _selectedKey = (container.Source, container.Id);
        _slotEdits = FirstInventorySlots(container).Select(slot => new PlayerInventorySlotEdit(slot)).ToList();
        // Live: the open container is the one the host's periodic tick re-reads on its own (one
        // cheap read, not the world scan) so its health and contents follow the game.
        if (Session is LiveContainersSession live) live.WatchedContainerId = container.Id;
    }

    private void ClearWatchedContainer()
    {
        if (Session is LiveContainersSession live) live.WatchedContainerId = null;
    }

    /// <summary>Reloads any slot whose session record changed underneath us (revert, save,
    /// cross-container move). Edits are applied and re-baselined immediately on every
    /// change, so a difference here always means the session moved on, not a pending edit.</summary>
    private void SyncEditsFromSession()
    {
        if (_slotEdits is null) return;
        if (SelectedContainer is not { } container) { _selectedKey = null; _slotEdits = null; ClearWatchedContainer(); return; }
        var slots = FirstInventorySlots(container);
        if (slots.Count != _slotEdits.Count) { SelectContainer(container); return; }
        for (var i = 0; i < slots.Count; i++)
        {
            var edit = _slotEdits[i];
            if (!Equals(edit.ToInventorySlot(), slots[i]))
            {
                edit.LoadFrom(slots[i]);
                edit.AcceptCurrentAsBaseline();
            }
        }
    }

    /// <summary>Stages every CHANGED slot edit into the world session (the single save/revert
    /// path) - or, live, sends each changed slot to the running game immediately. Used to send
    /// every slot unconditionally, dirty or not: live, that meant one edit (say, a stack count
    /// typed into a single slot) fired one <c>containers.set</c> round trip PER SLOT in the
    /// container, each of which ends in its own refresh - and that refresh's data (which does not
    /// yet include the not-yet-sent slots later in the loop) could reach
    /// <see cref="SyncEditsFromSession"/> before the loop got around to sending them, silently
    /// overwriting the player's own not-yet-sent edit with the stale pre-edit value. Reported as
    /// "changing a container item's quantity doesn't take effect."</summary>
    private async Task ApplyEditsAsync()
    {
        if (_slotEdits is null || _selectedKey is not { } key) return;
        for (var i = 0; i < _slotEdits.Count; i++)
        {
            var edit = _slotEdits[i];
            if (!edit.IsDirty) continue;
            await TrySetSlotAsync(key.Source, key.Id, 0, i, edit.ToInventorySlot());
            edit.AcceptCurrentAsBaseline();
        }
        InvalidateSummaries();
        Workspace.NotifyEdited();
        StateHasChanged();
    }

    /// <summary>
    /// Every write this tab makes to the session funnels through here (or
    /// <see cref="TrySwapSlotsAsync"/>): a file session's version of these calls always
    /// succeeds synchronously, but a live session's talks to the running game over the
    /// network, so this is also the one place that catches a dropped connection instead of
    /// letting it crash out of a UI event handler.
    /// </summary>
    private async Task<bool> TrySetSlotAsync(WorldContainerSource source, string id, int inventoryIndex, int slotIndex, InventoryItemSlot slot)
    {
        _busy = true;
        try
        {
            var applied = await Session.TrySetContainerSlotAsync(source, id, inventoryIndex, slotIndex, slot);
            if (applied) _liveError = null;
            return applied;
        }
        catch (Exception exception) when (IsLiveTransportFailure(exception))
        {
            _liveError = Errors.Present(exception, "Edit this container.", "The connection may have dropped; try reconnecting.");
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SortAsync(WorldContainer container)
    {
        _busy = true;
        try
        {
            var sorted = await Session.SortContainerSlotsAsync(container.Source, container.Id, 0);
            if (sorted)
            {
                _liveError = null;
                if (SelectedContainer is { } refreshed) SelectContainer(refreshed);
                InvalidateSummaries();
                Workspace.NotifyEdited();
            }
        }
        catch (Exception exception) when (IsLiveTransportFailure(exception))
        {
            _liveError = Errors.Present(exception, "Sort this container.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Renames a container. Applies immediately for a live session (see
    /// <c>LiveContainersSession.TryRenameContainerAsync</c> for how that reaches every connected
    /// player, not only the host), otherwise stages the edit like every other field here.</summary>
    private async Task RenameContainerAsync(WorldContainer container, string? name)
    {
        _busy = true;
        try
        {
            var renamed = await Session.TryRenameContainerAsync(container.Source, container.Id, name ?? string.Empty);
            if (renamed)
            {
                _liveError = null;
                // Not AutoDisplayName's own cache (_names) - the class-based guess never changes,
                // only what search/row text shows alongside it does.
                InvalidateSummaries();
                if (!Session.AppliesImmediately) Workspace.NotifyEdited();
            }
        }
        catch (Exception exception) when (IsLiveTransportFailure(exception))
        {
            _liveError = Errors.Present(exception, "Rename this container.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> TrySwapSlotsAsync(WorldContainerSource source, string id, int inventoryIndex, int firstIndex, int secondIndex)
    {
        _busy = true;
        try
        {
            var swapped = await Session.TrySwapContainerSlotsAsync(source, id, inventoryIndex, firstIndex, secondIndex);
            if (swapped) _liveError = null;
            return swapped;
        }
        catch (Exception exception) when (IsLiveTransportFailure(exception))
        {
            _liveError = Errors.Present(exception, "Edit this container.", "The connection may have dropped; try reconnecting.");
            return false;
        }
        finally
        {
            _busy = false;
        }
    }

    private static bool IsLiveTransportFailure(Exception exception) => exception is LiveAgentException
        or System.Net.Sockets.SocketException or IOException or OperationCanceledException;

    /// <summary>Opens the slot in the right-hand sidebar editor (native slot-tap semantics).</summary>
    private void SelectSlot(PlayerInventorySlotEdit edit)
    {
        if (_slotEdits is null || SelectedContainer is not { } container) return;
        Selection.Select(new InventorySelection(
            DisplayName(container), edit, _slotEdits,
            Items.Entries.Select(entry => entry.Id).ToArray(),
            Session.Deployables.Where(deployable => deployable.IsCraftingBench).ToArray(),
            _slotEdits, true,
            ApplyEditsAsync, SwapAsync, UpgradeAsync,
            slotEdit => UpgradeCatalog.UpgradeFor(slotEdit.ItemId) is not null,
            slotEdit => UpgradeCatalog.SourceOf(slotEdit.ItemId) is not null)
        {
            SupportsCoatingEdits = !Session.AppliesImmediately || (Session.SupportsCompleteItemWrites && edit.InstanceMetadata is not null),
            SupportsLiquidTypeEdits = Session.AppliesImmediately,
            QuickGiveFallback = _ => _slotEdits.FirstOrDefault(candidate => candidate.IsEmpty) is { } empty ? new(empty, null, null) : null,
            SelectSlot = SelectSibling,
        });
    }

    private void SelectSibling(PlayerInventorySlotEdit edit) { if (_slotEdits?.Contains(edit) == true) SelectSlot(edit); }

    private async Task SwapAsync((int First, int Second) pair)
    {
        if (_slotEdits is null || _selectedKey is not { } key) return;
        var first = _slotEdits.FindIndex(edit => edit.Index == pair.First);
        var second = _slotEdits.FindIndex(edit => edit.Index == pair.Second);
        if (first < 0 || second < 0 || first == second) return;
        await ApplyEditsAsync();
        await TrySwapSlotsAsync(key.Source, key.Id, 0, first, second);
        SyncEditsFromSession();
    }

    private async Task UpgradeAsync((int Index, bool Downgrade) action)
    {
        var edit = _slotEdits?.FirstOrDefault(candidate => candidate.Index == action.Index);
        if (edit is null || edit.IsEmpty) return;
        var edge = action.Downgrade ? UpgradeCatalog.SourceOf(edit.ItemId) : UpgradeCatalog.UpgradeFor(edit.ItemId);
        if (edge is null) return;
        edit.ItemId = action.Downgrade ? edge.SourceId : edge.OutputId;
        edit.AssetId = null;
        if (edit.InstanceMetadata is { } metadata) edit.InstanceMetadata = metadata with { ItemDataTable = ItemTableIndex.TableRefFor(edit.ItemId) };
        await ApplyEditsAsync();
    }

    /// <summary>Slot-on-slot drop: swap within this container; a sidebar palette drag
    /// spawns a fresh copy of the catalog item here (native container drop rules).</summary>
    private async Task DropOnSlot(PlayerInventorySlotEdit target)
    {
        if (_busy) return;
        if (Dnd.PaletteItem is { } palette)
        {
            Dnd.End();
            if (SlotDropRules.ValidateForSlot(L, null, null, palette) is not null) return;
            SlotDropRules.FillFromCatalog(target, palette);
            await ApplyEditsAsync();
            SelectSlot(target);
            return;
        }
        // A slot dragged over from the character's own screens trades places with this one.
        if (Dnd.Source is { } carried) { await TakeFromCharacterAsync(carried, target); return; }
        if (_dragEdit is not { } source || ReferenceEquals(source, target) || _slotEdits is null) return;
        _dragEdit = null;
        await SwapAsync((source.Index, target.Index));
        SelectSlot(target);
    }

    /// <summary>Native container-row drop: the dragged item moves into the target
    /// container's first empty slot; the source slot is cleared.</summary>
    private async Task DropOnContainer(WorldContainer target)
    {
        if (_busy) return;
        if (Dnd.PaletteItem is { } palette) { await GiveToContainerAsync(target, palette); return; }
        if (Dnd.Source is { } carried) { await TakeFromCharacterAsync(carried, target); return; }
        if (_dragEdit is not { } source || source.IsEmpty) return;
        _dragEdit = null;
        await MoveToContainerAsync(target, source);
    }

    /// <summary>Moves one item into the first free space of another crate. Shared by the
    /// mouse drop and the tap-a-crate step of the pick-then-place flow.</summary>
    private async Task MoveToContainerAsync(WorldContainer target, PlayerInventorySlotEdit source)
    {
        if (_selectedKey is not { } key) return;
        if (target.Source == key.Source && string.Equals(target.Id, key.Id, StringComparison.Ordinal)) return;
        if (FirstEmptySlot(target) is not { } emptyIndex)
        {
            _moveStatus = L.Resource("WorldContainers_ContainerFullFormat", DisplayName(target));
            return;
        }
        var moved = SlotName(source);
        if (Session is LiveContainersSession live)
        {
            if (!await TryLiveTransferAsync(live, new(source.Index, ContainerId: key.Id), new(emptyIndex, ContainerId: target.Id))) return;
            InvalidateSummaries(); SyncEditsFromSession();
            _moveStatus = L.Resource("WorldContainers_MovedIntoFormat", moved, DisplayName(target));
            return;
        }
        await ApplyEditsAsync();
        if (!await TrySetSlotAsync(target.Source, target.Id, 0, emptyIndex, source.ToInventorySlot()))
        {
            _moveStatus = L.Resource("WorldContainers_MoveNotPossible");
            return;
        }
        source.Clear();
        await ApplyEditsAsync();
        _moveStatus = L.Resource("WorldContainers_MovedIntoFormat", moved, DisplayName(target));
    }

    /// <summary>Native right-click send: the item lands in the loaded sibling player's first
    /// free backpack slot, else the hotbar, and the container slot is cleared. Both sides
    /// stay staged until their sessions are saved.</summary>
    private async Task SendToPlayerAsync(PlayerInventorySlotEdit edit)
    {
        if (edit.IsEmpty) return;
        if (Session is LiveContainersSession live && LivePlayerSession is { } livePlayer && _selectedKey is { } key)
        {
            var liveDestination = livePlayer.Backpack.FirstOrDefault(slot => slot.IsEmpty);
            var liveArea = PlayerInventoryArea.Backpack;
            if (liveDestination is null) { liveDestination = livePlayer.Hotbar.FirstOrDefault(slot => slot.IsEmpty); liveArea = PlayerInventoryArea.Hotbar; }
            if (liveDestination is null) return;
            if (!await TryLiveTransferAsync(live, new(edit.Index, ContainerId: key.Id), PlayerEndpoint(livePlayer, liveArea, liveDestination.Index), livePlayer)) return;
            InvalidateSummaries(); SyncEditsFromSession();
            return;
        }
        if (PlayerSession is not { } player) { _moveStatus = L.Resource("WorldContainers_NoPlayerSaveFound"); return; }
        var (destination, whereKey) = player.Backpack.FirstOrDefault(slot => slot.IsEmpty) is { } backpack
            ? (backpack, "PlayerInventory_Backpack")
            : (player.Hotbar.FirstOrDefault(slot => slot.IsEmpty), "PlayerInventory_Hotbar");
        if (destination is null) return;
        var area = whereKey == "PlayerInventory_Backpack" ? PlayerInventoryArea.Backpack : PlayerInventoryArea.Hotbar;
        var itemLabel = SlotName(edit);
        if (!player.TrySetInventorySlot(area, destination.Index, edit.ToInventorySlot())) return;
        player.MarkChanged();
        edit.Clear();
        await ApplyEditsAsync();
        // The character is named, not numbered: the account number the save is filed under is
        // not something a player recognises.
        _moveStatus = L.Resource("WorldContainers_SentItemFormat", itemLabel, PlainNames.Player(L, player.SteamIdentifier), L.Resource(whereKey));
    }

    private async Task<bool> TryLiveTransferAsync(LiveContainersSession live,
        AbioticEditor.Core.LiveEditing.World.LiveInventoryEndpoint first,
        AbioticEditor.Core.LiveEditing.World.LiveInventoryEndpoint second, LiveInventorySession? player = null)
    {
        _busy = true;
        try { await live.TransferAsync(first, second, player); _liveError = null; return true; }
        catch (Exception exception) when (IsLiveTransportFailure(exception))
        { _liveError = Errors.Present(exception, "Move this item.", "The connection may have dropped; try reconnecting."); return false; }
        finally { _busy = false; }
    }

    private static AbioticEditor.Core.LiveEditing.World.LiveInventoryEndpoint PlayerEndpoint(
        LiveInventorySession player, PlayerInventoryArea area, int index)
        => new(index, Kind: area switch { PlayerInventoryArea.Equipment => "equip", PlayerInventoryArea.Hotbar => "hotbar",
            PlayerInventoryArea.Transmog => "transmog", _ => "backpack" }, PlayerId: player.PlayerId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // Ask the browser whether this is a device that can hover a pointer. Phones cannot,
        // so the wording switches from "drag" to the two-tap flow.
        _dnd = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/AbioticEditor.Web.Shared/transmog-dnd.js");
        await _dnd.InvokeVoidAsync("init");
        var touch = await _dnd.InvokeAsync<bool>("isTouch");
        if (touch == _touch) return;
        _touch = touch;
        StateHasChanged();
    }

    private void Refresh() => _ = InvokeAsync(StateHasChanged);

    public async ValueTask DisposeAsync()
    {
        Selection.Changed -= Refresh;
        Dnd.Changed -= Refresh;
        ClearWatchedContainer();
        // Leaving the tab retires the sidebar editor for these slots.
        if (_slotEdits is not null && Selection.Current is { } current && ReferenceEquals(current.Slots, _slotEdits)) Selection.Clear();
        try { if (_dnd is not null) await _dnd.DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
