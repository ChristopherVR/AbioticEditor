@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Core.Codex
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.World
@inject GameArtService Art

@* Round 79: this tab used to publish a preview into the shared right-hand sidebar (the same
   "select a row, see/edit it over there" idiom WorldDroppedItemsTab and PlayerRecipesTab use) -
   a player specifically asked for the preview to live inline next to the row list instead, the
   way the offline story-NPC tab already lays itself out (list + detail split pane), so a picture
   of the creature (see CreatureWikiImages - the live game itself reports no appearance data at
   all, only a class name) has somewhere to sit beside its info rather than in a detached pane. *@
<section class="world-editor world-native-tab" aria-label="@L.Resource("LiveNpcs_Title")">
    <div class="card-title-row">
        <h2 class="wt-h2">@L.Resource("LiveNpcs_Title")</h2>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>

    @if (!Session.IsHost)
    {
        <p class="error-text" role="alert">@L.Resource("LiveNpcs_NotHostWarning")</p>
    }
    <p class="wt-intro">@L.Resource("LiveNpcs_Intro")</p>

    @if (Session.Npcs.Count == 0)
    {
        <p class="wt-empty">@L.Resource("LiveNpcs_NoneFound")</p>
    }
    else
    {
        <div class="wt-md">
            <div class="wt-list" role="listbox" aria-label="@L.Resource("LiveNpcs_Title")">
                @foreach (var npc in Session.Npcs)
                {
                    <button type="button" role="option" aria-selected="@(_selectedId == npc.Id ? "true" : "false")"
                            class="wt-row @(_selectedId == npc.Id ? "selected" : null)" @key="npc.Id"
                            @onclick="() => SelectRow(npc)">
                        <span class="wt-row-text">
                            <strong>@DisplayName(npc)</strong>
                        </span>
                        <span class="wt-row-status">@(npc.IsDead ? L.Resource("WorldPets_StatusDead") : L.Resource("WorldPets_StatusHealthy"))</span>
                    </button>
                }
            </div>
            <div class="wt-detail">
                @if (Selected is not { } selected)
                {
                    <p class="wt-select-hint">@L.Resource("Editing_SelectNpc")</p>
                }
                else
                {
                    @* Same fixed-frame-while-loading / attribution pattern the GATEPAL fish tab
                       already uses for its own wiki art - see that tab's own remarks on why the
                       frame stays a fixed size while the image downloads. *@
                    @if (_wikiLoading || _wikiFile is not null)
                    {
                        <figure class="codex-wiki">
                            @if (_wikiFile is { } wikiFile) { <img src="@Art.WikiImageUrl(wikiFile)" alt="@DisplayName(selected)" /> }
                            else { <span class="codex-wiki-frame" role="status" aria-label="@L.Resource("PlayerCodex_FetchingImage")"><span class="header-busy-spinner"></span></span> }
                            <figcaption class="muted">@(_wikiFile is null ? L.Resource("PlayerCodex_FetchingImage") : L.Resource("Slot_ImageAbioticfactorWikiGg"))</figcaption>
                        </figure>
                    }
                    <h3 class="wt-h3">@DisplayName(selected)</h3>
                    <p class="wt-muted">@L.Resource("LiveNpcs_ClassLabel"): @selected.Label</p>
                    <p class="rb-detail-stats">@(selected.IsDead ? L.Resource("WorldPets_StatusDead") : L.Resource("WorldPets_StatusHealthy"))</p>
                    <div class="wt-button-row">
                        <button type="button" class="wt-btn wt-green" disabled="@(!Session.IsHost || _busy)"
                                @onclick="() => ToggleDeadAsync(selected)">
                            @(selected.IsDead ? L.Resource("LiveNpcs_Revive") : L.Resource("LiveNpcs_Kill"))
                        </button>
                    </div>
                    <label class="wt-check">
                        <input type="checkbox" checked="@selected.IsDisabled" disabled="@(!Session.IsHost || _busy)"
                               @onchange="e => SetDisabledAsync(selected, (bool)e.Value!)" />
                        @L.Resource("LiveNpcs_Disabled")
                    </label>
                    <label class="wt-check">
                        <input type="checkbox" checked="@selected.Invincible" disabled="@(!Session.IsHost || _busy)"
                               @onchange="e => SetInvincibleAsync(selected, (bool)e.Value!)" />
                        @L.Resource("LiveNpcs_Invincible")
                    </label>
                    <label class="wt-field">
                        <span class="wt-label">@L.Resource("LiveNpcs_Faction")</span>
                        <input class="wt-input" type="number" value="@selected.Faction" disabled="@(!Session.IsHost || _busy)"
                               @onchange="e => SetFactionAsync(selected, e)" />
                    </label>
                    <p class="wt-muted">@L.Resource("LiveNpcs_NoAppearanceDataNote")</p>
                }
            </div>
        </div>
    }

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveNpcSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private string? _selectedId;
    private string? _wikiFile;
    private bool _wikiLoading;

    // Live class names for this actor type are "NPC_Monster_<...>_C" or "NPC_<...>_C" (see
    // PetCatalog.cs's own identical stripping for the same family of classes) - PlainNames.Thing
    // alone does not know either prefix (only "ABF_NPC_"), so left unstripped this used to read
    // "NPC Monster Peccary" instead of "Peccary" for most creatures, and CreatureWikiImages needs
    // exactly this clean name to find a matching wiki page.
    private static readonly string[] ClassPrefixes = ["ABF_NPC_", "NPC_Monster_", "NPC_"];

    private static string DisplayName(LiveNpc npc)
    {
        var tail = npc.Label;
        if (tail.EndsWith("_C", StringComparison.Ordinal)) tail = tail[..^2];
        foreach (var prefix in ClassPrefixes)
        {
            if (tail.StartsWith(prefix, StringComparison.OrdinalIgnoreCase)) { tail = tail[prefix.Length..]; break; }
        }
        return PlainNames.Words(tail) is { Length: > 0 } name ? name : npc.Label;
    }

    private LiveNpc? Selected => _selectedId is null ? null : Session.Npcs.FirstOrDefault(npc => npc.Id == _selectedId);

    private void SelectRow(LiveNpc npc)
    {
        // Tapping the open row again closes its preview, matching every other list in the editor.
        if (_selectedId == npc.Id) { _selectedId = null; _wikiFile = null; _wikiLoading = false; return; }
        _selectedId = npc.Id;
        _ = LoadWikiImageAsync(npc);
    }

    /// <summary>Resolves the selected creature's wiki art, download-once-then-cached like the
    /// GATEPAL fish tab's own identical flow - see that tab's Select method's remarks.</summary>
    private async Task LoadWikiImageAsync(LiveNpc npc)
    {
        _wikiFile = null;
        _wikiLoading = false;
        var candidates = CreatureWikiImages.CandidatesFor(DisplayName(npc));
        if (candidates.Count == 0) return;
        _wikiLoading = true;
        var selected = npc.Id;
        StateHasChanged();
        foreach (var candidate in candidates)
        {
            var path = await Art.GetWikiImagePathAsync(candidate);
            if (_selectedId != selected) return;
            if (path is not null) { _wikiFile = candidate; break; }
        }
        _wikiLoading = false;
        StateHasChanged();
    }

    protected override void OnParametersSet()
    {
        // Drops the selection when the creature it pointed at unloaded or died out of the
        // roster, the same way the offline story-NPC tab's own selection just goes stale
        // quietly rather than showing a row that no longer exists.
        if (_selectedId is not null && Selected is null) { _selectedId = null; _wikiFile = null; _wikiLoading = false; }
    }

    private async Task RefreshAsync() => await RunAsync(() => Session.RefreshAsync());

    private Task ToggleDeadAsync(LiveNpc npc) =>
        RunAsync(() => Session.ApplyAsync(new LiveNpcEdit(npc.Id, IsDead: !npc.IsDead)));

    private Task SetDisabledAsync(LiveNpc npc, bool value) =>
        RunAsync(() => Session.ApplyAsync(new LiveNpcEdit(npc.Id, IsDisabled: value)));

    private Task SetInvincibleAsync(LiveNpc npc, bool value) =>
        RunAsync(() => Session.ApplyAsync(new LiveNpcEdit(npc.Id, Invincible: value)));

    private Task SetFactionAsync(LiveNpc npc, ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var faction)) return Task.CompletedTask;
        return RunAsync(() => Session.ApplyAsync(new LiveNpcEdit(npc.Id, Faction: faction)));
    }

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Edit this creature.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
