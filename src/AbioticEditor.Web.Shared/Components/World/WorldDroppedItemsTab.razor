@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.WorldSaves
@inject ItemCatalogService Items
@inject InventorySelectionService Selection
@inject SaveWorkspaceSessionService Workspace

@* Faithful port of the native WorldDroppedTab.xaml: "ITEMS ON THE GROUND" heading with the
   Digital7 summary readout, RESTORE and DELETE ALL SHOWN, the intro line, one filter box,
   and simple name/subtext rows with a per-row DELETE. Tapping a row opens the item's
   encyclopedia card in the right-hand sidebar, exactly like the native tap handler.

   Shared with live editing (see IWorldDroppedItemsSession): a live session only really
   supports listing and removing, so RESTORE disappears and every removal applies straight
   to the running game instead of staging - see AppliesImmediately below. *@
<section class="world-editor wg-tab" aria-label="@L.Resource("WorldDropped_ItemsOnTheGround")">
    @if (!Session.CanEditDroppedItems)
    {
        <p class="empty">@L.Resource("WorldDropped_NoGroundItems")</p>
    }
    else
    {
        @if (Session.AppliesImmediately && !Session.IsHost)
        {
            <p class="error-text" role="alert">@L.Resource("LiveDropped_NotHostWarning")</p>
        }
        <div class="wg-head">
            <h2 class="wg-title">@L.Resource("WorldDropped_ItemsOnTheGround")</h2>
            <span class="wg-summary">@Summary</span>
            @* A live despawn cannot be undone, so RESTORE only exists for a staged file edit. *@
            @if (!Session.AppliesImmediately)
            {
                <button class="wg-restore" type="button" @onclick="RestoreAll">@L.Resource("WorldDropped_Restore")</button>
            }
            <button class="wg-delete-all" type="button" disabled="@(_busy || (Session.AppliesImmediately && !Session.IsHost))" @onclick="DeleteShown">@L.Resource("WorldDropped_DeleteAllShown")</button>
        </div>
        <p class="wg-intro">@L.Resource("WorldDropped_GroundItemsIntro")</p>
        @if (Session.SupportsLiveAdd)
        {
            <div class="wg-spawn">
                <input class="wg-filter" aria-label="@L.Resource("WorldDropped_SpawnItemIdPlaceholder")" @bind="_spawnItemId" placeholder="@L.Resource("WorldDropped_SpawnItemIdPlaceholder")" />
                <input type="number" min="1" class="wt-readout-input" aria-label="@L.Resource("WorldDropped_SpawnStack")" @bind="_spawnStack" />
                <button type="button" class="wt-btn wt-green" disabled="@(_busy || !Session.IsHost || string.IsNullOrWhiteSpace(_spawnItemId))" @onclick="SpawnItem">@L.Resource("WorldDropped_SpawnNearMe")</button>
                <small class="wt-muted">@L.Resource("WorldDropped_SpawnNearMeHelp")</small>
            </div>
        }
        <input class="wg-filter" aria-label="@L.Resource("WorldDropped_FilterPlaceholder")" @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("WorldDropped_FilterPlaceholder")" />
        @if (PlayerPosition is not null)
        {
            @* The Facility is one continuous map with no real per-area boundaries in the data
               (see PlayerPosition's own remarks) - "nearby only" is a distance cutoff, the
               closest honest stand-in for "just this area" the live protocol can offer. On by
               default so opening this tab shows what is actually around the player, not
               everything dropped anywhere on the whole map; turn it off for a global search
               (e.g. hunting one specific item id regardless of where it ended up). *@
            <div class="wg-nearby">
                <label class="wt-check">
                    <input type="checkbox" checked="@_nearbyOnly" @onchange="e => _nearbyOnly = (bool)e.Value!" />
                    @L.Resource("WorldDropped_NearbyOnly")
                </label>
                @if (_nearbyOnly)
                {
                    <input type="number" min="100" step="100" class="wt-readout-input" aria-label="@L.Resource("WorldDropped_NearbyRadius")"
                           value="@_nearbyRadius" @onchange="e => SetNearbyRadius(e)" />
                    <small class="wt-muted">@L.Resource("WorldDropped_NearbyRadiusHelp")</small>
                }
            </div>
        }
        <div class="wg-list" role="list" aria-label="@L.Resource("WorldDropped_ItemsOnTheGround")">
            @foreach (var item in Visible)
            {
                <div class="wg-row" role="listitem" @key="item.Id" @onclick="() => Inspect(item)">
                    <span class="wg-texts">
                        <button class="world-row-name" type="button" @onclick="() => Inspect(item)" @onclick:stopPropagation>@DisplayName(item)</button>
                        <small>@SubText(item)</small>
                    </span>
                    <button class="wg-delete" type="button" disabled="@(_busy || (Session.AppliesImmediately && !Session.IsHost))" @onclick="() => Delete(item)" @onclick:stopPropagation>@L.Resource("WorldDropped_Delete")</button>
                </div>
            }
            @if (Visible.Count == 0)
            {
                <p class="wg-empty">@(_nearbyOnly && PlayerPosition is not null && Session.DroppedItems.Count > 0
                    ? L.Resource("WorldDropped_NoneNearby")
                    : L.Resource("WorldDropped_NoGroundItems"))</p>
            }
        </div>
        @if (Session.AppliesImmediately && Session.Status is not null) { <p class="status-text">@Session.Status</p> }
        @if (_liveError is not null) { <p class="error-text" role="alert">@_liveError</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public IWorldDroppedItemsSession Session { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "World editor";
    [Parameter] public EventCallback<string?> OnError { get; set; }
    /// <summary>
    /// The connected character's current position (live only - the live-connect page passes
    /// _spawn?.LivePosition; null for the file session, which has no "right now"). Abiotic
    /// Factor's Facility level is one persistent level, not streamed per region - dropped items
    /// anywhere on the whole map are always ALL returned by dropped.list regardless of where the
    /// player currently is (reported live as items dropped somewhere else entirely, like the
    /// Botanical Gardens, showing up while standing in a completely different sector). Combined
    /// with the 200-row cap below, an item you just dropped a moment ago could be pushed off the
    /// visible list entirely by hundreds of older items elsewhere on the map in arbitrary order -
    /// sorting by distance when this is available keeps what is actually near the player first.
    /// </summary>
    [Parameter] public (double X, double Y, double Z)? PlayerPosition { get; set; }
    private string _filter = string.Empty;
    private string _spawnItemId = string.Empty;
    private int _spawnStack = 1;
    // Off by default (round 81) - see the "wg-nearby" markup's own comment for why a distance
    // cutoff is the closest this can get to "just this area" without real region boundaries in
    // the data. It defaulted ON at first, but a live report of "the item I just dropped isn't
    // showing up" turned out to be this filter quietly hiding it (whatever guessed radius is set
    // is still a guess, and the drop can land outside it) - same lesson as the containers tab's
    // own default flip, see that field's remarks. 10,000 cm (100 m) is kept as the starting
    // radius for whenever someone does turn it on.
    private bool _nearbyOnly;
    private double _nearbyRadius = 10000;
    // Set only while a removal is talking to a live game; the file session's own methods
    // complete synchronously so this never has anything to wait on there.
    private bool _busy;
    private string? _liveError;
    // Ground items whose staged removal this tab can undo (native RESTORE; file only - a
    // live despawn cannot be undone). Pruned each render so a session Revert (which restores
    // everything itself) resets the counter.
    private readonly List<WorldDroppedItem> _removed = [];

    /// <summary>Capped at 200 rows like native - long-lived worlds accumulate 1000+ ground items.
    /// Sorted nearest-first when <see cref="PlayerPosition"/> is known, so the cap drops distant
    /// items instead of whatever the world happened to enumerate first.</summary>
    private List<WorldDroppedItem> Visible
    {
        get
        {
            IEnumerable<WorldDroppedItem> items = Session.DroppedItems
                .Where(item => string.IsNullOrWhiteSpace(_filter)
                    || DisplayName(item).Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
                    || (item.Slot.ItemId?.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false));
            if (PlayerPosition is { } position)
            {
                if (_nearbyOnly)
                    items = items.Where(item => item.DistanceTo(position.X, position.Y, position.Z) <= _nearbyRadius);
                items = items.OrderBy(item => item.DistanceTo(position.X, position.Y, position.Z));
            }
            return items.Take(200).ToList();
        }
    }

    private string Summary
    {
        get
        {
            PruneRestored();
            var count = Session.DroppedItems.Count;
            return _removed.Count == 0
                ? L.Resource("WorldEditor_DroppedSummaryFormat", count)
                : L.Resource("WorldEditor_DroppedSummaryWithDeletionsFormat", count, _removed.Count);
        }
    }

    private string DisplayName(WorldDroppedItem item)
        => Items.Find(item.Slot.ItemId)?.DisplayName ?? item.Slot.ItemId ?? L.Editor("workspace.unknown");

    /// <summary>"Deployable_Chair_Office_01 · ×1 · no despawn" - the native SubText verbatim,
    /// plus a distance-from-the-player suffix when <see cref="PlayerPosition"/> is known (the
    /// live surface only - see that parameter's own remarks).</summary>
    private string SubText(WorldDroppedItem item)
    {
        var text = $"{item.Slot.ItemId} · ×{item.Slot.Count}" + (item.NoDespawn ? " · no despawn" : "");
        if (PlayerPosition is { } position)
            text += $" · {item.DistanceTo(position.X, position.Y, position.Z):F0} cm away";
        return text;
    }

    private void SetNearbyRadius(ChangeEventArgs args)
    {
        if (double.TryParse(args.Value?.ToString(), out var value) && value > 0) _nearbyRadius = value;
    }

    private Task SpawnItem() => RunAsync(async () =>
    {
        await Session.AddDroppedItemLiveAsync(_spawnItemId.Trim(), Math.Max(1, _spawnStack));
        _spawnItemId = string.Empty;
        _spawnStack = 1;
    });

    private Task Delete(WorldDroppedItem item) => RunAsync(async () =>
    {
        await Session.RemoveDroppedItemAsync(item.Id);
        if (!Session.AppliesImmediately && !item.Id.StartsWith("pending-", StringComparison.Ordinal)) _removed.Add(item);
    });

    private Task DeleteShown() => RunAsync(async () =>
    {
        // One batched call (or the file session's cheap in-memory loop) instead of removing shown
        // items one network round trip at a time - see
        // IWorldDroppedItemsSession.RemoveDroppedItemsAsync's remarks.
        var shown = Visible;
        await Session.RemoveDroppedItemsAsync(shown.Select(item => item.Id));
        if (!Session.AppliesImmediately)
        {
            foreach (var item in shown)
            {
                if (!item.Id.StartsWith("pending-", StringComparison.Ordinal)) _removed.Add(item);
            }
        }
    });

    private void RestoreAll()
    {
        foreach (var item in _removed.ToArray())
        {
            if (Session.RestoreDroppedItem(item)) _removed.Remove(item);
        }
        _removed.Clear();
        Workspace.NotifyEdited();
    }

    /// <summary>A session Revert already restored everything; drop stale local markers.</summary>
    private void PruneRestored()
        => _removed.RemoveAll(removed => Session.DroppedItems.Any(item => string.Equals(item.Id, removed.Id, StringComparison.Ordinal)));

    /// <summary>Native tap: the item's encyclopedia card opens in the right-hand sidebar.</summary>
    private void Inspect(WorldDroppedItem item) => Selection.ShowEncyclopedia(item.Slot.ItemId);

    /// <summary>
    /// Every removal funnels through here: a file session's version always succeeds
    /// synchronously, but a live session's talks to the running game over the network, so
    /// this is also the one place that catches a dropped connection instead of letting it
    /// crash out of a UI event handler.
    /// </summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _liveError = null;
        try
        {
            await action();
            Workspace.NotifyEdited();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _liveError = Errors.Present(exception, "Remove this item.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
