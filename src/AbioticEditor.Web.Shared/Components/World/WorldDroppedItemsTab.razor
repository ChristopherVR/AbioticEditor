@namespace AbioticEditor.Web.Components.World
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.WorldSaves
@inject ItemCatalogService Items
@inject InventorySelectionService Selection
@inject SaveWorkspaceSessionService Workspace

@* Faithful port of the native WorldDroppedTab.xaml: "ITEMS ON THE GROUND" heading with the
   Digital7 summary readout, RESTORE and DELETE ALL SHOWN, the intro line, one filter box,
   and simple name/subtext rows with a per-row DELETE. Tapping a row opens the item's
   encyclopedia card in the right-hand sidebar, exactly like the native tap handler.

   Shared with live editing (see IWorldDroppedItemsSession): a live session only really
   supports listing and removing, so RESTORE disappears and every removal applies straight
   to the running game instead of staging - see AppliesImmediately below. *@
<section class="world-editor wg-tab" aria-label="@L.Resource("WorldDropped_ItemsOnTheGround")">
    @if (!Session.CanEditDroppedItems)
    {
        <p class="empty">@L.Resource("WorldDropped_NoGroundItems")</p>
    }
    else
    {
        @if (Session.AppliesImmediately && !Session.IsHost)
        {
            <p class="error-text" role="alert">@L.Resource("LiveDropped_NotHostWarning")</p>
        }
        <div class="wg-head">
            <h2 class="wg-title">@L.Resource("WorldDropped_ItemsOnTheGround")</h2>
            <span class="wg-summary">@Summary</span>
            @* A live despawn cannot be undone, so RESTORE only exists for a staged file edit. *@
            @if (!Session.AppliesImmediately)
            {
                <button class="wg-restore" type="button" @onclick="RestoreAll">@L.Resource("WorldDropped_Restore")</button>
            }
            <button class="wg-delete-all" type="button" disabled="@(_busy || (Session.AppliesImmediately && !Session.IsHost))" @onclick="DeleteShown">@L.Resource("WorldDropped_DeleteAllShown")</button>
        </div>
        <p class="wg-intro">@L.Resource("WorldDropped_GroundItemsIntro")</p>
        <input class="wg-filter" aria-label="@L.Resource("WorldDropped_FilterPlaceholder")" @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("WorldDropped_FilterPlaceholder")" />
        <div class="wg-list" role="list" aria-label="@L.Resource("WorldDropped_ItemsOnTheGround")">
            @foreach (var item in Visible)
            {
                <div class="wg-row" role="listitem" @key="item.Id" @onclick="() => Inspect(item)">
                    <span class="wg-texts">
                        <strong>@DisplayName(item)</strong>
                        <small>@SubText(item)</small>
                    </span>
                    <button class="wg-delete" type="button" disabled="@(_busy || (Session.AppliesImmediately && !Session.IsHost))" @onclick="() => Delete(item)" @onclick:stopPropagation>@L.Resource("WorldDropped_Delete")</button>
                </div>
            }
            @if (Visible.Count == 0) { <p class="wg-empty">@L.Resource("WorldDropped_NoGroundItems")</p> }
        </div>
        @if (Session.AppliesImmediately && Session.Status is not null) { <p class="status-text">@Session.Status</p> }
        @if (_liveError is not null) { <p class="error-text" role="alert">@_liveError</p> }
    }
</section>

@code {
    [Parameter, EditorRequired] public IWorldDroppedItemsSession Session { get; set; } = null!;
    [Parameter] public string Title { get; set; } = "World editor";
    [Parameter] public EventCallback<string?> OnError { get; set; }
    private string _filter = string.Empty;
    // Set only while a removal is talking to a live game; the file session's own methods
    // complete synchronously so this never has anything to wait on there.
    private bool _busy;
    private string? _liveError;
    // Ground items whose staged removal this tab can undo (native RESTORE; file only - a
    // live despawn cannot be undone). Pruned each render so a session Revert (which restores
    // everything itself) resets the counter.
    private readonly List<WorldDroppedItem> _removed = [];

    /// <summary>Capped at 200 rows like native - long-lived worlds accumulate 1000+ ground items.</summary>
    private List<WorldDroppedItem> Visible => Session.DroppedItems
        .Where(item => string.IsNullOrWhiteSpace(_filter)
            || DisplayName(item).Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase)
            || (item.Slot.ItemId?.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) ?? false))
        .Take(200)
        .ToList();

    private string Summary
    {
        get
        {
            PruneRestored();
            var count = Session.DroppedItems.Count;
            return _removed.Count == 0
                ? L.Resource("WorldEditor_DroppedSummaryFormat", count)
                : L.Resource("WorldEditor_DroppedSummaryWithDeletionsFormat", count, _removed.Count);
        }
    }

    private string DisplayName(WorldDroppedItem item)
        => Items.Find(item.Slot.ItemId)?.DisplayName ?? item.Slot.ItemId ?? L.Editor("workspace.unknown");

    /// <summary>"Deployable_Chair_Office_01 · ×1 · no despawn" - the native SubText verbatim.</summary>
    private static string SubText(WorldDroppedItem item)
        => $"{item.Slot.ItemId} · ×{item.Slot.Count}" + (item.NoDespawn ? " · no despawn" : "");

    private Task Delete(WorldDroppedItem item) => RunAsync(async () =>
    {
        await Session.RemoveDroppedItemAsync(item.Id);
        if (!Session.AppliesImmediately && !item.Id.StartsWith("pending-", StringComparison.Ordinal)) _removed.Add(item);
    });

    private Task DeleteShown() => RunAsync(async () =>
    {
        foreach (var item in Visible)
        {
            await Session.RemoveDroppedItemAsync(item.Id);
            if (!Session.AppliesImmediately && !item.Id.StartsWith("pending-", StringComparison.Ordinal)) _removed.Add(item);
        }
    });

    private void RestoreAll()
    {
        foreach (var item in _removed.ToArray())
        {
            if (Session.RestoreDroppedItem(item)) _removed.Remove(item);
        }
        _removed.Clear();
        Workspace.NotifyEdited();
    }

    /// <summary>A session Revert already restored everything; drop stale local markers.</summary>
    private void PruneRestored()
        => _removed.RemoveAll(removed => Session.DroppedItems.Any(item => string.Equals(item.Id, removed.Id, StringComparison.Ordinal)));

    /// <summary>Native tap: the item's encyclopedia card opens in the right-hand sidebar.</summary>
    private void Inspect(WorldDroppedItem item) => Selection.ShowEncyclopedia(item.Slot.ItemId);

    /// <summary>
    /// Every removal funnels through here: a file session's version always succeeds
    /// synchronously, but a live session's talks to the running game over the network, so
    /// this is also the one place that catches a dropped connection instead of letting it
    /// crash out of a UI event handler.
    /// </summary>
    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _liveError = null;
        try
        {
            await action();
            Workspace.NotifyEdited();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _liveError = Errors.Present(exception, "Remove this item.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }
}
