@inject AbioticEditor.Ui.IExternalNavigationService ExternalNavigation

<aside class="live-editing-guide live-guide-compact" aria-label="@L.Resource("Editing_LiveTitle")">
    <span class="mode-badge experimental">@L.Resource("Editing_Experimental")</span>
    <span>@L.Resource("Editing_LiveShort")</span>
    <a href="@GuideUrl" @onclick="OpenGuideAsync" @onclick:preventDefault>@L.Resource("Editing_GuideLink")</a>
</aside>

@code {
    private const string GuideUrl = "https://christophervr.github.io/AbioticEditor/guide/live-editing";
    private Task OpenGuideAsync() => ExternalNavigation.OpenUrlAsync(new Uri(GuideUrl));
}
