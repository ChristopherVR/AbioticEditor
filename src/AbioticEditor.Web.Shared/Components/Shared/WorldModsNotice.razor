@using AbioticEditor.Core.Assets
@using AbioticEditor.Web.Models
@inject HostLanguageService Languages
@inject HostSettingsService HostSettings
@inject ModalService Modals

@* The mods this world last ran with (the game keeps them in WorldSave_MetaData.sav), next to
   what the editor loads. Things from a mod the editor has not loaded show as unknown but are
   kept exactly as they are. Silent for an unmodded world with no mods loaded, and in the browser
   build, which cannot see the player's mods at all. When installed mods the world uses are
   switched off, it asks once per world whether to switch them on. *@
@if (_usage is { } usage && (usage.WorldMods.Count > 0 || usage.ExtraLoaded.Count > 0))
{
    <section class="save-modded-notice world-mods-notice" role="status">
        <strong>@Languages.Resource("WorldMods_Title")</strong>
        @if (usage.Matches)
        {
            <p>@Languages.Resource("WorldMods_Matches", usage.WorldMods.Count)</p>
        }
        else
        {
            @if (usage.Unavailable.Any())
            {
                <p>@Languages.Resource("WorldMods_UnknownHint")</p>
            }
            <ul>
                @foreach (var mod in usage.WorldMods)
                {
                    <li>@mod.DisplayName @if (mod.DisplayName != $"mod.io #{mod.ModIoId}") { <small>(mod.io #@mod.ModIoId)</small> }: @StateText(mod.State)</li>
                }
            </ul>
            @if (usage.ExtraLoaded.Count > 0)
            {
                <p>@Languages.Resource("WorldMods_Extra", string.Join(", ", usage.ExtraLoaded.Select(mod => mod.DisplayName)))</p>
            }
            @if (usage.WorldMods.Any(mod => mod.State == WorldModState.Off) || usage.ExtraLoaded.Count > 0)
            {
                <button type="button" class="wt-btn" disabled="@_busy" @onclick="UseWorldModsAsync">@Languages.Resource("WorldMods_UseThese")</button>
            }
        }
    </section>
}

@code {
    // A world whose mods the player chose not to switch on is not asked about again until the
    // editor restarts, however often its saves are reopened.
    private static readonly System.Collections.Concurrent.ConcurrentDictionary<string, byte> Declined = new(StringComparer.OrdinalIgnoreCase);

    /// <summary>The open world save; its own or its sibling metadata save lists the mods.</summary>
    [Parameter] public WorldSaveSession? World { get; set; }

    /// <summary>The open player save; the world it lives in lists the mods.</summary>
    [Parameter] public PlayerSaveSession? Player { get; set; }

    private object? _read;
    private IReadOnlyList<long> _ids = [];
    private WorldModUsage? _usage;
    private bool _busy;

    protected override async Task OnParametersSetAsync()
    {
        object? current = (object?)World ?? Player;
        if (ReferenceEquals(current, _read)) return;
        _read = current;
        _usage = null;
        if (current is null || OperatingSystem.IsBrowser()) return;
        try
        {
            _ids = World is { } world ? await world.WorldModIdsAsync() : await PlayerWorldModIdsAsync(Player!.Path);
            _usage = await Task.Run(() => HostSettings.WorldMods(_ids));
            if (ReferenceEquals(current, _read)) OfferToSwitchOn(current);
        }
        catch (Exception exception) when (exception is not OutOfMemoryException)
        {
            // A notice is never worth failing the editor over.
            AbioticEditor.Core.Diagnostics.EditorLog.Warn("Mods", "Could not compare this world's mods with the editor's.", exception);
        }
    }

    /// <summary>
    /// Player saves sit in <c>&lt;World&gt;/PlayerData/</c>; the world's metadata save is one folder up.
    /// </summary>
    private static async Task<IReadOnlyList<long>> PlayerWorldModIdsAsync(string playerPath)
    {
        if (Path.GetDirectoryName(Path.GetDirectoryName(playerPath)) is not { Length: > 0 } world) return [];
        var metadata = Path.Combine(world, "WorldSave_MetaData.sav");
        if (!File.Exists(metadata)) return [];
        var bytes = await File.ReadAllBytesAsync(metadata);
        return await Task.Run(() => AbioticEditor.Core.WorldSaves.WorldSaveReader.ReadLastUsedModIds(new MemoryStream(bytes, writable: false)));
    }

    /// <summary>Asks whether to switch on the installed mods this world uses that the editor has off.</summary>
    private void OfferToSwitchOn(object session)
    {
        if (_usage is null || HostSettings.ModsLockedOff) return;
        var off = _usage.WorldMods.Where(mod => mod.State == WorldModState.Off).ToArray();
        if (off.Length == 0) return;
        var key = WorldKey(session);
        if (Declined.ContainsKey(key) || Modals.Current is not null) return;
        var names = string.Join(", ", off.Select(mod => mod.DisplayName));
        var body = Languages.Resource(HostSettings.ModsEnabled ? "WorldMods_PromptSomeOff" : "WorldMods_PromptAllOff", names);
        Modals.Show(new ModalRequest(
            Languages.Resource("WorldMods_PromptTitle"),
            builder => builder.AddMarkupContent(0, $"<p>{System.Net.WebUtility.HtmlEncode(body)}</p>"),
            Languages.Resource("WorldMods_PromptConfirm"),
            async () =>
            {
                _busy = true;
                try
                {
                    await Task.Run(() => HostSettings.EnableWorldMods(_ids));
                    _usage = await Task.Run(() => HostSettings.WorldMods(_ids));
                }
                finally { _busy = false; await InvokeAsync(StateHasChanged); }
            },
            Languages.Resource("WorldMods_PromptDecline"),
            OnCancel: () => { Declined.TryAdd(key, 0); return Task.CompletedTask; }));
    }

    private string WorldKey(object session) => session switch
    {
        WorldSaveSession world => Path.GetDirectoryName(world.Path) ?? world.Path,
        PlayerSaveSession player => Path.GetDirectoryName(Path.GetDirectoryName(player.Path)) ?? player.Path,
        _ => string.Empty,
    };

    private async Task UseWorldModsAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            await Task.Run(() => HostSettings.UseWorldMods(_ids));
            _usage = await Task.Run(() => HostSettings.WorldMods(_ids));
        }
        finally { _busy = false; }
    }

    private string StateText(WorldModState state) => state switch
    {
        WorldModState.Loaded => Languages.Resource("WorldMods_StateLoaded"),
        WorldModState.Off => Languages.Resource("WorldMods_StateOff"),
        WorldModState.Downloading => Languages.Resource("WorldMods_StateDownloading"),
        _ => Languages.Resource("WorldMods_StateMissing"),
    };
}
