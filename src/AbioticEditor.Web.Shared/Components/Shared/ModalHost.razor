@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject ModalService Modals
@inject IJSRuntime Js

@if (Modals.Current is { } modal)
{
    <div class="modal-backdrop" role="presentation" @onclick="() => BackdropClicked(modal)">
        <section @ref="_dialog" class="modal @(modal.IsWide ? "modal-wide" : null)" role="dialog" aria-modal="true" aria-labelledby="modal-title" tabindex="-1" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
            <div class="modal-accent" aria-hidden="true"></div>
            <header class="modal-header"><h2 id="modal-title">@modal.Title</h2></header>
            <div class="modal-body">@modal.Body</div>
            <footer class="modal-actions"><button @ref="_initialButton" class="secondary" @onclick="CancelAsync">@modal.CancelText</button>
                @if (modal.OnConfirm is not null) { <button class="@(modal.IsDestructive ? "danger" : "primary")" disabled="@_confirming" @onclick="ConfirmAsync">@(_confirming ? L.Resource("Common_Working") : modal.ConfirmText ?? L.Resource("Common_Confirm"))</button> }
            </footer>
        </section>
    </div>
}

@code {
    private bool _confirming;
    private ElementReference _dialog;
    private ElementReference _initialButton;
    private bool _focusPending;
    // Round 118: only true once "activate" actually ran - see DisposeAsync. ModalHost itself is
    // mounted unconditionally in MainLayout (it just renders nothing while Modals.Current is
    // null), so on every app start its very first instance is the one from the initial static
    // prerender pass, which the framework disposes the moment the interactive instance takes
    // over - long before any modal was ever shown. That used to fire an unawaited, unguarded
    // "deactivate" interop call from Dispose() straight into a component that "is being statically
    // rendered", which is an InvalidOperationException with nobody awaiting the discarded task -
    // exactly the "Unobserved task exception: JavaScript interop calls cannot be issued at this
    // time" entries a live report showed right before that session's circuit crash. Skipping the
    // call entirely when nothing was ever activated removes the interop call from the one path
    // that hits it on every single launch, not just a rare disconnect race.
    private bool _activated;
    protected override void OnInitialized() => Modals.Changed += HandleChanged;
    private void HandleChanged() { _focusPending = Modals.Current is not null; _ = InvokeAsync(StateHasChanged); }
    private Task BackdropClicked(ModalRequest modal) => modal.CloseOnBackdrop ? CancelAsync() : Task.CompletedTask;
    private Task HandleKeyDown(KeyboardEventArgs args) => args.Key == "Escape" ? CancelAsync() : Task.CompletedTask;
    private async Task CancelAsync() { var modal = Modals.Current; Modals.Close(); if (modal?.OnCancel is { } declined) await declined(); }
    // Confirming closes THIS dialog, and only this one. Some confirmations lead straight to another
    // question - repairing a save and then being refused again, opening a world that turns out to
    // need attention - and an unconditional close swallowed the follow-up the instant it appeared,
    // so the player answered the first question and then saw nothing at all.
    private async Task ConfirmAsync()
    {
        var modal = Modals.Current;
        var action = modal?.OnConfirm;
        if (action is null) return;
        _confirming = true;
        try
        {
            // Marks the window in which action() is allowed to chain straight into a follow-up
            // Modals.Show() without that being mistaken for the still-resolving modal having
            // been abandoned - see ModalService.Show.
            using (Modals.BeginResolving()) { await action(); }
            if (ReferenceEquals(Modals.Current, modal)) Modals.Close();
        }
        finally { _confirming = false; }
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && Modals.Current is not null)
        {
            _focusPending = false;
            _activated = true;
            await Js.InvokeVoidAsync("abiotic.modal.activate", _dialog, _initialButton);
        }
    }
    // async ValueTask, not the sync IDisposable this used to be - matching every other modal shell
    // in the editor (ModeSelectDialog, Settings, ReleaseNotesDialog all already do this). A
    // fire-and-forget interop call from a sync Dispose() cannot be awaited, so any failure - the
    // circuit already being gone, or this exact instance never having been interactive at all -
    // became an unobserved task exception with nowhere to go. See _activated's own remarks above.
    public async ValueTask DisposeAsync()
    {
        Modals.Changed -= HandleChanged;
        if (!_activated) return;
        try { await Js.InvokeVoidAsync("abiotic.modal.deactivate"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
