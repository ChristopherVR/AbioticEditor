    /// <summary>The live sidebar header's DISCONNECT button - see LiveSessionService.RequestDisconnectAsync
    /// for why this is a request rather than a direct call (the channel itself lives on the
    /// live-editing page, which also handles returning to the mode-select dialog afterwards).</summary>
    private Task DisconnectLiveAsync() => Live.RequestDisconnectAsync();

    /// <summary>Frees the save list again, whether the save opened, failed, or was not wanted.</summary>
    private Task DoneSwitchingSaveAsync()
    {
        _switchingSave = false;
        return InvokeAsync(StateHasChanged);
    }

    private async Task OpenAsync(WorkspaceSave save)
    {
        try
        {
            CloseDrawers();
            _activeIniFileName = null;
            if (!string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), "browse", StringComparison.OrdinalIgnoreCase))
            {
                // Save rows are global navigation in the native workbench. Return to the
                // editor surface immediately so its loading state and eventual session are
                // visible even when the user selected the save from INI, live editing, or
                // another tool. "browse" (not "./" - that resolved to ModeSelect's "/" once
                // ModeSelect claimed the root route, not the editor surface it used to mean).
                Navigation.NavigateTo("browse");
            }
            await Workspace.SelectAsync(save.Path);
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Open save from sidebar");
            Toasts.Show(L.Resource("Main_LoadSaveFailed", save.Name), ToastKind.Error, TimeSpan.FromSeconds(8));
        }
        finally
        {
            await DoneSwitchingSaveAsync();
        }
    }
    private async Task ReloadAsync()
    {
        if (_writing) return;
        _writing = true;
        try { await Workspace.ReloadSelectedAsync(); }
        finally { _writing = false; }
    }

    /// <summary>
    /// Writes the staged edits into the save.
    /// </summary>
    /// <remarks>
    /// Guarded because writing a save is not instant and the button says nothing while it runs:
    /// a second press would start a second write of the same file, over a backup the first press
    /// had just made, and on a Game Pass world two repacks of one container at once.
    /// </remarks>
    private async Task SaveAsync()
    {
        if (_writing) return;
        _writing = true;
        try
        {
            await Workspace.SaveSelectedAsync();

            // In a browser, saving is not the end of the story. On a folder the tab cannot write
            // to, the result only exists here until it is downloaded; and even on one it can
            // write to, editing a single save can change others, so the way to take the result
            // away intact is the whole-world EXPORT. Neither is obvious, hence the reminder.
            // The desktop writes straight to the game's folder, has no EXPORT to point at, and
            // needs no such nudge.
            if (Export.OffersSaveExport)
            {
                Toasts.Show(
                    Workspace.CanWrite
                        ? L.Resource("Workspace_SavedUseExport")
                        : L.Resource("Workspace_SavedUseExportReadOnly"),
                    Workspace.CanWrite ? ToastKind.Success : ToastKind.Warning,
                    TimeSpan.FromSeconds(9));
            }
        }
        catch (AbioticEditor.Core.GamePass.GamePassUnsafeWriteException refusal)
        {
            // A refusal is not a failure. Nothing went wrong and nothing is lost: the editor
            // declined on purpose because the save is in a state where Xbox would probably throw
            // the edit away later. Caught ahead of the general handler below so it never reads as
            // work that went missing - the answer here is to clear the reason, or to insist.
            ShowSaveRefused(refusal);
        }
        catch (Exception exception)
        {
            // SaveSelectedAsync can throw (a locked file, a save missing an expected
            // struct, etc.); an uncaught exception here would otherwise take down the
            // whole editor session instead of just failing this one write. Both paths below
            // record the cause themselves.

            // A Game Pass save that failed to pack back is not an ordinary failed write: the edit
            // exists, but only in a working copy the player does not know about. A toast that
            // fades after eight seconds is the wrong place to tell someone where their work went,
            // so that case gets a dialog naming the folder it is waiting in.
            if (Workspace.UnwrittenEditsFolder is { } stranded)
            {
                var why = Errors.Detail(exception, "Pack Game Pass save", L.Editor("workspace.saveFailed"));
                Modals.Show(new ModalRequest(
                    L.Resource("Main_GpWriteFailedTitle"),
                    @<div>
                        <p>@L.Resource("Main_GpWriteFailedMessage", why)</p>
                        <p>@L.Resource("Main_GpWriteFailedRecovery", stranded)</p>
                    </div>,
                    CancelText: L.Resource("Common_Close")));
                return;
            }
            Toasts.Show(Errors.Present(exception, L.Editor("workspace.saveFailed"), L.Resource("PlayerUi_ChangesRemainOpen")), ToastKind.Error, TimeSpan.FromSeconds(8));
        }
        finally
        {
            _writing = false;
        }
    }

    /// <summary>
    /// Says why the editor would not write into the Xbox save, and offers the two ways forward.
    /// </summary>
    /// <remarks>
    /// The way out that is most likely to work is the one on the button: a half-synced folder is
    /// something the editor can put right itself, so that becomes the confirm action and the save
    /// follows automatically. Insisting is deliberately not the confirm button - it is the one
    /// choice here that can lose the save for good, so it sits apart from the dialog's own actions
    /// and is marked as the hazard it is.
    /// </remarks>
    private void ShowSaveRefused(AbioticEditor.Core.GamePass.GamePassUnsafeWriteException refusal)
    {
        // The guard fills in what it found; a refusal raised any other way has only its own text,
        // and that text is authored for the player, so it is shown rather than flattened away.
        var why = Errors.Detail(refusal, "Pack Game Pass save", L.Editor("workspace.saveFailed"));
        IReadOnlyList<string> reasons = refusal.Check.Lines();
        if (reasons.Count == 0) reasons = [why];
        var repairable = GamePassRecovery.RepairIsTheRemedy(Workspace);
        Modals.Show(new ModalRequest(
            L.Resource("Main_GpSaveRefusedTitle"),
            @<div>
                <p>@L.Resource("Main_GpSaveRefusedMessage")</p>
                <ul>
                    @foreach (var reason in reasons)
                    {
                        <li>@reason</li>
                    }
                </ul>
                <p>@L.Resource("Main_GpSaveRefusedSafe")</p>
                <p class="muted">@L.Resource("Main_GpSaveAnywayHint")</p>
                <button class="danger" type="button" @onclick="SaveAnywayAsync">@L.Resource("Main_GpSaveAnyway")</button>
            </div>,
            ConfirmText: repairable ? L.Resource("Main_GpRepairThenSave") : null,
            OnConfirm: repairable ? RepairThenSaveAsync : null,
            CancelText: L.Resource("Common_Close")));
    }

    /// <summary>Puts the folder right, then saves again. A second refusal simply asks again.</summary>
    private async Task RepairThenSaveAsync()
    {
        try
        {
            var repaired = await GamePassRecovery.RepairAsync(Workspace);
            Toasts.Show(L.Resource("Main_GpMidSyncRepaired", repaired.Count), ToastKind.Success);
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Repair Game Pass save");
            Toasts.Show(L.Resource("Main_GpRepairFailed"), ToastKind.Error);
            return;
        }
        await SaveAsync();
    }

    /// <summary>
    /// Writes the edit despite the refusal, on the player's word. Everything about this is recorded
    /// - the acceptance carries into the log beside the write, because if this is the wrong call the
    /// damage turns up days later with nothing on screen to connect it to.
    /// </summary>
    private async Task SaveAnywayAsync()
    {
        if (_writing) return;
        _writing = true;
        Modals.Close();
        try
        {
            await Workspace.SaveSelectedAcceptingGamePassRiskAsync("player confirmed in the save-anyway dialog");
            Toasts.Show(L.Resource("Main_GpSavedAnyway"), ToastKind.Warning, TimeSpan.FromSeconds(12));
        }
        catch (Exception exception)
        {
            Toasts.Show(Errors.Present(exception, L.Editor("workspace.saveFailed"), L.Resource("PlayerUi_ChangesRemainOpen")), ToastKind.Error, TimeSpan.FromSeconds(8));
        }
        finally
        {
            _writing = false;
        }
    }
    private void Revert() { InventorySelection.Clear(); Workspace.RevertSelected(); }
    private void ToggleFilePane()
    {
        // Native rails: one drawer at a time on phones; on desktops a manual toggle also
        // records the user's choice so threshold crossings don't override it.
        if (DrawerMode) { _fileDrawer = !_fileDrawer; if (_fileDrawer) _detailsDrawer = false; return; }
        var show = !FileVisible;
        _fileAutoCollapsed = false;
        if (Preferences.State.FilePaneCollapsed == show) Preferences.ToggleFilePane();
    }
    private void ToggleDetailsPane()
    {
        if (!DetailsAvailable) return;
        if (DrawerMode) { _detailsDrawer = !_detailsDrawer; if (_detailsDrawer) _fileDrawer = false; return; }
        var show = !DetailsVisible;
        _detailsAutoCollapsed = false;
        if (Preferences.State.DetailsPaneCollapsed == show) Preferences.ToggleDetailsPane();
    }
    private void CloseDrawers() { _fileDrawer = false; _detailsDrawer = false; }
    private void ItemCommitted()
    {
        // On a phone the slot editor lives in a full-screen sheet over the list. Once the item
        // itself has changed there is nothing left to do in the sheet, and leaving it up just
        // hides the result, so close it and let the change show on the list underneath. On a
        // desktop the editor sits beside the list, so there is nothing to close.
        if (DrawerMode && _detailsDrawer) { _detailsDrawer = false; Refresh(); }
    }
    /// <summary>
    /// Selecting a slot surfaces the slot editor wherever it currently lives: as a drawer on
    /// phones, or by un-collapsing the auto-collapsed inline pane on desktops (never overriding
    /// an explicit user hide). Mirrors the native ActiveSlot handling.
    /// </summary>
    /// <remarks>
    /// Only redraws the shell when that actually moved a pane. Nothing in the shell's own markup
    /// depends on which slot is selected, and the slot editor listens for the same event and
    /// redraws itself - so the unconditional refresh that used to be here was rebuilding the save
    /// list and the whole editor surface behind it on every single click of an item. Measured at
    /// roughly a third of a second per click on a real save, in a release build.
    /// </remarks>
    private void SelectionChanged()
    {
        var hasSelection = InventorySelection.HasAnySelection;
        var movedAPane = false;
        if (hasSelection && !_hadSlotSelection)
        {
            if (DrawerMode)
            {
                if (!_detailsDrawer) { _detailsDrawer = true; _fileDrawer = false; movedAPane = true; }
            }
            else if (_detailsAutoCollapsed && !Preferences.State.DetailsPaneCollapsed)
            {
                _detailsAutoCollapsed = false;
                movedAPane = true;
            }
        }
        _hadSlotSelection = hasSelection;
        if (movedAPane) Refresh();
    }
    private void ToggleAddPlayer() { _showAddPlayer = !_showAddPlayer; _addPlayerStatus = null; }
    private async Task AddPlayerAsync()
    {
        if (Workspace.Current is not { } workspace || !CanAddPlayer) return;
        // Pressing Enter twice on the form would otherwise write two characters into the world
        // under the same id, which the game has no way to tell apart afterwards.
        if (_addingPlayer) return;
        _addingPlayer = true;
        try
        {
            var copy = _copySelectedPlayer ? workspace.PlayerSession?.Path : null;
            var path = await WorldCreator.AddPlayerAsync(new(workspace.WorldFolder, _newPlayerId, copy));
            await Workspace.OpenAsync(workspace.WorldFolder); await Workspace.SelectAsync(path);
            _newPlayerId = string.Empty; _copySelectedPlayer = false; _showAddPlayer = false;
        }
        catch (Exception ex) { _addPlayerStatus = Errors.Present(ex, L.Resource("Main_AddPlayerFailedTitle"), L.Resource("Main_NewPlayerIdMessage")); }
        finally { _addingPlayer = false; }
    }
    private void OpenConfig(AbioticIniFile config)
    {
        try
        {
            var worldFolder = Workspace.Current!.WorldFolder;
            // Populate the shared session before navigating so the first render already has
            // the requested document. The query parameters below remain the durable fallback
            // when the page or host session is recreated.
            IniSessions.OpenDiscovered(worldFolder, config.FullPath);
            _activeIniFileName = Path.GetFileName(config.FullPath);
            CloseDrawers();
            Navigation.NavigateTo($"/ini/{Uri.EscapeDataString(Path.GetFileName(config.FullPath))}");
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Open configuration file from sidebar");
            Toasts.Show(
                L.Resource("Main_IniOpenFailed", Path.GetFileName(config.FullPath), L.Resource("Main_ParseError")),
                ToastKind.Error,
                TimeSpan.FromSeconds(8));
        }
    }
    // Character budget approximating the native sidebar's pixel-fitted MiddleTruncation at
    // the default file-pane width; the row tooltip keeps the full path.
    private const int SaveNameBudget = 36;

    /// <summary>
    /// Native sidebar labeling rule: a player row whose persona resolves shows
    /// "persona · filename"; everything else shows the folder-relative path. Personas
    /// come from the machine's Steam accounts plus the world's bed claims (claim names
    /// win - they are what teammates see), and are sanitized so Steam's control/private
    /// -use glyphs never render as tofu boxes.
    /// </summary>
    private string SaveDisplayName(WorkspaceSave save)
    {
        if (save.Kind == SaveDocumentKind.Player
            && SteamPersonaIndex.IdFromPlayerPath(save.Path) is { } id
            && ResolvePersona(id) is { Length: > 0 } persona)
        {
            return $"{persona} · {save.Name}";
        }
        return save.RelativePath;
    }

    private string? ResolvePersona(string id)
    {
        if (_claimPersonas is { } claims && claims.TryGetValue(id, out var claimName))
        {
            var sanitizedClaim = PersonaNames.Sanitize(claimName);
            if (sanitizedClaim.Length > 0) return sanitizedClaim;
        }
        return MachinePersonas.Value.TryGetValue(id, out var persona) ? NullIfEmpty(PersonaNames.Sanitize(persona)) : null;
    }

    private static string? NullIfEmpty(string value) => value.Length == 0 ? null : value;

    private bool _exporting;

    /// <summary>
    /// The read-only counterpart of SAVE: applies the staged edits (which land in memory rather
    /// than on the player's disk, because this folder could only be read) and then hands that one
    /// save back as a download.
    /// </summary>
    private async Task ExportSelectedAsync()
    {
        if (_exporting || Workspace.Current?.SelectedSave is not { } selected) return;
        _exporting = true;
        try
        {
            // The same save path as always. On a read-only folder it writes into the in-memory
            // copy, which is exactly what the export then reads, so the download carries the edits.
            if (IsDirty) await Workspace.SaveSelectedAsync();
            await Export.ExportSaveAsync(selected);
            Toasts.Show(L.Resource("Workspace_Downloaded", selected.Name), ToastKind.Success);
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Download the edited save");
            Toasts.Show(L.Resource("FileSidebar_ExportFailed"), ToastKind.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    /// <summary>
    /// Hands the player a zip of every save in the open world. Deliberately the whole world
    /// rather than the selected file: several editor actions change saves the player never
    /// opened, so exporting only what is on screen would hand back an incomplete set.
    /// </summary>
    private async Task ExportWorkspaceAsync()
    {
        if (_exporting) return;
        _exporting = true;
        try
        {
            var (count, unsavedOmitted) = await Export.ExportWorkspaceAsync();
            // Never let an export look complete when the edit the player just made is not in it.
            if (unsavedOmitted)
            {
                Toasts.Show(L.Resource("FileSidebar_ExportedUnsaved", count), ToastKind.Warning, TimeSpan.FromSeconds(10));
            }
            else
            {
                Toasts.Show(L.Resource("FileSidebar_Exported", count), ToastKind.Success);
            }
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Export the open world");
            Toasts.Show(L.Resource("FileSidebar_ExportFailed"), ToastKind.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private IReadOnlyDictionary<string, string>? _claimPersonas;
    private string? _claimPersonaFolder;

    /// <summary>
    /// Mirrors the native EnrichPlayerNamesAsync: bed claims in the workspace folder's
    /// WorldSave_Facility.sav carry the in-game names of every claiming co-op player.
    /// Read off-thread and cached by the bed service; rows re-render when names arrive.
    /// </summary>
    private void LoadClaimPersonas(string worldFolder)
    {
        if (string.Equals(_claimPersonaFolder, worldFolder, StringComparison.OrdinalIgnoreCase)) return;
        _claimPersonaFolder = worldFolder;
        _claimPersonas = null;
        RefreshClaimPersonas();
    }

    /// <summary>
    /// Picks up co-op names from the world save if - and only if - it has already been read.
    /// </summary>
    /// <remarks>
    /// This used to read the save itself, which means parsing all ~16 MB of the facility one.
    /// In a browser that is several seconds on the only thread there is, and because it was
    /// kicked off in the background at world-open it landed on whichever control the player
    /// touched first: measured at 5.6 seconds of dead page on the first click of a session, for
    /// a label. The screens that genuinely need the world - the bed picker, sending a companion,
    /// teleporter sync - still read it and say they are doing so; when one of them has, this
    /// picks the names up for free.
    /// </remarks>
    private void RefreshClaimPersonas()
    {
        var facility = (Workspace.Current?.Saves ?? [])
            .FirstOrDefault(save => save.Kind == SaveDocumentKind.World
                && string.Equals(save.Name, "WorldSave_Facility.sav", StringComparison.OrdinalIgnoreCase))
            ?.Path;
        if (facility is null) return;
        try
        {
            if (Beds.DeployablesIfAlreadyRead(facility, Workspace.Current?.WorldSession) is not { } deployables) return;
            _claimPersonas = SteamPersonaIndex.FromDeployables(deployables);
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Read bed-claim player names from the world save");
        }
    }

    /// <summary>The world was read by something else; the file list can now show its co-op names.</summary>
    private void DeployablesLoaded()
    {
        RefreshClaimPersonas();
        Refresh();
    }

    /// <summary>
    /// Puts reading the world save into the shell's busy line. It is the slowest thing the
    /// browser build does - parsing the ~16 MB facility save - and it happens on the one thread
    /// the page draws with, so without this the editor just stops for several seconds.
    /// </summary>
    private void WorldReading(bool reading)
        => _ = Workspace.ReportBusyAsync(reading ? L.Resource("Workspace_ReadingWorld") : null);
    private string KindLabel(SaveDocumentKind kind) => L.Resource(kind switch { SaveDocumentKind.Player => "Main_ChipPlayer", SaveDocumentKind.WorldMetadata => "Main_ChipMeta", SaveDocumentKind.World => "Main_ChipWorld", _ => "Main_ChipSave" });
    private static string KindClass(SaveDocumentKind kind) => kind.ToString().ToLowerInvariant();
    public async ValueTask DisposeAsync()
    {
        Workspace.Changed -= WorkspaceChanged; Live.Changed -= Refresh; Beds.Loaded -= DeployablesLoaded; Beds.Reading -= WorldReading; Preferences.Changed -= Refresh; InventorySelection.Changed -= SelectionChanged; InventorySelection.ItemCommitted -= ItemCommitted; Navigation.LocationChanged -= NavigationChanged;
        if (_splitterModule is not null) { try { await _splitterModule.InvokeVoidAsync("unwatch"); await _splitterModule.DisposeAsync(); } catch (JSDisconnectedException) { } }
        _self?.Dispose();
    }

    private sealed record SidebarSaveGroup(string Key, string Label, IReadOnlyList<WorkspaceSave> Saves);
}
