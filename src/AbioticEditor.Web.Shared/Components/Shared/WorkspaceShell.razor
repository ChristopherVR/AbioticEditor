@using AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Components.Pages
@using AbioticEditor.Core.Steam
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject SaveWorkspaceSessionService Workspace
@inject LiveSessionService Live
@inject SaveExportService Export
@inject SiblingWorldBedService Beds
@inject ShellPreferencesService Preferences
@inject InventorySelectionService InventorySelection
@inject CreateWorldService WorldCreator
@inject IniEditorSessionService IniSessions
@inject ToastService Toasts
@inject UnsavedChangesGuard Unsaved
@inject ModalService Modals
@inject NavigationManager Navigation
@inject AbioticEditor.Ui.IExternalNavigationService External
@inject IJSRuntime Js

<div class="workspace-shell shell-with-splitters @(DrawerMode ? "drawer-mode" : null) @FileClass @DetailsClass" style="@ShellStyle">
    <aside class="shell-pane file-pane" aria-label="@(IsPureLiveMode ? L.Resource("Live_SidebarSubtitle") : L.Text("save.workspace"))">
    @if (IsPureLiveMode)
    {
        @* No world folder opened yet this session - all we know is who is live-connected. Once a
           folder is opened (the header's OPEN FOLDER, same button file mode uses), the merged list
           below takes over and every player/world save in it becomes reachable, live where
           possible and file-edited otherwise - see IsLiveOnlinePlayer/SelectOrSwitchAsync. *@
        @if (!Live.IsConnected)
        {
            @* Still connecting (or waiting for a local game) - there is no player directory to
               show yet, so say that plainly instead of an empty "no players" list that reads as
               though a game were already connected and simply empty. *@
            <header class="file-sidebar-header"><div class="file-pane-heading"><strong>@L.Resource("Live_SidebarSubtitle")</strong></div></header>
            <div class="shell-empty"><strong>@L.Resource("Live_ConnectingChip")</strong></div>
        }
        else
        {
            <header class="file-sidebar-header">
                <div class="file-pane-heading">
                    <strong>@L.Resource("Live_ConnectedPlayers")</strong>
                    <span class="platform-badge @(Live.Directory?.IsHost == true ? "platform-steam" : "platform-gamepass")">
                        @(Live.Directory?.IsHost == true ? L.Resource("Live_HostChip") : L.Resource("Live_ClientChip"))
                    </span>
                </div>
                @* Moved here from the bottom of the live-editing surface itself, the same way the
                   file sidebar's own EXPORT toolbar button lives in its header rather than under
                   the file list - DISCONNECT is a property of the connection, not of whichever
                   player/world surface happens to be on screen. Wired through LiveSessionService
                   because the actual channel lives on LiveConnect.razor, not here. *@
                <button class="sidebar-export" type="button" @onclick="DisconnectLiveAsync">
                    <span class="material-symbol" aria-hidden="true">link_off</span>
                    @L.Resource("Live_Disconnect")
                </button>
            </header>
            <div class="shell-save-list save-groups-scroll">
                <section class="save-group">
                    @if (Live.Directory is { Players.Count: > 0 } directory)
                    {
                        @foreach (var player in directory.Players)
                        {
                            <button type="button" class="save-file-row kind-player @(IsSelectedLivePlayerSurface(player.Id) ? "selected" : null)" @onclick="() => SelectLivePlayerSurfaceAsync(player.Id)">
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@player.Name</strong>
                                @* B: the id the game itself identifies this player by (their SteamID64
                                   on Steam) - muted secondary text, the same save-file-meta shape the
                                   file sidebar uses for a player-save row's kind/size. *@
                                <span class="save-file-meta">
                                    @if (player.IsLocal) { <b>@L.Resource("Live_YouChip")</b> }
                                    <small>@player.Id</small>
                                </span>
                            </button>
                        }
                    }
                    else
                    {
                        <p class="shell-no-results">@L.Resource("Live_SidebarNoPlayers")</p>
                    }
                    @* C: accounts in this same world that are NOT connected right now - their save
                       still opens for ordinary file editing right here, marked OFFLINE rather than
                       the LIVE/YOU chips a connected row gets. *@
                    @foreach (var offline in LiveOfflinePlayerSaves)
                    {
                        <button type="button" class="save-file-row kind-player live-offline @(IsSelectedOfflinePlayerFile(offline) ? "selected" : null)" @onclick="() => SelectOfflinePlayerFileAsync(offline)">
                            <span class="save-kind-marker" aria-hidden="true"></span>
                            <strong class="save-file-name">@MiddleTruncation.Truncate(SaveDisplayName(offline), SaveNameBudget)</strong>
                            <span class="save-file-meta"><b>@L.Resource("Live_OfflineChip")</b></span>
                        </button>
                    }
                    @* A: one row per region map of this world, enabled only for the one the game
                       currently has loaded - mirrors the file sidebar's own per-save-file rows
                       instead of the old single catch-all WORLD row. Falls back to a static,
                       mostly-disabled region list when this world's folder could not be found on
                       this PC (see LiveWorldFolderLocator via LiveSessionService.WorldFolder). *@
                    @* Active first, the same "what you can act on comes before what you cannot"
                       order the player rows above use: the region the game has loaded right now
                       (HERE), then the metadata save, then every other region of this world,
                       disabled. *@
                    @if (IsLiveWorldOpen)
                    {
                        @foreach (var region in LiveRegionSaves.Where(IsCurrentLiveRegion))
                        {
                            <button type="button" class="save-file-row kind-world @(Live.Surface == LiveSurface.World && !Live.WorldSurfaceIsMetadata ? "selected" : null)"
                                    title="@region.RelativePath" @onclick="() => SelectLiveRegionAsync(region)">
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@MiddleTruncation.Truncate(SaveDisplayName(region), SaveNameBudget)</strong>
                                <span class="save-file-meta"><b>@L.Resource("Live_HereChip")</b></span>
                            </button>
                        }
                    }
                    <button type="button" class="save-file-row kind-worldmetadata @(Live.Surface == LiveSurface.World && Live.WorldSurfaceIsMetadata ? "selected" : null)" @onclick="SelectLiveMetadataAsync">
                        <span class="save-kind-marker" aria-hidden="true"></span>
                        <strong class="save-file-name">@(LiveMetadataSave is { } metadata ? SaveDisplayName(metadata) : L.Resource("LiveWorld_Title"))</strong>
                    </button>
                    @if (IsLiveWorldOpen)
                    {
                        @foreach (var region in LiveRegionSaves.Where(region => !IsCurrentLiveRegion(region)))
                        {
                            <button type="button" class="save-file-row kind-world region-disabled" disabled title="@L.Resource("Live_RegionNotHereHint")">
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@MiddleTruncation.Truncate(SaveDisplayName(region), SaveNameBudget)</strong>
                            </button>
                        }
                    }
                    else
                    {
                        @foreach (var token in FallbackRegionTokens)
                        {
                            var isCurrent = string.Equals(NormalizeLevelToken(Live.CurrentRegionToken), token, StringComparison.OrdinalIgnoreCase);
                            <button type="button" class="save-file-row kind-world region-disabled" disabled title="@L.Resource("Live_RegionNotHereHint")">
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@(WorldAreaCatalog.FriendlyName(token) ?? token)</strong>
                                @if (isCurrent) { <span class="save-file-meta"><b>@L.Resource("Live_HereChip")</b></span> }
                            </button>
                        }
                    }
                    @* Says plainly which area the game itself reports, so a region list with
                       nothing marked HERE is diagnosable at a glance instead of a mystery. *@
                    <p class="shell-no-results">@L.Resource("Live_InGameRegion", NormalizeLevelToken(Live.CurrentRegionToken) is { } here ? (WorldAreaCatalog.FriendlyName(here) ?? here) : L.Resource("Live_RegionUnknown"))</p>
                </section>
            </div>
        }
    }
    else
    {
        <header class="file-sidebar-header">
            <div class="file-pane-heading">
                <strong>@L.Resource("FileSidebar_SaveFiles")</strong>
                @if (Workspace.Current is not null) { <span class="platform-badge @PlatformBadgeClass">@PlatformLabel</span> }
            </div>
            <label class="sidebar-search">
                <span class="material-symbol" aria-hidden="true">search</span>
                <input @bind="_filter" @bind:event="oninput" placeholder="@L.Resource("FileSidebar_SearchSavesAndConfig")" aria-label="@L.Resource("FileSidebar_SearchSavesAndConfig")" />
                @if (!string.IsNullOrWhiteSpace(_filter)) { <button class="material-symbol" type="button" @onclick="ClearFilter" aria-label="@L.Resource("FileSidebar_ClearFilter")">close</button> }
            </label>
            @if (Workspace.Current is { } loadedWorkspace)
            {
                <span class="sidebar-count">@L.Text("items.count", loadedWorkspace.Saves.Count)</span>
                @* The whole world, not just the open save: setting a story chapter rewrites the
                   Facility save, and the "move players" option rewrites every player save, so a
                   copy of only the file on screen would quietly leave those behind. *@
                @* Said once, where the file list is, rather than on every screen: this is a
                   property of the folder that is open, and the player needs to know before they
                   edit anything that their work leaves through EXPORT. *@
                @if (!Workspace.CanWrite)
                {
                    <p class="sidebar-readonly" role="note">@L.Resource("Workspace_ReadOnlyNotice")</p>
                }
                @if (Export.OffersSaveExport)
                {
                    <button class="sidebar-export" type="button" disabled="@_exporting"
                            title="@L.Resource("FileSidebar_ExportTooltip")"
                            @onclick="ExportWorkspaceAsync">
                        <span class="material-symbol" aria-hidden="true">archive</span>
                        @(_exporting ? L.Resource("FileSidebar_Exporting") : L.Resource("FileSidebar_Export"))
                    </button>
                }
            }
        </header>

        @if (Workspace.Current is not { } workspace)
        {
            <div class="shell-empty"><strong>@L.Resource("FileSidebar_NoFolderLoaded")</strong><p>@L.Editor("workspace.openHint")</p></div>
        }
        else
        {
            <div class="shell-save-list save-groups-scroll">
                @foreach (var group in SaveGroups)
                {
                    <section class="save-group" aria-labelledby="save-group-@group.Key">
                        <header class="save-group-heading" id="save-group-@group.Key">
                            <strong>@group.Label</strong><span>@group.Saves.Count</span>
                            @if (group.Key == "players" && CanAddPlayer)
                            {
                                <button type="button" class="add-player-button material-symbol" @onclick="ToggleAddPlayer" aria-expanded="@_showAddPlayer" aria-label="@L.Resource("FileSidebar_AddAPlayerNewOrCopiedFromAnExistingOne")">add</button>
                            }
                        </header>
                        @foreach (var save in group.Saves)
                        {
                            <button type="button" class="save-file-row kind-@KindClass(save.Kind) @(workspace.SelectedSave == save ? "selected" : null) @(IsLiveOnlinePlayer(save) ? "live-online" : null)" aria-current="@(workspace.SelectedSave == save ? "true" : null)" title="@save.Path" @onclick="() => SelectOrSwitchAsync(save)"
                                    @oncontextmenu="@(args => OpenSaveMenu(save, args))" @oncontextmenu:preventDefault>
                                <span class="save-kind-marker" aria-hidden="true"></span>
                                <strong class="save-file-name">@MiddleTruncation.Truncate(SaveDisplayName(save), SaveNameBudget)</strong>
                                <span class="save-file-meta">
                                    <b>@(IsLiveOnlinePlayer(save) ? L.Resource("Live_LiveChip") : KindLabel(save.Kind))</b>
                                    <small>@save.Size</small>
                                </span>
                            </button>
                        }
                    </section>
                }
                @if (FilteredSaveCount == 0) { <p class="shell-no-results">@L.Text("saves.no.matches", _filter)</p> }
            </div>

            @* Right-click menu for a save row. The backdrop closes it on any outside click,
               which is simpler and more reliable than tracking focus loss on the menu itself. *@
            @if (_saveMenuFor is not null)
            {
                <div class="save-menu-backdrop" role="presentation" @onclick="CloseSaveMenu" @oncontextmenu="CloseSaveMenu" @oncontextmenu:preventDefault></div>
                <div class="save-context-menu" role="menu" style="@_saveMenuStyle">
                    @* Saving one file on its own, in a browser: the only way to take a single save
                       away without exporting the whole world as a zip. The desktop has the file
                       itself in the game's folder, so it offers the folder instead. *@
                    @if (Export.OffersSaveExport)
                    {
                        <button type="button" role="menuitem" @onclick="ExportSelectedSaveAsync">@L.Resource("FileSidebar_ExportThisSave")</button>
                    }
                    @* Opening a folder on the computer, which a browser tab cannot do. *@
                    @if (Workspace.HasLocalPaths)
                    {
                        <button type="button" role="menuitem" @onclick="RevealSelectedSaveAsync">@RevealLabel</button>
                    }
                </div>
            }

            @if (_showAddPlayer && CanAddPlayer)
            {
                <div class="sidebar-dialog-backdrop" role="presentation">
                <form class="add-player-panel" role="dialog" aria-modal="true" aria-labelledby="add-player-title" @onsubmit="AddPlayerAsync" @onsubmit:preventDefault>
                    <h2 id="add-player-title">@L.Resource("Main_AddPlayerHeader")</h2>
                    <label>@L.Text("player.new.steamid")<input @bind="_newPlayerId" inputmode="numeric" autocomplete="off" /></label>
                    <label class="checkbox-field"><input type="checkbox" @bind="_copySelectedPlayer" disabled="@(workspace.PlayerSession is null)" /> @L.Text("player.copy.selected")</label>
                    <div><button class="primary" type="submit" disabled="@(_addingPlayer || string.IsNullOrWhiteSpace(_newPlayerId))">@L.Text("player.add")</button><button class="secondary" type="button" @onclick="ToggleAddPlayer">@L.Text("cancel")</button></div>
                    @if (_addPlayerStatus is not null) { <p role="status">@_addPlayerStatus</p> }
                </form>
                </div>
            }

            @* Only ever draws anything for a Game Pass save that has a spare copy or a leftover to
               offer, so it costs an ordinary world nothing. It sits below the file list because it
               is about the folder rather than about any one save in it. *@

            @if (VisibleConfigFiles.Count > 0)
            {
                <section class="config-group" aria-labelledby="config-files-title">
                    <header class="config-group-heading" id="config-files-title"><strong>@L.Resource("FileSidebar_ConfigFiles")</strong></header>
                    <div class="config-file-list">
                    @foreach (var config in VisibleConfigFiles)
                    {
                        <button type="button" class="config-file-row" title="@config.FullPath" @onclick="() => OpenConfig(config)"><b>@L.Resource(ConfigChipResourceKey(config.Kind))</b><span>@Path.GetFileName(config.FullPath)</span><small>@ConfigDetail(config)</small></button>
                    }
                    </div>
                </section>
            }
        }
    }
    </aside>

    <div class="shell-splitter file-splitter" @ref="_fileSplitter" role="separator" tabindex="0" @onkeydown="ResizeFileWithKeyboard" aria-orientation="vertical" aria-label="@L.Text("resize.saves")" aria-valuemin="220" aria-valuemax="600" aria-valuenow="@Preferences.State.FilePaneWidth">
        <button type="button" @onclick="ToggleFilePane" title="@L.Resource("Main_ShowOrHideTheSaveFileList")" aria-label="@L.Editor("workspace.collapseSaves")">@(FileShown ? "‹" : "›")</button><span aria-hidden="true"></span>
    </div>

    <section class="shell-center">
        <section class="shell-status" aria-live="polite">
            @* /live wins outright, same as the sidebar: switching to a connected player can leave a
               file still selected behind it, and that file's SAVE/RELOAD/REVERT toolbar has no
               business showing on the live route. The one exception is the offline-player-file
               surface (round 78): that save's own toolbar below is the whole point of opening it,
               so it falls through to the very same markup the file editor's sidebar uses. *@
            @if (Workspace.BusyOperation is { } busy) { <span class="shell-busy">@busy</span> }
            else if (IsPureLiveMode && Live.Surface != LiveSurface.OfflinePlayerFile) { <span>@L.Resource("Live_SidebarSubtitle")</span> }
            else if (Workspace.Current?.SelectedSave is { } save)
            {
                <div class="selected-save-title"><strong>@SaveDisplayName(save)</strong><span><b>@KindLabel(save.Kind)</b> @save.Size</span></div>
                @* Native header: a hazard dot + UNSAVED only while changes are staged; nothing when clean. *@
                @if (IsDirty) { <span class="dirty unsaved-chip"><i aria-hidden="true"></i>@L.Resource("Main_Unsaved")</span> }
                @* A folder opened read-only (a browser that cannot write to one) has no SAVE to
                   offer. Rather than a disabled button with no explanation, the same slot becomes
                   the action that DOES work here: download the edited copy. *@
                <div class="editor-actions">
                    <button class="secondary" type="button" disabled="@_writing" @onclick="ReloadAsync">@L.Editor("workspace.reload").ToUpperInvariant()</button>
                    <button class="secondary" type="button" disabled="@(!IsDirty || _writing)" @onclick="Revert">@L.Text("revert").ToUpperInvariant()</button>
                    @if (Workspace.CanWrite)
                    {
                        <button class="primary" type="button" disabled="@(!IsDirty || _writing)" @onclick="SaveAsync">@L.Text("save").ToUpperInvariant()</button>
                    }
                    else if (Export.OffersSaveExport)
                    {
                        <button class="primary" type="button" disabled="@_exporting"
                                title="@L.Resource("Workspace_ReadOnlyExportTooltip")"
                                @onclick="ExportSelectedAsync">@L.Resource("Workspace_Download")</button>
                    }
                </div>
            }
            else { <span>@L.Editor("workspace.selectHint")</span> }
        </section>
        <div class="shell-body">
            @if (_activeIniFileName is { } iniFileName)
            {
                <IniEditor RequestedFileName="@iniFileName" />
            }
            else
            {
                @ChildContent
            }
        </div>
    </section>

    <div class="shell-splitter details-splitter" @ref="_detailsSplitter" role="separator" tabindex="0" @onkeydown="ResizeDetailsWithKeyboard" aria-orientation="vertical" aria-label="@L.Text("resize.slot.editor")" aria-valuemin="260" aria-valuemax="680" aria-valuenow="@Preferences.State.DetailsPaneWidth">
        <button type="button" @onclick="ToggleDetailsPane" title="@L.Resource("Main_ShowOrHideTheSlotEditorAndItemCatalog")" aria-label="@L.Editor("workspace.collapseDetails")">@(DetailsShown ? "›" : "‹")</button><span aria-hidden="true"></span>
    </div>

    <aside class="shell-pane details-pane" aria-label="@L.Text("inventory.slot.editor")">
        <InventorySlotEditor />
    </aside>

    @if (DrawerMode)
    {
        <div class="drawer-scrim @(_fileDrawer || _detailsDrawer ? "open" : null)" @onclick="CloseDrawers" aria-hidden="true"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = null!;
    // Responsive state machine, mirroring the native ResponsivePaneController:
    // below 900 the panes are slide-in overlay drawers; below 1150 the inline panes
    // auto-collapse (and restore on widen) while a user toggle is remembered separately.
    private string _viewport = "wide";
    private bool _fileAutoCollapsed;
    private bool _detailsAutoCollapsed;
    private bool _fileDrawer;
    private bool _detailsDrawer;
    private bool _hadSlotSelection;
    private string _filter = string.Empty;
    private bool _showAddPlayer;
    private string _newPlayerId = string.Empty;
    private bool _copySelectedPlayer;
    private string? _addPlayerStatus;
    // Held for the whole of one write (SAVE, RELOAD, save-anyway) and one save switch. Both cover
    // work that carries on after the click returns, so the flag is what stops a second press
    // starting the same work again, and the buttons read it to say so.
    private bool _writing;
    private bool _switchingSave;
    private bool _addingPlayer;
    private string? _activeIniFileName;
    private string? _selectedSavePath;
    private string? _workspaceFolder;
    private PlayerSaveSession? _playerSession;
    private WorldSaveSession? _worldSession;
    private ElementReference _fileSplitter;
    private ElementReference _detailsSplitter;
    private IJSObjectReference? _splitterModule;
    private DotNetObjectReference<WorkspaceShell>? _self;
    private static readonly Lazy<IReadOnlyDictionary<string, string>> MachinePersonas = new(SteamPersonaIndex.LoadMachineAccounts);

    private bool IsDirty => Workspace.Current?.PlayerSession?.IsDirty == true || Workspace.Current?.WorldSession?.IsDirty == true;
    private bool DrawerMode => _viewport == "drawer";
    private bool FileVisible => !Preferences.State.FilePaneCollapsed && !_fileAutoCollapsed;
    private bool DetailsVisible => !Preferences.State.DetailsPaneCollapsed && !_detailsAutoCollapsed;
    // Rail chevrons point toward the pane when it is shown (a collapse hint) and toward
    // the screen edge when hidden, exactly like the native rails.
    private bool FileShown => DrawerMode ? _fileDrawer : FileVisible;
    private bool DetailsShown => DrawerMode ? _detailsDrawer : DetailsVisible;
    // The slot editor only means something once a save is open OR a live connection is up
    // (PlayerEditor publishes the same palette context live, and InventorySlotEditor binds to
    // InventorySelectionService either way - see LiveInventorySession); before either, the whole
    // right pane and its rail stay out of the layout.
    private bool DetailsAvailable => Workspace.Current?.SelectedSave is not null || Live.IsConnected;
    private string FileClass => DrawerMode ? (_fileDrawer ? "file-drawer-open" : string.Empty) : (FileVisible ? string.Empty : "file-collapsed");
    private string DetailsClass => !DetailsAvailable
        ? "details-unavailable"
        : DrawerMode ? (_detailsDrawer ? "details-drawer-open" : string.Empty) : (DetailsVisible ? string.Empty : "details-collapsed");
    private string ShellStyle => $"--file-pane-width:{Preferences.State.FilePaneWidth}px;--details-pane-width:{Preferences.State.DetailsPaneWidth}px";
    private bool IsGamePass => Workspace.Current?.Platform == SavePlatform.GamePass;
    private string PlatformLabel => Workspace.Current is { } current
        ? L.PlatformLabel(current.Platform, current.Source)
        : string.Empty;
    private string PlatformBadgeClass => Workspace.Current switch
    {
        { Platform: SavePlatform.Steam } => "platform-steam",
        { Platform: SavePlatform.GamePass } => "platform-gamepass",
        _ => "platform-unknown",
    };
    private bool CanAddPlayer => Workspace.Current is not null && !IsGamePass;
    private IReadOnlyList<AbioticIniFile> ConfigFiles => Workspace.Current is { } workspace ? AbioticIniCatalog.Discover(workspace.WorldFolder) : [];
    private IReadOnlyList<AbioticIniFile> VisibleConfigFiles => ConfigFiles.Where(config => Matches(Path.GetFileName(config.FullPath)) || Matches(AbioticIniCatalog.LabelFor(config.Kind))).ToArray();
    private int FilteredSaveCount => SaveGroups.Sum(group => group.Saves.Count);
    private IReadOnlyList<SidebarSaveGroup> SaveGroups
    {
        get
        {
            var saves = Workspace.Current?.Saves.Where(save => Matches(save.Name) || Matches(save.RelativePath) || Matches(save.Kind.ToString())).ToArray() ?? [];
            return new[]
            {
                new SidebarSaveGroup("metadata", L.Resource("Main_GroupWorldStory"), saves.Where(save => save.Kind == SaveDocumentKind.WorldMetadata).ToArray()),
                new SidebarSaveGroup("players", L.Resource("Main_GroupPlayers"), saves.Where(save => save.Kind == SaveDocumentKind.Player).ToArray()),
                new SidebarSaveGroup("world", L.Resource("Main_GroupWorldRegions"), saves.Where(save => save.Kind == SaveDocumentKind.World).ToArray()),
                new SidebarSaveGroup("other", L.Resource("Main_GroupOther"), saves.Where(save => save.Kind == SaveDocumentKind.Unknown).ToArray()),
            }.Where(group => group.Saves.Count > 0 || (group.Key == "players" && CanAddPlayer && string.IsNullOrWhiteSpace(_filter))).ToArray();
        }
    }

    /// <summary>True while the live-connect page is the active route, whether a connection has
    /// actually landed yet or is still being attempted - see MainLayout's identical property for
    /// why this cannot just be <c>Live.IsConnected</c>.</summary>
    private bool IsOnLivePage => string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), "live", StringComparison.OrdinalIgnoreCase);

    /// <summary>True whenever the sidebar should show only live content (connected players), never
    /// the file workspace's save list and settings files - see MainLayout's identical property for
    /// why being on <c>/live</c> wins outright, loaded workspace or not.</summary>
    private bool IsPureLiveMode => IsOnLivePage || (Live.IsConnected && Workspace.Current is null);

    protected override void OnInitialized() { Workspace.Changed += WorkspaceChanged; Live.Changed += Refresh; Preferences.Changed += Refresh; InventorySelection.Changed += SelectionChanged; InventorySelection.ItemCommitted += ItemCommitted; Navigation.LocationChanged += NavigationChanged; _selectedSavePath = Workspace.Current?.SelectedSave?.Path; _workspaceFolder = Workspace.Current?.WorldFolder; _playerSession = Workspace.Current?.PlayerSession; _worldSession = Workspace.Current?.WorldSession; _hadSlotSelection = InventorySelection.HasAnySelection; if (Workspace.Current is { } open) LoadClaimPersonas(open.WorldFolder); Beds.Loaded += DeployablesLoaded; Beds.Reading += WorldReading; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _splitterModule = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/AbioticEditor.Web.Shared/workspace-shell.js");
        await _splitterModule.InvokeVoidAsync("attach", _fileSplitter, _self, "file");
        await _splitterModule.InvokeVoidAsync("attach", _detailsSplitter, _self, "details");
        await _splitterModule.InvokeVoidAsync("watch", _self);
    }
    [JSInvokable] public void ResizePane(string pane, int width) { if (pane == "file") Preferences.SetFilePaneWidth(width); else Preferences.SetDetailsPaneWidth(width); }
    [JSInvokable]
    public void ViewportChanged(string mode)
    {
        var wasDrawer = DrawerMode;
        var wasCompact = _viewport != "wide";
        _viewport = mode;
        if (DrawerMode != wasDrawer) { _fileDrawer = false; _detailsDrawer = false; }
        var compact = _viewport != "wide";
        if (compact != wasCompact) { _fileAutoCollapsed = compact; _detailsAutoCollapsed = compact; }
        Refresh();
    }
    private void ResizeFileWithKeyboard(KeyboardEventArgs args) => ResizeWithKeyboard(args, "file");
    private void ResizeDetailsWithKeyboard(KeyboardEventArgs args) => ResizeWithKeyboard(args, "details");
    private void ResizeWithKeyboard(KeyboardEventArgs args, string pane)
    {
        var direction = args.Key switch { "ArrowLeft" => -1, "ArrowRight" => 1, _ => 0 };
        if (direction == 0) return;
        if (pane == "file") Preferences.SetFilePaneWidth(Preferences.State.FilePaneWidth + direction * 10);
        else Preferences.SetDetailsPaneWidth(Preferences.State.DetailsPaneWidth - direction * 10);
    }
    private void WorkspaceChanged()
    {
        var selectedPath = Workspace.Current?.SelectedSave?.Path;
        var player = Workspace.Current?.PlayerSession;
        var world = Workspace.Current?.WorldSession;
        if (!string.Equals(selectedPath, _selectedSavePath, StringComparison.OrdinalIgnoreCase) || !ReferenceEquals(player, _playerSession) || !ReferenceEquals(world, _worldSession))
        {
            _selectedSavePath = selectedPath; _playerSession = player; _worldSession = world; InventorySelection.Clear();
        }
        // Opening a world with the file pane collapsed (a remembered toggle from a prior
        // session) would land the player on an empty center with no visible save list, so
        // a freshly opened folder always reveals the sidebar. Drawer mode keeps its own
        // tap-to-open flow.
        var folder = Workspace.Current?.WorldFolder;
        if (!string.Equals(folder, _workspaceFolder, StringComparison.OrdinalIgnoreCase))
        {
            _workspaceFolder = folder;
            if (folder is not null && !DrawerMode)
            {
                _fileAutoCollapsed = false;
                if (Preferences.State.FilePaneCollapsed) Preferences.ToggleFilePane();
            }
        }
        if (Workspace.Current is { } open) LoadClaimPersonas(open.WorldFolder);
        Refresh();
    }
    private void Refresh() => _ = InvokeAsync(StateHasChanged);
    private void NavigationChanged(object? sender, LocationChangedEventArgs args)
    {
        if (!Navigation.ToBaseRelativePath(args.Location).StartsWith("ini/", StringComparison.OrdinalIgnoreCase))
            _activeIniFileName = null;
        Refresh();
    }
    private bool Matches(string? value) => string.IsNullOrWhiteSpace(_filter) || value?.Contains(_filter.Trim(), StringComparison.OrdinalIgnoreCase) == true;
    private void ClearFilter() => _filter = string.Empty;
    /// <summary>
    /// Opens a save from the sidebar, asking first when the open one has edits that would be
    /// thrown away. Selecting the save that is already open changes nothing, so it never asks.
    /// </summary>
    /// <remarks>
    /// One at a time, held for the whole attempt. The unsaved-edits question hands control back
    /// as soon as it is on screen, so without this a player clicking down the list while that
    /// question was up started a parse of every save they touched, each finishing later and
    /// replacing what was on the editor surface.
    /// </remarks>
    private Task SelectAsync(WorkspaceSave save)
    {
        if (_switchingSave) return Task.CompletedTask;
        if (string.Equals(save.Path, Workspace.Current?.SelectedSave?.Path, StringComparison.OrdinalIgnoreCase))
            return Task.CompletedTask;
        _switchingSave = true;
        return Unsaved.ConfirmAsync(() => OpenAsync(save), DoneSwitchingSaveAsync);
    }

    /// <summary>A player row is "live" only when it is BOTH currently connected to the running
    /// game AND we are live-connected ourselves - an offline player (in the world folder but not
    /// in Live.Directory right now) has nothing live to edit, so falls back to the ordinary file
    /// row below regardless of this flag.</summary>
    private bool IsLiveOnlinePlayer(WorkspaceSave save) =>
        Live.IsConnected && save.Kind == SaveDocumentKind.Player
        && SteamPersonaIndex.IdFromPlayerPath(save.Path) is { } steamId
        && Live.Directory?.Players.Any(player => player.Id == steamId) == true;

    /// <summary>The sidebar's one click handler for every row once a live connection AND a world
    /// folder are both open: a currently-connected player switches the live view to them (no file
    /// touched, matching what the user asked for - live memory wherever a live path exists);
    /// anything else (an offline player, or any world save - live world editing does not exist
    /// yet) opens it for ordinary file editing exactly as SelectAsync always has.</summary>
    private Task SelectOrSwitchAsync(WorkspaceSave save)
    {
        if (IsLiveOnlinePlayer(save) && SteamPersonaIndex.IdFromPlayerPath(save.Path) is { } steamId)
            return SwitchLivePlayerAsync(steamId);
        return SelectAsync(save);
    }

    private async Task SwitchLivePlayerAsync(string playerId)
    {
        await Live.RequestPlayerSwitchAsync(playerId);
        if (!string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), "live", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("live");
    }

    /// <summary>True when <paramref name="playerId"/> is both the selected live player AND the
    /// Player surface is what is on screen - a player can be "selected" (their data loaded) while
    /// the WORLD row is what is actually showing, in which case neither row should look selected
    /// as a player row.</summary>
    private bool IsSelectedLivePlayerSurface(string playerId) =>
        Live.Surface == LiveSurface.Player && Live.SelectedPlayerId == playerId;

    /// <summary>The pure-live sidebar's own player row click: always switches to that player's
    /// Player surface. Reselecting the player who is already the Player surface is a no-op;
    /// picking a different one runs the same full switch <see cref="SwitchLivePlayerAsync"/>
    /// already did for the combined file+live sidebar. Returning here from the WORLD row for the
    /// SAME player still needs a request (nothing else flips the surface back).</summary>
    private Task SelectLivePlayerSurfaceAsync(string playerId)
        => IsSelectedLivePlayerSurface(playerId) ? Task.CompletedTask : SwitchLivePlayerAsync(playerId);

    /// <summary>A sidebar region row, or the metadata row: switches the live surface to the world
    /// tabs (with the matching tab set - see LiveConnect's own metadata split) without
    /// touching which player is loaded.</summary>
    private async Task SelectLiveWorldSurfaceAsync(bool isMetadata)
    {
        if (Live.Surface == LiveSurface.World && Live.WorldSurfaceIsMetadata == isMetadata) return;
        await Live.RequestWorldSurfaceAsync(isMetadata);
        if (!string.Equals(Navigation.ToBaseRelativePath(Navigation.Uri), "live", StringComparison.OrdinalIgnoreCase))
            Navigation.NavigateTo("live");
    }

    /// <summary>Round 78: whether this world's own folder was found and opened on the shared
    /// file-editing service (see LiveConnect's <c>TryLocateLiveWorldFolderAsync</c>) - only
    /// then do the region/offline-player rows below have real save data to draw from. False shows
    /// a static, mostly-disabled region list instead (<see cref="FallbackRegionTokens"/>).</summary>
    private bool IsLiveWorldOpen => Live.WorldFolder is not null
        && string.Equals(Workspace.Current?.WorldFolder, Live.WorldFolder, StringComparison.OrdinalIgnoreCase);

    /// <summary>Every region save (<c>WorldSave_&lt;Region&gt;.sav</c>) in this world - one
    /// sidebar row each, all but the currently loaded one disabled. Empty (and the fallback list
    /// shows instead) until <see cref="IsLiveWorldOpen"/>.</summary>
    private IReadOnlyList<WorkspaceSave> LiveRegionSaves => IsLiveWorldOpen
        ? Workspace.Current!.Saves.Where(save => save.Kind == SaveDocumentKind.World).ToArray()
        : [];

    /// <summary>This world's metadata save, when its folder was found - used only to label the
    /// metadata row; that row is shown and enabled regardless (it needs no file, only the live
    /// channel - see LiveConnect's metadata tab set).</summary>
    private WorkspaceSave? LiveMetadataSave => IsLiveWorldOpen
        ? Workspace.Current!.Saves.FirstOrDefault(save => save.Kind == SaveDocumentKind.WorldMetadata)
        : null;

    /// <summary>C: this world's player saves that are NOT currently connected - shown as OFFLINE
    /// rows under the connected ones. A player who IS connected never appears twice: their id is
    /// excluded here regardless of surface.</summary>
    private IReadOnlyList<WorkspaceSave> LiveOfflinePlayerSaves
    {
        get
        {
            if (!IsLiveWorldOpen) return [];
            var onlineIds = (Live.Directory?.Players ?? [])
                .Select(player => player.Id)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            return Workspace.Current!.Saves
                .Where(save => save.Kind == SaveDocumentKind.Player
                    && (SteamPersonaIndex.IdFromPlayerPath(save.Path) is not { } id || !onlineIds.Contains(id)))
                .ToArray();
        }
    }

    /// <summary>Whether a region save is the one the live game currently has loaded, matched by
    /// its <c>WorldSave_&lt;token&gt;.sav</c> file name against <see
    /// cref="LiveSessionService.CurrentRegionToken"/> (see <c>LiveWorldInfoChannel</c>).</summary>
    private bool IsCurrentLiveRegion(WorkspaceSave save) =>
        NormalizeLevelToken(Live.CurrentRegionToken) is { } token
        && string.Equals(WorldAreaCatalog.TokenFromSaveFile(save.Path), token, StringComparison.OrdinalIgnoreCase);

    /// <summary>The game can report its active level as a bare name (<c>Facility_MFWest</c>), as
    /// a full package path (<c>/Game/Maps/Facility_MFWest.Facility_MFWest</c>), with a streaming
    /// suffix (<c>:PersistentLevel</c>) or an editor-play prefix; the save file is always the bare
    /// name, so every comparison happens on that.</summary>
    private static string? NormalizeLevelToken(string? token)
    {
        if (string.IsNullOrWhiteSpace(token)) return null;
        var t = token.Trim();
        var colon = t.IndexOf(':');
        if (colon >= 0) t = t[..colon];
        var slash = t.LastIndexOf('/');
        if (slash >= 0) t = t[(slash + 1)..];
        var dot = t.LastIndexOf('.');
        if (dot >= 0) t = t[(dot + 1)..];
        const string editorPlayPrefix = "UEDPIE_0_";
        if (t.StartsWith(editorPlayPrefix, StringComparison.OrdinalIgnoreCase)) t = t[editorPlayPrefix.Length..];
        return t.Length == 0 ? null : t;
    }

    /// <summary>The static region list shown (all disabled) when this world's folder could not be
    /// found on this PC - a curated subset of the game's own Facility sub-levels, named through
    /// the same <c>WorldAreaCatalog.FriendlyName</c> the real per-file rows use.</summary>
    private static readonly string[] FallbackRegionTokens =
    {
        "Facility",
        "Facility_Office1", "Facility_MFWest", "Facility_MFMines", "Facility_MFFoundry",
        "Facility_MFHQ", "Facility_MFMaggot", "Facility_Labs", "Facility_Security",
        "Facility_Dam", "Facility_Reservoir", "Facility_Pens", "Facility_Parking",
        "Facility_Residence",
    };

    /// <summary>The current region row's click handler - a no-op (never reachable in the UI
    /// anyway, since only the current region's row is enabled) for any other row.</summary>
    private Task SelectLiveRegionAsync(WorkspaceSave save)
        => IsCurrentLiveRegion(save) ? SelectLiveWorldSurfaceAsync(isMetadata: false) : Task.CompletedTask;

    /// <summary>The metadata row's click handler - always reachable, unlike a region row.</summary>
    private Task SelectLiveMetadataAsync() => SelectLiveWorldSurfaceAsync(isMetadata: true);

    /// <summary>True when <paramref name="save"/> is the offline player file currently open on
    /// <see cref="Workspace"/> AND that is what the page is actually showing - the same "selected
    /// means both things" rule <see cref="IsSelectedLivePlayerSurface"/> applies to a live player
    /// row.</summary>
    private bool IsSelectedOfflinePlayerFile(WorkspaceSave save) =>
        Live.Surface == LiveSurface.OfflinePlayerFile
        && string.Equals(Workspace.Current?.SelectedSave?.Path, save.Path, StringComparison.OrdinalIgnoreCase);

    /// <summary>C: clicking an offline player's row stages their save on the shared file-editing
    /// service (asking first when a DIFFERENT save already has unsaved edits, the same guard
    /// <see cref="SelectAsync"/> uses) and asks <c>LiveConnect</c> to show it.</summary>
    private Task SelectOfflinePlayerFileAsync(WorkspaceSave save)
    {
        if (_switchingSave || IsSelectedOfflinePlayerFile(save)) return Task.CompletedTask;
        _switchingSave = true;
        return Unsaved.ConfirmAsync(() => OpenOfflinePlayerAsync(save), DoneSwitchingSaveAsync);
