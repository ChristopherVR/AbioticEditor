@namespace AbioticEditor.Web.Components.Player
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@using AbioticEditor.Core.GamePass
@using AbioticEditor.Core.PlayerSaves
@inject CustomizationCatalogService Catalog
@inject SaveWorkspaceSessionService Workspace
@inject ISaveFileSystem Files
@inject AbioticEditor.Ui.IFilePicker FilePicker
@inject ISaveExporter Exporter

@* Faithful port of the native appearance panel (PlayerCharacterTab.xaml, second AfPanel):
   header row with slot picker + SAVE APPEARANCE, explanatory captions, then the wrapped
   field pickers with live icon/swatch previews. The save is discovered next to the loaded
   player save (never read from this machine's own game folder). Game Pass worlds keep
   appearance in account-level ProfileScientistCustomization wgs containers instead, so
   when no loose file exists the editor looks for the workspace's wgs folder and edits the
   container directly, exactly like the native editor. *@
<section class="editor-card appearance-panel" aria-label="@L.Resource("PlayerCharacter_AppearanceHeadHairClothing")">
    <div class="appearance-header">
        <p class="tab-section-label">@L.Resource("PlayerCharacter_AppearanceHeadHairClothing")</p>
        @if (_slots.Count > 1)
        {
            <select class="appearance-slot-select" aria-label="@L.Resource("PlayerUi_ChooseCharacterSlot")" @bind="SelectedSlot">
                @foreach (var slot in _slots.Keys) { <option value="@slot">@slot</option> }
            </select>
        }
        <button class="primary appearance-save" type="button" disabled="@(_session is null || !_session.IsDirty)" @onclick="SaveAsync">@L.Resource("PlayerCharacter_SaveAppearance")</button>
    </div>

    @if (_session is not null)
    {
        @* When the save exists: explain what is being edited and where it lives. *@
        <small class="general-help">
            @(_gamePassSet is not null
                ? L.Resource("Customization_AvailableCaptionGamePass", _selectedSlot)
                : L.Resource("Customization_AvailableCaptionSteam", SlotFileName(_session.Path)))
        </small>
    }
    @if (_status is not null) { <small class="appearance-status" role="status">@_status</small> }
    @* A character's look is stored beside the WORLDS folder, not inside a world, so a host that
       can only see the folder it was given cannot find it on its own. Let the player point at
       the file instead of leaving them with a dead panel. *@
    @if (_session is null && !Files.HasLocalPaths)
    {
        <div class="appearance-open-row">
            <p class="general-help">@L.Resource("Customization_OpenFileHint")</p>
            <button class="secondary" type="button" disabled="@_opening" @onclick="OpenAppearanceFileAsync">
                @L.Resource("Customization_OpenFile")
            </button>
        </div>
    }
    @if (_session is not null)
    {
        <small class="appearance-status">@L.Resource("Customization_VoiceNote")</small>
        @* The option tables mount the game paks on first use, which takes a moment. Say so:
           until they arrive every picker below is empty and looks broken. *@
        @if (!_catalogReady)
        {
            <p class="general-loading" role="status">
                <span class="header-busy-spinner" aria-hidden="true"></span>
                @L.Resource("Customization_LoadingOptions")
            </p>
        }
        <div class="appearance-fields">
            @foreach (var appearanceField in _session.Fields)
            {
                var options = _catalogReady ? Catalog.OptionsFor(appearanceField.TableName) : Array.Empty<CustomizationOption>();
                var selected = options.FirstOrDefault(option => string.Equals(option.RowName, appearanceField.Value, StringComparison.OrdinalIgnoreCase));
                var swatch = SwatchHex(selected);
                <div class="appearance-field">
                    <span class="appearance-field-label">@appearanceField.Label</span>
                    <div class="appearance-field-body">
                        @* Live preview: the option's own icon render, or a color swatch. *@
                        @if (selected?.IconAssetPath is { } icon)
                        {
                            <span class="appearance-preview"><GameArtImage GameRef="@icon" Alt="@selected.DisplayName" /></span>
                        }
                        else if (swatch is not null)
                        {
                            <span class="appearance-swatch" style="background:#@swatch" aria-hidden="true"></span>
                        }
                        <select @bind="appearanceField.Value" aria-label="@appearanceField.Label">
                            @if (options.Count == 0 || selected is null) { <option value="@appearanceField.Value">@appearanceField.Value</option> }
                            @foreach (var option in options) { <option value="@option.RowName">@option.DisplayName</option> }
                        </select>
                    </div>
                </div>
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired] public PlayerSaveSession Player { get; set; } = null!;
    private bool _catalogReady;
    private string? _playerPath;

    protected override async Task OnInitializedAsync()
    {
        // The DT_Customization_* option tables mount the game paks lazily; warm them
        // off-thread so the first render never blocks the circuit (any OptionsFor call
        // forces the one-time load regardless of the table name asked for).
        await Task.Run(() => Catalog.OptionsFor(string.Empty));
        _catalogReady = true;
    }
    private string? _status;
    private CustomizationSaveSession? _session;
    private readonly SortedDictionary<int, string?> _slots = new();
    private GamePassSaveSet? _gamePassSet;
    private int _selectedSlot;

    /// <summary>True when this workspace's appearance lives in Game Pass save data.</summary>
    private bool IsGamePassOrigin => _gamePassSet is not null
        || Workspace.Current?.Platform == AbioticEditor.Core.Saves.SavePlatform.GamePass;

    private int SelectedSlot
    {
        get => _selectedSlot;
        set { if (_selectedSlot == value) return; _selectedSlot = value; _ = LoadSlotAsync(value); }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(_playerPath, Player.Path, StringComparison.OrdinalIgnoreCase)) return;
        _playerPath = Player.Path;
        _session = null;
        _sessionIsPickedFile = false;
        _status = null;
        _slots.Clear();
        _gamePassSet = null;
        foreach (var (slot, path) in await DiscoverSlotsAsync()) _slots[slot] = path;
        if (_slots.Count == 0) DiscoverGamePassSlots();
        _selectedSlot = _slots.Count > 0 ? _slots.Keys.First() : 0;
        await LoadSlotAsync(_selectedSlot);
    }

    /// <summary>
    /// The appearance saves this player has, as slot number -> where to read it from. On the
    /// desktop they are found by walking up to the account folder; a host with no local paths
    /// cannot walk anywhere, so it looks inside the folder the player actually opened.
    /// </summary>
    private async Task<IReadOnlyList<(int Slot, string Path)>> DiscoverSlotsAsync()
    {
        var found = new List<(int, string)>();
        try
        {
            var candidates = Files.HasLocalPaths
                ? CustomizationSaveSession.DiscoverNearPlayer(Player.Path, Player.SteamIdentifier)
                    .Select(path => (Path: path, Name: System.IO.Path.GetFileNameWithoutExtension(path)))
                    .ToArray()
                : (await Files.ListSavesAsync(Workspace.Current?.WorldFolder ?? string.Empty))
                    .Where(entry => entry.Name.StartsWith("ScientistCustomization_", StringComparison.OrdinalIgnoreCase))
                    .Select(entry => (entry.Path, Name: entry.Name[..^".sav".Length]))
                    .ToArray();

            foreach (var (path, name) in candidates)
            {
                var separator = name.LastIndexOf('_');
                if (separator >= 0 && int.TryParse(name[(separator + 1)..], out var slot)) found.Add((slot, path));
            }
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Find the appearance saves for this character");
        }
        return found;
    }

    /// <summary>
    /// Game Pass fallback: no loose ScientistCustomization file exists next to a wgs
    /// extraction, so look for the workspace's container folder and list its
    /// ProfileScientistCustomization slots (existing Core container IO, read-only here).
    /// </summary>
    private void DiscoverGamePassSlots()
    {
        try
        {
            // A container workspace already has its wgs set open - reuse it, because the
            // temp extraction folder has no wgs siblings for the locator walk to find.
            var set = Workspace.Current?.GamePass?.Set;
            if (set is null)
            {
                var store = CustomizationSaveSession.TryLocateGamePassStore(Workspace.Current?.WorldFolder);
                if (store is null) return;
                set = GamePassSaveSet.Open(store);
            }
            var slots = set.CustomizationSlots();
            if (slots.Count == 0) return;
            _gamePassSet = set;
            foreach (var slot in slots) _slots[slot] = null;
        }
        catch (Exception exception)
        {
            Errors.Record(exception, "Read Game Pass appearance containers");
        }
    }

    private async Task LoadSlotAsync(int slot)
    {
        _session = null;
        if (!_slots.TryGetValue(slot, out var path))
        {
            _status = L.Resource(IsGamePassOrigin ? "Customization_StatusNotFoundGamePass" : "Customization_StatusNotFound");
            return;
        }
        try
        {
            if (_gamePassSet is not null)
            {
                _session = CustomizationSaveSession.LoadGamePass(_gamePassSet, slot);
                _status = _session is null
                    ? L.Resource("Customization_StatusNotFoundGamePass")
                    : L.Resource("Customization_StatusEditingGamePass", slot);
                return;
            }

            _session = Files.HasLocalPaths
                ? CustomizationSaveSession.Load(path!)
                : CustomizationSaveSession.LoadFromBytes(path!, await Files.ReadAllBytesAsync(path!));
            _status = L.Resource("Customization_StatusEditingFile", SlotFileName(path!));
        }
        catch (Exception exception)
        {
            _session = null;
            _status = Errors.Present(exception, L.Resource("PlayerUi_AppearanceOpenFailed"), L.Resource("PlayerUi_CheckFileReadable"));
        }
    }

    private bool _opening;
    private bool _sessionIsPickedFile;

    /// <summary>
    /// Opens an appearance save the player points at directly. Needed because these live one
    /// level above the world folder (beside <c>Worlds/</c>), which a browser cannot reach from
    /// the folder it was granted - so without this, opening a single world means no appearance
    /// editing at all. Loaded from bytes and saved back with DOWNLOAD, since a picked file is a
    /// snapshot with nowhere to write.
    /// </summary>
    private async Task OpenAppearanceFileAsync()
    {
        if (_opening) return;
        _opening = true;
        try
        {
            var picked = await FilePicker.PickFileAsync(new()
            {
                Title = L.Resource("Customization_OpenFile"),
                FileTypes = [new("Abiotic Factor save", [".sav"])],
            });
            if (picked is null) return;

            await using var stream = await picked.OpenReadAsync(CancellationToken.None);
            using var buffer = new MemoryStream();
            await stream.CopyToAsync(buffer);

            _session = CustomizationSaveSession.LoadFromBytes(picked.Name, buffer.ToArray());
            _sessionIsPickedFile = true;
            _gamePassSet = null;
            _status = L.Resource("Customization_StatusEditingFile", picked.Name);
        }
        catch (Exception exception)
        {
            _session = null;
            _status = Errors.Present(exception, L.Resource("PlayerUi_AppearanceOpenFailed"), L.Resource("PlayerUi_CheckFileReadable"));
        }
        finally
        {
            _opening = false;
        }
    }

    /// <summary>The file's own name, taken from the end of whatever identifies it on this host.</summary>
    private string SlotFileName(string path)
        => Files.HasLocalPaths ? System.IO.Path.GetFileName(path) : path[(path.LastIndexOf('/') + 1)..];

    private async Task SaveAsync()
    {
        if (_session is null) return;
        try
        {
            // A file the player pointed at directly is not in the open folder, so there is nowhere
            // to put it back - it comes back as a download instead.
            if (_sessionIsPickedFile)
            {
                await Exporter.ExportAsync(_session.Path, _session.SaveToBytes());
                _status = L.Resource("Customization_StatusDownloaded", _session.Path);
            }
            else if (_session.WritesBytes)
            {
                // Read from the open folder, so it goes back through the same file system - which
                // keeps the .bak, or updates the in-memory copy on a read-only folder.
                await Files.WriteAllBytesAsync(_session.Path, _session.SaveToBytes());
                _status = L.Resource("Customization_StatusSaved", $"{DateTime.Now:HH:mm:ss}");
            }
            else
            {
                _session.Save();
                _status = L.Resource("Customization_StatusSaved", $"{DateTime.Now:HH:mm:ss}");
            }
        }
        catch (Exception exception)
        {
            _status = Errors.Present(exception, L.Resource("PlayerUi_AppearanceSaveFailed"), L.Resource("PlayerUi_ChangesRemainOpen"));
        }
    }

    /// <summary>FLinearColor.Hex may carry an alpha tail - keep just RRGGBB (native SwatchColor).</summary>
    private static string? SwatchHex(CustomizationOption? option)
    {
        var hex = option?.ColorHex?.TrimStart('#');
        if (string.IsNullOrEmpty(hex)) return null;
        return hex.Length > 6 ? hex[..6] : hex;
    }
}
