@namespace AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.LiveEditing
@using AbioticEditor.Core.LiveEditing.Player
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services

@inject ItemCatalogService Catalog

@* Unlike the vitals/skills tabs on the live-connect page, edits here apply per slot (see
   LiveInventorySession's own doc comment) rather than staging for a page-level APPLY - the same
   reasoning LiveNpcsTab already uses, but per-row here since a slot edit is usually several
   fields at once (item id + stack + durability), not one toggle. *@
<section class="editor-card" aria-label="@L.Resource("LiveInventory_Title")">
    <div class="card-title-row">
        <h3>@L.Resource("LiveInventory_Title")</h3>
        <button class="secondary" type="button" disabled="@_busy" @onclick="RefreshAsync">@L.Resource("LiveNpcs_Refresh")</button>
    </div>
    <p class="muted">@L.Resource("LiveInventory_Intro")</p>

    <ItemPaletteDatalist />

    @foreach (var group in Groups)
    {
        <h4 class="live-inventory-group">@KindLabel(group.Kind)</h4>
        <div class="shell-save-list">
            @foreach (var draft in group.Slots)
            {
                var entry = string.IsNullOrEmpty(draft.ItemId) ? null : Catalog.Find(draft.ItemId);
                <div class="save-file-row kind-player" @key="(draft.Kind, draft.SlotIndex)">
                    <span class="save-kind-marker" aria-hidden="true"></span>
                    <strong class="save-file-name">@L.Resource("LiveInventory_Slot", draft.SlotIndex)@(entry is not null ? $" · {entry.DisplayName}" : null)</strong>
                    <div class="live-inventory-controls">
                        <input list="shell-item-palette" @bind="draft.ItemId" placeholder="@L.Inventory("empty")" autocomplete="off" />
                        <label class="live-inventory-field">@L.Inventory("count")<input type="number" min="0" @bind="draft.Stack" /></label>
                        <label class="live-inventory-field">@L.Inventory("durability")<input type="number" min="0" step="any" @bind="draft.Durability" /></label>
                        <label class="live-inventory-field">@L.Inventory("maxDurability")<input type="number" min="0" step="any" @bind="draft.MaxDurability" /></label>
                        <button class="secondary" type="button" disabled="@_busy" @onclick="() => ApplyAsync(draft)">@L.Resource("LiveInventory_Apply")</button>
                        <button class="secondary" type="button" disabled="@(_busy || draft.IsEmpty)" @onclick="() => ClearAsync(draft)">@L.Inventory("clear").ToUpperInvariant()</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (Session.Status is not null)
    {
        <p class="status-text">@Session.Status</p>
    }
    @if (_error is not null)
    {
        <p class="error-text" role="alert">@_error</p>
    }
</section>

@code {
    [Parameter, EditorRequired] public LiveInventorySession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private bool _busy;
    private string? _error;
    private List<SlotDraft> _drafts = [];
    private IReadOnlyList<LiveInventorySlot>? _draftedFrom;

    // Ordered groups (backpack/equip/hotbar) built once per Slots refresh - a plain LINQ GroupBy
    // over Session.Slots on every render would also rebuild every draft's edited-but-not-yet-
    // applied text, wiping in-progress typing whenever anything else on the page re-renders.
    private IEnumerable<(string Kind, List<SlotDraft> Slots)> Groups
    {
        get
        {
            if (!ReferenceEquals(_draftedFrom, Session.Slots)) RebuildDrafts();
            return KindOrder.Select(kind => (kind, _drafts.Where(d => d.Kind == kind).ToList()))
                .Where(g => g.Item2.Count > 0);
        }
    }

    private static readonly string[] KindOrder = ["backpack", "equip", "hotbar"];

    private void RebuildDrafts()
    {
        _draftedFrom = Session.Slots;
        _drafts = Session.Slots.Select(s => new SlotDraft(s)).ToList();
    }

    private string KindLabel(string kind) => kind switch
    {
        "backpack" => L.Resource("LiveInventory_Backpack"),
        "equip" => L.Resource("LiveInventory_Equipment"),
        "hotbar" => L.Resource("LiveInventory_Hotbar"),
        _ => kind,
    };

    private async Task RefreshAsync() => await RunAsync(() => Session.RefreshAsync());

    private Task ApplyAsync(SlotDraft draft) => RunAsync(() => Session.ApplyAsync(
        new LiveInventoryEdit(draft.Kind, draft.SlotIndex, ItemId: draft.ItemId,
            Stack: draft.Stack, Durability: draft.Durability, MaxDurability: draft.MaxDurability)));

    private Task ClearAsync(SlotDraft draft) => RunAsync(() => Session.ApplyAsync(
        new LiveInventoryEdit(draft.Kind, draft.SlotIndex, Clear: true)));

    private async Task RunAsync(Func<Task> action)
    {
        _busy = true;
        _error = null;
        try
        {
            await action();
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) when (exception is LiveAgentException or System.Net.Sockets.SocketException
            or IOException or OperationCanceledException)
        {
            _error = Errors.Present(exception, "Edit this inventory slot.", "The connection may have dropped; try reconnecting.");
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>A slot's locally-editable draft - separate from <see cref="LiveInventorySlot"/>
    /// (a read-only record) so typing into a field does not apply anything until APPLY is
    /// clicked, matching the file editor's own slot-edit model.</summary>
    private sealed class SlotDraft(LiveInventorySlot slot)
    {
        public string Kind { get; } = slot.Kind;
        public int SlotIndex { get; } = slot.SlotIndex;
        public bool IsEmpty { get; } = slot.IsEmpty;
        public string ItemId { get; set; } = slot.ItemId;
        public int Stack { get; set; } = slot.Stack;
        public double Durability { get; set; } = slot.Durability;
        public double MaxDurability { get; set; } = slot.MaxDurability;
    }
}
