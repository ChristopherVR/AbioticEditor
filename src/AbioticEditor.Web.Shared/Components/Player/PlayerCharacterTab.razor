@namespace AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Web.Models
@using AbioticEditor.Web.Services
@implements IDisposable
@inject ProgressionVocabularyService Progression
@inject InventorySelectionService Selection

@* Faithful port of the native PlayerCharacterTab.xaml: a CHARACTER panel (background picker,
   trait chips, add-trait browser) followed by the per-account appearance panel. *@
<div class="character-tab">
    <section class="editor-card" aria-label="@L.Resource("PlayerCharacter_Character")">
        <h3>@L.Resource("PlayerCharacter_Character")</h3>
        <div class="tab-hazard-stripe" aria-hidden="true"></div>

        <div class="character-background-row">
            <span class="general-field-label">@L.Resource("PlayerCharacter_Background")</span>
            <select class="character-background-select" value="@Session.Background" @onchange="OnBackgroundChangedAsync" disabled="@(!Session.CanChangeBackground)" aria-label="@L.Resource("PlayerCharacter_Background")">
                @if (string.IsNullOrEmpty(Session.Background)) { <option value="" disabled hidden></option> }
                else if (!TraitCatalog.Backgrounds.ContainsKey(Session.Background)) { <option value="@Session.Background">@Session.Background</option> }
                @foreach (var background in TraitCatalog.Backgrounds) { <option value="@background.Key">@background.Value</option> }
            </select>
            <small class="general-help">@L.Resource("PlayerCharacter_BackgroundHelp")</small>
        </div>

        @if (FileSession is { } completedIntroSession)
        {
            <div class="character-background-row">
                <label class="general-field-label">
                    <input type="checkbox" checked="@completedIntroSession.CompletedIntro"
                           @onchange="e => OnCompletedIntroChanged(completedIntroSession, e)" />
                    @L.Resource("PlayerCharacter_CompletedIntro")
                </label>
                <small class="general-help">@L.Resource("PlayerCharacter_CompletedIntroHelp")</small>
            </div>
        }
        <div class="tab-divider" aria-hidden="true"></div>

        <p class="tab-section-label">@L.Resource("PlayerCharacter_Traits")</p>
        @if (_traitError is not null) { <p class="error" role="alert">@_traitError</p> }
        @if (Session.CanEditTraits)
        {
            <div class="trait-chips">
                @foreach (var id in Session.Traits.ToArray())
                {
                    <span class="trait-chip @(_selectedTraitId == id ? "selected" : null)" title="@ChipTooltip(id)">
                        <button class="trait-chip-name" type="button" @onclick="() => SelectTrait(id)">@DisplayNameFor(id)</button>
                        <button class="trait-chip-remove" type="button" aria-label="@($"{L.Detail("remove")} {DisplayNameFor(id)}")" title="@(CanEditTrait(id) ? null : L.Resource("PlayerCharacter_TraitsCatalogRequired"))" disabled="@(!CanEditTrait(id) || _traitBusy)" @onclick="() => RemoveTrait(id)">&#x2715;</button>
                    </span>
                }
            </div>

            @* Trait browser: read what a trait does BEFORE adding it. *@
            <input type="search" class="trait-search" placeholder="@L.Resource("PlayerCharacter_SearchTraitsPlaceholder")" aria-label="@L.Resource("PlayerUi_FilterTraits")" @bind="Search" @bind:event="oninput" />
            @* Descriptions and costs come out of the game files and take a moment on first use.
               Until they land the rows carry names only, which reads as though the traits have
               nothing to say for themselves. *@
            @if (_detailsLoading)
            {
                <p class="general-loading" role="status">
                    <span class="header-busy-spinner" aria-hidden="true"></span>
                    @L.Resource("PlayerCharacter_LoadingTraitDetails")
                </p>
            }
            else
            {
                @* Rendered only once trait descriptions/costs are in: before that every row would
                   show blank/placeholder text that then gets filled in underneath the spinner
                   above, which reads as broken rather than loading. *@
                <div class="trait-browser" role="list" aria-label="@L.Resource("PlayerUi_TraitDetails")">
                    @if (!VisibleTraitOptions.Any())
                    {
                        <p class="trait-browser-empty">@L.Resource("PlayerCharacter_NoTraitsMatch")</p>
                    }
                    @foreach (var row in VisibleTraitOptions)
                    {
                        <div class="trait-browser-row" role="listitem">
                            <span class="trait-browser-name">@row.DisplayName</span>
                            <span class="trait-browser-cost">@CostText(row)</span>
                            <span class="trait-browser-description">@row.Description</span>
                            <button class="trait-browser-add" type="button" title="@(CanEditTrait(row.Id) ? null : L.Resource("PlayerCharacter_TraitsCatalogRequired"))" disabled="@(!CanEditTrait(row.Id) || _traitBusy)" @onclick="() => AddTrait(row.Id)">@L.Resource("PlayerCharacter_Add")</button>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            @* Older agents and remote clients expose the current traits as a readout. *@
            <div class="trait-chips">
                @foreach (var id in Session.Traits)
                {
                    <span class="trait-chip" title="@ChipTooltip(id)">
                        <span class="trait-chip-name">@DisplayNameFor(id)</span>
                    </span>
                }
            </div>
            <small class="general-help live-warning">@L.Resource("PlayerCharacter_TraitsLiveReadOnlyHelp")</small>
        }
    </section>

    @if (FileSession is { } appearanceSession)
    {
        <PlayerAppearanceEditor Player="appearanceSession" />
    }
    else if (Session.Appearance is { } liveAppearance)
    {
        <LivePlayerAppearanceEditor @key="Session.OwnerId" Session="liveAppearance" />
    }
    else
    {
        <section class="editor-card appearance-panel" aria-label="@L.Resource("PlayerCharacter_AppearanceHeadHairClothing")">
            <p class="tab-section-label">@L.Resource("PlayerCharacter_AppearanceHeadHairClothing")</p>
            <small class="general-help live-warning">@L.Resource("PlayerCharacter_AppearanceLiveReadOnlyHelp")</small>
        </section>
    }
</div>

@code {
    [Parameter, EditorRequired] public IPlayerGeneralSession Session { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }
    // Offline appearance edits use the profile file beside the player save. Live appearance
    // binds to the current character and offers a separate local-profile save action.
    private PlayerSaveSession? FileSession => Session as PlayerSaveSession;

    private async Task OnBackgroundChangedAsync(ChangeEventArgs e)
    {
        var background = e.Value?.ToString();
        if (string.IsNullOrEmpty(background)) return;
        await Session.SetBackgroundAsync(background);
        await OnChanged.InvokeAsync();
    }

    private async Task OnCompletedIntroChanged(PlayerSaveSession fileSession, ChangeEventArgs e)
    {
        fileSession.CompletedIntro = e.Value is bool value && value;
        fileSession.MarkChanged();
        await OnChanged.InvokeAsync();
    }
    private string Search { get; set; } = string.Empty;
    private IReadOnlyList<TraitBrowserRow>? _allRows;
    private IReadOnlyDictionary<string, TraitDetail> Details { get; set; } =
        new Dictionary<string, TraitDetail>(StringComparer.Ordinal);

    protected override void OnInitialized() => Selection.Changed += OnSelectionChanged;

    protected override async Task OnInitializedAsync()
    {
        // Trait descriptions/costs come from the game paks; load them off-thread on demand
        // (save selection deliberately never scans paks). Until they arrive the curated
        // name catalog renders, then the rows refresh with full detail.
        try
        {
            var details = await Task.Run(Progression.GetTraitDetails);
            Details = new Dictionary<string, TraitDetail>(details, StringComparer.OrdinalIgnoreCase);
            _allRows = null;
        }
        finally
        {
            _detailsLoading = false;
        }
        // A trait card already open when details finish loading is still showing the
        // name-only fallback - refresh it now that the full breakdown is available.
        if (_selectedTraitId is not null) ShowTraitDetail();
    }

    private const string DetailKeyPrefix = "player-trait:";
    private string? _selectedTraitId;

    /// <summary>Tap-to-toggle: opens a selected trait's points/description breakdown in the
    /// right-hand pane; a second tap on the same chip closes it.</summary>
    private void SelectTrait(string id)
    {
        if (Selection.DetailKey == DetailKeyPrefix + id)
        {
            _selectedTraitId = null;
            Selection.CloseDetail();
            return;
        }
        _selectedTraitId = id;
        ShowTraitDetail();
    }

    private void ShowTraitDetail()
    {
        if (_selectedTraitId is { } id) Selection.ShowDetail(DetailKeyPrefix + id, TraitDetailContent);
    }

    private void CloseOwnDetail()
    {
        _selectedTraitId = null;
        if (Selection.DetailKey?.StartsWith(DetailKeyPrefix, StringComparison.Ordinal) == true)
        {
            Selection.CloseDetail();
        }
    }

    /// <summary>Drops the stale chip highlight when the pane closes or another tab takes it.</summary>
    private void OnSelectionChanged()
    {
        if (_selectedTraitId is not null && Selection.DetailKey != DetailKeyPrefix + _selectedTraitId)
        {
            _selectedTraitId = null;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Selection.Changed -= OnSelectionChanged;
        // Leaving the tab retires this tab's own detail card (never someone else's).
        if (Selection.DetailKey?.StartsWith(DetailKeyPrefix, StringComparison.Ordinal) == true)
        {
            Selection.CloseDetail();
        }
    }

    /// <summary>A selected trait's points + description breakdown, the same information the
    /// chip's hover tooltip carries, surfaced properly for touch (and easier reading) instead
    /// of only on hover.</summary>
    private RenderFragment TraitDetailContent => __builder =>
    {
        if (_selectedTraitId is { } id)
        {
            var name = DisplayNameFor(id);
            var hasDetail = Details.TryGetValue(id, out var detail);
            <div class="detail-card detail-card--terminal char-detail">
                <div class="detail-head">
                    <span class="detail-title"><strong>@name</strong><small>@id</small></span>
                    <button class="detail-close" type="button" @onclick="CloseOwnDetail">✕</button>
                </div>
                @if (hasDetail && detail!.PointCost != 0)
                {
                    <span class="chip chip--orange">@PointsText(detail.PointCost)</span>
                }
                <span class="detail-label">@L.Resource("PlayerCharacter_Description")</span>
                <p class="detail-value">@((hasDetail ? detail!.Description : null) ?? L.Resource("PlayerUi_TraitDescriptionUnavailable"))</p>
            </div>
        }
    };

    /// <summary>True while the trait descriptions and costs are still being read from the game.</summary>
    private bool _detailsLoading = true;

    private string DisplayNameFor(string id)
        => Details.TryGetValue(id, out var detail) ? detail.DisplayName : TraitCatalog.DisplayNameFor(id);

    /// <summary>Hover text for a trait chip: what the trait does in game, plus its cost in
    /// trait points when that is known. With the game not installed there is nothing to say,
    /// so it says exactly that rather than falling back to the stored name.</summary>
    private string ChipTooltip(string id)
    {
        if (!Details.TryGetValue(id, out var detail) || detail.Description is not { Length: > 0 } description)
            return L.Resource("PlayerUi_TraitDescriptionUnavailable");
        return detail.PointCost != 0 ? $"{description}  [{PointsText(detail.PointCost)}]" : description;
    }

    /// <summary>"+2 pts" / "-1 pts": the wording and the sign both come from the catalogue.</summary>
    private string PointsText(int points) => L.Resource("PlayerCharacter_TraitPointsFormat", points);

    private IEnumerable<TraitBrowserRow> VisibleTraitOptions
    {
        get
        {
            _allRows ??= BuildRows();
            IEnumerable<TraitBrowserRow> rows = _allRows;
            if (!string.IsNullOrWhiteSpace(Search))
            {
                var filter = Search.Trim();
                rows = rows.Where(row => row.DisplayName.Contains(filter, StringComparison.OrdinalIgnoreCase)
                                      || (row.Description?.Contains(filter, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            var have = new HashSet<string>(Session.Traits, StringComparer.OrdinalIgnoreCase);
            return rows.Where(row => !have.Contains(row.Id)).ToList();
        }
    }

    private List<TraitBrowserRow> BuildRows() => TraitCatalog.Traits.Keys
        .Select(id =>
        {
            Details.TryGetValue(id, out var detail);
            // Cut traits ship without any description text and are never offered by the
            // in-game creator - label them instead of showing a blank.
            var description = detail?.Description
                ?? (detail is { AvailableOnStart: false } ? L.Resource("PlayerEditor_CutTraitDescription") : null);
            return new TraitBrowserRow(id, detail?.DisplayName ?? TraitCatalog.DisplayNameFor(id), description, detail?.PointCost ?? 0);
        })
        .OrderBy(row => row.DisplayName, StringComparer.OrdinalIgnoreCase)
        .ToList();

    private bool _traitBusy;
    private string? _traitError;
    private bool CanEditTrait(string id) => FileSession is not null || Details.TryGetValue(id, out var detail) && detail.BuffRowName is not null;
    private Task AddTrait(string id) => ChangeTraitAsync(id, true);
    private Task RemoveTrait(string id) => ChangeTraitAsync(id, false);
    private async Task ChangeTraitAsync(string id, bool enabled)
    {
        if (_traitBusy || !CanEditTrait(id)) return;
        _traitBusy = true;
        _traitError = null;
        try
        {
            Details.TryGetValue(id, out var detail);
            await Session.SetTraitAsync(id, enabled, detail?.BuffRowName);
            await OnChanged.InvokeAsync();
        }
        catch (Exception exception) { _traitError = Errors.Present(exception, "Update these traits.", "Try reconnecting to the game."); }
        finally { _traitBusy = false; }
    }

    /// <summary>The cost badge on an add-trait row. 0 is real data (traits picked up in the
    /// world, like Forbidden Diet), so it is shown rather than hidden.</summary>
    private string CostText(TraitBrowserRow row) => PointsText(row.PointCost).ToUpperInvariant();

    /// <summary>One row of the add-trait browser: full description + point cost up front.</summary>
    private sealed record TraitBrowserRow(string Id, string DisplayName, string? Description, int PointCost);
}
