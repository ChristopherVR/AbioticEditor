@namespace AbioticEditor.Web.Components.Player
@using System.Globalization
@using AbioticEditor.Core.PlayerSaves
@using AbioticEditor.Core.Steam
@using AbioticEditor.Core.WorldSaves
@inject AbioticEditor.Web.Services.SiblingWorldBedService Beds
@inject AbioticEditor.Web.Services.SaveWorkspaceSessionService Workspace
@inject AbioticEditor.Web.Services.ModalService Modals

@* Faithful port of the retired native SPAWN tab: one "SPAWN & HOME" panel with the
   editable last-safe location + region, the punch-card respawn-terminal picker, the
   spawn-to-bed picker and the resolved home-bed line. Beds come from the sibling
   WorldSave_Facility.sav (read-only, off-thread) exactly like the native lookup - no
   world save needs to be open. Claim rewrites stage into a world session and finish
   with SAVE WORLD, the established web contract. *@
<section class="editor-card spawn-panel" aria-label="@L.Resource("PlayerSpawn_SpawnAndHome")">
    <h3>@L.Resource("PlayerSpawn_SpawnAndHome")</h3>
    <div class="hazard" role="presentation"></div>
    <p class="spawn-sublabel">@L.Resource("PlayerSpawn_HomeAndRespawn")</p>

    <div class="spawn-coord-grid">
        <span class="sp-label">@L.Resource("PlayerSpawn_X")</span>
        <input type="number" step="1" aria-label="@L.Resource("PlayerSpawn_X")"
               value="@Coordinate(Session.Respawn.X)" @onchange="e => SetCoordinate(e, value => Session.Respawn.X = value)" />
        <span class="sp-label">@L.Resource("PlayerSpawn_Y")</span>
        <input type="number" step="1" aria-label="@L.Resource("PlayerSpawn_Y")"
               value="@Coordinate(Session.Respawn.Y)" @onchange="e => SetCoordinate(e, value => Session.Respawn.Y = value)" />
        <span class="sp-label">@L.Resource("PlayerSpawn_Z")</span>
        <input type="number" step="1" aria-label="@L.Resource("PlayerSpawn_Z")"
               value="@Coordinate(Session.Respawn.Z)" @onchange="e => SetCoordinate(e, value => Session.Respawn.Z = value)" />
        <span class="sp-label spawn-region-label">@L.Resource("PlayerSpawn_Region")</span>
        <span class="spawn-picker-stack">
            @* The native Picker renders its Title as a muted caption above the box. *@
            <span class="spawn-picker-caption">@L.Resource("PlayerSpawn_PickRegionTitle")</span>
            <select aria-label="@L.Resource("PlayerSpawn_Region")" title="@L.Resource("PlayerSpawn_PickRegionTitle")"
                    value="@(SelectedLevelGuid ?? string.Empty)" @onchange="RegionSelected">
                @if (SelectedLevelGuid is null)
                {
                    <option value="" disabled selected></option>
                }
                @foreach (var level in Levels)
                {
                    <option value="@level.LevelGuid">@level.DisplayName</option>
                }
            </select>
        </span>
    </div>

    <div class="spawn-row">
        <span class="sp-label">@L.Resource("PlayerSpawn_RespawnTerminal")</span>
        <span class="spawn-picker-stack">
            <span class="spawn-picker-caption">@L.Resource("PlayerSpawn_PickTerminalTitle")</span>
            <select aria-label="@L.Resource("PlayerSpawn_RespawnTerminal")" title="@L.Resource("PlayerSpawn_PickTerminalTitle")"
                    value="@(Session.Respawn.TerminalGuid ?? string.Empty)" @onchange="TerminalSelected">
                @if (string.IsNullOrEmpty(Session.Respawn.TerminalGuid))
                {
                    <option value="" disabled selected></option>
                }
                else if (RespawnTerminalCatalog.NameFor(Session.Respawn.TerminalGuid) is null)
                {
                    @* The save can point at a terminal this editor doesn't know (a newer game
                       sector); keep it selectable raw exactly like the native picker did. *@
                    <option value="@Session.Respawn.TerminalGuid">@L.Resource("PlayerEditor_UnknownTerminal", Session.Respawn.TerminalGuid[..Math.Min(8, Session.Respawn.TerminalGuid.Length)])</option>
                }
                @foreach (var terminal in RespawnTerminalCatalog.All)
                {
                    <option value="@terminal.TerminalGuid">@terminal.LocationName</option>
                }
            </select>
        </span>
    </div>

    <div class="spawn-bed-row">
        <span class="sp-label">@L.Resource("PlayerSpawn_Beds")</span>
        <span class="spawn-picker-stack">
            <span class="spawn-picker-caption">@L.Resource("PlayerSpawn_ChooseBedTitle")</span>
            <select aria-label="@L.Resource("PlayerSpawn_Beds")" title="@L.Resource("PlayerSpawn_ChooseBedTitle")"
                    @bind="_selectedBedId">
                @if (_selectedBedId is null)
                {
                    <option value="" disabled selected></option>
                }
                @foreach (var bed in BedOptions)
                {
                    <option value="@bed.Bed.Id">@bed.Label</option>
                }
            </select>
        </span>
        <button type="button" class="spawn-set-btn" disabled="@(string.IsNullOrEmpty(_selectedBedId))" @onclick="SetSpawnToBed">@L.Resource("PlayerSpawn_SetSpawnHere")</button>
    </div>
    @if (_bedsLoading) { <p class="muted spawn-beds-loading">@L.Resource("PlayerPets_BedsLoading")</p> }

    @if (HomeBedText is { } homeBed)
    {
        <div class="spawn-homebed">
            <span class="sp-label">@L.Resource("PlayerSpawn_HomeBed")</span>
            <span class="spawn-homebed-value">@homeBed</span>
        </div>
    }

    @if (_status is { } status)
    {
        <p class="spawn-status" role="status">@status</p>
    }
    @if (_claimSession is { IsDirty: true } dirtyWorld)
    {
        @* The staged claim lives in a world session; the user finishes with SAVE WORLD
           (same contract as sending a companion to a bed). *@
        <p class="muted spawn-world-note">@L.Resource("PlayerPets_WorldSaveNeeded", System.IO.Path.GetFileName(dirtyWorld.Path))</p>
        <button class="heal-all-button spawn-save-world" type="button" @onclick="SaveClaimWorld">@L.Resource("PlayerPets_SaveWorld")</button>
    }

    <p class="spawn-help">@L.Resource("PlayerSpawn_SpawnHelp")</p>
</section>

@code {
    [Parameter, EditorRequired] public PlayerSaveSession Session { get; set; } = null!;
    [Parameter] public WorldSaveSession? WorldSession { get; set; }
    [Parameter] public EventCallback OnChanged { get; set; }

    private static readonly Lazy<IReadOnlyDictionary<string, string>> MachinePersonas = new(SteamPersonaIndex.LoadMachineAccounts);

    private string? _scannedPath;
    private string? _regionBaseline;
    private string? _terminalBaseline;
    private string? _selectedBedId;
    private string? _status;
    private bool _bedsLoading;
    private object? _bedSource;
    private IReadOnlyList<WorldDeployable> _deployables = [];
    private IReadOnlyList<(WorldDeployable Bed, string Label)> _bedOptions = [];
    private WorldSaveSession? _claimSession;
    private string? _homeBedText;
    private IReadOnlyList<WorldLevel> Levels { get; set; } = [];

    private IReadOnlyList<(WorldDeployable Bed, string Label)> BedOptions => _bedOptions;
    private string? HomeBedText => _homeBedText;

    protected override void OnParametersSet()
    {
        if (!string.Equals(_scannedPath, Session.Path, StringComparison.OrdinalIgnoreCase))
        {
            _scannedPath = Session.Path;
            // The snap-to-anchor guards compare against the values stored in the save, so
            // Picker churn replaying the stored value never moves the spot (native rule).
            _regionBaseline = Session.Respawn.LevelGuid;
            _terminalBaseline = Session.Respawn.TerminalGuid;
            _status = null;
            _selectedBedId = null;
            _bedSource = null;
            _claimSession = null;
            // Sibling world saves live two levels up from PlayerData\Player_<id>.sav.
            var worldDir = System.IO.Path.GetDirectoryName(System.IO.Path.GetDirectoryName(Session.Path));
            Levels = worldDir is null ? [] : WorldLevelIndex.ScanFolder(worldDir);
        }
        if (!ReferenceEquals(_bedSource, WorldSession) || _bedSource is null)
        {
            _bedSource = WorldSession ?? (object?)Session.Path;
            _ = LoadBedsAsync();
        }
    }

    /// <summary>
    /// Player beds resolved like the native lookup: the open world session's deployables
    /// when one is loaded, otherwise the sibling WorldSave_Facility.sav read off-thread.
    /// </summary>
    private async Task LoadBedsAsync()
    {
        _bedsLoading = true;
        try
        {
            if (WorldSession is { } world)
            {
                _deployables = world.Deployables;
            }
            else if (await Beds.FacilityPathForAsync(Session.Path, Workspace.Current) is { } facility)
            {
                _deployables = await Beds.GetDeployablesAsync(facility, WorldSession);
            }
            else
            {
                _deployables = [];
            }
        }
        catch (Exception ex)
        {
            Errors.Record(ex, "Read player beds from the sibling world save");
            _deployables = [];
        }
        finally
        {
            _bedsLoading = false;
            RefreshBeds();
            StateHasChanged();
        }
    }

    /// <summary>Player beds as spawn targets, claimed-by-this-player first (native ordering).</summary>
    private void RefreshBeds()
    {
        var playerId = Session.SteamIdentifier ?? string.Empty;
        var deployables = _deployables;
        if (deployables.Count == 0)
        {
            _bedOptions = [];
            _homeBedText = playerId.Length == 0 ? null : L.Resource("Main_BedLookupUnavailable");
            return;
        }

        var bases = BaseDetector.Detect(deployables);
        string BaseName(WorldDeployable bed) => bases.FirstOrDefault(worldBase => worldBase.Deployables.Contains(bed))?.Name
            ?? L.Resource("Main_OutsideAnyBase");
        // Pet beds are claimable in the same map but a player can't respawn on one.
        _bedOptions = deployables
            .Where(deployable => deployable.IsBed && !deployable.IsPetBed)
            .OrderByDescending(deployable => deployable.OwnerId == playerId)
            .Select(bed => (bed, L.Resource("Main_BedLabel", PersonaNames.Sanitize(bed.DisplayName), BaseName(bed),
                bed.X.ToString("F0", CultureInfo.CurrentCulture), bed.Y.ToString("F0", CultureInfo.CurrentCulture))))
            .ToArray();
        var mine = _bedOptions.FirstOrDefault(option => option.Bed.OwnerId == playerId);
        _selectedBedId ??= (mine.Bed ?? _bedOptions.FirstOrDefault().Bed)?.Id;

        if (playerId.Length == 0) { _homeBedText = null; return; }
        var homeBed = deployables.FirstOrDefault(deployable =>
            deployable.IsBed && deployable.OwnerId is { Length: > 0 } owner && owner == playerId);
        _homeBedText = homeBed is null
            ? L.Resource("Main_NoClaimedBed")
            : L.Resource("Main_BedLabel", homeBed.FriendlyClass, BaseName(homeBed),
                  homeBed.X.ToString("F0", CultureInfo.CurrentCulture), homeBed.Y.ToString("F0", CultureInfo.CurrentCulture))
              + (homeBed.OwnerName is { Length: > 0 } ownerName ? L.Resource("Main_BedClaimedBy", PersonaNames.Sanitize(ownerName)) : string.Empty);
    }

    private static string Coordinate(double value) => value.ToString("F0", CultureInfo.InvariantCulture);

    private async Task SetCoordinate(ChangeEventArgs args, Action<double> apply)
    {
        if (double.TryParse(args.Value?.ToString(), NumberStyles.Float, CultureInfo.InvariantCulture, out var value))
        {
            apply(value);
            await Changed();
        }
    }

    private string? SelectedLevelGuid => Levels.FirstOrDefault(level =>
        string.Equals(level.LevelGuid, Session.Respawn.LevelGuid, StringComparison.OrdinalIgnoreCase))?.LevelGuid;

    private async Task RegionSelected(ChangeEventArgs args)
    {
        var guid = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(guid)) return;
        Session.Respawn.LevelGuid = guid;
        // A user-picked region keeps the spawn coordinates honest: snap to that region's
        // punch-card terminal (a guaranteed-walkable anchor) when one exists. Guarded
        // against the save's own region.
        var level = Levels.FirstOrDefault(candidate => string.Equals(candidate.LevelGuid, guid, StringComparison.OrdinalIgnoreCase));
        if (!string.Equals(guid, _regionBaseline, StringComparison.OrdinalIgnoreCase)
            && level is not null
            && RespawnTerminalCatalog.ForRegionLabel(level.DisplayName) is { } anchor)
        {
            Session.Respawn.X = anchor.X;
            Session.Respawn.Y = anchor.Y;
            Session.Respawn.Z = anchor.Z;
        }
        await Changed();
    }

    private async Task TerminalSelected(ChangeEventArgs args)
    {
        var guid = args.Value?.ToString();
        if (string.IsNullOrWhiteSpace(guid)) return;
        Session.Respawn.TerminalGuid = guid;
        // Terminal positions are baked into the Facility map - picking one also snaps the
        // spawn coordinates onto it. Guarded against the save's own terminal.
        if (!string.Equals(guid, _terminalBaseline, StringComparison.OrdinalIgnoreCase)
            && RespawnTerminalCatalog.Find(guid) is { } terminal)
        {
            Session.Respawn.X = terminal.X;
            Session.Respawn.Y = terminal.Y;
            Session.Respawn.Z = terminal.Z;
        }
        await Changed();
    }

    private async Task SetSpawnToBed()
    {
        var option = _bedOptions.FirstOrDefault(candidate => candidate.Bed.Id == _selectedBedId);
        if (option.Bed is not { } bed) return;
        var playerId = Session.SteamIdentifier ?? string.Empty;
        var claimedByOther = bed.OwnerId is { Length: > 0 } owner && owner != playerId;
        if (claimedByOther)
        {
            // Respawning at a bed requires owning its claim; a bed claimed by someone else
            // must be reassigned - which leaves that player without a claimed bed. Confirm
            // through the shared modal dialog first.
            Modals.Show(new ModalRequest(
                L.Resource("Main_BedOtherPlayerTitle"),
                Paragraph(L.Resource("PlayerUi_ConfirmReassignBed", bed.DisplayName)),
                ConfirmText: L.Resource("Main_ReassignBedButton"),
                OnConfirm: async () => { await ApplyBedAsync(bed); await InvokeAsync(StateHasChanged); },
                CancelText: L.Resource("Common_Cancel")));
            return;
        }
        await ApplyBedAsync(bed);
    }

    private static RenderFragment Paragraph(string text) => builder =>
    {
        builder.OpenElement(0, "p");
        builder.AddContent(1, text);
        builder.CloseElement();
    };

    private async Task ApplyBedAsync(WorldDeployable bed)
    {
        // +90: stand on top of the mattress, not inside it (native offset).
        Session.Respawn.X = bed.X;
        Session.Respawn.Y = bed.Y;
        Session.Respawn.Z = bed.Z + 90;
        var playerId = Session.SteamIdentifier ?? string.Empty;
        if (playerId.Length > 0 && bed.OwnerId != playerId)
        {
            // Take (or reassign) the bed claim by staging it in a world session for the
            // save the bed lives in: the loaded world session when it is that file,
            // otherwise a session held open for the sibling Facility save. The claim
            // writes when the world is saved (SAVE WORLD below / the workspace SAVE).
            try
            {
                var worldPath = WorldSession?.Path ?? await Beds.FacilityPathForAsync(Session.Path, Workspace.Current);
                if (worldPath is not null)
                {
                    var session = await Beds.GetOrLoadSessionAsync(worldPath, WorldSession);
                    session.SetDeployableCustomName(bed.Id, $"{playerId}{WorldDeployable.ClaimSeparator}{ResolvePlayerName(playerId)}");
                    _claimSession = session;
                    _deployables = session.Deployables;
                    _bedSource = null; // labels now reflect the staged claim
                    RefreshBeds();
                }
            }
            catch (Exception ex)
            {
                Errors.Record(ex, "Stage a bed claim in the world save");
            }
        }
        _status = L.Resource("Main_SpawnMoved", bed.DisplayName);
        await Changed();
    }

    /// <summary>Writes the staged world session (with its .bak) so the bed claim lands on disk.</summary>
    private async Task SaveClaimWorld()
    {
        if (_claimSession is not { } session) return;
        try
        {
            await session.SaveAsync();
            _status = L.Resource("PlayerPets_WorldSaved", System.IO.Path.GetFileName(session.Path));
            Workspace.NotifyEdited();
            _bedSource = null;
            await LoadBedsAsync();
        }
        catch (Exception ex)
        {
            Errors.Record(ex, "Save the world file that received a bed claim");
            _status = L.Resource("PlayerUi_DropStageFailed");
        }
    }

    /// <summary>Display name to embed in a bed claim for this player.</summary>
    private string ResolvePlayerName(string ownerId)
        => MachinePersonas.Value.TryGetValue(ownerId, out var persona) ? persona : L.Resource("Main_DefaultPlayerName");

    private async Task Changed()
    {
        Session.MarkChanged();
        await OnChanged.InvokeAsync();
    }
}
