@namespace AbioticEditor.Web.Components.Player

<div class="recipe-unlock-controls">
    <span role="status">@L.Resource(ResearchPending ? "RecipeLearning_PendingResearch" : Learned ? Staged ? "RecipeGuide_Staged" : "RecipeGuide_Learned" : "RecipeGuide_NotLearned")</span>
    @if (!Learned)
    {
        <button type="button" class="primary" disabled="@Busy" @onclick="() => OnUnlock.InvokeAsync(RecipeId)">@L.Resource(Busy ? "RecipeGuide_Unlocking" : "RecipeGuide_Unlock")</button>
    }
    @if (CanUndo) { <button type="button" class="secondary" disabled="@Busy" @onclick="() => OnUndo.InvokeAsync(RecipeId)">@L.Resource("RecipeGuide_Undo")</button> }
    @if (Feedback is { Length: > 0 }) { <p class="recipe-action-feedback" role="status">@Feedback</p> }
</div>

@code {
    [Parameter, EditorRequired] public string RecipeId { get; set; } = string.Empty;
    [Parameter] public bool Learned { get; set; }
    [Parameter] public bool ResearchPending { get; set; }
    [Parameter] public bool Staged { get; set; }
    [Parameter] public bool CanUndo { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string? Feedback { get; set; }
    [Parameter] public EventCallback<string> OnUnlock { get; set; }
    [Parameter] public EventCallback<string> OnUndo { get; set; }
}
