@namespace AbioticEditor.Web.Components.Player
@using AbioticEditor.Core.Items
@using Microsoft.JSInterop
@inject IJSRuntime Js
@implements IAsyncDisposable

<div class="recipe-workflow-heading">
    <h3>@(Concealed(RootRecipe) ? L.Resource("Spoiler_Redacted") : L.Resource("RecipeGuide_MakeTitle", ItemName(RootRecipe.CreatesItemId ?? RootRecipe.Id)))</h3>
    <button type="button" class="secondary" @onclick="OnBack">@L.Resource(ReturnToCheck ? "RecipeGuide_BackCheck" : "RecipeGuide_BackBook")</button>
</div>
<div class="hazard" role="presentation"></div>
@if (Concealed(RootRecipe))
{
    <p class="recipe-workflow-copy">@L.Resource("RecipeGuide_Sealed")</p>
    <button type="button" class="secondary" @onclick="() => OnReveal.InvokeAsync(RootRecipe.Id)">@L.Resource("RecipeGuide_Reveal")</button>
}
else
{
<RecipeUnlockControls RecipeId="@RootRecipe.Id" Learned="@Learned(RootRecipe.Id)" ResearchPending="@ResearchPending(RootRecipe.Id)" Staged="@Staged(RootRecipe.Id)" CanUndo="@CanUndo(RootRecipe.Id)"
                      Busy="Busy" Feedback="@Feedback(RootRecipe.Id)" OnUnlock="OnUnlock" OnUndo="OnUndo" />
<p class="recipe-workflow-copy">@L.Resource("RecipeGuide_TreeHelp")</p>
<div class="recipe-expand-controls">
    <span>@L.Resource("RecipeGuide_AmountHelp", ItemName(RootRecipe.CreatesItemId ?? RootRecipe.Id))</span>
    <div>
        <button type="button" class="secondary" @onclick="ExpandAll">@L.Resource("RecipeGuide_ExpandAll")</button>
        <button type="button" class="secondary" @onclick="Collapse">@L.Resource("RecipeGuide_Collapse")</button>
    </div>
</div>
@if (_tree is { } tree)
{
    <div class="recipe-crafting-tree" tabindex="-1" @ref="_treeElement" aria-label="@L.Resource("RecipeGuide_MakeTitle", ItemName(RootRecipe.CreatesItemId ?? RootRecipe.Id))">
        <ul>
            <RecipeCraftingBranch Node="tree" Expanded="_expanded" ItemName="ItemName" StationName="StationName" RouteName="RouteName"
                                  Concealed="Concealed" Learned="Learned" ResearchPending="ResearchPending" OnToggle="Toggle" OnRoute="ChooseRoute"
                                  SourceHint="SourceHint"
                                  OnInspect="OnInspect" OnReveal="OnReveal" />
        </ul>
    </div>
}
@if (LearningContent is not null) { @LearningContent(RootRecipe.Id) }
<p class="recipe-workflow-copy">@L.Resource("RecipeGuide_StationHelp") @L.Resource("RecipeGuide_StockHelp")</p>
<p class="recipe-workflow-copy">@L.Resource("RecipeGuide_MaterialCoverage")</p>
}

@code {
    [Parameter, EditorRequired] public RecipeGraph Graph { get; set; } = null!;
    [Parameter, EditorRequired] public RecipeInfo RootRecipe { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, string> ItemName { get; set; } = null!;
    [Parameter, EditorRequired] public Func<RecipeInfo, string> StationName { get; set; } = null!;
    [Parameter, EditorRequired] public Func<RecipeInfo, string> RouteName { get; set; } = null!;
    [Parameter, EditorRequired] public Func<RecipeInfo, bool> Concealed { get; set; } = null!;
    [Parameter, EditorRequired] public Func<string, bool> Learned { get; set; } = null!;
    [Parameter] public Func<string, string?> SourceHint { get; set; } = _ => null;
    [Parameter] public Func<string, bool> Staged { get; set; } = _ => false;
    [Parameter] public Func<string, bool> ResearchPending { get; set; } = _ => false;
    [Parameter] public Func<string, bool> CanUndo { get; set; } = _ => false;
    [Parameter] public Func<string, string?> Feedback { get; set; } = _ => null;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string> OnUnlock { get; set; }
    [Parameter] public EventCallback<string> OnUndo { get; set; }
    [Parameter] public bool ReturnToCheck { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }
    [Parameter] public EventCallback<RecipeCraftingSelection> OnInspect { get; set; }
    [Parameter] public EventCallback<string> OnReveal { get; set; }
    [Parameter] public long RevealRequest { get; set; }
    [Parameter] public RenderFragment<string>? LearningContent { get; set; }

    private readonly HashSet<string> _expanded = ["root", "root.0"];
    private readonly Dictionary<string, string> _routes = new(StringComparer.Ordinal);
    private RecipeTreeNode? _tree;
    private RecipeGraph? _boundGraph;
    private string? _rootId;
    private ElementReference _treeElement;
    private IJSObjectReference? _guideModule;
    private long _revealedRequest;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || RevealRequest == 0 || RevealRequest == _revealedRequest || _tree is null || Concealed(RootRecipe)) return;
        _revealedRequest = RevealRequest;
        try
        {
            _guideModule ??= await Js.InvokeAsync<IJSObjectReference>("import", "./_content/AbioticEditor.Web.Shared/recipe-guide.js");
            if (_disposed) { await _guideModule.DisposeAsync(); _guideModule = null; return; }
            await _guideModule.InvokeVoidAsync("reveal", _treeElement);
        }
        catch (JSDisconnectedException) { }
        catch (JSException exception)
        {
            AbioticEditor.Core.Diagnostics.EditorLog.Warn("RecipeGuide", $"Could not reveal the crafting guide: {exception.Message}");
        }
        catch (ObjectDisposedException) when (_disposed) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_guideModule is null) return;
        try { await _guideModule.DisposeAsync(); }
        catch (JSException) { }
    }

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Graph, _boundGraph) && string.Equals(_rootId, RootRecipe.Id, StringComparison.OrdinalIgnoreCase)) return;
        _boundGraph = Graph;
        _rootId = RootRecipe.Id;
        _routes.Clear();
        _expanded.Clear();
        _expanded.UnionWith(["root", "root.0"]);
        Rebuild();
    }

    private void Rebuild()
    {
        _tree = Graph.BuildTree(RootRecipe.Id, routeChoices: _routes);
        // Player knowledge changes presentation defaults, never the static catalog graph.
        // An explicit choice, including a sealed route, is kept until the player changes it.
        for (var attempt = 0; attempt < 24; attempt++)
        {
            var changed = ChooseVisibleDefaults(_tree);
            if (!changed) break;
            _tree = Graph.BuildTree(RootRecipe.Id, routeChoices: _routes);
        }
    }
    private bool ChooseVisibleDefaults(RecipeTreeNode node)
    {
        var changed = false;
        if (node.Recipe is { } recipe && Concealed(recipe) && !_routes.ContainsKey(node.Path)
            && node.Alternatives.FirstOrDefault(info => !Concealed(info)) is { } visible)
        {
            _routes[node.Path] = visible.Id;
            changed = true;
        }
        foreach (var child in node.Children) changed |= ChooseVisibleDefaults(child);
        return changed;
    }
    private void Toggle(string path) { if (!_expanded.Add(path)) _expanded.Remove(path); }
    private void Collapse() { _expanded.Clear(); _expanded.Add("root"); }
    private void ExpandAll()
    {
        if (_tree is not null) Expand(_tree);
    }
    private void Expand(RecipeTreeNode node)
    {
        _expanded.Add(node.Path);
        foreach (var child in node.Children) Expand(child);
    }
    private void ChooseRoute(RecipeRouteChoice choice)
    {
        _routes[choice.Path] = choice.RecipeId;
        Rebuild();
    }
}
